{
  "name": "registry-typescript-clients",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node generate-all.ts",
    "check:generated": "node generate-all.ts --check",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "test": "node --test tests/*.test.ts",
    "test:deno": "deno test --allow-read=tests,../../crates/registry-platform-crypto/tests/fixtures tests/deno/",
    "build": "tsc -p tsconfig.browser.json"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
