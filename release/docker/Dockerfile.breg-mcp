# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG SOURCE_DATE_EPOCH=0

FROM public.ecr.aws/docker/library/debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a AS runtime-root
ARG SOURCE_DATE_EPOCH

ADD --checksum=sha256:967aa62605721081c3eb2a17650611a792aa802d76a6511d1840242623d204c9 https://snapshot.debian.org/archive/debian/20260913T000000Z/pool/main/g/glibc/libc6_2.41-12+deb13u4_amd64.deb /workspace/runtime-packages/libc6_2.41-12+deb13u4_amd64.deb
ADD --checksum=sha256:8784eda966b189c777a384dac5ce009e8fc9b52d006926c5a013e7fa8aa688cc https://snapshot.debian.org/archive/debian/20260913T000000Z/pool/main/g/glibc/libc6_2.41-12+deb13u4_arm64.deb /workspace/runtime-packages/libc6_2.41-12+deb13u4_arm64.deb
ADD --checksum=sha256:ff16bc048bcd7d1b256094450b79c77947d8e76fe2a24bd99b91021d591fa074 https://snapshot.debian.org/archive/debian-security/20260930T060347Z/pool/updates/main/o/openssl/libssl3t64_3.5.7-1~deb13u3_amd64.deb /workspace/runtime-packages/libssl3t64_3.5.7-1~deb13u3_amd64.deb
ADD --checksum=sha256:d0681293a160392186c6ef85a165e40603d1628a099936137d24d391bd591f97 https://snapshot.debian.org/archive/debian-security/20260930T060347Z/pool/updates/main/o/openssl/libssl3t64_3.5.7-1~deb13u3_arm64.deb /workspace/runtime-packages/libssl3t64_3.5.7-1~deb13u3_arm64.deb

# The gateway configuration, the chat host's trust anchors, the gateway's private
# key, and the audit hash key are deployment inputs. The image carries only the
# runtime binary and its licenses. The gateway keeps no citizen state; only its
# append-only tool-call audit log needs a writable persistent directory, which
# the audit sink refuses unless the runtime user owns it and no one else may
# write to it.
RUN --mount=type=bind,source=dist/image-bin,target=/workspace/image-bin \
    --mount=type=bind,source=LICENSE,target=/workspace/LICENSE \
    --mount=type=bind,source=THIRD_PARTY_NOTICES,target=/workspace/THIRD_PARTY_NOTICES,readonly \
    --mount=type=bind,source=release/scripts/install-runtime-packages.sh,target=/workspace/install-runtime-packages.sh,readonly \
    /workspace/install-runtime-packages.sh /workspace/runtime-root /workspace/runtime-packages \
    && mkdir -p \
        /workspace/runtime-root/etc/breg-mcp \
        /workspace/runtime-root/licenses/breg-mcp \
        /workspace/runtime-root/usr/local/bin \
        /workspace/runtime-root/var/lib/breg-mcp \
    && install -m 0755 /workspace/image-bin/breg-mcp /workspace/runtime-root/usr/local/bin/breg-mcp \
    && install -m 0644 /workspace/LICENSE /workspace/runtime-root/licenses/breg-mcp/LICENSE \
    && install -m 0644 /workspace/THIRD_PARTY_NOTICES /workspace/runtime-root/licenses/breg-mcp/THIRD_PARTY_NOTICES \
    && chown -R 65532:65532 /workspace/runtime-root/var/lib/breg-mcp \
    && chmod 0700 /workspace/runtime-root/var/lib/breg-mcp \
    && find /workspace/runtime-root -exec touch -h --date="@${SOURCE_DATE_EPOCH}" {} +

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2 AS runtime

LABEL org.registrystack.runtime.uid="65532" \
      org.registrystack.runtime.gid="65532"

COPY --from=runtime-root /workspace/runtime-root/ /

WORKDIR /var/lib/breg-mcp

EXPOSE 8110

# The gateway serves GET /health and GET /ready. Distroless has no shell or HTTP
# client, so the deployment platform owns the probe.
ENTRYPOINT ["/usr/local/bin/breg-mcp"]
CMD ["--runtime-config", "/etc/breg-mcp/runtime.yaml", "serve"]
