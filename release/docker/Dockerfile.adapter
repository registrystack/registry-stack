# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG SOURCE_DATE_EPOCH=0

FROM docker.io/library/debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS runtime-root
ARG SOURCE_DATE_EPOCH

ADD --checksum=sha256:b59b0625cd1a791375d40dab23a4d5d3d0641e3d0a773501becdc3725b7f99cf https://snapshot.debian.org/archive/debian/20261114T144101Z/pool/main/g/glibc/libc6_2.41-12+deb13u5_amd64.deb /workspace/runtime-packages/libc6_2.41-12+deb13u5_amd64.deb
ADD --checksum=sha256:0966fc3da1a26cc57647c68b5736f791b6e7eb498173a7993f63b6c89b4ed4f5 https://snapshot.debian.org/archive/debian/20261114T144101Z/pool/main/g/glibc/libc6_2.41-12+deb13u5_arm64.deb /workspace/runtime-packages/libc6_2.41-12+deb13u5_arm64.deb
ADD --checksum=sha256:ff16bc048bcd7d1b256094450b79c77947d8e76fe2a24bd99b91021d591fa074 https://snapshot.debian.org/archive/debian-security/20260930T060347Z/pool/updates/main/o/openssl/libssl3t64_3.5.7-1~deb13u3_amd64.deb /workspace/runtime-packages/libssl3t64_3.5.7-1~deb13u3_amd64.deb
ADD --checksum=sha256:d0681293a160392186c6ef85a165e40603d1628a099936137d24d391bd591f97 https://snapshot.debian.org/archive/debian-security/20260930T060347Z/pool/updates/main/o/openssl/libssl3t64_3.5.7-1~deb13u3_arm64.deb /workspace/runtime-packages/libssl3t64_3.5.7-1~deb13u3_arm64.deb
ADD --checksum=sha256:8c27c342230503b73dfde629642c3b352e87b554e06d60cf58772f236a305ceb https://snapshot.debian.org/archive/debian-security/20261107T075304Z/pool/updates/main/z/zlib/zlib1g_1.3.dfsg+really1.3.1-1+deb13u1_amd64.deb /workspace/runtime-packages/zlib1g_1.3.dfsg+really1.3.1-1+deb13u1_amd64.deb
ADD --checksum=sha256:0e41b3d7ad8ad7fcd36dd4d61ca91a70018478fc4af652e044f4be770784ddff https://snapshot.debian.org/archive/debian-security/20261107T075304Z/pool/updates/main/z/zlib/zlib1g_1.3.dfsg+really1.3.1-1+deb13u1_arm64.deb /workspace/runtime-packages/zlib1g_1.3.dfsg+really1.3.1-1+deb13u1_arm64.deb

# The project directory, the runtime configuration, and secrets are deployment
# inputs. The image carries the runtime binary, the adapterctl author and
# operator tool, and their licenses. The runtime stays the entrypoint. An
# operator runs adapterctl by overriding it.
# Adapter keeps its journal and idempotency state in PostgreSQL, so the image
# needs no writable persistent directory.
# Every release that carries the Adapter image stages adapterctl beside the
# runtime, and the candidate refuses a build whose staged copy is missing.
RUN --mount=type=bind,source=dist/image-bin,target=/workspace/image-bin \
    --mount=type=bind,source=LICENSE,target=/workspace/LICENSE \
    --mount=type=bind,source=THIRD_PARTY_NOTICES,target=/workspace/THIRD_PARTY_NOTICES,readonly \
    --mount=type=bind,source=release/scripts/install-runtime-packages.sh,target=/workspace/install-runtime-packages.sh,readonly \
    /workspace/install-runtime-packages.sh /workspace/runtime-root /workspace/runtime-packages \
    && mkdir -p \
        /workspace/runtime-root/etc/registry-adapter \
        /workspace/runtime-root/licenses/adapter \
        /workspace/runtime-root/usr/local/bin \
    && install -m 0755 /workspace/image-bin/adapter /workspace/runtime-root/usr/local/bin/adapter \
    && install -m 0755 /workspace/image-bin/adapterctl /workspace/runtime-root/usr/local/bin/adapterctl \
    && install -m 0644 /workspace/LICENSE /workspace/runtime-root/licenses/adapter/LICENSE \
    && install -m 0644 /workspace/THIRD_PARTY_NOTICES /workspace/runtime-root/licenses/adapter/THIRD_PARTY_NOTICES \
    && find /workspace/runtime-root -exec touch -h --date="@${SOURCE_DATE_EPOCH}" {} +

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:cb87acc574abe719b6e5c547384defa2f7b1f24af9605d3f618cf852495d8be2 AS runtime

LABEL org.registrystack.runtime.uid="65532" \
      org.registrystack.runtime.gid="65532"

COPY --from=runtime-root /workspace/runtime-root/ /

EXPOSE 8080

# Adapter serves GET /health and GET /ready on the listener its runtime
# configuration binds, and the examples bind port 8080. Distroless has no shell
# or HTTP client, so the deployment platform owns the probe.
ENTRYPOINT ["/usr/local/bin/adapter"]
CMD ["serve", "--runtime-config", "/etc/registry-adapter/runtime.yaml", "--project", "/etc/registry-adapter/project"]
