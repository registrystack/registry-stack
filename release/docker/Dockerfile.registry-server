# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG SOURCE_DATE_EPOCH=0

FROM debian:trixie-slim@sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258 AS runtime-root
ARG SOURCE_DATE_EPOCH

# The runtime configuration, compiled package, deployment trust anchor, runtime
# secrets, migration credential, and signing keys are deployment inputs. The
# release image carries only the runtime binary and the license, and gives
# operators fixed read-only mount points under /etc/registry-server.
RUN --mount=type=bind,source=dist/image-bin,target=/workspace/image-bin \
    --mount=type=bind,source=LICENSE,target=/workspace/LICENSE \
    mkdir -p \
        /workspace/runtime-root/etc/registry-server \
        /workspace/runtime-root/licenses/registry-server \
        /workspace/runtime-root/usr/local/bin \
        /workspace/runtime-root/var/lib/registry-server \
    && install -m 0755 /workspace/image-bin/registry-server /workspace/runtime-root/usr/local/bin/registry-server \
    && install -m 0644 /workspace/LICENSE /workspace/runtime-root/licenses/registry-server/LICENSE \
    && chown -R 65532:65532 /workspace/runtime-root/var/lib/registry-server \
    && find /workspace/runtime-root -exec touch -h --date="@${SOURCE_DATE_EPOCH}" {} +

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:d97bc0a941b8d4be647dc0ee75b264ddbb772f1ac5ba690a4309c00723b23775 AS runtime

LABEL org.registrystack.runtime.uid="65532" \
      org.registrystack.runtime.gid="65532"

COPY --from=runtime-root /workspace/runtime-root/ /

WORKDIR /var/lib/registry-server

EXPOSE 8080

# Registry Server serves GET /health and GET /healthz. Distroless has no shell
# or HTTP client, and the runtime deliberately has no healthcheck subcommand.
ENTRYPOINT ["/usr/local/bin/registry-server"]
CMD ["--config", "/etc/registry-server/runtime.yaml"]
