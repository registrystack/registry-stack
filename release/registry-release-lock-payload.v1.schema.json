{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/release/registry-release-lock-payload.v1.schema.json",
  "title": "RegistryReleaseLockV1 signed payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "release",
    "registryctl_artifacts",
    "images",
    "runtime",
    "supported_contracts",
    "embedded_starters",
    "minimum_compose_version",
    "postgresql_major_version"
  ],
  "properties": {
    "schema_id": {
      "const": "io.registrystack.registry_release_lock"
    },
    "schema_version": {
      "const": "1.0"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "registryctl_artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/registryctl_artifact"
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relay",
        "notary",
        "postgresql_state_plane"
      ],
      "properties": {
        "relay": {
          "$ref": "#/$defs/image"
        },
        "notary": {
          "$ref": "#/$defs/image"
        },
        "postgresql_state_plane": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relay_public",
        "relay_consultation",
        "notary",
        "postgresql_state_plane",
        "operator_files"
      ],
      "properties": {
        "relay_public": {
          "$ref": "#/$defs/product_runtime"
        },
        "relay_consultation": {
          "$ref": "#/$defs/product_runtime"
        },
        "notary": {
          "$ref": "#/$defs/product_runtime"
        },
        "postgresql_state_plane": {
          "$ref": "#/$defs/postgresql_runtime"
        },
        "operator_files": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": {
            "$ref": "#/$defs/operator_file"
          }
        }
      }
    },
    "supported_contracts": {
      "$ref": "#/$defs/supported_contracts"
    },
    "embedded_starters": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/starter"
      }
    },
    "minimum_compose_version": {
      "const": "2.35.0"
    },
    "postgresql_major_version": {
      "const": 17
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32768
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_version",
        "release_tag",
        "source_repository",
        "source_workflow",
        "source_ref",
        "manifest_source_ref",
        "tag_target"
      ],
      "properties": {
        "product_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "release_tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "source_repository": {
          "const": "registrystack/registry-stack"
        },
        "source_workflow": {
          "const": ".github/workflows/release.yml"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "manifest_source_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tag_target": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "registryctl_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "filename",
        "sha256"
      ],
      "properties": {
        "platform": {
          "enum": [
            "linux-amd64",
            "linux-arm64",
            "macos-arm64"
          ]
        },
        "filename": {
          "type": "string",
          "pattern": "^registryctl-v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?-(linux-amd64|linux-arm64|macos-arm64)$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "manifest_digest"
      ],
      "properties": {
        "platform": {
          "enum": [
            "linux-amd64",
            "linux-arm64"
          ]
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "platforms"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/platform"
          }
        }
      }
    },
    "product_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serve",
        "prepare_state_store",
        "initialize_state",
        "verify_state",
        "health_probe"
      ],
      "properties": {
        "serve": {
          "$ref": "#/$defs/runtime_action"
        },
        "prepare_state_store": {
          "$ref": "#/$defs/runtime_action"
        },
        "initialize_state": {
          "$ref": "#/$defs/runtime_action"
        },
        "verify_state": {
          "$ref": "#/$defs/runtime_action"
        },
        "health_probe": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "mount_source": {
      "enum": [
        "bundle",
        "anchor",
        "anti_rollback_state",
        "audit",
        "postgresql_data"
      ]
    },
    "runtime_mount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "read_only"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/mount_source"
        },
        "target": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f]{1,511}$"
        },
        "read_only": {
          "type": "boolean"
        }
      }
    },
    "secret_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "target",
        "mode",
        "uid",
        "gid"
      ],
      "properties": {
        "file_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "target": {
          "type": "string",
          "pattern": "^/run/secrets/[^/\\u0000-\\u001f]{1,127}$"
        },
        "mode": {
          "const": "0400"
        },
        "uid": {
          "enum": [
            "65532",
            "999"
          ]
        },
        "gid": {
          "enum": [
            "65532",
            "999"
          ]
        }
      }
    },
    "runtime_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "mounts",
        "environment_files",
        "secret_files"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/command"
        },
        "mounts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/runtime_mount"
          }
        },
        "environment_files": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "secret_files": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/secret_projection"
          }
        }
      }
    },
    "service_hardening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "read_only_root_filesystem",
        "cap_drop",
        "security_opt",
        "tmpfs"
      ],
      "properties": {
        "user": {
          "const": "999:999"
        },
        "read_only_root_filesystem": {
          "const": true
        },
        "cap_drop": {
          "const": [
            "ALL"
          ]
        },
        "security_opt": {
          "const": [
            "no-new-privileges:true"
          ]
        },
        "tmpfs": {
          "const": [
            "/tmp",
            "/var/run/postgresql:uid=999,gid=999,mode=0750"
          ]
        }
      }
    },
    "postgresql_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serve",
        "bootstrap",
        "health_probe",
        "server_environment",
        "hardening"
      ],
      "properties": {
        "serve": {
          "$ref": "#/$defs/runtime_action"
        },
        "bootstrap": {
          "$ref": "#/$defs/runtime_action"
        },
        "health_probe": {
          "$ref": "#/$defs/command"
        },
        "server_environment": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "hardening": {
          "$ref": "#/$defs/service_hardening"
        }
      }
    },
    "operator_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "format",
        "mode",
        "allowed_owners",
        "required_keys"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "format": {
          "enum": [
            "dotenv",
            "pem_certificate",
            "pem_private_key",
            "json_web_key",
            "compact_jwt",
            "opaque"
          ]
        },
        "mode": {
          "const": "0600"
        },
        "allowed_owners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "root:root",
              "65532:65532",
              "999:999"
            ]
          }
        },
        "required_keys": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
          }
        }
      }
    },
    "supported_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_bundle_schema",
        "config_signature_schema",
        "trust_anchor_schema",
        "anchor_transition_schema",
        "relay_config_schema",
        "notary_config_schema"
      ],
      "properties": {
        "config_bundle_schema": {
          "const": "registry.platform.config_bundle.v1"
        },
        "config_signature_schema": {
          "const": "registry.platform.config_bundle_signatures.v1"
        },
        "trust_anchor_schema": {
          "const": "registry.platform.config_trust_anchor.v1"
        },
        "anchor_transition_schema": {
          "const": "registry.platform.anchor_transition@1.0"
        },
        "relay_config_schema": {
          "const": "https://id.registrystack.org/schemas/registry-relay/registry-relay.config.schema.json"
        },
        "notary_config_schema": {
          "const": "https://id.registrystack.org/schemas/registry-notary/registry-notary.config.schema.json"
        }
      }
    },
    "starter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "release",
        "content_digest"
      ],
      "properties": {
        "id": {
          "enum": [
            "dhis2-tracker",
            "fhir-r4",
            "http",
            "opencrvs-dci",
            "snapshot"
          ]
        },
        "release": {
          "type": "string"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
