{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/release/registry-release-lock-payload.v1.schema.json",
  "title": "RegistryReleaseLockV1 signed payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "release",
    "registryctl_artifacts",
    "images",
    "runtime",
    "supported_contracts",
    "embedded_starters",
    "minimum_compose_version",
    "postgresql_major_version"
  ],
  "properties": {
    "schema_id": {
      "const": "io.registrystack.registry_release_lock"
    },
    "schema_version": {
      "const": "1.0"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "registryctl_artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/registryctl_artifact"
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relay",
        "notary",
        "postgresql_state_plane",
        "private_namespace_holder"
      ],
      "properties": {
        "relay": {
          "$ref": "#/$defs/image"
        },
        "notary": {
          "$ref": "#/$defs/image"
        },
        "postgresql_state_plane": {
          "$ref": "#/$defs/image"
        },
        "private_namespace_holder": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relay_public",
        "relay_consultation",
        "notary",
        "postgresql_state_plane",
        "private_namespace_holder"
      ],
      "properties": {
        "relay_public": {
          "$ref": "#/$defs/product_runtime"
        },
        "relay_consultation": {
          "$ref": "#/$defs/product_runtime"
        },
        "notary": {
          "$ref": "#/$defs/product_runtime"
        },
        "postgresql_state_plane": {
          "$ref": "#/$defs/supporting_runtime"
        },
        "private_namespace_holder": {
          "$ref": "#/$defs/supporting_runtime"
        }
      }
    },
    "supported_contracts": {
      "$ref": "#/$defs/supported_contracts"
    },
    "embedded_starters": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/starter"
      }
    },
    "minimum_compose_version": {
      "const": "2.35.0"
    },
    "postgresql_major_version": {
      "const": 17
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_version",
        "release_tag",
        "source_repository",
        "source_workflow",
        "source_ref",
        "source_sha"
      ],
      "properties": {
        "product_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "release_tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "source_repository": {
          "const": "registrystack/registry-stack"
        },
        "source_workflow": {
          "const": ".github/workflows/release.yml"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "registryctl_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "filename",
        "sha256"
      ],
      "properties": {
        "platform": {
          "enum": [
            "linux-amd64",
            "linux-arm64",
            "macos-arm64"
          ]
        },
        "filename": {
          "type": "string",
          "pattern": "^registryctl-v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?-(linux-amd64|linux-arm64|macos-arm64)$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "manifest_digest"
      ],
      "properties": {
        "platform": {
          "enum": [
            "linux-amd64",
            "linux-arm64"
          ]
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "platforms"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/platform"
          }
        }
      }
    },
    "product_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serve",
        "prepare_state_store",
        "initialize_state",
        "verify_state",
        "health_probe"
      ],
      "properties": {
        "serve": {
          "$ref": "#/$defs/command"
        },
        "prepare_state_store": {
          "$ref": "#/$defs/command"
        },
        "initialize_state": {
          "$ref": "#/$defs/command"
        },
        "verify_state": {
          "$ref": "#/$defs/command"
        },
        "health_probe": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "supporting_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "health_probe"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/command"
        },
        "health_probe": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "supported_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_bundle_schema",
        "config_signature_schema",
        "trust_anchor_schema",
        "anchor_transition_schema",
        "relay_config_schema",
        "notary_config_schema"
      ],
      "properties": {
        "config_bundle_schema": {
          "const": "registry.platform.config_bundle.v1"
        },
        "config_signature_schema": {
          "const": "registry.platform.config_bundle_signatures.v1"
        },
        "trust_anchor_schema": {
          "const": "registry.platform.config_trust_anchor.v1"
        },
        "anchor_transition_schema": {
          "const": "registry.platform.anchor_transition@1.0"
        },
        "relay_config_schema": {
          "const": "https://id.registrystack.org/schemas/registry-relay/registry-relay.config.schema.json"
        },
        "notary_config_schema": {
          "const": "https://id.registrystack.org/schemas/registry-notary/registry-notary.config.schema.json"
        }
      }
    },
    "starter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "release",
        "content_digest"
      ],
      "properties": {
        "id": {
          "enum": [
            "dhis2-tracker",
            "fhir-r4",
            "http",
            "opencrvs-dci",
            "snapshot",
            "spreadsheet"
          ]
        },
        "release": {
          "type": "string"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
