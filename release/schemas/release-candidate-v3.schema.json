{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/schemas/release-candidate-v3.schema.json",
  "title": "Registry Stack unit release candidate v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "release",
    "workflow",
    "validity",
    "payloads",
    "images",
    "sbom",
    "scans",
    "advisory",
    "bundle"
  ],
  "properties": {
    "schema_version": {"const": "registry-stack.release-candidate.v3"},
    "repository": {"const": "registrystack/registry-stack"},
    "release": {
      "oneOf": [
        {"$ref": "#/$defs/discoveryRelease"},
        {"$ref": "#/$defs/stackRelease"}
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision", "run_id", "run_attempt"],
      "properties": {
        "path": {"const": ".github/workflows/release-candidate.yml"},
        "revision": {"$ref": "#/$defs/sha"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1}
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "expires_at"],
      "properties": {
        "created_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/payload"},
      "contains": {
        "type": "object",
        "required": ["kind"],
        "properties": {"kind": {"const": "security-evidence"}}
      },
      "minContains": 1,
      "maxContains": 1
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidateImage"}
    },
    "sbom": {"$ref": "#/$defs/fileReference"},
    "docs": {"$ref": "#/$defs/fileReference"},
    "distribution_components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/distributionComponent"}
    },
    "components": {"$ref": "#/$defs/rstackComponentManifest"},
    "scans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image", "name", "sha256", "status"],
        "properties": {
          "image": {"type": "string", "minLength": 1},
          "name": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "status": {"const": "passed"}
        }
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "verdict"],
      "properties": {
        "name": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "verdict": {"const": "passed"}
      }
    },
    "bundle": {"$ref": "#/$defs/sizedFile"}
  },
  "oneOf": [
    {
      "properties": {"release": {"$ref": "#/$defs/discoveryRelease"}},
      "not": {
        "anyOf": [
          {"required": ["docs"]},
          {"required": ["distribution_components"]},
          {"required": ["components"]}
        ]
      }
    },
    {
      "required": ["docs", "distribution_components"],
      "if": {
        "properties": {
          "release": {
            "properties": {
              "version": {
                "anyOf": [
                  {"pattern": "^0\\.(?:4[4-9]|[5-9][0-9])\\.[0-9]+$"},
                  {"pattern": "^0\\.[1-9][0-9]{2,}\\.[0-9]+$"},
                  {"pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"}
                ]
              }
            }
          }
        }
      },
      "then": {"required": ["components"]},
      "else": {"not": {"required": ["components"]}},
      "properties": {
        "release": {"$ref": "#/$defs/stackRelease"},
        "payloads": {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": {"kind": {"const": "distribution"}}
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  ],
  "$defs": {
    "discoveryRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "version", "release_id", "tag", "source_sha"],
      "properties": {
        "unit": {"const": "discovery"},
        "version": {"$ref": "#/$defs/version"},
        "release_id": {"$ref": "#/$defs/releaseId"},
        "tag": {
          "type": "string",
          "pattern": "^discovery/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "source_sha": {"$ref": "#/$defs/sha"}
      }
    },
    "stackRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "release_id", "tag", "source_sha"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "release_id": {"$ref": "#/$defs/releaseId"},
        "tag": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "source_sha": {"$ref": "#/$defs/sha"}
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "path": {"type": "string", "minLength": 1},
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sizedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256"],
      "properties": {
        "name": {"$ref": "#/$defs/path"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "size", "sha256"],
      "properties": {
        "name": {"$ref": "#/$defs/path"},
        "kind": {
          "enum": ["binary", "installer", "notice", "docs", "client-package", "sbom", "security-evidence", "distribution"]
        },
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "candidate_ref", "digest", "final_ref"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "candidate_ref": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "final_ref": {"type": "string", "minLength": 1}
      }
    },
    "rstackComponentManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "release", "launcher", "components"],
      "properties": {
        "schema_version": {"const": "registry-stack.components.v1"},
        "release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "launcher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux-amd64", "linux-arm64", "macos-arm64"],
          "properties": {
            "linux-amd64": {"$ref": "#/$defs/rstackComponentAsset"},
            "linux-arm64": {"$ref": "#/$defs/rstackComponentAsset"},
            "macos-arm64": {"$ref": "#/$defs/rstackComponentAsset"}
          }
        },
        "components": {
          "type": "object",
          "propertyNames": {
            "enum": ["breg", "casework", "discovery", "evidence", "manifest", "messaging", "render", "scheduling", "coordinator"]
          },
          "additionalProperties": {"$ref": "#/$defs/rstackComponent"}
        }
      }
    },
    "rstackComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "dependencies", "platforms"],
      "properties": {
        "entrypoint": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "platforms": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"enum": ["linux-amd64", "linux-arm64", "macos-arm64"]},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assets", "capabilities"],
            "properties": {
              "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rstackComponentAsset"}},
              "capabilities": {"type": "object", "additionalProperties": {"type": "boolean"}}
            }
          }
        }
      }
    },
    "rstackComponentAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "distributionComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "version", "release_tag", "source_sha", "manifest", "payloads", "images"],
      "properties": {
        "unit": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "release_tag": {"type": "string"},
        "source_sha": {"$ref": "#/$defs/sha"},
        "manifest": {"$ref": "#/$defs/fileReference"},
        "payloads": {"type": "array", "items": {"$ref": "#/$defs/payload"}},
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "final_ref", "digest"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "final_ref": {"type": "string", "minLength": 1},
              "digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    }
  }
}
