# The single home for the glibc floor of published Registry Stack Linux
# binaries: the oldest glibc a released binary may require to start.
#
# 2.35 is Ubuntu 22.04 LTS. Debian 12 carries 2.36 and Ubuntu 24.04 carries
# 2.39, so both run a binary built to this floor.
#
# Consumers:
#   release/scripts/build-release-binaries.sh   selects the zig glibc target
#   release/scripts/check-glibc-floor.sh        refuses a binary above it
#   release/scripts/render-installer-libc-preflight.py
#                                               writes it into the published
#                                               installer scripts
#
# Raising this value strands every adopter whose distribution is older, so it
# is a release-policy change, not a build detail.
REGISTRY_GLIBC_FLOOR=2.35
