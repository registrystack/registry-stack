#!/usr/bin/env bash
set -euo pipefail

case "$(basename -- "$0")" in
  zig-cc)
    driver=cc
    ;;
  zig-cxx)
    driver=c++
    ;;
  *)
    printf 'zig-glibc-compiler must be invoked as zig-cc or zig-cxx\n' >&2
    exit 2
    ;;
esac

zig_python="${REGISTRY_ZIG_PYTHON:-}"
zig_target="${REGISTRY_ZIG_TARGET:-}"
if [[ "${zig_python}" != /* || ! -x "${zig_python}" ]]; then
  printf 'REGISTRY_ZIG_PYTHON must name an absolute executable\n' >&2
  exit 2
fi
# The wrapper is reached through a symlink named zig-cc or zig-cxx, so the
# invocation path is followed back to this file before the floor beside it is
# read. The floor has one home and is never repeated here.
self="${BASH_SOURCE[0]}"
while [[ -L "${self}" ]]; do
  link="$(readlink -- "${self}")"
  case "${link}" in
    /*) self="${link}" ;;
    *) self="$(dirname -- "${self}")/${link}" ;;
  esac
done
script_dir="$(cd -- "$(dirname -- "${self}")" && pwd)"
floor_file="${script_dir}/../glibc-floor.env"
if [[ ! -f "${floor_file}" ]]; then
  printf 'the release glibc floor is missing: %s\n' "${floor_file}" >&2
  exit 2
fi
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../glibc-floor.env
. "${floor_file}"
product_floor="${REGISTRY_GLIBC_FLOOR:?REGISTRY_GLIBC_FLOOR is required}"

# The Node addons keep an older floor on purpose: they are loaded into a host
# Node process, so they must start wherever that runtime already starts. The
# product binaries own their own process and follow the release floor.
node_addon_floor=2.17

approved=()
for floor in "${node_addon_floor}" "${product_floor}"; do
  approved+=("x86_64-linux-gnu.${floor}" "aarch64-linux-gnu.${floor}")
done
# The check is a plain comparison rather than a pipeline into grep: under
# pipefail a pipeline fails whenever grep matches and exits before printf has
# written every candidate, and cc-rs runs this wrapper hundreds of times in
# parallel.
target_approved=0
for candidate in "${approved[@]}"; do
  if [[ "${zig_target}" == "${candidate}" ]]; then
    target_approved=1
  fi
done
if (( target_approved == 0 )); then
  printf 'REGISTRY_ZIG_TARGET must name an approved target, one of: %s\n' \
    "${approved[*]}" >&2
  exit 2
fi

# cc-rs adds the Rust target even when the selected compiler is a wrapper.
# Remove its target selector so Zig receives exactly the approved target above.
# CMake's compiler-ABI probe also asks the linker to print its version; Zig
# 0.12.1 rejects that informational linker flag, which prevents CMake from
# detecting a 64-bit target and makes AWS-LC select the wrong assembly set.
filtered=()
while (( "$#" )); do
  case "$1" in
    -Wl,-v)
      shift
      ;;
    --target=*)
      shift
      ;;
    --target|-target)
      if (( "$#" < 2 )); then
        printf '%s requires a target argument\n' "$1" >&2
        exit 2
      fi
      shift 2
      ;;
    -target=*)
      printf 'unsupported target selector: %s\n' "$1" >&2
      exit 2
      ;;
    *)
      filtered+=("$1")
      shift
      ;;
  esac
done

compiler=("${zig_python}" -m ziglang "${driver}" -target "${zig_target}")

# AWS-LC-FIPS generates its validated module as textual assembly while CMake
# also requests a dependency file. Zig 0.12.1 exits successfully for that
# combined invocation without writing the requested assembly output. Preserve
# both outputs with two ordinary compiler passes. This stays in the pinned Zig
# adapter so every canonical Linux artifact follows the same glibc-floor path.
has_assembly=0
has_dependencies=0
for argument in "${filtered[@]}"; do
  case "${argument}" in
    -S) has_assembly=1 ;;
    -MD | -MMD) has_dependencies=1 ;;
  esac
done

if (( has_assembly && has_dependencies )); then
  dependency_args=()
  assembly_args=()
  index=0
  while (( index < ${#filtered[@]} )); do
    argument="${filtered[index]}"
    case "${argument}" in
      -S | -c)
        ;;
      -MD | -MMD)
        dependency_args+=("${argument}")
        ;;
      -MF | -MT | -MQ)
        if (( index + 1 >= ${#filtered[@]} )); then
          printf '%s requires an argument\n' "${argument}" >&2
          exit 2
        fi
        dependency_args+=("${argument}" "${filtered[index + 1]}")
        ((index += 1))
        ;;
      -o)
        if (( index + 1 >= ${#filtered[@]} )); then
          printf '%s requires an argument\n' "${argument}" >&2
          exit 2
        fi
        assembly_args+=("${argument}" "${filtered[index + 1]}")
        ((index += 1))
        ;;
      *)
        dependency_args+=("${argument}")
        assembly_args+=("${argument}")
        ;;
    esac
    ((index += 1))
  done
  dependency_args+=(-E)
  assembly_args+=(-S)
  if "${compiler[@]}" "${dependency_args[@]}" >/dev/null; then
    exec "${compiler[@]}" "${assembly_args[@]}"
  else
    exit $?
  fi
fi

exec "${compiler[@]}" "${filtered[@]}"
