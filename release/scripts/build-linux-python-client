#!/usr/bin/env bash
set -euo pipefail

client=""
rust_target=""
compatibility=""
zig_python=""
maturin=""
output_dir=""
profile="release"
while (( "$#" )); do
  case "$1" in
    --client|--target|--compatibility|--zig-python|--maturin|--out|--profile)
      if (( "$#" < 2 )); then
        printf '%s requires a value\n' "$1" >&2
        exit 2
      fi
      case "$1" in
        --client) client="$2" ;;
        --target) rust_target="$2" ;;
        --compatibility) compatibility="$2" ;;
        --zig-python) zig_python="$2" ;;
        --maturin) maturin="$2" ;;
        --out) output_dir="$2" ;;
        --profile) profile="$2" ;;
      esac
      shift 2
      ;;
    *)
      printf 'unknown argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

case "${client}" in
  discovery|evidence|relay|breg|casework|messaging) ;;
  *)
    printf 'client must be discovery, evidence, relay, breg, casework, or messaging\n' >&2
    exit 2
    ;;
esac

case "${rust_target}" in
  x86_64-unknown-linux-gnu)
    zig_target=x86_64-linux-gnu.2.17
    ;;
  aarch64-unknown-linux-gnu)
    zig_target=aarch64-linux-gnu.2.17
    ;;
  *)
    printf 'unsupported Linux Python target: %s\n' "${rust_target}" >&2
    exit 2
    ;;
esac

case "${compatibility}" in
  linux|manylinux_2_17) ;;
  *)
    printf 'compatibility must be linux or manylinux_2_17\n' >&2
    exit 2
    ;;
esac

case "${profile}" in
  release) profile_flags=(--release) ;;
  ci)
    profile_flags=(--profile ci)
    # The workspace CI profile deliberately inherits dev to avoid release LTO.
    # AWS-LC-FIPS cannot delocate the unoptimized x86_64 assembly Zig emits at
    # opt-level 0. Level 1 keeps this a cheap, non-LTO CI build while selecting
    # AWS-LC's supported release CMake mode.
    export CARGO_PROFILE_CI_OPT_LEVEL=1
    ;;
  *)
    printf 'profile must be release or ci\n' >&2
    exit 2
    ;;
esac

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/../.." && pwd)"
client_dir="${repo_root}/crates/registry-${client}-client-py"
if [[ ! -f "${client_dir}/pyproject.toml" ]]; then
  printf 'Python client manifest is missing: %s\n' "${client_dir}/pyproject.toml" >&2
  exit 2
fi
if [[ "${zig_python}" != /* || ! -x "${zig_python}" ]]; then
  printf 'zig Python must name an absolute executable\n' >&2
  exit 2
fi
if [[ "${maturin}" != /* || ! -x "${maturin}" ]]; then
  printf 'maturin must name an absolute executable\n' >&2
  exit 2
fi
if [[ "${output_dir}" != /* ]]; then
  printf 'output directory must be absolute\n' >&2
  exit 2
fi
zig_version="$("${zig_python}" -m ziglang version)"
if [[ "${zig_version}" != 0.12.1 ]]; then
  printf 'zig Python must provide hash-pinned ziglang 0.12.1, got %s\n' \
    "${zig_version}" >&2
  exit 2
fi

compiler="${script_dir}/zig-glibc-compiler"
test -x "${compiler}"

if [[ -n "${RUNNER_TEMP:-}" ]]; then
  # Keep compiler paths stable across this job's product builds. Separate
  # checkouts, toolchains, targets, and wrapper revisions retain distinct paths
  # so Cargo cannot reuse a native build made with different compiler inputs.
  wrapper_key="$({
    printf '%s\0' "${compiler}" "${zig_python}" "${zig_version}" "${zig_target}"
    cat "${compiler}" "${script_dir}/../glibc-floor.env"
  } | sha256sum | cut -d ' ' -f 1)"
  wrapper_root="${RUNNER_TEMP}/registry-python-zig/${wrapper_key}"
  mkdir -p -- "${wrapper_root}"
else
  wrapper_root="$(mktemp -d /tmp/registry-python-zig.XXXXXX)"
  cleanup() {
    rm -rf -- "${wrapper_root}"
  }
  trap cleanup EXIT
fi
for driver in zig-cc zig-cxx; do
  if ! ln -s "${compiler}" "${wrapper_root}/${driver}" 2>/dev/null; then
    if [[ ! -L "${wrapper_root}/${driver}" ||
          "$(readlink -- "${wrapper_root}/${driver}")" != "${compiler}" ]]; then
      printf 'unexpected compiler wrapper: %s\n' "${wrapper_root}/${driver}" >&2
      exit 2
    fi
  fi
done

cc_wrapper="${wrapper_root}/zig-cc"
cxx_wrapper="${wrapper_root}/zig-cxx"
target_env="${rust_target//-/_}"
cargo_target_env="${target_env^^}"

export REGISTRY_ZIG_PYTHON="${zig_python}"
export REGISTRY_ZIG_TARGET="${zig_target}"
export HOST_CC="${cc_wrapper}"
export HOST_CXX="${cxx_wrapper}"
export TARGET_CC="${cc_wrapper}"
export TARGET_CXX="${cxx_wrapper}"
export "CC_${target_env}=${cc_wrapper}"
export "CXX_${target_env}=${cxx_wrapper}"
export "CARGO_TARGET_${cargo_target_env}_LINKER=${cc_wrapper}"

(
  cd "${client_dir}"
  "${maturin}" build "${profile_flags[@]}" --locked \
    --target "${rust_target}" --compatibility "${compatibility}" \
    --out "${output_dir}"
)
