fn mapping_walk(value, steps, path) {
    for step in steps {
        if type_of(value) != "map" || !value.contains(step[0]) {
            return ();
        }
        value = value[step[0]];
        if step.len() == 3 {
            if type_of(value) != "array" {
                return ();
            }
            let found = ();
            let count = 0;
            for item in value {
                if type_of(item) == "map" && item.contains(step[1]) && item[step[1]] == step[2] {
                    found = item;
                    count += 1;
                }
            }
            if count > 1 {
                throw "mapping.duplicate: " + path;
            }
            if count == 0 {
                return ();
            }
            value = found;
        }
    }
    value
}

fn mapping_required(value, path) {
    if type_of(value) == "()" {
        throw "mapping.missing: " + path;
    }
    value
}

fn mapping_date(value, path) {
    if type_of(value) == "string" && value.len() == 10 {
        let characters = value.to_chars();
        let ok = true;
        for position in 0..10 {
            if position == 4 || position == 7 {
                if characters[position] != '-' {
                    ok = false;
                }
            } else if characters[position] < '0' || characters[position] > '9' {
                ok = false;
            }
        }
        if ok {
            let year = parse_int(value.sub_string(0, 4));
            let month = parse_int(value.sub_string(5, 2));
            let day = parse_int(value.sub_string(8, 2));
            if month >= 1 && month <= 12 {
                let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
                let days = [31, if leap { 29 } else { 28 }, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
                if day >= 1 && day <= days[month - 1] {
                    return value;
                }
            }
        }
    }
    throw "mapping.conversion: " + path;
}

fn project_person_registration(source) {
    let out = #{
        "registration": #{
            "organisationUnit": mapping_required(mapping_walk(source, [["orgUnit"]], "registration.organisationUnit"), "registration.organisationUnit"),
            "lastChangedAt": mapping_required(mapping_walk(source, [["updatedAt"]], "registration.lastChangedAt"), "registration.lastChangedAt")
        },
        "person": #{
            "dateOfBirth": mapping_date(mapping_required(mapping_walk(source, [["attributes", "attribute", "Dob00000001"], ["value"]], "person.dateOfBirth"), "person.dateOfBirth"), "person.dateOfBirth")
        }
