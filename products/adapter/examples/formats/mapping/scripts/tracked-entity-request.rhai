            for item in value {
                if type_of(item) == "map" && item.contains(step[1]) && item[step[1]] == step[2] {
                    found = item;
                    count += 1;
                }
            }
            if count > 1 {
                throw "mapping.duplicate: " + path;
            }
            if count == 0 {
                return ();
            }
            value = found;
        }
    }
    value
}

fn mapping_required(value, path) {
