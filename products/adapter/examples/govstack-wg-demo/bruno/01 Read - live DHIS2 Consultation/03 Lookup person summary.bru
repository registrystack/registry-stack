meta {
  name: 03 Lookup person summary
  type: http
  seq: 3
}

post {
  url: {{dhis2_base}}/v1/collections/people-summary/lookup
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "selector": "by-record-id",
    "values": {
      "record-id": "{{dhis2RecordId}}"
    }
  }
}

tests {
  test("Lookup uses the generated selector and returns one summary", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.recordId).to.equal(bru.getVar("dhis2RecordId"));
    expect(res.body.data).to.have.all.keys("organisationUnit", "lastChangedAt");
  });
}
