meta {
  name: 04 Update contact and remove note
  type: http
  seq: 4
}

patch {
  url: {{breg_base}}/v1/collections/contacts/records/{{recordId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/merge-patch+json
  Authorization: Bearer {{access_token}}
  Idempotency-Key: "wg-update-{{runId}}"
  If-Match: {{etag}}
}

body:json {
  {
    "data": {
      "name": "Registry WG updated {{runId}}",
      "note": null
    }
  }
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setVar("newEtag", res.getHeader("etag"));
  }
}

tests {
  test("conditional JSON Merge Patch succeeds without a body", function() {
    expect(res.getStatus()).to.equal(204);
    expect(res.body === "" || res.body == null).to.equal(true);
  });

  test("Update returns a new strong validator", function() {
    const newEtag = res.getHeader("etag");
    expect(newEtag).to.match(/^"[\x21\x23-\x7e]{1,256}"$/);
    expect(newEtag).to.not.equal(bru.getVar("etag"));
  });
}
