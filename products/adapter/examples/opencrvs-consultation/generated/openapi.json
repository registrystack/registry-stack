            },
            "description": "The request could not be served."
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The source answered with an error."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The service is unavailable."
          },
          "504": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The source did not answer in time."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-govstack-digital-registries": {
          "capability": "retrieve",
          "collection": "birth-registrations",
          "registry": "https://registry.example/registries/civil",
          "view": "birth-summary"
        }
      }
    }
  }
