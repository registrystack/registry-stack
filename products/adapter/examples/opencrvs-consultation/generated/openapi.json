{
  "components": {
    "schemas": {
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "errors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                "pointer": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "pointer",
                "message"
              ],
              "type": "object"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "traceId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "format": "uri",
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "traceId"
        ],
        "type": "object"
      },
      "ValidationProblem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "errors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                "pointer": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "pointer",
                "message"
              ],
              "type": "object"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "traceId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "format": "uri",
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "traceId",
          "errors"
        ],
        "type": "object"
      },
      "birth-summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "dateOfEvent": {
            "format": "date",
            "type": "string"
          },
          "registration": {
            "additionalProperties": false,
            "properties": {
              "eventType": {
                "const": "birth",
                "type": "string"
              },
              "status": {
                "const": "REGISTERED",
                "type": "string"
              }
            },
            "required": [
              "eventType",
              "status"
            ],
            "type": "object"
          }
        },
        "required": [
          "registration"
        ],
        "type": "object",
        "x-public-schema-id": "https://registry.example/schemas/birth-summary/1.0.0"
      },
      "tracking-id": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "recordId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "recordId"
        ],
        "type": "object",
        "x-public-schema-id": "https://registry.example/schemas/birth-tracking-id/1.0.0"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "opencrvs-consultation-example",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/capabilities": {
      "get": {
        "operationId": "getCallerCapabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "collections": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "collectionId": {
                            "maxLength": 64,
                            "minLength": 1,
                            "type": "string"
                          },
                          "operations": {
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "capability": {
                                  "maxLength": 128,
                                  "minLength": 1,
                                  "pattern": "^[a-z][a-z0-9-]{0,127}$",
                                  "type": "string",
                                  "x-extensible-enum": [
                                    "retrieve",
                                    "lookup",
                                    "list",
                                    "search"
                                  ]
                                },
                                "contract": {
                                  "format": "uri",
                                  "maxLength": 2048,
                                  "minLength": 1,
                                  "pattern": "^https://\\S+$",
                                  "type": "string"
                                },
                                "operationId": {
                                  "maxLength": 128,
                                  "pattern": "^[A-Za-z][A-Za-z0-9]*$",
                                  "type": "string"
                                },
                                "searches": {
                                  "items": {
                                    "maxLength": 128,
                                    "minLength": 1,
                                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$",
                                    "type": "string"
                                  },
                                  "maxItems": 64,
                                  "minItems": 1,
                                  "type": "array",
                                  "uniqueItems": true
                                },
                                "selectors": {
                                  "items": {
                                    "maxLength": 128,
                                    "minLength": 1,
                                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$",
                                    "type": "string"
                                  },
                                  "maxItems": 64,
                                  "minItems": 1,
                                  "type": "array",
                                  "uniqueItems": true
                                },
                                "view": {
                                  "maxLength": 128,
                                  "minLength": 1,
                                  "pattern": "^[a-z][a-z0-9_-]{0,127}$",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "operationId",
                                "contract",
                                "capability",
                                "view"
                              ],
                              "type": "object"
                            },
                            "maxItems": 16,
                            "minItems": 1,
                            "type": "array",
                            "uniqueItems": true
                          },
                          "registry": {
                            "format": "uri",
                            "maxLength": 2048,
                            "minLength": 1,
                            "type": "string"
                          }
                        },
                        "required": [
                          "collectionId",
                          "registry",
                          "operations"
                        ],
                        "type": "object"
                      },
                      "maxItems": 64,
                      "type": "array",
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "collections"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Bounded caller-filtered capability document.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The caller was not authenticated."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The caller is not authorized."
          },
          "406": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The response media type is not acceptable."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request could not be served."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The service is unavailable."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/collections/birth-registrations/lookup": {
      "post": {
        "operationId": "lookupBirthRegistrations",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "selector": {
                    "const": "by-tracking-id"
