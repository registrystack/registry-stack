{
  "components": {
    "schemas": {
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "errors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                "pointer": {
                  "format": "json-pointer",
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "pointer",
                "message"
              ],
              "type": "object"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "traceId": {
            "pattern": "^(?!0{32}$)[\\da-f]{32}$",
            "type": "string"
          },
          "type": {
            "format": "uri",
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^https://govstack\\.global/problems/[a-z][a-z0-9-]{1,30}/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "traceId"
        ],
        "type": "object"
      },
      "UnprocessableContentProblem": {
        "description": "Semantic body validation failure or idempotency fingerprint mismatch.",
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/ValidationProblem"
              },
              {
                "description": "Bind semantic field validation failure to its 422 identity.",
                "properties": {
                  "status": {
                    "const": 422
                  },
                  "type": {
                    "const": "https://govstack.global/problems/digital-registries/invalid-content"
                  }
                },
                "required": [
                  "type",
                  "title",
                  "status",
                  "traceId"
                ],
                "type": "object"
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/Problem"
              },
              {
                "description": "Bind idempotency fingerprint mismatch to its distinct 422 identity.",
                "not": {
                  "required": [
                    "errors"
                  ]
                },
                "properties": {
                  "status": {
                    "const": 422
                  },
                  "type": {
                    "const": "https://govstack.global/problems/digital-registries/idempotency-fingerprint-mismatch"
                  }
                },
                "required": [
                  "type",
                  "title",
                  "status",
                  "traceId"
                ],
                "type": "object"
              }
            ]
          }
        ],
        "required": [
          "type",
          "title",
          "status",
          "traceId"
        ]
      },
      "ValidationProblem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "errors": {
            "items": {
              "additionalProperties": false,
