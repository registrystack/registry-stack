                                  "type": "string"
                                },
                                "family": {
                                  "enum": [
                                    "consultation",
                                    "write"
                                  ],
                                  "type": "string"
                                },
                                "operationId": {
                                  "maxLength": 128,
                                  "pattern": "^[A-Za-z][A-Za-z0-9]*$",
                                  "type": "string"
                                },
                                "searches": {
                                  "items": {
                                    "maxLength": 128,
                                    "minLength": 1,
                                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$",
                                    "type": "string"
                                  },
                                  "maxItems": 64,
                                  "minItems": 1,
                                  "type": "array",
                                  "uniqueItems": true
                                },
                                "selectors": {
                                  "items": {
                                    "maxLength": 128,
                                    "minLength": 1,
                                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$",
                                    "type": "string"
                                  },
                                  "maxItems": 64,
                                  "minItems": 1,
                                  "type": "array",
                                  "uniqueItems": true
                                },
                                "view": {
                                  "maxLength": 128,
                                  "minLength": 1,
