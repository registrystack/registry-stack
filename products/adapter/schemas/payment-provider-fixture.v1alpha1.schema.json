      "properties": {
        "apiVersion": {
          "const": "id.registrystack.org/formats/adapter/payment-provider-fixture/v1alpha1",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "intent": true,
        "kind": {
          "const": "AdapterPaymentProviderFixture",
          "type": "string"
        },
        "settings": true,
