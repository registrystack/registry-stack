{
  "$defs": {
    "Direction": {
      "enum": [
        "p2g-collection",
        "g2p-disbursement"
      ],
      "type": "string"
    },
    "Exchange": {
      "additionalProperties": false,
      "properties": {
        "expected": true,
        "response": {
          "$ref": "#/$defs/ProviderResponse"
        }
      },
      "required": [
        "response",
        "expected"
      ],
      "type": "object"
    },
    "FixtureAcceptance": {
      "additionalProperties": false,
      "properties": {
        "correlationId": {
          "type": "string"
        },
        "references": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/LocalId"
          },
          "type": "object"
        }
      },
      "required": [
        "correlationId",
        "references"
      ],
      "type": "object"
    },
    "LocalId": {
      "description": "A local identifier: a lowercase letter, then up to 63 lowercase letters, digits, `_`, or `-`.",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "MappedExchange": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "$ref": "#/$defs/FixtureAcceptance"
        },
        "expected": true,
        "expectedRequest": true,
        "response": {
          "$ref": "#/$defs/MappedResponse"
        }
      },
      "required": [
        "expectedRequest",
        "response",
        "expected"
      ],
      "type": "object"
    },
    "MappedResponse": {
      "additionalProperties": false,
      "properties": {
        "bodyJson": {
          "maxLength": 65536,
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "format": "uint32",
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        }
      },
      "required": [
        "status",
        "bodyJson"
      ],
      "type": "object"
    },
    "ProviderResponse": {
      "additionalProperties": false,
      "properties": {
        "body": true,
        "httpStatus": {
          "format": "uint32",
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        }
      },
      "required": [
        "httpStatus",
        "body"
      ],
      "type": "object"
    }
  },
