              },
              "detail": {
                "type": "string"
              },
              "status": {
                "const": 429,
                "type": "integer"
              },
              "title": {
                "const": "the source is throttling requests",
                "type": "string"
              }
            },
            "required": [
              "code",
              "status",
              "title"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "code": {
                "const": "source.loop-bound",
