// SPDX-License-Identifier: Apache-2.0

//! The pass-time projection and the plain digest
//! (`products/adapter/CONCEPT.md` section 17.2 and the governed-ingestion
//! concept section 3). The job declares the dotted fields the workflow
//! needs; the pass picks them from each item value at hand-off time, and
//! the item row's digest covers what [`ProjectionDecl::digest_of`]
//! declares: the projected fields by default, or the whole captured
//! item. The digest is plain, with no keyed construction and no secret:
//! the item table holds identity, not confidential material, and a dump
//! of it exposes no answers.

use registry_adapter_core::{ProjectionDecl, ProjectionDigestOf};
use sha2::{Digest as _, Sha256};
use std::collections::BTreeMap;

/// One field the projection could not resolve in the item value. A
/// missing field projects as `null` and never aborts the pass: the
/// destination sees the null and answers for itself.
const MISSING_FIELD: serde_json::Value = serde_json::Value::Null;

/// The projected form of one item value: one object member per declared
/// field, in declaration order, with a missing field carried as `null`.
/// A path walks objects only; a segment that lands on an array, a
/// scalar, or nothing projects as `null`, because the declared paths are
/// dotted identifiers and name no array element.
#[must_use]
pub fn project(declaration: &ProjectionDecl, value: &serde_json::Value) -> serde_json::Value {
    let mut projected = serde_json::Map::new();
    for field in &declaration.fields {
        projected.insert(field.clone(), lookup(value, field));
    }
    serde_json::Value::Object(projected)
}

/// Walk one dotted path through an object value, `null` on every miss.
fn lookup(value: &serde_json::Value, path: &str) -> serde_json::Value {
    let mut current = value;
    for segment in path.split('.') {
        match current.get(segment) {
            Some(next) => current = next,
            None => return MISSING_FIELD,
        }
    }
    current.clone()
}

/// The bytes the item digest covers, per the job's `digestOf`
/// declaration: the canonical serialization of the projected fields by
/// default, or of the whole captured item. Canonical means compact,
/// UTF-8, and every object's members sorted by key, so the same logical
/// value always digests to the same bytes across runs and processes.
#[must_use]
pub fn digest_input(
    declaration: &ProjectionDecl,
    value: &serde_json::Value,
    projected: &serde_json::Value,
) -> Vec<u8> {
    match declaration.digest_of {
        ProjectionDigestOf::Projection => canonical_bytes(projected),
        ProjectionDigestOf::Value => canonical_bytes(value),
    }
}

/// The plain item digest, stored and handed off as `sha256:` followed by
/// 64 lowercase hex digits. No keyed construction and no digest secret:
/// the digest says only whether the bytes the job covers changed.
#[must_use]
pub fn item_digest(declaration: &ProjectionDecl, value: &serde_json::Value) -> String {
    let projected = project(declaration, value);
    let digest = Sha256::digest(digest_input(declaration, value, &projected).as_slice());
    format!("sha256:{}", hex_lower(&digest))
}

/// The canonical serialization of one JSON value: compact, and every
/// object's members sorted by key at every depth. The projection
/// functions build their own members in a fixed order, but an item value
/// digested under `digestOf: value` arrives with the source's own member
/// order, so the canonical form, not the arriving form, defines the
/// digest.
#[must_use]
pub fn canonical_bytes(value: &serde_json::Value) -> Vec<u8> {
    canonicalize(value).to_string().into_bytes()
}

fn canonicalize(value: &serde_json::Value) -> String {
    match value {
        serde_json::Value::Object(members) => {
            let sorted: BTreeMap<&str, &serde_json::Value> = members
                .iter()
                .map(|(key, value)| (key.as_str(), value))
                .collect();
            let members = sorted
                .into_iter()
                .map(|(key, value)| {
                    format!(
                        "{}:{}",
                        serde_json::to_string(key).expect("a string key renders"),
                        canonicalize(value)
                    )
                })
                .collect::<Vec<_>>()
                .join(",");
            format!("{{{members}}}")
        }
        serde_json::Value::Array(items) => {
            let items = items.iter().map(canonicalize).collect::<Vec<_>>().join(",");
            format!("[{items}]")
        }
        other => other.to_string(),
    }
}

fn hex_lower(bytes: &[u8]) -> String {
    bytes.iter().map(|byte| format!("{byte:02x}")).collect()
}

#[cfg(test)]
mod tests {
    use super::*;
    use registry_adapter_core::ProjectionDecl;

    fn declaration(fields: &[&str]) -> ProjectionDecl {
        ProjectionDecl {
            fields: fields.iter().map(|field| (*field).to_string()).collect(),
            digest_of: ProjectionDigestOf::default(),
        }
    }

    #[test]
    fn a_projection_carries_declared_fields_and_null_for_missing_ones() {
        let declaration = declaration(&["id", "answers.age", "answers.name"]);
        let value = serde_json::json!({"id": "a", "answers": {"age": "045"}});
        let projected = project(&declaration, &value);
        assert_eq!(
            projected,
            serde_json::json!({"id": "a", "answers.age": "045", "answers.name": null}),
            "a missing field projects as null, never aborts"
        );
    }

    #[test]
    fn a_path_that_leaves_the_objects_projects_as_null() {
        let declaration = declaration(&["answers.age.years", "answers"]);
        let value = serde_json::json!({"answers": {"age": "045"}});
        let projected = project(&declaration, &value);
        assert_eq!(
            projected,
            serde_json::json!({"answers.age.years": null, "answers": {"age": "045"}}),
            "a segment landing on a scalar projects as null"
        );
    }

    #[test]
    fn the_digest_is_plain_sha256_over_the_canonical_projection() {
        let declaration = declaration(&["id", "answers.age"]);
        let value = serde_json::json!({"answers": {"age": "045"}, "id": "a"});
        let digest = item_digest(&declaration, &value);
        assert!(
            digest.starts_with("sha256:"),
            "the digest carries the sha256 label"
        );
        let hex = digest.trim_start_matches("sha256:");
        assert_eq!(hex.len(), 64, "the digest carries 64 hex digits");
        assert!(
            hex.bytes()
                .all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()),
            "the hex is lowercase"
        );
        // The digest covers the canonical projection, so member order in
        // the source value cannot move it.
        let reordered = serde_json::json!({"id": "a", "answers": {"age": "045"}});
        assert_eq!(item_digest(&declaration, &reordered), digest);
        // A changed projected field changes the digest.
        let changed = serde_json::json!({"id": "a", "answers": {"age": "046"}});
        assert_ne!(item_digest(&declaration, &changed), digest);
    }

    #[test]
    fn a_value_digest_covers_the_whole_item_and_ignores_key_order() {
        let mut decl = declaration(&["id"]);
        decl.digest_of = ProjectionDigestOf::Value;
        let value = serde_json::json!({"id": "a", "nested": {"b": 1, "a": 2}});
        let digest = item_digest(&decl, &value);
        let reordered = serde_json::json!({"nested": {"a": 2, "b": 1}, "id": "a"});
        assert_eq!(
            item_digest(&decl, &reordered),
            digest,
            "the canonical form, not the arriving member order, defines the digest"
        );
        // The projection fields play no part in a value digest: a
        // declaration that names different fields, under the same
        // digestOf, digests the same value identically.
        let mut other_projection = declaration(&["answers.age"]);
        other_projection.digest_of = ProjectionDigestOf::Value;
        assert_eq!(item_digest(&other_projection, &value), digest);
    }

    #[test]
    fn canonical_bytes_are_compact_sorted_json() {
        let value = serde_json::json!({"b": [1, {"y": 2, "x": 3}], "a": "s"});
        let bytes = canonical_bytes(&value);
        assert_eq!(
            String::from_utf8(bytes).as_deref(),
            Ok(r#"{"a":"s","b":[1,{"x":3,"y":2}]}"#)
        );
    }
}
}

/// A re-delivery of the same item sends identical bytes: the retry
/// identity the destination dedups on is stable across deliveries.
#[tokio::test]
async fn a_redelivery_sends_identical_bytes() {
    let receiver = FixtureReceiver::start(vec![
        Scripted::Acknowledge { run_id: None },
        Scripted::Acknowledge { run_id: None },
    ])
    .await;
    let destination = FixtureDestination::new(&receiver.url).expect("a loopback receiver");
    let item = deliverable(json!({"id": "a", "answers.age": "045"}));
    destination.deliver(&job_identity(), &item).await;
    destination.deliver(&job_identity(), &item).await;
    let requests = receiver.requests();
    assert_eq!(requests.len(), 2, "both deliveries arrived");
    assert_eq!(
        requests[0].body, requests[1].body,
        "the same logical hand-off sends the same bytes"
    );
}

/// No credential crosses the seam: the deliverable carries no
/// authentication header and no credential-shaped member, whatever the
/// source sent.
#[tokio::test]
async fn no_credential_crosses_the_seam() {
    let receiver = FixtureReceiver::start(vec![Scripted::Acknowledge { run_id: None }]).await;
    let destination = FixtureDestination::new(&receiver.url).expect("a loopback receiver");
    let projected = json!({"id": "a", "answers.age": "045"});
    destination
        .deliver(&job_identity(), &deliverable(projected))
        .await;
    let delivery = &receiver.requests()[0];
    for (name, value) in &delivery.headers {
        let name = name.to_ascii_lowercase();
        assert!(
            !name.contains("authorization") && !name.contains("cookie") && !name.contains("token"),
            "no credential header crosses the seam: {name}"
        );
        assert!(
            !value.contains("secret:env"),
            "no secret reference crosses the seam: {value}"
        );
    }
    let body: Value = serde_json::from_str(&delivery.body_text()).expect("the body parses");
    let body_text = body.to_string();
    assert!(
        !body_text.contains("credential") && !body_text.contains("password"),
        "no credential member crosses the seam: {body_text}"
    );
}

/// The projection and digest ride the compiled engine path: a page the
/// route produced over the loopback double projects to exactly the
/// declared fields, the digest covers the projection, and the hand-off
/// the fixture destination sends carries that projection and no source
/// payload.
#[tokio::test]
async fn the_projection_rides_the_compiled_engine_path() {
    let fixture = JobFixture::start(
        job_fixture::PAGE_SCRIPT,
        vec![(200, reply_page())],
        job_fixture::Edits::Ordered,
    )
    .await;
    let program =
        compile_job(&fixture.pack, &fixture.job, &fixture.runtime).expect("the job compiles");
    let result = run_job_page(&program, None).await.expect("the page runs");
    assert_eq!(result.page.items.len(), 2, "both reply entries are items");
    let receiver = FixtureReceiver::start(vec![
        Scripted::Acknowledge { run_id: None },
        Scripted::Acknowledge {
            run_id: Some("proposal-1".to_string()),
        },
    ])
    .await;
    let destination = FixtureDestination::new(&receiver.url).expect("a loopback receiver");
    let declaration = &program.job.projection;
    let mut digests = Vec::new();
    for item in &result.page.items {
        let projected = projection::project(declaration, &item.value);
        assert_eq!(
            projected,
            json!({"id": item.value["id"], "answers.age": item.value["answers"]["age"]}),
            "the projection carries exactly the declared fields"
        );
        let projected_text = projected.to_string();
        assert!(
            !projected_text.contains("never-projected"),
            "the projection never carries an undeclared source field"
        );
        let digest = projection::item_digest(declaration, &item.value);
        assert!(digest.starts_with("sha256:"), "the digest is plain sha256");
        let deliverable = DeliverableItem {
            key: item.key.clone(),
            sequence: 1,
            digest: digest.clone(),
            prior_run_id: None,
            admitted_before: false,
            projected,
        };
        let outcome = destination.deliver(&program.job.job, &deliverable).await;
        assert!(matches!(outcome, HandOffOutcome::Acknowledged { .. }));
        digests.push(digest);
    }
    // The digest follows the projection: changing a projected field
    // changes it, changing an undeclared one does not.
    let changed_projected =
