//! The read-only `postgres` source of the governed-ingestion mode
//! (`products/adapter/CONCEPT.md` sections 8.10 and 17.2), the bounded
//! port of camel-sql's parameterized read
//! (camel-4.23.0:components/camel-sql/src/main/java/org/apache/camel/component/sql/SqlConsumer.java,
//! whose parameter binding and bounded consumption this keeps, and
//! whose `onConsume` progress updates are not ported because they write
//! the source; progress tracking is the item table's original work).
//!
//! The endpoint's digest-pinned query file is parsed at compile
//! (`pg_query`), and exactly one top-level plain `SELECT` is served: no
//! data-modifying statement, no data-modifying CTE, no utility
//! command. Its distinct `$n` parameter references are the send's
//! parameter names: a `to: postgres:<id>` send carries
//! `queryParameters` whose name set is exactly the query's, each
//! engine-evaluated to one scalar and bound typed. Execution opens
//! `BEGIN TRANSACTION READ ONLY`, sets `statement_timeout` to the
//! endpoint's declared attempt timeout, fetches at most the profile's
//! rows bound, and builds the item page itself: one item per row, the
//! row's canonical JSON digest as the stable key, and
//! `{"offset": cursor offset + rows}` when the page was full. The read
//! is read-committed per send; the pack's scan declaration records what
//! that means for the source (PostgreSQL isolation documentation,
//! "Read Committed isolation level": each statement sees a snapshot as
//! of its own start, so one send's page is internally consistent while
//! pages of one scan may straddle commits).
//!
//! The engine carries no client: the boundary (E3) links no PostgreSQL
//! client types. This module compiles the statement, owns the
//! transaction preamble and the statement bound, evaluates and types
//! the parameters, shapes the rows into the item contract, and defines
//! the [`PostgresSource`] seam the host implements
//! (`registry-adapter-job`, over its own pool) and the test fixtures
//! impersonate. Cancel safety: the send's future is dropped with the
//! route's deadline, which ends the read; `statement_timeout` bounds
//! the server's work beside it. No `onConsume`, no cursor updates on
//! the source.

use std::time::Duration;

use registry_adapter_core::ErrorClass;
use serde_json::Value;

use crate::engine::route::RouteFailure;

/// The engine-side plan of one postgres source: its parsed query, the
/// namespace its item keys carry, and its declared attempt bound. The
/// client lives behind the [`PostgresSource`] seam the host supplies.
#[derive(Clone)]
pub struct PostgresPlan {
    pub query: PinnedQuery,
    pub namespace: String,
    pub attempt: Duration,
}

impl std::fmt::Debug for PostgresPlan {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        formatter
            .debug_struct("PostgresPlan")
            .finish_non_exhaustive()
    }
}

/// Compile the engine side of one postgres source: parse the pinned
/// query and hold the plan. The credential, the pool, and the
/// connection are the host's, built from the runtime config's
/// `sources.postgres` block beside this same plan.
pub fn compile_plan(
    namespace: String,
    query_text: &str,
    attempt: Duration,
) -> Result<PostgresPlan, String> {
    let query = compile_query(query_text).map_err(|refused| refused.0.to_owned())?;
    Ok(PostgresPlan {
        query,
        namespace,
        attempt,
    })
}

/// One pinned, parsed, and refused-or-admitted query: its text and the
/// parameter names its `$n` references declare, in name order.
#[derive(Debug, Clone)]
pub struct PinnedQuery {
    pub text: String,
    pub parameter_names: Vec<String>,
}

/// Why a query file was refused at compile. The code is the landed
/// `adapter.job.postgres-query-refused`; the message is fixed and
/// value-free.
#[derive(Debug)]
pub struct QueryRefused(pub &'static str);

/// Parse one query text and refuse everything but exactly one top-level
/// plain SELECT: no other statement kind, no data-modifying CTE, no
/// utility command, and a parameter set of `$1` through `$n` with no
/// gap.
pub fn compile_query(text: &str) -> Result<PinnedQuery, QueryRefused> {
    let parsed =
        pg_query::parse(text).map_err(|_| QueryRefused("the query file is not valid SQL"))?;
    let mut parameter_names: Vec<Option<String>> = Vec::new();
    let mut select_roots = 0_usize;
    for (node, _, _, _) in parsed.protobuf.nodes() {
        match node {
            pg_query::NodeRef::SelectStmt(_) => select_roots += 1,
            pg_query::NodeRef::InsertStmt(_)
            | pg_query::NodeRef::UpdateStmt(_)
            | pg_query::NodeRef::DeleteStmt(_)
            | pg_query::NodeRef::MergeStmt(_)
            | pg_query::NodeRef::CopyStmt(_)
            | pg_query::NodeRef::TransactionStmt(_)
            | pg_query::NodeRef::DoStmt(_)
            | pg_query::NodeRef::LockStmt(_)
            | pg_query::NodeRef::NotifyStmt(_)
            | pg_query::NodeRef::ListenStmt(_)
            | pg_query::NodeRef::UnlistenStmt(_)
            | pg_query::NodeRef::CheckPointStmt(_)
            | pg_query::NodeRef::VacuumStmt(_)
            | pg_query::NodeRef::ReindexStmt(_)
            | pg_query::NodeRef::ClusterStmt(_) => {
                return Err(QueryRefused(
                    "the query file carries a statement or command that is not a plain SELECT",
                ));
            }
            pg_query::NodeRef::ParamRef(parameter) => {
                let index = parameter.number as usize;
                if index == 0 {
                    return Err(QueryRefused(
                        "the query carries a zero parameter reference; write $1 and up",
                    ));
                }
                if parameter_names.len() < index {
                    parameter_names.resize(index, None);
                }
                parameter_names[index - 1] = Some(format!("${index}"));
            }
            _ => {}
        }
    }
    if select_roots != 1 {
        return Err(QueryRefused(
            "the query file must carry exactly one SELECT statement",
        ));
    }
    if parameter_names.iter().any(Option::is_none) {
        return Err(QueryRefused(
            "the query's parameter references leave a gap; use $1 through $n with none missing",
        ));
    }
    Ok(PinnedQuery {
        text: text.to_owned(),
        parameter_names: parameter_names.into_iter().flatten().collect(),
    })
}

/// The send's named parameters must be exactly the query's own set:
/// the same names, none missing, none extra.
pub(crate) fn parameters_match(
    query: &PinnedQuery,
    carried: &std::collections::BTreeMap<
        registry_platform_yaml::ExternalId,
        registry_adapter_core::Expression,
    >,
) -> Result<(), RouteFailure> {
    let carried: std::collections::BTreeSet<&str> =
        carried.keys().map(|name| name.as_str()).collect();
    let declared: std::collections::BTreeSet<&str> =
        query.parameter_names.iter().map(String::as_str).collect();
    if carried == declared {
        return Ok(());
    }
    Err(failure(
        ErrorClass::EgressRefused,
        "the send's queryParameters are not exactly the query's own parameter names",
    ))
}

fn failure(class: ErrorClass, message: &'static str) -> RouteFailure {
    RouteFailure {
        class,
        message: Some(message.to_owned()),
        data: None,
        auth: None,
        code: None,
    }
}

/// One scalar the engine hands the host or receives from it: the
/// closed value form both sides of the seam speak, so the client's
/// column types never enter the engine.
#[derive(Debug, Clone, PartialEq)]
pub enum SourceScalar {
    Text(String),
    Integer(i64),
    Float(f64),
    Boolean(bool),
    /// A numeric as its text, so precision never crosses the seam
    /// through a float.
    Numeric(String),
}

/// One row the host read: columns in order, each a name and a scalar.
#[derive(Debug, Clone)]
pub struct SourceRow {
    pub columns: Vec<(String, SourceScalar)>,
}

/// One read the host executes: the engine-compiled statements, the
    length: u64,
}

fn read_file(candidate: &Candidate, bounds: &ReadBounds) -> Result<ReadFile, FileReadFault> {
    let file =
        std::fs::File::open(&candidate.path).map_err(|_| FileReadFault::DirectoryUnreadable)?;
    let mut bytes = Vec::new();
    let reader = std::io::BufReader::new(file);
    reader
        .take(bounds.maximum_file_bytes.saturating_add(1))
        .read_to_end(&mut bytes)
        .map_err(|_| FileReadFault::DirectoryUnreadable)?;
    if bytes.len() as u64 > bounds.maximum_file_bytes {
        return Err(FileReadFault::Oversize);
    }
    let digest = registry_platform_config::sha256_uri(&bytes);
    let length = bytes.len() as u64;
    Ok(ReadFile {
        bytes,
        digest,
        length,
    })
}

/// Camel's `changed` read lock
/// (camel-4.23.0:components/camel-file/src/main/java/org/apache/camel/component/file/strategy/FileChangedExclusiveReadLockStrategy.java):
/// the file's length and last-modified time stand still across two
/// checks spaced the check interval apart, inside the timeout, and a
/// nonempty file locks. Divergence: a lock that never settles raises
/// instead of skipping the file this poll.
async fn changed_lock(
    path: &std::path::Path,
    timeout: Duration,
    check_interval: Duration,
) -> Result<(), FileReadFault> {
    let deadline = tokio::time::Instant::now() + timeout;
    let mut previous: Option<(u64, Option<std::time::SystemTime>)> = None;
    loop {
        let metadata = std::fs::metadata(path).map_err(|_| FileReadFault::DirectoryUnreadable)?;
        let current = (metadata.len(), metadata.modified().ok());
        if current.0 >= 1 && previous == Some(current) {
            return Ok(());
        }
        previous = Some(current);
        let wake = tokio::time::Instant::now() + check_interval;
        if wake >= deadline {
            return Err(FileReadFault::LockTimeout);
        }
        tokio::time::sleep_until(wake).await;
    }
}

/// The Ant-style flat glob match over one file name: `*` spans any run
/// of characters, `?` spans exactly one, and the rest matches itself.
/// Names carry no path separators, so `**` has no recursive meaning
/// here and spans like `*`.
fn match_glob(pattern: &str, name: &str) -> bool {
    let pattern: Vec<char> = pattern.chars().collect();
    let name: Vec<char> = name.chars().collect();
    // Classic backtracking glob: a star remembers its position and
    // extends over the name until the pattern's tail matches.
    let (mut p, mut n) = (0_usize, 0_usize);
    let (mut star, mut mark) = (None::<usize>, 0_usize);
    while n < name.len() {
        if p < pattern.len() && (pattern[p] == '?' || pattern[p] == name[n]) {
            p += 1;
            n += 1;
        } else if p < pattern.len() && pattern[p] == '*' {
            star = Some(p);
            p += 1;
            mark = n;
        } else if let Some(star_at) = star {
            p = star_at + 1;
            mark += 1;
            n = mark;
        } else {
            return false;
        }
    }
    while p < pattern.len() && pattern[p] == '*' {
        p += 1;
    }
    p == pattern.len()
}

#[cfg(test)]
mod tests {
    use super::*;

    /// The flat glob matches Camel's simple Ant patterns over plain
    /// names: stars span, question marks span one, and a mismatched
    /// literal refuses.
    #[test]
    fn the_include_glob_matches_plain_names() {
        assert!(match_glob("*.csv", "people.csv"));
        assert!(!match_glob("*.csv", "people.tsv"));
        assert!(match_glob("export-???.json", "export-042.json"));
        assert!(!match_glob("export-???.json", "export-42.json"));
        assert!(match_glob("a*b*c", "aXbYc"));
        assert!(!match_glob("a*b*c", "aXc"));
        assert!(match_glob("**", "anything"));
        assert!(match_glob("plain.txt", "plain.txt"));
    }

    /// A done-file pattern never admits its own done files as
    /// candidates.
    #[test]
    fn done_file_patterns_recognize_their_own_done_files() {
        let literal = crate::engine::job_sources::DoneFileName::Literal("done".to_owned());
        assert!(literal.is_done_file("done"));
        assert!(!literal.is_done_file("data.csv"));
        let suffix = crate::engine::job_sources::DoneFileName::Placeholder {
            prefix: String::new(),
            suffix: ".done".to_owned(),
        };
        assert!(suffix.is_done_file("data.csv.done"));
        assert!(!suffix.is_done_file("data.csv"));
        assert_eq!(suffix.of("data.csv"), "data.csv.done");
    }
}
// SPDX-License-Identifier: Apache-2.0

//! The served write's custody: the concrete [`WriteExecutionContext`]
//! behind the engine's `WriteCustody` seam
//! (`products/adapter/CONCEPT.md` section 9, and the E3 ruling in
//! `products/adapter/scratch/core/engine-boundary-plan.md`). The
//! journal transaction, the idempotency store, and every terminal
//! resolution stay facade-side; the engine names this module never, and
//! the facade installs the concrete arc on each served write's exchange
//! and consults it for the terminal response.

use std::fmt;
use std::future::Future;
use std::pin::Pin;
use std::sync::Arc;
use std::time::SystemTime;

use deadpool_postgres::GenericClient;
use registry_adapter_core::ErrorClass;
use tokio::sync::Mutex;

use crate::engine::exchange::{WriteClaim, WriteCustody};
use crate::engine::route::RouteFailure;
use crate::idempotent::{
    Claim, ClaimRequest, Execution, IdempotencyError, PostgresIdempotencyStore, StoredResponse,
    TerminalOutcome, VerifiedCallerIdentity,
};

/// The facade-visible result of running the idempotency processor.
#[derive(Clone, Debug, Eq, PartialEq)]
pub enum WriteResolution {
    Pending,
    Replay {
        outcome: TerminalOutcome,
        response: StoredResponse,
    },
    Conflict,
    Mismatch,
    ResponseExpired,
    UnsupportedIncomplete,
    Released,
    Finished,
}

enum WriteState {
    Ready,
    Executing {
        execution: Option<Execution>,
        effect_marked: bool,
    },
    Replay {
        outcome: TerminalOutcome,
        response: StoredResponse,
    },
    Conflict,
    Mismatch,
    ResponseExpired,
    UnsupportedIncomplete {
        execution: Option<Execution>,
    },
    Released,
    Finished,
}

/// A process-private idempotency capability shared across exchange clones.
/// Its Debug implementation deliberately reports no caller, operation, key,
/// request digest, response, or database detail.
pub struct WriteExecutionContext {
    store: PostgresIdempotencyStore,
    caller: VerifiedCallerIdentity,
    deployment: String,
    concrete_operation: String,
    request_digest: [u8; 32],
    state: Mutex<WriteState>,
}

impl fmt::Debug for WriteExecutionContext {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        formatter
            .debug_struct("WriteExecutionContext")
            .finish_non_exhaustive()
    }
}

impl WriteExecutionContext {
    /// Construct the served write's concrete custody over its store and
    /// verified caller. The facade keeps this concrete arc beside itself
    /// for the terminal resolution, and installs a clone on the served
    /// write's exchange behind the engine's seam.
    #[allow(clippy::too_many_arguments)]
    pub fn new(
        store: PostgresIdempotencyStore,
        caller: VerifiedCallerIdentity,
        deployment: String,
        concrete_operation: String,
        request_digest: [u8; 32],
    ) -> Arc<Self> {
        Arc::new(Self {
            store,
            caller,
            deployment,
            concrete_operation,
            request_digest,
            state: Mutex::new(WriteState::Ready),
        })
    }

    /// The terminal resolution of the served write, read by the facade
    /// when the route answers.
    pub async fn resolution(&self) -> WriteResolution {
        match &*self.state.lock().await {
            WriteState::Ready | WriteState::Executing { .. } => WriteResolution::Pending,
            WriteState::Replay { outcome, response } => WriteResolution::Replay {
                outcome: *outcome,
                response: response.clone(),
            },
            WriteState::Conflict => WriteResolution::Conflict,
            WriteState::Mismatch => WriteResolution::Mismatch,
            WriteState::ResponseExpired => WriteResolution::ResponseExpired,
            WriteState::UnsupportedIncomplete { .. } => WriteResolution::UnsupportedIncomplete,
            WriteState::Released => WriteResolution::Released,
            WriteState::Finished => WriteResolution::Finished,
        }
    }

    /// Persist the terminal response on the facade's journal transaction so
    /// terminal audit and response custody have one commit boundary.
    pub async fn finish_with_client(
        &self,
        client: &impl GenericClient,
        outcome: TerminalOutcome,
        response: StoredResponse,
    ) -> Result<(), IdempotencyError> {
        let mut state = self.state.lock().await;
        let execution = match &mut *state {
            WriteState::Executing { execution, .. }
            | WriteState::UnsupportedIncomplete { execution } => execution,
            _ => return Err(IdempotencyError::StateConflict),
        };
        let execution = execution.take().ok_or(IdempotencyError::StateConflict)?;
        self.store
            .finish_with_client(client, execution, outcome, response, SystemTime::now())
            .await?;
        *state = WriteState::Finished;
        Ok(())
    }
}

fn idempotency_failure(error: IdempotencyError) -> RouteFailure {
    tracing::error!(%error, "the idempotency store refused a write transition");
    RouteFailure::of(ErrorClass::Facade)
}

/// The concrete capability: the same transitions the exchange's seam
/// exposes, over the idempotency store's own state machine.
impl WriteCustody for WriteExecutionContext {
    fn claim<'a>(
        &'a self,
        key: &'a str,
    ) -> Pin<Box<dyn Future<Output = Result<WriteClaim, RouteFailure>> + Send + 'a>> {
        Box::pin(async move {
            let mut state = self.state.lock().await;
            if !matches!(*state, WriteState::Ready) {
                return Err(RouteFailure::of(ErrorClass::Facade));
            }
            let claimed = self
                .store
                .claim(
                    ClaimRequest {
                        caller: &self.caller,
                        deployment: &self.deployment,
                        concrete_operation: &self.concrete_operation,
                        key,
                        request_digest: self.request_digest,
                    },
                    SystemTime::now(),
                )
                .await
                .map_err(idempotency_failure)?;
            match claimed {
                Claim::Execute(execution) => {
                    *state = WriteState::Executing {
                        execution: Some(execution),
                        effect_marked: false,
                    };
                    Ok(WriteClaim::Execute)
                }
                Claim::Replay { outcome, response } => {
                    *state = WriteState::Replay { outcome, response };
                    Ok(WriteClaim::Stop)
                }
                Claim::InFlight | Claim::EffectUnknown => {
                    *state = WriteState::Conflict;
                    Ok(WriteClaim::Stop)
                }
                Claim::Mismatch => {
                    *state = WriteState::Mismatch;
                    Ok(WriteClaim::Stop)
                }
                Claim::ResponseExpired { .. } => {
                    *state = WriteState::ResponseExpired;
                    Ok(WriteClaim::Stop)
                }
            }
        })
    }

    fn before_effect<'a>(
        &'a self,
    ) -> Pin<Box<dyn Future<Output = Result<(), RouteFailure>> + Send + 'a>> {
#!/usr/bin/env bash
set -euo pipefail

: "${CARGO_TARGET_DIR:?Set CARGO_TARGET_DIR to an external worktree Cargo target.}"

repo_root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
cd "$repo_root"

# The verification floor from products/adapter/DELIVERY-PLAN.md: format
# over the workspace, then clippy and tests over the adapter crates. Cargo
# runs in the caller's explicit worktree target, so an omitted target cannot
# fill the source volume before the example generator rejects it. PATH keeps
# cargo reachable when it is not on the caller's PATH.
PATH="$HOME/.cargo/bin:$PATH" cargo fmt --check
PATH="$HOME/.cargo/bin:$PATH" cargo clippy -p registry-adapter -p registry-adapter-core -p registry-adapterctl --all-targets -- -D warnings
PATH="$HOME/.cargo/bin:$PATH" cargo test -p registry-adapter -p registry-adapter-core -p registry-adapterctl --locked
# The governed-ingestion job sources (CONCEPT 17): each default-off
# feature gate holds its own clippy and test lane, so a gate can never
# rot behind the default build.
PATH="$HOME/.cargo/bin:$PATH" cargo clippy -p registry-adapter --features job-file --all-targets -- -D warnings
PATH="$HOME/.cargo/bin:$PATH" cargo test -p registry-adapter --features job-file --locked
PATH="$HOME/.cargo/bin:$PATH" cargo clippy -p registry-adapter --features job-postgres --all-targets -- -D warnings
PATH="$HOME/.cargo/bin:$PATH" cargo test -p registry-adapter --features job-postgres --locked
PATH="$HOME/.cargo/bin:$PATH" cargo clippy -p registry-adapter --features job-file,job-postgres --all-targets -- -D warnings
PATH="$HOME/.cargo/bin:$PATH" cargo test -p registry-adapter --features job-file,job-postgres --locked

# The generated schemas are held to their generator (CFG-SCHEMA-2), and the
# five adapter formats are held to the configuration-format convention
# (CFG-SCHEMA-1) with the platform lint that CI also runs.
PATH="$HOME/.cargo/bin:$PATH" cargo run --locked -p registry-adapterctl -- schemas --check --output-dir products/adapter/schemas
products/adapter/scripts/generate-effective-contract-example.sh --check
uv run --no-project --with PyYAML==6.0.2 python products/platform/scripts/check-config-conventions.py

# The Camel port table (CONCEPT.md 8.10) is held to the code: every
# delivered row maps to named core tests and every accepted key has a row;
# later-increment rows report pending and never fail.
python3 products/adapter/scripts/check-port-table.py

# The example and corpus checks run the real adapterctl binary. It comes
# from, most explicit first:
#   1. the --bin-dir option,
#   2. the ADAPTERCTL_BIN environment variable, run exactly as named,
#   3. a build under the exported CARGO_TARGET_DIR,
# and the script refuses otherwise. A repo-local target/ directory is
# never used: a stale binary there once checked green against the wrong
# reader, which passed the corpus silently.
bin_dir=''
adapterctl_bin=''
previous=''
for argument in "$@"; do
  case "$argument" in
  --bin-dir=*) bin_dir="${argument#--bin-dir=}" ;;
  *)
    if [[ "$previous" == '--bin-dir' ]]; then
      bin_dir="$argument"
    fi
    ;;
  esac
  previous="$argument"
done

if [[ -n "$bin_dir" ]]; then
  adapterctl_bin="${bin_dir}/adapterctl"
elif [[ -n "${ADAPTERCTL_BIN:-}" ]]; then
  if [[ ! -x "${ADAPTERCTL_BIN}" ]]; then
    printf 'check-contracts: ADAPTERCTL_BIN names no executable: %s\n' "${ADAPTERCTL_BIN}" >&2
    printf 'Set ADAPTERCTL_BIN to the adapterctl binary, pass --bin-dir, or export CARGO_TARGET_DIR.\n' >&2
    exit 2
  fi
  # Run exactly the named binary: reducing it to its directory would
  # silently run a different adapterctl from the same directory. The
  # directory is kept only for the aws-lc-fips artifact lookup below.
  adapterctl_bin="${ADAPTERCTL_BIN}"
  bin_dir="$(cd "$(dirname "${ADAPTERCTL_BIN}")" && pwd -P)"
elif [[ -n "${CARGO_TARGET_DIR:-}" ]]; then
  command -v cargo >/dev/null 2>&1 || {
    printf 'check-contracts: CARGO_TARGET_DIR is set but cargo is not on PATH.\n' >&2
    exit 2
  }
  cargo build --locked -p registry-adapterctl --manifest-path "${repo_root}/Cargo.toml" --target-dir "${CARGO_TARGET_DIR}"
  bin_dir="${CARGO_TARGET_DIR}/debug"
  adapterctl_bin="${bin_dir}/adapterctl"
else
  printf 'check-contracts: no adapterctl binary found.\n' >&2
  printf 'Set ADAPTERCTL_BIN to the adapterctl binary, pass --bin-dir, or export CARGO_TARGET_DIR; the repository target/ directory is never used.\n' >&2
  exit 2
fi

if [[ ! -x "${adapterctl_bin}" ]]; then
  printf 'check-contracts: no adapterctl binary at %s.\n' "${adapterctl_bin}" >&2
  printf 'Set ADAPTERCTL_BIN to the adapterctl binary, pass --bin-dir, or export CARGO_TARGET_DIR.\n' >&2
  exit 2
fi

# A debug build that links aws-lc-fips-sys dynamically on macOS needs its
# library at each adapterctl launch. Keep the directory in the same
# non-DYLD carrier the conformance wrapper uses, and put it on the DYLD
# search for the direct child executions below.
if [[ -z "${REGISTRY_CARGO_RUNTIME_LIBRARY_PATH:-}" ]]; then
  for artifacts in "${bin_dir}"/build/aws-lc-fips-sys-*/out/build/artifacts; do
    if [[ -d "$artifacts" ]]; then
      REGISTRY_CARGO_RUNTIME_LIBRARY_PATH="$(cd "$artifacts" && pwd -P)"
      export REGISTRY_CARGO_RUNTIME_LIBRARY_PATH
      break
    fi
