// SPDX-License-Identifier: Apache-2.0

//! The `adapter-job` binary entry point: the operator surface of the
//! governed-ingestion job (`products/adapter/CONCEPT.md` section 17.4).
//! Check compiles a job the engine compiles, pass runs one bounded pass
//! or the trigger loop, status counts what the item table holds, inspect
//! reads one item's row, and rescan marks a rescan due and runs it. The
//! output is value-free by default: no item value, no projection, no
//! secret. The store holds no payload to leak.

use clap::Parser;
use deadpool_postgres::Pool;
use registry_adapter::engine::job::{compile_job, JobError, JobProgram};
use registry_adapter_core::AdapterJob;
use registry_adapter_job::cli::{Cli, Command};
use registry_adapter_job::destination::{FixtureDestination, NullDestination};
use registry_adapter_job::pass::{run_pass, PassOptions, PassReport, StopReason};
use registry_adapter_job::store;
use registry_adapter_job::trigger::{self, Edits, JobState};
use registry_platform_config::{SecretProvider, SecretResolver};
use std::path::Path;
use std::process::ExitCode;
use std::time::Duration;

fn main() -> ExitCode {
    let cli = Cli::parse();
    let runtime = match tokio::runtime::Builder::new_multi_thread()
        .enable_all()
        .build()
    {
        Ok(runtime) => runtime,
        Err(error) => {
            eprintln!("adapter-job: the async runtime could not start: {error}");
            return ExitCode::FAILURE;
        }
    };
    let outcome = match &cli.command {
        Command::Check {
            job_yaml,
            pack,
            runtime: runtime_path,
        } => check(job_yaml, pack, runtime_path),
        Command::Status {
            job_yaml,
            runtime: runtime_path,
        } => runtime.block_on(status(job_yaml, runtime_path)),
        Command::Inspect {
            job_yaml,
            runtime: runtime_path,
            key,
        } => runtime.block_on(inspect(job_yaml, runtime_path, key)),
        Command::Pass {
            job_yaml,
            pack,
            runtime: runtime_path,
            fixture,
            fixture_url,
            dry_run,
            r#loop,
            refusal_limit,
        } => runtime.block_on(pass(
            job_yaml,
            pack,
            runtime_path,
            *fixture,
            fixture_url.as_deref(),
            *dry_run,
            !*r#loop,
            *refusal_limit,
            cli.show_values,
        )),
        Command::Rescan {
            job_yaml,
            pack,
            runtime: runtime_path,
            fixture,
            fixture_url,
            dry_run,
            refusal_limit,
        } => runtime.block_on(rescan(
            job_yaml,
            pack,
            runtime_path,
            *fixture,
            fixture_url.as_deref(),
            *dry_run,
            *refusal_limit,
            cli.show_values,
        )),
    };
    match outcome {
        Ok(code) => code,
        Err(message) => {
            eprintln!("adapter-job: {message}");
            ExitCode::FAILURE
        }
    }
}

/// Compile the job the way the engine compiles it and print the
/// value-free report.
fn check(job_yaml: &Path, pack: &Path, runtime: &Path) -> Result<ExitCode, String> {
    let program = compile(pack, job_yaml, runtime)?;
    let report = serde_json::json!({
        "ok": true,
        "job": {
            "id": program.job.job.id.as_str(),
            "version": program.job.job.version,
        },
        "source": {
            "pack": {
                "id": program.job.source.pack.id.as_str(),
                "version": program.job.source.pack.version,
            },
            "route": program.job.source.route,
        },
        "projectionDigest": program.job.projection_digest(),
    });
    println!(
        "{}",
        serde_json::to_string_pretty(&report).expect("a plain object renders")
    );
    Ok(ExitCode::SUCCESS)
}

/// One bounded pass or the trigger loop.
#[allow(clippy::too_many_arguments)]
async fn pass(
    job_yaml: &Path,
    pack: &Path,
    runtime_path: &Path,
    fixture: bool,
    fixture_url: Option<&str>,
    dry_run: bool,
    once: bool,
    refusal_limit: u32,
    show_values: bool,
) -> Result<ExitCode, String> {
    let program = compile(pack, job_yaml, runtime_path)?;
    let pool = open_pool(runtime_path).await?;
    let preview = NullDestination::new();
    if once {
        let options = PassOptions {
            refusal_limit,
            ..PassOptions::default()
        };
        let report = bounded_pass(
            &program,
            &pool,
            &preview,
            options,
            fixture,
            fixture_url,
            dry_run,
        )
        .await?;
        print_pass_report(&report, dry_run, show_values, &preview);
        return Ok(pass_exit_code(&report));
    }
    // The loop: the interval trigger decides when a pass starts, a
    // rescan source's declared delay decides when a scan runs from the
    // first page, and greedy restarts after a pass that read at least
    // one item.
    let edits = source_edits(&program)?;
    let interval = trigger::interval_trigger(&program.job)
        .cloned()
        .ok_or_else(|| {
            "the job declares no interval trigger, so the loop has no schedule; declare one interval trigger".to_string()
        })?;
    let mut hot = false;
    loop {
        let now = std::time::SystemTime::now();
        let state = job_state(&pool, &program.job).await?;
        let was_hot = hot;
        hot = false;
        let rescan = !was_hot && trigger::rescan_due(&edits, &state, now);
        if !was_hot && !rescan {
            if let Some(wait) = trigger::next_due(&program.job, &state, now) {
                if wait > Duration::ZERO {
                    tokio::select! {
                        _ = tokio::time::sleep(wait) => {}
                        _ = tokio::signal::ctrl_c() => return Ok(ExitCode::SUCCESS),
                    }
                    continue;
                }
            }
        }
        let options = PassOptions {
            refusal_limit,
            rescan,
            dry_run: false,
        };
        let report = bounded_pass(
            &program,
            &pool,
            &preview,
            options,
            fixture,
            fixture_url,
            false,
        )
        .await?;
        print_pass_report(&report, false, show_values, &preview);
        // A greedy trigger starts again immediately after a pass that
        // read at least one item; the Camel port's own skip warning is
        // why the job author has to declare it.
        hot = interval.greedy && report.items_read > 0 && !rescan;
    }
}

/// Mark a rescan due now, then run one rescan pass from the first page.
#[allow(clippy::too_many_arguments)]
async fn rescan(
    job_yaml: &Path,
    pack: &Path,
    runtime_path: &Path,
    fixture: bool,
    fixture_url: Option<&str>,
    dry_run: bool,
    refusal_limit: u32,
    show_values: bool,
) -> Result<ExitCode, String> {
    let program = compile(pack, job_yaml, runtime_path)?;
    let edits = source_edits(&program)?;
    if !matches!(edits, Edits::Rescan { .. }) {
        return Err(
            "the job's source route declares edits: ordered, whose edits the position finds; only an edits: rescan source rescans".to_string(),
        );
    }
    let pool = open_pool(runtime_path).await?;
    let preview = NullDestination::new();
    if !dry_run {
        let client = pool
            .get()
            .await
            .map_err(|error| format!("the job store could not be reached: {error}"))?;
        store::ensure_state(&client, program.job.job.id.as_str())
            .await
            .map_err(|error| format!("the job store refused: {error}"))?;
        store::mark_rescan_due(&client, program.job.job.id.as_str())
            .await
            .map_err(|error| format!("the job store refused: {error}"))?;
    }
    let options = PassOptions {
        refusal_limit,
        rescan: true,
        dry_run,
    };
    let report = bounded_pass(
        &program,
        &pool,
        &preview,
        options,
        fixture,
        fixture_url,
        dry_run,
    )
    .await?;
    print_pass_report(&report, dry_run, show_values, &preview);
    Ok(pass_exit_code(&report))
}

/// One bounded pass with the named destination: the fixture destination
/// at its loopback URL, or the preview destination of the dry run. A
/// real destination is its own brief; the seam is the hand-off point it
/// plugs into.
async fn bounded_pass(
    program: &JobProgram,
    pool: &Pool,
    preview: &NullDestination,
    options: PassOptions,
    fixture: bool,
    fixture_url: Option<&str>,
    dry_run: bool,
) -> Result<PassReport, String> {
    if !dry_run && !fixture {
        return Err(
            "name a destination: --destination with --fixture-url, or --dry-run for the operator preview; a real destination plugs into the same seam".to_string(),
        );
    }
    if fixture {
        let url =
            fixture_url.ok_or_else(|| "--fixture-url names the fixture receiver".to_string())?;
        let destination = FixtureDestination::new(url)
            .map_err(|reason| format!("the fixture url was refused: {reason}"))?;
        Ok(run_pass(pool, program, &destination, options).await)
    } else {
        Ok(run_pass(pool, program, preview, options).await)
    }
}

/// Print one pass report, value-free unless the caller asked for the
/// dry-run's recorded projections.
fn print_pass_report(
    report: &PassReport,
    dry_run: bool,
    show_values: bool,
    preview: &NullDestination,
) {
    let stopped = report.stopped.as_ref().map(|reason| {
        serde_json::json!({
            "reason": stop_reason_name(reason),
            "code": reason.stop_text(),
        })
    });
    let mut body = serde_json::json!({
        "itemsRead": report.items_read,
        "itemsNew": report.items_new,
        "itemsChanged": report.items_changed,
        "itemsRedelivered": report.items_redelivered,
        "itemsSkipped": report.items_skipped,
        "itemsAcknowledged": report.items_acknowledged,
        "itemsRefused": report.items_refused,
        "refusalsByCode": report.refusals_by_code,
        "malformedLines": report.malformed_lines,
        "stopped": stopped,
        "overdue": report.overdue,
    });
    if dry_run {
        let delivered = preview
            .recorded()
            .into_iter()
            .map(|(job_id, item)| {
                let mut entry = serde_json::json!({
                    "jobId": job_id,
                    "key": item.key,
                    "sequence": item.sequence,
                    "digest": item.digest,
                    "priorRunId": item.prior_run_id,
                    "admittedBefore": item.admitted_before,
                });
                if show_values {
                    entry
                        .as_object_mut()
                        .expect("an object")
                        .insert("projected".to_string(), item.projected);
                }
                entry
            })
            .collect::<Vec<_>>();
        let members = body.as_object_mut().expect("an object");
        members.insert("dryRun".to_string(), serde_json::json!(true));
        members.insert("wouldDeliver".to_string(), serde_json::json!(delivered));
    }
    println!(
        "{}",
        serde_json::to_string_pretty(&body).expect("a plain object renders")
    );
}

fn stop_reason_name(reason: &StopReason) -> &'static str {
    match reason {
        StopReason::LeaseHeld => "lease-held",
        StopReason::PageFault { .. } => "page-fault",
        StopReason::DestinationStop { .. } => "destination-stop",
        StopReason::RefusalLimit { .. } => "refusal-limit",
    }
}

/// A pass leaves the operator's exit code at failure: a stopped pass is
/// a condition an operator or a CronJob acts on.
fn pass_exit_code(report: &PassReport) -> ExitCode {
    if report.stopped.is_some() {
        ExitCode::FAILURE
    } else {
        ExitCode::SUCCESS
    }
}

/// Count what the item table holds, value-free.
async fn status(job_yaml: &Path, runtime_path: &Path) -> Result<ExitCode, String> {
    let job = read_job(job_yaml)?;
    let pool = read_pool(runtime_path)?;
    let client = pool
        .get()
        .await
        .map_err(|error| format!("the job store could not be reached: {error}"))?;
    let job_id = job.job.id.as_str();
    store::ensure_state(&client, job_id)
        .await
        .map_err(|error| format!("the job store refused: {error}"))?;
    let counts = store::item_counts(&client, job_id)
        .await
        .map_err(|error| format!("the job store refused: {error}"))?;
    let row = store::read_state(&client, job_id)
        .await
        .map_err(|error| format!("the job store refused: {error}"))?
        .unwrap_or_default();
    let state = trigger_state(&row);
    let overdue = trigger::next_due(&job, &state, std::time::SystemTime::now())
        .is_some_and(|due| due == Duration::ZERO);
    let report = serde_json::json!({
        "job": {"id": job.job.id.as_str(), "version": job.job.version},
        "items": {
            "pending": counts.pending,
            "acknowledged": counts.acknowledged,
            "refused": counts.refused,
        },
        "refusalsByCode": counts.refusals_by_code,
        "schedule": {
            "overdue": overdue,
            "lastPassAt": optional_time(row.last_pass_at),
            "lastPassStop": row.last_pass_stop,
            "leaseExpires": optional_time(row.lease_expires),
            "positionPresent": row.position.is_some(),
            "lastRescanAt": optional_time(row.last_rescan_at),
            "idleStreak": row.idle_streak,
            "errorStreak": row.error_streak,
            "projectionDigest": row.projection_digest,
        },
    });
    println!(
        "{}",
        serde_json::to_string_pretty(&report).expect("a plain object renders")
    );
    Ok(ExitCode::SUCCESS)
}

/// Read one item's row, value-free.
async fn inspect(job_yaml: &Path, runtime_path: &Path, key: &str) -> Result<ExitCode, String> {
    let job = read_job(job_yaml)?;
    let pool = read_pool(runtime_path)?;
    let client = pool
        .get()
        .await
        .map_err(|error| format!("the job store could not be reached: {error}"))?;
    let record = store::inspect_item(&client, job.job.id.as_str(), key)
        .await
        .map_err(|error| format!("the job store refused: {error}"))?;
    let report = match record {
        Some(record) => serde_json::json!({
            "found": true,
            "item": {
                "key": record.key,
                "lastDigest": record.last_digest,
                "sequence": record.sequence,
                "status": record.status.as_str(),
                "code": record.code,
                "runId": record.run_id,
                "priorRunId": record.prior_run_id,
                "admittedBefore": record.admitted_before,
                "firstSeen": optional_time(Some(record.first_seen)),
                "lastSeen": optional_time(Some(record.last_seen)),
            },
        }),
        None => serde_json::json!({"found": false, "key": key}),
    };
    println!(
        "{}",
        serde_json::to_string_pretty(&report).expect("a plain object renders")
    );
    Ok(ExitCode::SUCCESS)
}

/// Compile the job the engine compiles.
fn compile(pack: &Path, job_yaml: &Path, runtime: &Path) -> Result<JobProgram, String> {
    compile_job(pack, job_yaml, runtime).map_err(|error| job_error_message(&error))
}

/// The value-free rendering of a compile refusal: every diagnostic the
/// compiler carried, code first.
fn job_error_message(error: &JobError) -> String {
    let rendered = error
        .diagnostics
        .iter()
        .map(|diagnostic| {
            format!(
                "{} at {} {}",
                diagnostic.code, diagnostic.path, diagnostic.message
            )
        })
        .collect::<Vec<_>>()
        .join("; ");
    format!("the job was refused: {rendered}")
}

/// The job's source route edit property, from the compiled program's
/// resolved declaration: the declaration the rescan gate runs on, read
/// at compile so the host never re-reads the pack file.
fn source_edits(program: &JobProgram) -> Result<Edits, String> {
    Edits::of(&program.source_route)
}

/// The job state the schedule reads, from the store row.
async fn job_state(pool: &Pool, job: &AdapterJob) -> Result<JobState, String> {
    let client = pool
        .get()
        .await
        .map_err(|error| format!("the job store could not be reached: {error}"))?;
    let row = store::read_state(&client, job.job.id.as_str())
        .await
        .map_err(|error| format!("the job store refused: {error}"))?
        .unwrap_or_default();
    Ok(trigger_state(&row))
}

fn trigger_state(row: &store::JobStateRow) -> JobState {
    JobState {
        position: row.position.clone(),
        projection_digest: row.projection_digest.clone(),
        lease_expires: row.lease_expires,
        last_pass_at: row.last_pass_at,
        last_pass_stop: row.last_pass_stop.clone(),
        last_rescan_at: row.last_rescan_at,
        idle_streak: u32::try_from(row.idle_streak.max(0)).unwrap_or(u32::MAX),
        error_streak: u32::try_from(row.error_streak.max(0)).unwrap_or(u32::MAX),
    }
}

/// Open the job store: one pool from the store block's connection
/// reference, migrated before it serves.
async fn open_pool(runtime_path: &Path) -> Result<Pool, String> {
    let store_config = read_store(runtime_path)?;
    let resolver = secret_resolver()?;
    let pool = store::build_pool(&store_config, &resolver).map_err(|error| error.to_string())?;
    let client = pool
        .get()
        .await
        .map_err(|error| format!("the job store migration could not connect: {error}"))?;
    store::migrate(&client)
        .await
        .map_err(|error| format!("the job store migration failed: {error}"))?;
    Ok(pool)
}

/// The read-only pool of the status and inspect surfaces, from the
/// runtime config's store block.
fn read_pool(runtime_path: &Path) -> Result<Pool, String> {
    let store_config = read_store(runtime_path)?;
    let resolver = secret_resolver()?;
    store::build_pool(&store_config, &resolver).map_err(|error| error.to_string())
}

fn secret_resolver() -> Result<SecretResolver, String> {
    SecretResolver::new([SecretProvider::Environment], "")
        .map_err(|error| format!("the secret resolver could not start: {error:?}"))
}

/// Read the job definition: the engine boundary's public artifact
/// read, the same envelope, expression, and unknown-key discipline the
/// compile path reads the job through.
fn read_job(path: &Path) -> Result<AdapterJob, String> {
    registry_adapter::engine::load::read_artifact::<AdapterJob>(
        path,
        registry_adapter_core::ADAPTER_JOB_KIND,
        registry_adapter_core::ADAPTER_JOB_API_VERSION,
    )
    .map(|(job, _bytes)| job)
    .map_err(|error| format!("the job definition was refused: {error}"))
}

/// Read the job store block of the operator runtime config: the one
/// reader the compile path shares (`engine::job_sources`), then the
/// host's own strict decode of the `store` member alone. The endpoint
/// bindings and the job sources block refuse in that reader; the store
/// block refuses here.
fn read_store(path: &Path) -> Result<store::JobStoreConfig, String> {
    let document = registry_adapter::engine::job_sources::JobRuntimeConfig::load(path)
        .map_err(|error| format!("the runtime config was refused: {error}"))?;
    let store = document
        .store
        .ok_or_else(|| "the runtime config carries no store block for the job store".to_string())?;
    serde_json::from_value::<store::JobStoreConfig>(store)
        .map_err(|error| format!("the store block was refused: {error}"))
}

/// One timestamp in the operator output: UTC, RFC 3339, or absent.
fn optional_time(at: Option<std::time::SystemTime>) -> Option<String> {
    at.map(|at| {
        let seconds = at
            .duration_since(std::time::UNIX_EPOCH)
            .map(|since| since.as_secs() as i64)
            .unwrap_or(0);
        chrono::DateTime::from_timestamp(seconds, 0)
            .unwrap_or(chrono::DateTime::UNIX_EPOCH)
            .to_rfc3339_opts(chrono::SecondsFormat::Secs, true)
    })
}
// SPDX-License-Identifier: Apache-2.0

//! The governed-ingestion job compiler and page entry
//! (`products/adapter/CONCEPT.md` sections 17.1 and 17.2).
//!
//! A job pairs one pack source route with an explicit, bounded profile.
//! [`compile_job`] loads the pack, the `AdapterJob` definition, the
//! operator runtime config, and the profile and project the pack's
//! directory carries, runs the authoring checks the runtime stands on,
//! and compiles the source route into a [`JobProgram`] with no listener,
//! no database, no OIDC issuer, and no served facade operation. The
//! route interpreter is not rewritten: [`run_job_page`] runs the source
//! route through the ordinary engine with the profile's page deadline
//! and validates the final body against the item contract before it is
//! returned.
//!
//! The exchange starts with a null body and the page cursor under the
//! read-only [`ADAPTER_JOB_CURSOR_PROPERTY`] property. The name sits
//! under the engine's reserved `Adapter` prefix, so the same closed rule
//! that guards the facade's engine properties refuses every
//! `setProperty` and `removeProperty` naming it; a route carries its
//! resumption cursor out through its own body, and the entry validates
//! the page like every other page member.

use std::collections::BTreeMap;
use std::fmt;
use std::path::{Path, PathBuf};
use std::sync::Arc;
use std::time::Duration;

use registry_adapter_core::{
    check_endpoint_bindings, check_job, check_project_pins, check_workspace, AdapterJob,
    AdapterPack, AdapterProfile, AdapterProject, ComponentKind, Step, Workspace,
    ADAPTER_JOB_API_VERSION, ADAPTER_JOB_KIND, ADAPTER_PACK_API_VERSION, ADAPTER_PACK_KIND,
    ADAPTER_PROFILE_API_VERSION, ADAPTER_PROFILE_KIND, ADAPTER_PROJECT_API_VERSION,
    ADAPTER_PROJECT_KIND, ADAPTER_RUNTIME_KIND,
};
use registry_platform_config::{sha256_uri, SecretProvider, SecretResolver};
use registry_platform_yaml::{Diagnostic, Severity};
use serde_json::Value;

use crate::engine::exchange::Exchange;
use crate::engine::load::{
    artifact_path, compile_authored_with, format_spec, preflight_endpoint_credential, read,
    step_aggregation_strategies, step_expressions, EndpointCompilation, LoadError,
};
use crate::engine::resilience::ResilienceRuntime;
use crate::engine::route::{
    check_job_servable, is_served_auth, run_job_route, EndpointRuntime, RouteContext, RouteTable,
};
use crate::engine::scripts::{CodeMaps, ScriptSet};

/// The exchange property carrying the page cursor into the source route.
/// The name sits under the engine's reserved `Adapter` prefix, so the
/// authoring checks refuse every `setProperty` and `removeProperty`
/// naming it and the value stays read-only for scripts and expressions.
pub const ADAPTER_JOB_CURSOR_PROPERTY: &str = "AdapterJobCursor";

/// The job page exchange's identifier. It is engine-owned and bounded:
/// it names nothing from the job, the pack, or the page.
const JOB_PAGE_EXCHANGE_ID: &str = "job-page";

/// The journal event a read raises when its decoder skipped malformed
/// input, carrying only a count. The item page shape is closed, so the
/// count leaves the page through this side channel and the entry
/// returns it beside the page.
pub(crate) const JOB_PAGE_DECODE_FAULTS_EVENT: &str = "jobPageDecodeFaults";

/// The engine-side additions to the job vocabulary. The authoring codes
/// live in `registry_adapter_core::JobCode`; these name the conditions
/// only the engine sees, and the list is closed like the core's.
pub const JOB_ENGINE_CODES: &[&str] = &[
    "adapter.job.component-unavailable",
    "adapter.job.decoder-row",
    "adapter.job.direct-unknown",
    "adapter.job.postgres-query-refused",
    "adapter.job.read-bound",
    "adapter.job.source-unbound",
];

/// Why a compiled job was refused. Every diagnostic carries its closed
/// code and fixed text, never a value read from an artifact, a source,
/// or a page.
#[derive(Debug)]
pub struct JobError {
    /// The findings, each with its closed code and artifact kind.
    pub diagnostics: Vec<Diagnostic>,
}

impl fmt::Display for JobError {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        let rendered = self
            .diagnostics
            .iter()
            .map(|diagnostic| format!("{} {}", diagnostic.code, diagnostic.message))
            .collect::<Vec<_>>()
            .join("; ");
        write!(formatter, "the job was refused: {rendered}")
    }
}

impl std::error::Error for JobError {}

fn job_error(diagnostics: Vec<Diagnostic>) -> JobError {
    JobError { diagnostics }
}

/// One finding of the job compiler: the closed code, the artifact kind
/// it points into, and the fixed text.
fn job_finding(
    code: &str,
    artifact: &'static str,
    path: &str,
    message: &str,
    action: &str,
) -> Diagnostic {
    let mut diagnostic = Diagnostic::error(code, path, message, action);
    diagnostic.artifact = Some(artifact.to_owned());
    diagnostic
}

/// The compiled job: the checked definition, the source route it runs,
/// and every endpoint, script, and route the source route can reach,
/// with no listener, no database requirement, and no facade serving
/// state. `Debug` prints no member: the compiled state carries
/// credential plans and origins the diagnostics never repeat.
pub struct JobProgram {
    /// The checked job definition.
    pub job: AdapterJob,
    /// The source route's declaration, resolved from the pinned pack:
    /// the scan, recovery, and edit semantics the host's triggers read,
    /// so they never re-read the pack file.
    pub source_route: registry_adapter_core::SourceRouteDecl,
    /// The source route's steps, the one list every page run
    /// interprets.
    pub steps: Arc<Vec<Step>>,
    pub(crate) endpoints: BTreeMap<String, EndpointRuntime>,
    pub(crate) scripts: ScriptSet,
    pub(crate) code_maps: CodeMaps,
    pub(crate) resilience: ResilienceRuntime,
    pub(crate) routes: RouteTable,
    pub(crate) resolver: SecretResolver,
    /// The compiled governed-ingestion sources the page runs read.
    pub(crate) job_state: crate::engine::job_sources::JobPageState,
}

impl JobProgram {
    /// The checked job profile the program enforces at every page run.
    #[must_use]
    pub fn profile(&self) -> &registry_adapter_core::JobProfile {
        &self.job.profile
    }
}

impl fmt::Debug for JobProgram {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        formatter
            .debug_struct("JobProgram")
            .field("job", &self.job.job.id.as_str())
            .finish_non_exhaustive()
    }
}

/// The success path of one page run: the validated page and the count
/// of malformed input lines its decoders skipped, which the page's
/// closed shape cannot carry.
#[derive(Clone, Debug)]
pub struct JobPageResult {
    /// The validated item page.
    pub page: registry_adapter_core::ItemPage,
    /// How many malformed input lines the reads skipped, value-free.
    pub malformed_lines: u32,
}

/// Why a page run failed: the route failure's class when the route
/// raised one, or the closed page-fault or engine-read code when the
/// entry or a decoder refused the page. Never a value.
#[derive(Clone, Debug)]
pub struct JobPageFailure {
    /// The route failure's class, when a route failure ended the run.
    pub class: Option<registry_adapter_core::ErrorClass>,
    /// The value-free page-fault or engine-read code, when the failure
    /// is the page's or a read's own.
    pub code: Option<&'static str>,
}

impl JobPageFailure {
    fn of_class(class: registry_adapter_core::ErrorClass) -> Self {
        Self {
            class: Some(class),
            code: None,
        }
    }

    fn of_code(code: &'static str) -> Self {
        Self {
            class: None,
            code: Some(code),
        }
    }
}

/// Compile a job the way the facade loader compiles a deployment: read
/// the artifacts, run the authoring checks, and assemble the runnable
/// program. `pack_path` names the pack; the profile and project the
/// workspace checks run over are read from beside it, exactly as the
/// loader defaults them beside a project. No facade serving state is
/// compiled: no binding is served, no listener is opened, and no
/// database or issuer is contacted.
///
/// # Errors
///
/// Every refusal carries its closed code: the reader's, the workspace
/// and job checks', or the engine's own
/// `adapter.job.component-unavailable` for a job source this runtime
/// cannot serve.
pub fn compile_job(
    pack_path: &Path,
    job_path: &Path,
    runtime_path: &Path,
) -> Result<JobProgram, JobError> {
    let pack_directory = artifact_directory(pack_path)?;
    let profile_path = artifact_path(None, &pack_directory, "profile.yaml", "--profile")
        .map_err(|error| artifact_error(LoadError::Runtime(error.to_string())))?;
    let project_path = artifact_path(None, &pack_directory, "project.yaml", "--project")
        .map_err(|error| artifact_error(LoadError::Runtime(error.to_string())))?;
    compile_job_with(
        pack_path,
        job_path,
        runtime_path,
        &profile_path,
        &project_path,
    )
}

/// The same compile with the profile and project paths named: the form
/// an offline check takes when its artifacts sit beside the job instead
/// of beside the pack. Every refusal carries the closed code the
/// beside-pack form carries.
///
// SPDX-License-Identifier: Apache-2.0

//! The engine-side sources block of the operator runtime config
//! (`products/adapter/CONCEPT.md` sections 10.2 and 17.2) over the
//! endpoint bindings core owns
//! (`registry_adapter_core::AdapterEndpointBindings`): the environment
//! state of the governed-ingestion sources, which no endpoint binding
//! can carry. The facade reader
//! (`registry_adapter_core::AdapterRuntimeConfig`) refuses the block, so
//! a facade deployment accepts no job source state; the job compiler
//! reads the same document through [`JobRuntimeConfig`], whose bindings
//! core is the core-owned type and whose `sources` member this module
//! parses. The bindings core keeps its own unknown-key refusal, so a
//! facade member in a job document refuses exactly as the core reader
//! refuses it. Numeric bounds are reader-checked through the platform's
//! bounded types; every other shape rule is a `Deserialize` impl here,
//! value-free, so a malformed source binding refuses at the reader and
//! not at the first read.

use std::collections::BTreeMap;

use registry_adapter_core::{
    AdapterEndpointBindings, MAXIMUM_JOB_FIELD_BYTES, MAXIMUM_JOB_FILE_BYTES,
    MAXIMUM_JOB_ROWS_PER_PAGE, MAXIMUM_JOB_ROW_BYTES,
};
use registry_platform_config::{RuntimeConfigLoader, RuntimeEnvelope};
use registry_platform_yaml::{BoundedU64, LocalId, SecretReference};
use serde::Deserialize;

/// The read bounds of a route that runs no read step: the format's
/// widest values. Facade deployments carry no job profile, so this is
/// the state their routes run under; no facade path reads it.
#[must_use]
pub fn unused_read_bounds() -> registry_adapter_core::ReadBounds {
    registry_adapter_core::ReadBounds {
        maximum_file_bytes: MAXIMUM_JOB_FILE_BYTES,
        maximum_row_bytes: MAXIMUM_JOB_ROW_BYTES,
        maximum_field_bytes: MAXIMUM_JOB_FIELD_BYTES,
        maximum_rows_per_page: MAXIMUM_JOB_ROWS_PER_PAGE,
    }
}

/// The governed-ingestion state one route run carries: the job profile
/// whose bounds the read steps hold, and the compiled file sources by
/// endpoint id. Empty in every facade deployment and replay, whose
/// routes carry no job step.
#[derive(Clone, Default)]
pub struct JobPageState {
    /// The job profile of the run; `None` in every facade deployment.
    /// Read only by the read steps, so a build without them never reads
    /// it.
    #[cfg_attr(not(feature = "job-file"), allow(dead_code))]
    pub(crate) profile: Option<registry_adapter_core::JobProfile>,
    /// The compiled file sources by pack endpoint id.
    #[cfg_attr(not(feature = "job-file"), allow(dead_code))]
    pub(crate) files: BTreeMap<String, FileSourceConfig>,
    /// The compiled read-only postgres source plans by pack endpoint
    /// id; a build without job-postgres carries none.
    #[cfg(feature = "job-postgres")]
    pub(crate) postgres:
        BTreeMap<String, std::sync::Arc<crate::engine::component::postgres::PostgresPlan>>,
    /// The source clients the host registered beside the plans; the
    /// engine boundary carries no client of its own.
    #[cfg(feature = "job-postgres")]
    pub(crate) postgres_clients:
        BTreeMap<String, std::sync::Arc<dyn crate::engine::component::postgres::PostgresSource>>,
}

/// The runtime config as the job mode reads it: the endpoint bindings
/// core beside the job-only `sources` block and the job host's `store`
/// block. The core member is decoded from the same document with the
/// other two set aside, so the bindings core's own unknown-key refusal
/// stands: a facade member in a job document refuses exactly as the
/// facade reader refuses it, and a facade load of the same file refuses
/// the `sources` member itself. The bindings core is
/// `registry_adapter_core::AdapterEndpointBindings`, the shape the
/// facade document sets aside with `AdapterRuntimeConfig::endpoint_bindings`.
#[derive(Debug)]
pub struct JobRuntimeConfig {
    /// The endpoint bindings every mode shares.
    pub core: AdapterEndpointBindings,
    /// The governed-ingestion source bindings. Absent, the deployment
    /// binds no job source; a pack whose source route reads one refuses
    /// at the job compile, never at the first read.
    pub sources: Option<JobSources>,
    /// The job host's store block, passed through raw and uninterpreted
    /// by the engine: the item table's database references are the
    /// host's own state, which the host validates with its own reader.
    /// Absent, the document configures no job store.
    pub store: Option<serde_json::Value>,
}

impl JobRuntimeConfig {
    /// Read the job runtime document through the platform runtime
    /// loader: the envelope and retired keys the facade document
    /// carries, then this document's own member discipline. The one
    /// reader the compile path and the job host share.
    ///
    /// # Errors
    ///
    /// The loader's refusal, the reader's own value-free report.
    pub fn load(
        path: &std::path::Path,
    ) -> Result<Self, registry_platform_config::RuntimeConfigError> {
        // The loader refuses a path with a symbolic-link component; the
        // canonical path names the same file without one (the system
        // temporary directory carries such a component on some
        // platforms). A path that cannot be canonicalized is left to
        // the loader's own unreadable refusal.
        let absolute = std::fs::canonicalize(path).unwrap_or_else(|_| path.to_path_buf());
        RuntimeConfigLoader::new(RuntimeEnvelope {
            api_version: registry_adapter_core::ADAPTER_RUNTIME_API_VERSION,
            kind: registry_adapter_core::ADAPTER_RUNTIME_KIND,
        })
        .removed_keys(registry_adapter_core::ADAPTER_REMOVED_KEYS)
        .load::<Self>(&absolute)
        .map(|loaded| loaded.config)
    }
}

impl<'de> Deserialize<'de> for JobRuntimeConfig {
    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
        // The shared reader admits only the YAML subset that maps to
        // JSON, so this round trip loses nothing. The envelope members
        // are the reader's, checked before decoding, so they sit beside
        // `sources` in the set-aside.
        let document = serde_json::Value::deserialize(deserializer)?;
        let Some(members) = document.as_object() else {
            return Err(serde::de::Error::custom(
                "the runtime config is not a mapping",
            ));
        };
        let sources = members.get("sources").cloned();
        let store = members.get("store").cloned();
        let mut core_members = members.clone();
        core_members.remove("sources");
        // The job host's store block, beside `sources`: the engine sets
        // it aside without interpreting it. The item table's database
        // references are the job host's own state (`registry-adapter-job`
        // reads and validates the block); every other member of the
        // document refuses here, so a member neither the bindings core,
        // the sources block, nor the host's store claims is refused by
        // one of the two readers.
        core_members.remove("store");
        core_members.remove("apiVersion");
        core_members.remove("kind");
        let core = AdapterEndpointBindings::deserialize(serde_json::Value::Object(core_members))
            .map_err(|error| {
                serde::de::Error::custom(format!("the runtime bindings were refused: {error}"))
            })?;
        let sources = match sources {
            None => None,
            Some(sources) => {
                Some(JobSources::deserialize(sources).map_err(serde::de::Error::custom)?)
            }
        };
        Ok(Self {
            core,
            sources,
            store,
        })
    }
}

/// The job source bindings of one runtime config, keyed by the pack
/// endpoint each binds.
#[derive(Debug, Default, Deserialize)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
pub struct JobSources {
    /// The file sources, keyed by endpoint id.
    #[serde(default, deserialize_with = "local_id_keys")]
    pub(crate) file: BTreeMap<String, FileSourceConfig>,
    /// The read-only postgres sources, keyed by endpoint id. The
    /// engine's compile reads it only with job-postgres; the host client
    /// reads the same block for its pool.
    #[cfg_attr(not(feature = "job-postgres"), allow(dead_code))]
    #[serde(default, deserialize_with = "local_postgres_keys")]
    pub(crate) postgres: BTreeMap<String, PostgresSourceConfig>,
}

/// Deserialize a map whose keys are `LocalId`s into a map keyed by the
/// plain text, the same discipline
/// `registry_adapter_core::model::local_id_map` holds for core maps.
fn local_id_keys<'de, D>(deserializer: D) -> Result<BTreeMap<String, FileSourceConfig>, D::Error>
where
    D: serde::Deserializer<'de>,
{
    let map = BTreeMap::<LocalId, FileSourceConfig>::deserialize(deserializer)?;
    Ok(map
        .into_iter()
        .map(|(key, value)| (key.into_string(), value))
        .collect())
}

/// The same key discipline for the postgres sources.
fn local_postgres_keys<'de, D>(
    deserializer: D,
) -> Result<BTreeMap<String, PostgresSourceConfig>, D::Error>
where
    D: serde::Deserializer<'de>,
{
    let map = BTreeMap::<LocalId, PostgresSourceConfig>::deserialize(deserializer)?;
    Ok(map
        .into_iter()
        .map(|(key, value)| (key.into_string(), value))
        .collect())
}

/// The runtime binding of one read-only `postgres` source endpoint
/// (`products/adapter/CONCEPT.md` sections 10.2 and 17.2): its own pool,
/// never the journal's, with its own credential and TLS posture. The
/// engine's compile reads only the namespace; the host client reads the
/// connection members from this same block.
#[allow(dead_code)]
#[derive(Debug, Clone, Deserialize)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
pub(crate) struct PostgresSourceConfig {
    /// The source host.
    pub(crate) host: String,
    /// The source port (1 to 65535); absent, 5432.
    #[serde(default = "default_postgres_port")]
    pub(crate) port: BoundedU64<1, 65_535>,
    /// The source database.
    pub(crate) database: String,
    /// The source user.
    pub(crate) user: String,
    /// The reference the source password resolves from; resolved
    /// through the platform secret providers, never logged.
    pub(crate) password_ref: SecretReference,
    /// The namespace every item key of this source carries.
    pub(crate) namespace: String,
    /// The TLS posture of the connection; absent, the system roots and
    /// a required TLS connection.
    #[serde(default)]
    pub(crate) tls: SourceTls,
}

fn default_postgres_port() -> BoundedU64<1, 65_535> {
    BoundedU64::new(5_432).expect("5432 is inside the bound")
}

/// The TLS posture of one postgres source connection. The default is
/// the secure one: system roots, TLS required. Plaintext exists for the
/// loopback test database only and refuses in every other build.
#[allow(dead_code)]
#[derive(Debug, Clone, Default, Deserialize)]
#[serde(tag = "type", rename_all = "kebab-case")]
pub(crate) enum SourceTls {
    /// The platform trust roots, TLS required, no client certificate.
    #[default]
    #[serde(rename = "system-roots")]
    SystemRoots,
    /// One private CA bundle file beside the platform roots, the same
    /// shape a facade trust profile carries: a CA bundle is not a
    /// secret, so the member names a file.
    #[serde(rename = "ca-bundle")]
    CaBundle {
        /// The absolute path of the PEM file holding the bundle.
        ca_bundle_file: String,
    },
    /// Plaintext, loopback test databases only; refused in any build
    /// without the postgres-test feature, the way the facade database
    /// block refuses it.
    #[cfg(feature = "postgres-test")]
    #[serde(rename = "plaintext")]
    Plaintext,
}

/// The runtime binding of one `file` source endpoint
/// (`products/adapter/CONCEPT.md` sections 10.2 and 17.2): the absolute
// SPDX-License-Identifier: Apache-2.0

//! The `file` source of the governed-ingestion read step, the bounded
//! read-only port of camel-file
//! (`products/adapter/CONCEPT.md` sections 8.10 and 17.2).
//!
//! One read considers the candidates of one base directory: the files
//! directly under it (non-recursive; Camel's `recursive` is not
//! ported), matched by the Ant-style `include` glob when declared
//! (camel-4.23.0:components/camel-file/src/main/java/org/apache/camel/component/file/AntPathMatcherFileFilter.java
//! over
//! camel-4.23.0:core/camel-util/src/main/java/org/apache/camel/util/AntPathMatcher.java),
//! sorted by name ascending (the `sortBy` default), limited to
//! `maxMessagesPerPoll` candidates, and, when the source declares
//! `doneFileName`, admitted only while its done file exists
//! (camel-4.23.0:components/camel-file/src/main/java/org/apache/camel/component/file/FileConsumer.java,
//! `isMatched`, and
//! camel-4.23.0:components/camel-file/src/main/java/org/apache/camel/component/file/GenericFileEndpoint.java,
//! `createDoneFileName` and `isDoneFile`). A done file itself is never
//! a candidate.
//!
//! Ported divergences, each with its reason: `markerFile`, `fileLock`,
//! `rename`, `delete`, `move`, `preMove`, `moveFailed`, and
//! `idempotent-rename` are not ported because each writes, locks, or
//! renames the source, and this read is read-only always; the `changed`
//! read lock keeps camel-4.23.0's FileChangedExclusiveReadLockStrategy
//! semantics (length and last-modified stable across two checks spaced
//! the check interval apart, inside the timeout, minLength 1) but
//! raises a timeout instead of silently skipping the file, because a
//! skipped file reads as a completed scan and nothing is silently
//! skipped here; and Camel's `noop` implies `idempotent`, suppressing
//! re-reads of a consumed file, which WE DIVERGE from: the read never
//! suppresses re-reads, the item table owns identity, and a second read
//! of unchanged content returns the same items (the page is the same;
//! the consumer deduplicates by the namespace-plus-digest key).
//!
//! Paging (original work, recorded simplification): one read processes
//! at most one file, the first candidate the cursor has not passed. The
//! cursor carries the processed file's digest, the byte offset after
//! the last emitted row, and that file's name as `resumeAfter`; the
//! next read resumes the named file at its offset while its bytes still
//! carry the pinned digest, passes it for the next candidate once its
//! offset stands at or past its end, reads it again from zero when its
//! content changed (the new digest gives the new bytes their own
//! identity), and otherwise starts at the first candidate after the
//! resume name. A cursor past every candidate, or a last candidate
//! finished, ends the scan: `next` is absent.
//!
//! Security: a candidate name carrying a path separator or a dot
//! segment refuses, a candidate whose canonical path leaves the
//! canonical base directory refuses (symlink escape), and a file over
//! the profile's file bound refuses whole, never a partial read.

use std::io::Read as _;
use std::time::Duration;

use registry_adapter_core::ReadBounds;
use serde_json::{json, Value};

use crate::engine::decoder::{decode, Decoder, DecoderFault};
use crate::engine::job_sources::{FileSourceConfig, ReadLockKind};

/// One completed read: the item page as the exchange body takes it.
pub(crate) struct FilePage {
    /// The `{items, next}` page value.
    pub(crate) body: Value,
    /// How many malformed JSONL lines the read skipped, for the job
    /// entry's side channel.
    pub(crate) malformed_lines: u32,
}

/// Why a read refused. The processor carries the closed code beside the
/// class the route failure raises.
#[derive(Debug)]
pub(crate) enum FileReadFault {
    /// A candidate name carried a path separator or dot segment.
    Traversal,
    /// A candidate name was not UTF-8, so no glob, done-file form, or
    /// item key could ever carry it.
    NameUnreadable,
    /// A candidate's canonical path left the base directory.
    Escape,
    /// A file stood over the profile's file bound.
    Oversize,
    /// The base directory could not be listed.
    DirectoryUnreadable,
    /// A malformed record the decoder refused; the payload is the
    /// record's 0-based index over every record of the file, header
    /// included, the one value the refusal may name.
    Row(u64),
    /// A record or field over the profile's read bounds.
    RowBound,
    /// The changed read lock did not settle inside its timeout.
    LockTimeout,
}

/// One candidate: its directory-flat name and its canonical path.
struct Candidate {
    name: String,
    path: std::path::PathBuf,
}

/// Read one page from a file source under the profile's read bounds and
/// the job cursor the entry placed.
pub(crate) async fn read_page(
    config: &FileSourceConfig,
    bounds: &ReadBounds,
    cursor: Option<&Value>,
    decoder: &Decoder,
) -> Result<FilePage, FileReadFault> {
    let base = candidates(config)?;
    let (resume_name, resume_digest, resume_offset) = cursor_parts(cursor);
    let read_lock = config.read_lock();
    // The candidate this read starts at: the resume file while it
    // stands, else the first candidate sorted after it, else the first
    // candidate of the directory.
    let start = resume_name.as_deref().map_or(0, |name| {
        base.partition_point(|candidate| candidate.name.as_str() < name)
    });
    let mut index = start;
    while let Some(candidate) = base.get(index) {
        if let Ok(ReadLockKind::Changed {
            timeout_milliseconds,
            check_interval_milliseconds,
        }) = &read_lock
        {
            changed_lock(
                &candidate.path,
                Duration::from_millis(*timeout_milliseconds),
                Duration::from_millis(*check_interval_milliseconds),
            )
            .await?;
        }
        let file = read_file(candidate, bounds)?;
        // The cursor's own file stands while its bytes carry the pinned
        // digest. At or past its end it is consumed, and the read moves
        // to the next candidate; inside it the read resumes at the
        // offset. A replaced file (its digest moved) reads again from
        // zero, under its new digest.
        let named_by_cursor = index == start
            && resume_name.as_deref() == Some(candidate.name.as_str())
            && resume_digest.as_deref() == Some(file.digest.as_str());
        if named_by_cursor && resume_offset.is_some_and(|offset| offset >= file.length) {
            index += 1;
            continue;
        }
        let resume = if named_by_cursor {
            resume_offset
                .filter(|offset| *offset < file.length)
                .unwrap_or(0)
        } else {
            0
        };
        let page = decode(
            decoder,
            &config.namespace,
            &file.digest,
            &candidate.name,
            &file.bytes,
            resume,
            bounds,
        )
        .map_err(|fault| match fault {
            DecoderFault::Row(index) => FileReadFault::Row(index),
            DecoderFault::Bound => FileReadFault::RowBound,
        })?;
        let body = if page.complete && index + 1 == base.len() {
            // The file is finished and no candidate stands after it: the
            // scan of this directory is complete.
            json!({ "items": page.items })
        } else {
            json!({
                "items": page.items,
                "next": {
                    "digest": file.digest,
                    "position": if page.complete { file.length } else { page.position },
                    "resumeAfter": candidate.name,
                },
            })
        };
        return Ok(FilePage {
            body,
            malformed_lines: page.malformed_lines,
        });
    }
    // No candidate stands beyond the cursor: the scan is complete.
    Ok(FilePage {
        body: json!({ "items": [] }),
        malformed_lines: 0,
    })
}

/// The cursor a previous page returned: the resume name, the file
/// digest it pinned, and the byte offset inside that file.
fn cursor_parts(cursor: Option<&Value>) -> (Option<String>, Option<String>, Option<u64>) {
    let Some(cursor) = cursor.and_then(Value::as_object) else {
        return (None, None, None);
    };
    (
        cursor
            .get("resumeAfter")
            .and_then(Value::as_str)
            .map(str::to_owned),
        cursor
            .get("digest")
            .and_then(Value::as_str)
            .map(str::to_owned),
        cursor.get("position").and_then(Value::as_u64),
    )
}

/// The candidates of one read: the directory's regular files, flat
/// names only, include-matched, done-file filtered, sorted by name.
fn candidates(config: &FileSourceConfig) -> Result<Vec<Candidate>, FileReadFault> {
    let entries =
        std::fs::read_dir(&config.directory).map_err(|_| FileReadFault::DirectoryUnreadable)?;
    let canonical_base =
        std::fs::canonicalize(&config.directory).map_err(|_| FileReadFault::DirectoryUnreadable)?;
    let mut base = Vec::new();
    for entry in entries {
        let entry = entry.map_err(|_| FileReadFault::DirectoryUnreadable)?;
        let name = entry.file_name();
        let Some(name) = name.to_str() else {
            return Err(FileReadFault::NameUnreadable);
        };
        if name.contains('/') || name.contains('\\') || name == "." || name == ".." {
            return Err(FileReadFault::Traversal);
        }
        let path = entry.path();
        if !std::fs::metadata(&path)
            .map_err(|_| FileReadFault::DirectoryUnreadable)?
            .is_file()
        {
            continue;
        }
        let canonical =
            std::fs::canonicalize(&path).map_err(|_| FileReadFault::DirectoryUnreadable)?;
        if !canonical.starts_with(&canonical_base) {
            return Err(FileReadFault::Escape);
        }
        if let Some(done) = &config.done_file_name {
            if done.is_done_file(name) {
                continue;
            }
            match std::fs::metadata(config.directory.join(done.of(name))) {
                Ok(metadata) if metadata.is_file() => {}
                _ => continue,
            }
        }
        if let Some(include) = &config.include {
            if !match_glob(include, name) {
                continue;
            }
        }
        base.push(Candidate {
            name: name.to_owned(),
            path: canonical,
        });
    }
    base.sort_by(|left, right| left.name.cmp(&right.name));

