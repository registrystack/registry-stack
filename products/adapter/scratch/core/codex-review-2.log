+fn source_route_checks(pack: &AdapterPack) -> Vec<Diagnostic> {
+    let mut findings = Vec::new();
+    let internal_ids: HashSet<&str> = pack
+        .routes
+        .iter()
+        .map(|route| route.id.as_str())
+        .chain(
