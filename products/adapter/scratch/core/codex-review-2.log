// The item page the kobo-submissions route returns: the F5 item
// contract of CONCEPT 17.2, `{items: [{key, revision, value}], next}`.
//
// The engine evaluates the route's final setBody expression on the
// exchange (CONCEPT 8.11.3). The reply body is the Kobo data-endpoint
// envelope `{count, next, previous, results}`; this script reads
// `results` and nothing else, and never follows the reply's `next` URL:
// the cursor stays the pack's own `{offset}` object, so paging remains
// origin-pinned by construction.
//
// Item mapping (both parts are probe-gated hypotheses, see the pack
// README): key = the submission's `_id` as text, revision = `_uuid`,
// value = the submission object as returned, `_validation_status`
// included only as read-only passthrough inside `value`. A submission
// without `_id` or `_uuid` throws: a page that cannot be keyed or
// revisioned is an unexpected shape, never a silently weaker item.
//
// The resumption cursor: the fixed page size of the route's `limit`
// query (100 in pack.yaml; the two constants move together) is the
// fullness test. A full page hands out `{offset: start + 100}`; a short
// or empty page hands out no cursor, so the job stops until its next
// run re-reads at that offset. Offset pages shift under concurrent
// submissions; the route declares `key-deduplicated` recovery for
// exactly that reason. Pure and deterministic; no I/O.
fn shape_page(exchange) {
    let body = exchange.body;
    let page = body["results"];
    if page == () {
        throw "kobo reply carries no results";
    }
    if page.type_of() != "array" {
        throw "kobo reply results is not an array";
    }
    let start = exchange.properties.koboStart;
    if start == () {
        throw "koboStart property is absent";
    }
    let items = [];
    for submission in page {
        let id = submission["_id"];
        if id == () {
            throw "submission carries no _id";
        }
        let revision = submission["_uuid"];
        if revision == () {
            throw "submission carries no _uuid";
        }
        items.push(#{
            key: `${id}`,
            revision: revision,
            value: submission
        });
    }
    if items.len() < 100 {
        return #{ items: items };
    }
    #{ items: items, next: #{ offset: start + 100 } }
}
// The offset the kobo-submissions route fetches in this run.
//
// The engine evaluates the route's setProperty expression on the
// exchange (CONCEPT 8.11.3). In job mode the exchange starts with the
// job cursor under the closed property `AdapterJobCursor`, absent on
// the first run (CONCEPT 17.2); this pack's cursor value is the
// `next` object the route handed out with the previous page, so the
// seed is that object's `offset`, or 0 on the first run. A cursor of
// the wrong shape throws rather than silently restarting at 0. Pure
// and deterministic; no I/O.
fn seed_offset(exchange) {
    let cursor = exchange.properties.AdapterJobCursor;
    if cursor == () {
        return 0;
    }
    if cursor.type_of() != "map" {
        throw "the job cursor is not an object";
    }
    let offset = cursor["offset"];
    if offset == () {
        throw "the job cursor carries no offset";
    }
    if offset.type_of() != "i64" {
        throw "the job cursor offset is not an integer";
    }
    offset
}
// The position the odk-submissions and odk-repeats routes fetch in
// this run.
//
// The engine evaluates the route's setProperty expressions on the
// exchange (CONCEPT 8.11.3). In job mode the exchange starts with the
// job cursor under the closed property `AdapterJobCursor`, absent on
// the first run (CONCEPT 17.2). The odk-submissions cursor is
// `{nextLink: <url>}` when a continuation follows and absent on the
// first run; the odk-repeats cursor is `{offset: <n>}` or absent. One
// file, two seeds, one reader: a cursor of the wrong shape throws
// rather than silently restarting. Pure and deterministic; no I/O.
fn cursor_member(exchange, member, expected_type) {
    let cursor = exchange.properties.AdapterJobCursor;
    if cursor == () {
        return ();
    }
    if cursor.type_of() != "map" {
        throw "the job cursor is not an object";
    }
    let value = cursor[member];
    if value == () {
        return ();
    }
    if value.type_of() != expected_type {
        throw "the job cursor member has the wrong type";
    }
    value
}

// The nextLink the odk-submissions route follows with an
// origin-pinned send (CONCEPT 8.11.5), absent on the first run.
fn seed_next_link(exchange) {
    cursor_member(exchange, "nextLink", "string")
}

// The repeat-set offset the odk-repeats route sends as `$skip`, 0 on
// the first run.
fn seed_repeat_offset(exchange) {
    let offset = cursor_member(exchange, "offset", "i64");
    if offset == () {
        return 0;
    }
    offset
}
// The item page the odk-submissions route returns: the F5 item
// contract of CONCEPT 17.2, `{items: [{key, revision, value}], next}`.
//
// The engine evaluates the route's final setBody expression on the
// exchange (CONCEPT 8.11.3). The reply body is the OData page:
// the entities under `value`, the optional `@odata.count`, and the
// optional `@odata.nextLink` (the OData page of
// https://docs.getodk.org/central-api-odata-endpoints/: with `$top`
// the reply carries the nextLink, and since Central v2023.4 it holds a
// `$skiptoken` opaque cursor). The link is handed out as written and
// the next run sends it through the engine's origin-pinned link rules,
// never a reparse.
//
// Item mapping (probe-gated, see the pack README): key = the
// entity's `__id` (the documented OData key), revision =
// `__system/updatedAt` (hypothesis: changes on edit), value = the
// entity object as returned. A page whose cursor grows beyond the
// 2 KiB cursor bound fails the run (CONCEPT 17.2); a Central
// nextLink stays far below it. The `@odata.nextLink` presence is the
// continue signal: no nextLink, no cursor. Pages may shift when
// submissions arrive while a job runs; the route declares
// `key-deduplicated` recovery for exactly that reason. Pure and
// deterministic; no I/O.
fn shape_page(exchange) {
    let body = exchange.body;
    let rows = body["value"];
    if rows == () {
        throw "OData reply carries no value";
    }
    if rows.type_of() != "array" {
        throw "OData reply value is not an array";
    }
    let items = [];
    for row in rows {
        let id = row["__id"];
        if id == () {
            throw "submission entity carries no __id";
        }
        let revision = ();
        let system = row["__system"];
        if system != () {
            revision = system["updatedAt"];
        }
        if revision == () {
            throw "submission entity carries no __system/updatedAt";
        }
        items.push(#{
            key: `${id}`,
            revision: revision,
            value: row
        });
    }
    let link = body["@odata.nextLink"];
    if link == () {
        return #{ items: items };
    }
    if link.type_of() != "string" {
        throw "OData nextLink is not a string";
    }
    #{ items: items, next: #{ nextLink: link } }
}
// The item page the odk-repeats route returns: the repeat-table
// sketch of the pack README, the F5 item contract of CONCEPT 17.2.
//
// The engine evaluates the route's final setBody expression on the
// exchange (CONCEPT 8.11.3). The reply body is one page of the
// deployment's repeat entity set (Central exposes repeats as separate
// entity sets, for example `Submissions.children.child`), shaped like
// any OData page.
//
// The key composition is the sketch's open question, stated rather
// than hidden: the OData page of
// https://docs.getodk.org/central-api-odata-endpoints/ names no member
// by which a repeat entity references its parent submission and no
// within-parent ordinal, so this script reads the hypothesized
// `__parent-id` and composes the key as
// `<parent>/<absolute row position>`, where the absolute position is
// the cursor's accumulated row count plus the position within this
// page. Both parts are probe-gated; if Central exposes a stable parent
// reference and ordinal, the composition stays; if not, the consumer
// should deduplicate on the repeat row's own `__id`, which `value`
// carries unchanged. The revision is `__system/updatedAt` where
// present, and the item carries no revision where absent. The cursor
// hands the nextLink on as written (the send follows the engine's
// origin-pinned link rules, CONCEPT 8.11.5) beside the accumulated
// count the key needs; no nextLink, no cursor. Pure and deterministic;
// no I/O.
fn shape_repeats(exchange) {
    let body = exchange.body;
    let rows = body["value"];
    if rows == () {
        throw "OData reply carries no value";
    }
    if rows.type_of() != "array" {
        throw "OData reply value is not an array";
    }
    let consumed = exchange.properties.odkRepeatStart;
    if consumed == () {
        throw "odkRepeatStart property is absent";
    }
    let items = [];
    let position = 0;
    for row in rows {
        let parent = row["__parent-id"];
        if parent == () {
            throw "repeat entity carries no parent reference";
        }
        let item = #{ key: `${parent}/${consumed + position}`, value: row };
        let system = row["__system"];
        if system != () && system["updatedAt"] != () {
            item.revision = system["updatedAt"];
        }
        items.push(item);
        position += 1;
    }
    let link = body["@odata.nextLink"];
    if link == () {
        return #{ items: items };
    }
    if link.type_of() != "string" {
        throw "OData nextLink is not a string";
    }
    #{ items: items,
       next: #{ offset: consumed + position, nextLink: link } }
}
# yaml-language-server: $schema=https://id.registrystack.org/schemas/adapter/pack/pack.v1alpha1.schema.json
#
# The kobotoolbox pack: KoboToolbox submission acquisition for the
# governed-ingestion job mode, one source route, one page per run
# (CONCEPT 17.1 and 17.2). Unproved state, stated plainly: no KoboToolbox
# server has been reached. Every upstream shape here is synthesized from
# the published documentation, and every fixture beside this pack is
# synthetic and `documented`, never `captured`. `testedVersions` is
# empty on purpose: it lists versions a pack was exercised against, and
# none was. The hosted KoboToolbox documentation carries no server
# version, so there is no honest version list to write; the acceptance
# row of CONCEPT 17.7 lists every behavior resting on documentation as
# unproved, and the pack README carries the probe questions.
#
# What the pack covers: the v2 submissions listing, `GET
# /api/v2/assets/{uid}/data/` (the v1 `/submissions/` name was renamed
# to `data` in v2; kobotoolbox/docs source/migrating_api.md, published
# from https://support.kobotoolbox.org/api.html). One route,
# `kobo-submissions`: one page per run, `limit` fixed at 100 (the
# documented default page size; a pack never raises a server bound),
# `start` from the job cursor. The reply envelope is
# `{count, next, previous, results}`; the route reads `results` only and
# never follows the reply's `next` URL, because the cursor is this
# pack's own `{offset}` object and paging stays origin-pinned by
# construction.
#
# Deployment scoping: the asset (form) a job reads is a deployment
# value, and a source route carries no template parameters. The
# deployment-owned slot is the endpoint binding's `baseUrl`: the engine
# pins the origin plus its base path (CONCEPT 8.11.5) and every send
# stays under it, so the runtime config binds `kobo-api` to the data
# URL of the deployment's own asset (see
# products/adapter/examples/kobotoolbox-job/runtime.example.yaml) and
# this pack sends `path: /`, which lands on the documented trailing
# slash. If the job compiler grows a parameters block on the job
# definition, these bindings should move there.
#
# Authentication (cited choice): KoboToolbox API requests authenticate
# with an API token over `Authorization: Token <token>`
# (kobotoolbox/docs source/migrating_api.md) or with Basic auth over
# TLS (the same documentation retrieves the token with
# `curl -u username:password`). An endpoint declares one kind, so this
# pack declares `basic`; a deployment that prefers the token swaps the
# kind to `static-authorization` with `scheme: Token` and binds
# tokenRef in the runtime config. Both sides of the kind match must
# move together. The endpoint declares no request or response header
# allowlists: the documented data read consumes no header the engine
# would copy, so the engine sends and copies nothing beyond its own.
#
# Item mapping (probe-gated, see the pack README): key = `_id` as
# text, revision = `_uuid`, value = the submission object as returned.
# `_validation_status` never appears in any step; it may pass through
# only inside `value`. No write, patch, or delete endpoint exists in
# this pack.
#
# Error clauses: the 401 answer never reaches the route - the engine's
# authentication plan raises the uncatchable `credential.rejected` for
# a refused Basic credential - so the pack adds no clause for it. The
# transport faults redeliver once, like the dhis2-tracker reads; a GET
# is safe to repeat. Every other error propagates as its own class.
apiVersion: id.registrystack.org/formats/adapter/pack/v1alpha1
kind: AdapterPack
id: kobotoolbox
version: "1"
testedVersions: []
endpoints:
  - id: kobo-api
    component: http
    authentication:
      type: basic
    attemptTimeoutMilliseconds: 10000
    maximumResponseBytes: 1048576
    operations:
      - id: submissions-page
    testedVersions: []
sourceRoutes:
  - id: kobo-submissions
    scan: ongoing
    nextRecovery: key-deduplicated
    edits: rescan
    rescanDelaySeconds: 3600
    steps:
      - onException:
          exception:
            - upstream.timeout
            - upstream.connection
          redeliveryPolicy:
            maximumRedeliveries: 1
            retryDelaySeconds: 2
      # The offset this run fetches: the engine restores the job cursor
      # into the AdapterJobCursor property, absent on the first run
      # (CONCEPT 17.2); scripts/seed-offset.rhai turns that into the
      # Kobo `start` value.
      - setProperty:
          name: koboStart
          value:
            rhai:
              file: scripts/seed-offset.rhai
              entrypoint: seed_offset
      - to:
          uri: http:kobo-api
          parameters:
            httpMethod: GET
            path: /
            operation: submissions-page
            query:
              format:
                constant: json
              # The fixed page size: the documented default page size of
              # the v2 data endpoint. scripts/shape-page.rhai repeats
              # this constant as the fullness test; the two move
              # together.
              limit:
                constant: "100"
              start:
                exchangeProperty: koboStart
      # The item page: one F5 item per submission, the `{offset}`
      # cursor while the page was full, no cursor when short or empty
      # (scripts/shape-page.rhai). This body is the whole route output;
      # the job entry validates it against the item contract and the
      # job profile (CONCEPT 17.2).
      - setBody:
          rhai:
            file: scripts/shape-page.rhai
            entrypoint: shape_page
scripts:
  - path: scripts/seed-offset.rhai
    digest: sha256:bbfca7e32def9f4bc6f152e8d99febbeb090930a1afd104f751ebb5e997d266f
  - path: scripts/shape-page.rhai
    digest: sha256:53d5ec547d9cdb6e3426777712c9046ce87aa2bde055bc02f5fbdff27265856e
capabilities:
  components:
    - http
  languages:
    - constant
    - exchangeProperty
    - rhai
  eips:
    - onException
    - setBody
    - setProperty
    - to
// SPDX-License-Identifier: Apache-2.0

//! The governed-ingestion job: the `AdapterJob` definition, its bounded
//! profile, the projection and trigger declarations, the item contract,
//! the CSV decoder options, and the job-side authoring checks
//! (`products/adapter/CONCEPT.md` sections 17.1 and 17.2).
//!
//! A job pairs one pack source route with an explicit, bounded profile and
//! runs beside the facade: no listener, no inbound record shape, and no
//! facade ceiling change. Every bound here is a check-time guarantee the
//! engine enforces again at the edge; every refusal carries a value-free
//! `adapter.job.*` code.

use std::collections::HashSet;

use registry_platform_yaml::{Diagnostic, LocalId};
use serde::{Deserialize, Serialize};

use crate::pack::AdapterPack;
use crate::route::Step;

/// apiVersion of the authored ingestion job definition.
pub const ADAPTER_JOB_API_VERSION: &str = "id.registrystack.org/formats/adapter/job/v1alpha1";

/// Kind of the authored ingestion job definition.
pub const ADAPTER_JOB_KIND: &str = "AdapterJob";

/// The job ceiling on one upstream send's response body, in bytes: the
/// platform's own response-body cap
/// (`registry-platform-httputil`'s `MAX_DESTINATION_RESPONSE_BODY_BYTES`).
/// An endpoint only source routes reach may declare up to this bound
/// (D39); a facade-reachable endpoint stays at the facade ceiling of
/// `crate::checks::MAXIMUM_RESPONSE_BYTES`.
pub const MAXIMUM_JOB_RESPONSE_BYTES: u64 = 16_777_216;
const _: () = assert!(
    MAXIMUM_JOB_RESPONSE_BYTES
        == registry_platform_httputil::destination::MAX_DESTINATION_RESPONSE_BODY_BYTES as u64
);

/// The job ceiling on one upstream attempt, in milliseconds. It equals the
/// platform-frozen facade ceiling on purpose:
/// `registry-platform-httputil`'s `FixedDestinationPolicy::send` hard-caps
/// every operation at 10 seconds, so a job profile cannot exceed it and a
/// page must fit inside it (D39).
pub const MAXIMUM_JOB_ATTEMPT_TIMEOUT_MILLISECONDS: u64 = 10_000;
const _: () = assert!(
    MAXIMUM_JOB_ATTEMPT_TIMEOUT_MILLISECONDS
        == registry_platform_httputil::destination::MAX_DESTINATION_OPERATION_TIMEOUT.as_millis()
            as u64
);

/// The longest one source-route run may take, in milliseconds: the page
/// deadline one job profile declares
/// (`products/adapter/CONCEPT.md` section 17.2).
pub const MAXIMUM_JOB_PAGE_DEADLINE_MILLISECONDS: u64 = 600_000;

/// The most items one produced page may carry.
pub const MAXIMUM_JOB_PAGE_ITEMS: u32 = 10_000;

/// The largest serialized item page, in bytes; equal to the platform
/// response-body cap so a page never outgrows a send that carries it.
pub const MAXIMUM_JOB_PAGE_BYTES: u64 = MAXIMUM_JOB_RESPONSE_BYTES;

/// The largest file one read may take in, in bytes (1 GiB). A bigger file
/// is refused, never partially read.
pub const MAXIMUM_JOB_FILE_BYTES: u64 = 1_073_741_824;

/// The largest one decoded row or line may take, in bytes.
pub const MAXIMUM_JOB_ROW_BYTES: u64 = 1_048_576;

/// The largest one decoded field may take, in bytes.
pub const MAXIMUM_JOB_FIELD_BYTES: u64 = 65_536;

/// The most decoded rows one page may carry.
pub const MAXIMUM_JOB_ROWS_PER_PAGE: u32 = 10_000;

/// The most named parameters one `postgres:` send may carry
/// (`products/adapter/CONCEPT.md` section 8.10, the SQL row).
pub const MAXIMUM_POSTGRES_QUERY_PARAMETERS: usize = 16;

/// The longest one item key may be, in bytes.
pub const MAXIMUM_ITEM_KEY_BYTES: usize = 512;

/// The longest one item revision may be, in bytes.
pub const MAXIMUM_ITEM_REVISION_BYTES: usize = 512;

/// The longest serialized `next` cursor, in bytes.
pub const MAXIMUM_NEXT_BYTES: usize = 2048;

/// The closed decoder names a `pollEnrich` step may write. Anything else
/// refuses under `adapter.job.decoder-unknown`.
pub const POLL_DECODER_NAMES: &[&str] = &["csv", "jsonl", "raw"];

/// The job's own upstream-call ceiling: the largest
/// `maximumUpstreamCalls` a job profile may declare. A pass never needs
/// more; a route whose static worst case passes this bound is a route
/// for another job shape.
pub const MAXIMUM_JOB_UPSTREAM_CALLS: u64 = 1_000;

/// The most fields one job projection may declare.
pub const MAXIMUM_PROJECTION_FIELDS: usize = 64;

/// The longest one projected path may be, in characters.
pub const MAXIMUM_PROJECTION_FIELD_CHARACTERS: usize = 128;

/// The most dotted segments one projected path may carry, the deepest
/// lookup a mapping is held to.
pub const MAXIMUM_PROJECTION_SEGMENTS: usize = 8;

/// The largest serialized projection field list, in bytes.
pub const MAXIMUM_PROJECTION_BYTES: usize = 2_048;

/// The closed trigger kinds a job may declare: `interval`, the served
/// kind, and `hook`, the declared seam the checks refuse until it is
/// built (`adapter.job.trigger-hook-unserved`).
pub const TRIGGER_KIND_VALUES: &[&str] = &["interval", "hook"];

/// The most triggers one job may declare. Coordinator holds its
/// workflows to the same bound on `eventTriggers`
/// (crates/registry-coordinator/src/event_trigger.rs), so a deployment
/// reasons about one trigger-count shape across products.
pub const MAXIMUM_JOB_TRIGGERS: usize = 16;

/// The shortest interval between two passes, in milliseconds: one
/// second. Camel's scheduler consumer defaults to a 500-millisecond

exec
