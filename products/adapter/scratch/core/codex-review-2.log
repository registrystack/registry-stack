#!/usr/bin/env bash
set -euo pipefail

: "${CARGO_TARGET_DIR:?Set CARGO_TARGET_DIR to an external worktree Cargo target.}"

# The ingestion-job host's PostgreSQL gate: runs registry-adapter-job's
# postgres-test suites, the item-table edges the in-process tests cannot
# reach (the lease, the crash replay, the refusal run, the position
# rules, the no-payload invariant). Without ADAPTER_TEST_DATABASE_URL
# this script starts its own disposable loopback PostgreSQL 17 container,
# proves it answers queries, and removes it on the way out; with the
# variable set it uses that server as given and touches nothing outside
# this process.

repo_root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd -P)
cd "$repo_root"

# Same image as the CI postgres services in .github/workflows/ci.yml.
image='docker.io/library/postgres:17.11@sha256:67f41722b7a8cbdb868a44a4995c846eddfdc2973bccb291ce937dce88ad5675'
db_user=adapter
db_password=adapter_test
db_name=adapter

container=
cleanup() {
	# Best effort for a container this run started; the failure that led
	# here is the one worth seeing, and a container that is already gone
	# needs no removal.
	if [[ -n "$container" ]] && [[ -n "$(docker ps -aq --filter "name=^${container}$")" ]]; then
		docker rm -f "$container" >/dev/null
		printf '%s\n' "Removed $container." >&2
	fi
}

if [[ -z "${ADAPTER_TEST_DATABASE_URL:-}" ]]; then
	if ! command -v docker >/dev/null 2>&1; then
		printf '%s\n' 'docker is required on PATH to start the test database (or set ADAPTER_TEST_DATABASE_URL).' >&2
		exit 2
	fi
	trap cleanup EXIT
	checkout_hash=$(printf '%s' "$repo_root" | openssl dgst -sha256 -r | cut -c1-8)
	container="adapter-job-pg-test-${checkout_hash}-$$"
	printf '%s\n' "Starting $container (loopback PostgreSQL 17)." >&2
	docker run -d --name "$container" \
		-e POSTGRES_USER="$db_user" -e POSTGRES_PASSWORD="$db_password" -e POSTGRES_DB="$db_name" \
		-p 127.0.0.1::5432 "$image" >/dev/null
	for attempt in {1..60}; do
		if docker exec "$container" pg_isready -h 127.0.0.1 -U "$db_user" -d "$db_name" >/dev/null 2>&1; then
			break
		fi
		if [[ "$attempt" == 60 ]]; then
			printf '%s\n' "$container never accepted connections; see docker logs $container." >&2
			exit 1
		fi
		sleep 1
	done
	# The image's temporary initialization server accepts Unix sockets;
	# probe the final TCP listener and prove it really answers a query.
	if ! answered=$(docker exec "$container" psql -h 127.0.0.1 -v ON_ERROR_STOP=1 -qAt -U "$db_user" -d "$db_name" -c 'select 1'); then
		printf '%s\n' "$container refused the connectivity probe; see docker logs $container." >&2
		exit 1
	fi
	if [[ "$answered" != 1 ]]; then
		printf '%s\n' "$container answered '$answered' to the connectivity probe instead of 1." >&2
		exit 1
	fi
	port=$(docker port "$container" 5432/tcp | head -n 1)
	port=${port##*:}
	export ADAPTER_TEST_DATABASE_URL="postgresql://${db_user}:${db_password}@localhost:${port}/${db_name}"
	printf '%s\n' "$container is serving ${db_name} on localhost:${port}." >&2
else
	printf '%s\n' 'Using ADAPTER_TEST_DATABASE_URL from the environment.' >&2
fi

# The postgres-test feature gates the suites that need the database, so a
# plain cargo test run never silently skips them.
PATH="$HOME/.cargo/bin:$PATH" cargo test --locked -p registry-adapter-job --features postgres-test
#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Check Adapter dependency direction from Cargo's resolved graph.

The Adapter's engine and facade stay source-neutral: `registry-adapter`,
`registry-adapter-core`, `registry-adapter-job`, and
`registry-adapterctl` reach shared platform primitives and nothing else
of the workspace, and no Adapter crate links a Coordinator crate. The
one product-surface exception is the parked connector crate
(`products/adapter/CONCEPT.md` section 17.5):
`registry-adapter-connectors` reaches exactly `registry-breg-client`
behind its off-by-default cargo feature, is reached by no other
workspace crate, is linked by no facade binary and no job path while
parked, and never reaches a product runtime, adopter tooling,
supporting service, binding, or database crate.

Inside `registry-adapter` the engine boundary is a module
(`crates/registry-adapter/src/engine`, `products/adapter/CONCEPT.md`
section 17.2): the listener-free engine the ingestion job runs and the
facade links. Until the boundary becomes its own crate, this gate
holds the same line at import level: no file under `src/engine` names
a facade module, and none names a dependency only the facade half
links. When the split lands, `cargo tree` on the new crate asserts the
same line and this section retires with the move.

Edges are read with every feature enabled and on every target, so an
optional dependency no default build enables still cannot escape the
closure check. A package's own dev-dependencies count, so a test cannot
link what the package may not. The dev-dependencies of a crate it
reaches are not followed: Cargo never builds them into the package being
checked.
"""

