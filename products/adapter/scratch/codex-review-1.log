+use serde_json::{json, Value};
+use std::path::Path;
+
+fn run_case(root: &Path, name: &str, steps: Value, routes: Value) {
+    let dir = root.join(name);
+    std::fs::create_dir_all(&dir).unwrap();
+    let source = include_str!("../../../../crates/registry-adapter/tests/adapter_job.rs");
+    let profile = source.split("const PROFILE_YAML: &str = r#\"").nth(1).unwrap().split("\"#;").next().unwrap();
+    let pack = json!({"apiVersion":"id.registrystack.org/formats/adapter/pack/v1alpha1", "kind":"AdapterPack", "id":"case-api-pack", "version":"1", "testedVersions":[], "routes":routes, "sourceRoutes":[{"id":"submissions-page", "scan":"finite", "nextRecovery":"exact-replay", "steps":steps} ]});
+    let pack_bytes = serde_json::to_vec(&pack).unwrap();
+    let project = json!({"apiVersion":"id.registrystack.org/formats/adapter/project/v1alpha1", "kind":"AdapterProject", "project":{"id":"job-test","version":"1"}, "profile":{"id":"case-api", "version":"1", "digest":sha256_uri(profile.as_bytes())}, "pack":{"id":"case-api-pack", "version":"1", "digest":sha256_uri(&pack_bytes)}, "recordTypes":[{"name":"case","fields":[{"name":"case_type", "type":"string", "required":true}]}]});
+    let job = json!({"apiVersion":"id.registrystack.org/formats/adapter/job/v1alpha1", "kind":"AdapterJob", "job":{"id":"case-daily","version":"1"}, "source":{"pack":{"id":"case-api-pack", "version":"1", "digest":sha256_uri(&pack_bytes)}, "route":"submissions-page"}, "profile":{"pageDeadlineMilliseconds":60000, "maximumResponseBytes":16777216, "maximumPageItems":100, "maximumPageBytes":16000000, "read":{"maximumFileBytes":1073741824,"maximumRowBytes":1048576,"maximumFieldBytes":65536,"maximumRowsPerPage":100}}});
+    let runtime = json!({"apiVersion":"id.registrystack.org/formats/adapter/runtime/v1alpha1", "kind":"AdapterRuntimeConfig", "id":"job-deployment", "endpoints":[], "allowedPrivateCidrs":["192.168.0.0/16"], "listener":{"bind":"127.0.0.1:8080"}, "database":{"runtimeUrlRef":"secret:env/JOB_TEST_DB", "migrationUrlRef":"secret:env/JOB_TEST_DB"}, "oidc":{"issuer":"https://issuer.example.invalid", "audience":"job-test"}, "allowedClients":["job-client"], "audit":{"retentionDays":90}});
+    std::fs::write(dir.join("pack.yaml"), pack_bytes).unwrap();
+    std::fs::write(dir.join("profile.yaml"), profile).unwrap();
+    for (file, value) in [("project.yaml", project), ("job.yaml",job), ("runtime.yaml",runtime)] {std::fs::write(dir.join(file), serde_json::to_vec(&value).unwrap()).unwrap();}
+    match compile_job(&dir.join("pack.yaml"), &dir.join("job.yaml"), &dir.join("runtime.yaml")) {
+        Err(error) => println!("{name}: compile refused {error}"),
+        Ok(program) => {
+            let runtime = tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap();
+            println!("{name}: compile OK; run {:?}", runtime.block_on(run_job_page(&program, None)).map(|page| page.page.items.len()));
+        }
+    }
+}
+
+fn main() {
+    let root = std::env::current_dir().unwrap().join("products/adapter/scratch/review-codex-20261031");
+    let page = json!({"setBody":{"constant":{"items":[]}}});
+    run_case(&root,"control", json!([page.clone()]),json!([]));
+    run_case(&root,"direct-throttle",json!([{"to":{"uri":"direct:shared"}}]),json!([{"id":"shared","from":{"uri":"direct:shared"},"steps":[{"throttle":{"constant":1,"steps":[page.clone()]}}]}]));
+    run_case(&root,"root-throttle",json!([{"throttle":{"constant":1,"steps":[page.clone()]}}]),json!([]));
+    run_case(&root,"missing-direct",json!([{"to":{"uri":"direct:missing"}},page.clone()]),json!([]));
+    let big = "a".repeat(1_100_000);
+    let setup = json!({"setBody":{"constant":[big]}});
+    run_case(&root,"large-control",json!([setup.clone(),page.clone()]),json!([]));
+    run_case(&root,"large-split",json!([setup,{"split":{"jsonpath":"$[*]","maximumItems":1,"steps":[{"setBody":{"constant":null}}]}},page]),json!([]));
+}

