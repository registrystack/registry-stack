//! The `throttle` processor, Camel 4's Throttler
//! (`products/adapter/CONCEPT.md` section 8.6): `mode` (`TotalRequests`
//! default, or `ConcurrentRequests`), a limit expression,
//! `timePeriodMilliseconds` (default 1000), and `rejectExecution`
//! (default false).
//!
//! Divergence: a waiting exchange waits at most until its deadline,
//! then raises `throttle.rejected`, instead of waiting without bound.

use registry_adapter_core::{ErrorClass, Expression, ThrottleStep};
use registry_platform_ratelimit::rolling_window::RollingWindowError;
use serde_json::{json, Value};

use crate::resilience::ThrottlePacer;
use crate::route::{Flow, RouteFailure, Run};

/// Run one exchange under the node's pacer, keyed by the address of its
/// step in the served operation's step tree.
pub(crate) async fn run(
    run: &mut Run<'_, '_>,
    step: &ThrottleStep,
    key: usize,
) -> Result<Flow, RouteFailure> {
    let limit = read_limit(run, &step.limit)?;
    let Some(pacer) = run.context.resilience.pacer(key) else {
        return Err(RouteFailure::of(ErrorClass::Script));
    };
    match &*pacer {
        ThrottlePacer::Total(window) => {
            loop {
                match window.acquire(limit).await {
                    Ok(()) => break,
                    Err(RollingWindowError::Configuration) => return Err(invalid_limit()),
                    Err(RollingWindowError::Exceeded { retry_after }) => {
                        if step.reject_execution {
                            return Err(refused(run, "window"));
                        }
                        // A wait that cannot finish before the exchange's
                        // deadline refuses now with the throttler's own
                        // class, instead of letting the run's budget
                        // expire it as `budget.exhausted` (section 8.6).
                        if tokio::time::Instant::now() + retry_after > run.deadline {
                            return Err(refused(run, "deadline"));
                        }
                        tokio::time::sleep(retry_after).await;
                    }
                }
            }
        }
        ThrottlePacer::Concurrent(governor) => {
            // The slot is held by the permit for the body's own run and
            // given back when it drops, on every exit, including a
            // future dropped mid-run.
            let _permit = governor
                .acquire(limit, run.deadline, step.reject_execution)
                .await
                .map_err(|()| refused(run, "concurrent"))?;
            return run.run_steps(&step.steps).await;
        }
    }
    run.run_steps(&step.steps).await
}

/// The limit as Camel 4 reads it: a whole positive number, evaluated
/// per exchange (section 8.6).
fn read_limit(run: &Run<'_, '_>, expression: &Expression) -> Result<u32, RouteFailure> {
    match run.eval(expression)? {
        Value::Number(number) => number
            .as_u64()
            .and_then(|limit| u32::try_from(limit).ok())
            .filter(|limit| *limit > 0)
            .ok_or_else(invalid_limit),
        _ => Err(invalid_limit()),
    }
}

fn invalid_limit() -> RouteFailure {
    RouteFailure {
        class: ErrorClass::Validation,
        message: Some("a throttle limit must be a positive integer".to_owned()),
        data: None,
        auth: None,
    }
// SPDX-License-Identifier: Apache-2.0

//! The `circuitBreaker` processor: resilience4j semantics and defaults,
//! per EIP node with process-local state, as in Camel
//! (`products/adapter/CONCEPT.md` sections 8.6 and 8.7).
//!
//! Defaults: `failureRateThreshold` 50, a count-based sliding window of
//! `slidingWindowCalls` 100, `minimumNumberOfCalls` 100,
//! `openStateWaitSeconds` 60, `maximumHalfOpenCalls` 10,
//! `automaticTransitionFromOpenToHalfOpenEnabled` false,
//! `slowCallRateThreshold` 100, `slowCallDurationThresholdSeconds` 60.
//! A rejected call always raises `breaker.open`, diverging from Camel's
//! `throwExceptionWhenHalfOpenOrOpenState: false` default, and
//! `onFallback` runs on a recorded failure and on rejection with its output
//! validated like any route output.
//!
//! The guarded steps and the fallback run bare, the way every nested
//! body does: the route error handler does not wrap a breaker or its
//! steps (section 8.7, `inheritErrorHandler` false).

use registry_adapter_core::{CircuitBreakerStep, ErrorClass};
use registry_platform_resilience::circuit_breaker::{Acquired, BreakerState};
use serde_json::json;

use crate::route::{Flow, RouteFailure, Run};

/// Run one guarded exchange under the node's breaker, keyed by the
/// address of its step in the served operation's step tree.
pub(crate) async fn run(
    run: &mut Run<'_, '_>,
    step: &CircuitBreakerStep,
    key: usize,
) -> Result<Flow, RouteFailure> {
    let Some(breaker) = run.context.resilience.breaker(key) else {
        return Err(RouteFailure::of(ErrorClass::Script));
    };
    let permit = match breaker.acquire() {
        Acquired::Permitted(permit) => permit,
        Acquired::Rejected => {
            // The refusal never reached the source, so it carries the
            // adapter's own class and the state that refused it.
            let state = match breaker.state() {
                BreakerState::HalfOpen => "halfOpen",
                _ => "open",
            };
            run.record("breakerRefused", json!({ "state": state }));
            return fallback(run, step, None).await;
        }
    };
    let started = std::time::Instant::now();
    let outcome = run.run_steps(&step.steps).await;
    let duration = started.elapsed();
    match outcome {
        Ok(flow) => {
            permit.record(true, duration);
            Ok(flow)
        }
        Err(failure) => {
            // Boundary failures are never softened by authored filters. They
            // count as failures and retain the fallback propagation rule.
            if failure.class.is_uncatchable() {
                permit.record(false, duration);
                return fallback(run, step, Some(failure)).await;
            }

            let ignored = step.ignore_exception.as_ref().is_some_and(|classes| {
                classes
                    .iter()
                    .any(|configured| failure.class.is_within(*configured))
            });

