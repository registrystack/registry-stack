/// The profile's own consistency: the row and page bounds never exceed
/// the bounds they sit inside.
fn profile_consistency_checks(profile: &JobProfile) -> Vec<Diagnostic> {
    let mut findings = Vec::new();
    if profile.read.maximum_rows_per_page > profile.maximum_page_items {
        findings.push(job_finding(
            JobCode::ProfileInconsistent,
            "/profile/read/maximumRowsPerPage",
            "the read's maximumRowsPerPage exceeds the page's maximumPageItems",
            "Keep the rows-per-page bound at or below the page item bound.",
        ));
    }
    if profile.maximum_page_bytes > profile.maximum_response_bytes {
        findings.push(job_finding(
            JobCode::ProfileInconsistent,
            "/profile/maximumPageBytes",
            "the page's maximumPageBytes exceeds the profile's maximumResponseBytes",
            "Keep the page byte bound at or below the response byte bound.",
        ));
    }
    findings
}

/// The profile is never tighter than a bound of an endpoint the source
/// route reaches: at runtime the lower of the two applies, so a profile
/// below an endpoint's declared bound would shorten it unreviewed.
fn profile_endpoint_checks(job: &AdapterJob, pack: &AdapterPack) -> Vec<Diagnostic> {
    let mut findings = Vec::new();
    let Some(source) = pack.source_routes.get(job.source.route.as_str()) else {
        return findings;
    };
    let mut reached = HashSet::new();
    collect_reached_endpoints(
        source.steps.as_slice(),
        pack,
        &mut HashSet::new(),
        0,
        &mut reached,
    );
    for endpoint in &reached {
        if let Some(declared) = pack
            .endpoints
            .get(endpoint.as_str())
            .map(|endpoint| endpoint.maximum_response_bytes.get())
        {
            if declared > job.profile.maximum_response_bytes {
                findings.push(job_finding(
                    JobCode::ProfileEndpointBound,
                    "/profile/maximumResponseBytes",
                    "the profile is tighter than a bound of an endpoint the source route reaches",
                    "Raise the profile bound to at least the declared bound of every endpoint the source route reaches.",
                ));
                break;
            }
        }
    }
    findings
}

/// The endpoint ids the sends of one source route reach, through
/// `direct:` expansion into the pack's internal routes and templates. A
/// `direct:` target that names another source route does not resolve
/// (source routes are entry points, not subroutines), and the expansion
/// cannot cycle because the direct graph is acyclic; the visited set
/// guards a defective pack regardless.
fn collect_reached_endpoints<'a>(
    steps: &'a [Step],
    pack: &'a AdapterPack,
    visiting: &mut HashSet<&'a str>,
    depth: usize,
    reached: &mut HashSet<String>,
) {
    if depth > crate::checks::MAX_DIRECT_DEPTH {
        return;
    }
    for step in steps {
        match step {
            Step::To(to) => match to.uri.component {
                crate::model::SendComponent::Http
                | crate::model::SendComponent::GraphQl
                | crate::model::SendComponent::Postgres => {
                    reached.insert(to.uri.id.clone());
                }
                crate::model::SendComponent::Direct => {
                    expand_reached(to.uri.id.as_str(), pack, visiting, depth, reached);
                }
                crate::model::SendComponent::File | crate::model::SendComponent::Sftp => {}
            },
            Step::Enrich(enrich) => match enrich.uri.component {
                crate::model::SendComponent::Http
                | crate::model::SendComponent::GraphQl
                | crate::model::SendComponent::Postgres => {
                    reached.insert(enrich.uri.id.clone());
                }
                crate::model::SendComponent::Direct => {
                    expand_reached(enrich.uri.id.as_str(), pack, visiting, depth, reached);
                }
                crate::model::SendComponent::File | crate::model::SendComponent::Sftp => {}
            },
            // A poll names its endpoint through the step's static URI, not
            // a send; the poll page is bounded by the read bounds, so no
            // send bound of the profile rides on it.
            Step::PollEnrich(_) => {}
            other => {
                for nested in nested_steps(other) {
                    collect_reached_endpoints(nested, pack, visiting, depth, reached);
                }
            }
        }
    }
}

fn expand_reached<'a>(
    name: &'a str,
    pack: &'a AdapterPack,
    visiting: &mut HashSet<&'a str>,
    depth: usize,
    reached: &mut HashSet<String>,
) {
    if !visiting.insert(name) {
        return;
    }
    let body = pack
        .routes
        .iter()
        .find(|route| route.from.uri.id.as_str() == name)
        .map(|route| route.steps.as_slice())
        .or_else(|| {
            pack.route_templates
                .iter()
                .find(|template| template.id.as_str() == name)
                .map(|template| template.steps.as_slice())
        });
    if let Some(body) = body {
        collect_reached_endpoints(body, pack, visiting, depth + 1, reached);
    }
    visiting.remove(name);
}

/// The nested step lists of a composite step, for the walks that expand
/// `direct:` sends themselves and so cannot use
/// `crate::checks::walk_steps`.
fn nested_steps(step: &Step) -> Vec<&[Step]> {
    match step {
        Step::Choice(choice) => choice
            .when
            .iter()
            .map(|when| when.steps.as_slice())
            .chain(
                choice
                    .otherwise
                    .iter()
                    .map(|otherwise| otherwise.steps.as_slice()),
            )
            .collect(),
        Step::Filter(filter) => vec![filter.steps.as_slice()],
        Step::Split(split) => vec![split.steps.as_slice()],
        Step::Loop(loop_step) => vec![loop_step.steps.as_slice()],
        Step::CircuitBreaker(breaker) => std::iter::once(breaker.steps.as_slice())
            .chain(
                breaker
                    .on_fallback
                    .iter()
                    .map(|fallback| fallback.steps.as_slice()),
            )
            .collect(),
        Step::Throttle(throttle) => vec![throttle.steps.as_slice()],
        Step::IdempotentConsumer(idempotent) => vec![idempotent.steps.as_slice()],
        Step::OnException(clause) => vec![clause.steps.as_slice()],
        Step::DoTry(do_try) => std::iter::once(do_try.steps.as_slice())
            .chain(do_try.do_catch.iter().map(|catch| catch.steps.as_slice()))
            .chain(
                do_try
                    .do_finally
                    .iter()
                    .map(|do_finally| do_finally.steps.as_slice()),
            )
            .collect(),
        _ => Vec::new(),
    }
}

#[cfg(test)]
/// `httpUri` (the query string the source wrote travels in the link), and
/// no other component carries the member at all. Each fault names the
/// member to remove.
fn http_uri_member_faults(
    component: SendComponent,
    parameters: &crate::route::ToParameters,
) -> Vec<&'static str> {
    if parameters.http_uri.is_none() {
        return Vec::new();
    }
    match component {
        SendComponent::Http => {
            let mut members = Vec::new();
            if parameters.path.is_some() {
                members.push("path");
            }
            if !parameters.query.is_empty() {
                members.push("query");
            }
            members
        }
        SendComponent::GraphQl
        | SendComponent::Direct
        | SendComponent::Postgres
        | SendComponent::File
        | SendComponent::Sftp => vec!["httpUri"],
    }
}

/// The findings for one send's or enrichment's `httpUri` member faults,
/// emitted at the pointers of the members that carry them.
fn push_http_uri_member_findings(
    route_findings: &mut Vec<Diagnostic>,
    code_prefix: &str,
    component: SendComponent,
    parameters: &crate::route::ToParameters,
) {
    for member in http_uri_member_faults(component, parameters) {
        let (message, action) = match member {
            "path" => (
                "the send carries path beside httpUri",
                "Declare exactly one of path and httpUri; a send cannot carry both.",
            ),
            "query" => (
                "the send carries a query beside httpUri",
                "Move the query parameters into the link; the query string a source wrote is sent as written.",
            ),
            _ => (
                "the send carries httpUri outside an http send",
                "Declare httpUri on an http send only; it pins a link to the endpoint origin.",
            ),
        };
        route_findings.push(finding(
            CheckCode::RouteHttpUriMembers,
            &format!("{code_prefix}/parameters/{member}"),
            message,
            action,
        ));
    }
}

/// Whether a header name is an RFC 9110 token: one or more `tchar`
/// octets, compared without case. Public so the runtime header filter
/// consumes the one shared predicate instead of forking it.
#[must_use]
pub fn is_header_token(name: &str) -> bool {
    !name.is_empty()
        && name.bytes().all(|byte| {
            matches!(
                byte,
                b'!' | b'#' | b'$' | b'%' | b'&' | b'\'' | b'*' | b'+' | b'-' | b'.' | b'^'
                    | b'_' | b'`' | b'|' | b'~' | b'0'..=b'9' | b'a'..=b'z' | b'A'..=b'Z'
            )
        })
}

/// Whether a query key is a valid upstream wire name: non-empty, at most
/// 128 bytes, no ASCII control characters, and no `=` or `&` (their
/// unescaped meaning; the engine percent-encodes names and values on
/// send). Returns the value-free fault text.
fn query_key_fault(key: &str) -> Option<&'static str> {
    if key.is_empty() {
        return Some("the query key is empty");
    }
    if key.len() > 128 {
        return Some("the query key is longer than 128 bytes");
    }
    if key
        .bytes()
        .any(|byte| byte.is_ascii_control() || byte == b'=' || byte == b'&')
    {
        return Some("the query key carries an ASCII control character or an unescaped `=` or `&`");
    }
    None
}

/// Whether any step in the body declares redelivery beyond the first
/// attempt, or a `retryWhile`.
fn declares_redelivery(steps: &[Step]) -> bool {
    let mut declared = false;
    walk_steps(steps, &mut |step, _| match step {
        Step::ErrorHandler(handler)
            if handler
                .default_error_handler
                .as_ref()
                .is_some_and(|handler| {
                    handler
                        .redelivery_policy
                        .as_ref()
                        .is_some_and(|policy| policy.maximum_redeliveries.get() > 0)
                        || handler.retry_while.is_some()
                }) =>
        {
            declared = true;
        }
        Step::OnException(clause)
            if clause
                .redelivery_policy
                .as_ref()
                .is_some_and(|policy| policy.maximum_redeliveries.get() > 0)
                || clause.retry_while.is_some() =>
        {
            declared = true;
        }
        _ => {}
    });
    declared
}

/// Whether the send's endpoint operation declares `idempotentUpstream`. A
/// send naming no operation is never idempotent, and an operation id the
/// endpoint does not declare is refused on its own under
/// `adapter.route.unknown-operation`, never silently false.
fn send_claims_idempotent(
    pack: &AdapterPack,
    endpoint_id: &str,
    operation: Option<&ExternalId>,
) -> bool {
    let Some(endpoint) = pack.endpoints.get(endpoint_id) else {
        return false;
    };
    let Some(operation_id) = operation else {
        return false;
    };
    endpoint
        .operations
        .iter()
        .any(|op| op.id.as_str() == operation_id.as_str() && op.idempotent_upstream)
}

/// Whether any upstream component send (`http:` or `graphql:`) is
/// reachable from the body, through composite steps and `direct:`
/// expansion. Redelivery applies only to component sends, so a
/// declaration whose reachable sends are all `direct:` has no effect.
/// The depth bound counts `direct:` hops only: composite nesting is
/// unbounded here and the cycle check guards the graph.
fn reaches_component_send(steps: &[Step], bodies: &HashMap<&str, &[Step]>, depth: usize) -> bool {
    if depth > MAX_DIRECT_DEPTH {
        return false;
    }
    steps.iter().any(|step| match step {
        Step::To(to) => match to.uri.component {
            SendComponent::Http | SendComponent::GraphQl => true,
            SendComponent::Postgres | SendComponent::File | SendComponent::Sftp => false,
            SendComponent::Direct => bodies
                .get(to.uri.id.as_str())
                .is_some_and(|target| reaches_component_send(target, bodies, depth + 1)),
        },
        Step::Enrich(enrich) => match enrich.uri.component {
            SendComponent::Http | SendComponent::GraphQl => true,
            SendComponent::Postgres | SendComponent::File | SendComponent::Sftp => false,
            SendComponent::Direct => bodies
                .get(enrich.uri.id.as_str())
                .is_some_and(|target| reaches_component_send(target, bodies, depth + 1)),
        },
        Step::Filter(filter) => reaches_component_send(&filter.steps, bodies, depth),
        Step::Split(split) => reaches_component_send(&split.steps, bodies, depth),
        Step::Loop(loop_step) => reaches_component_send(&loop_step.steps, bodies, depth),
        Step::Choice(choice) => {
            choice
                .when
                .iter()
                .any(|when| reaches_component_send(&when.steps, bodies, depth))
                || choice.otherwise.as_ref().is_some_and(|otherwise| {
                    reaches_component_send(&otherwise.steps, bodies, depth)
                })
        }
        Step::CircuitBreaker(breaker) => {
            reaches_component_send(&breaker.steps, bodies, depth)
                || breaker
                    .on_fallback
                    .as_ref()
                    .is_some_and(|fallback| reaches_component_send(&fallback.steps, bodies, depth))
        }
        Step::Throttle(throttle) => reaches_component_send(&throttle.steps, bodies, depth),
        Step::IdempotentConsumer(idempotent) => {
            reaches_component_send(&idempotent.steps, bodies, depth)
        }
        Step::OnException(clause) => reaches_component_send(&clause.steps, bodies, depth),
        Step::DoTry(do_try) => {
            reaches_component_send(&do_try.steps, bodies, depth)
                || do_try
                    .do_catch
                    .iter()
                    .any(|catch| reaches_component_send(&catch.steps, bodies, depth))
                || do_try.do_finally.as_ref().is_some_and(|do_finally| {
                    reaches_component_send(&do_finally.steps, bodies, depth)
                })
        }
        _ => false,
    })
}

/// One non-safe upstream send a route body can make.
struct NonSafeSend {
    /// The endpoint id the send names.
    endpoint: String,
    /// The endpoint operation the send names, when declared.
    operation: Option<ExternalId>,
    /// Whether the send sits inside an `idempotentConsumer`.
    inside_idempotency: bool,
// SPDX-License-Identifier: Apache-2.0
//! The BReg read family (the delivery plan's N1).
//!
//! Reads carry no command key, so they are plain blocking methods on the
//! connected connector, not [`Operation`](crate::operation::Operation)
//! implementations. One method performs one explicitly initiated exchange,
//! except [`RouteReads::list_page`], which advances the destination's own
//! continuation at most until the caller's item bound. The destination's
//! `lookup.unresolved` problem passes through unchanged as
//! [`Lookup::Unresolved`]: it is never retried and never read as
//! not-found.

use registry_breg_client::{
    BRegComplete, BRegContinuationProjection, BRegListRequest, BRegLookupRequest, BRegProposal,
    BRegProposalQuery, BRegProposalState, BRegProposalTurn, BRegRawDocument, BRegRecordOptions,
    BaseRegistryClientError, RegistryRecord, RegistryRecordSingleResponse,
};

use crate::operation::ConnectorFault;

use super::fault;

/// The reads one connected connector offers, bound to its route and
/// profile.
pub struct RouteReads<'a> {
    pub(crate) connector: &'a super::BregConnector,
}

/// One resolved or unresolved lookup. `Unresolved` is the destination's
/// typed `lookup.unresolved` answer (status 404, problem kind), not a
/// not-found answer and never a retry candidate.
#[derive(Debug)]
pub enum Lookup {
    /// Exactly one record resolved.
    Resolved(Box<BRegComplete<RegistryRecordSingleResponse>>),
    /// The destination's `lookup.unresolved` problem, passed through.
    Unresolved,
}

/// One bounded record list page: the items read and the persistable
/// continuation when the collection has more.
#[derive(Debug)]
pub struct RecordPage {
    /// The records across the pages this read advanced through.
    pub items: Vec<RegistryRecord>,
    /// The opaque, persistable continuation when the collection has more
    /// than the caller's bound admitted.
    pub continuation: Option<BRegContinuationProjection>,
}

/// The value-free summary of one listed Proposal: identity, lifecycle
/// state, turn, and submission version, and nothing else.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct ProposalSummary {
    /// The Proposal identifier.
    pub id: String,
    /// The Proposal lifecycle state (`draft`, `submitted`, `applied`,
    /// `cancelled`, `rejected`).
    pub state: BRegProposalState,
    /// Who the destination expects to act next, when derived.
    pub turn: Option<BRegProposalTurn>,
    /// The frozen submission version.
    pub submission_version: u32,
}

/// One bounded Proposal listing page.
#[derive(Debug)]
pub struct ProposalPage {
    /// The value-free summaries on this page.
    pub summaries: Vec<ProposalSummary>,
    /// The cursor when the collection has more; pass it back in the next
    /// query's `cursor`.
    pub next_cursor: Option<String>,
}

impl RouteReads<'_> {
    fn run<T: Send>(
        &self,
        exchange: impl std::future::Future<Output = Result<T, BaseRegistryClientError>> + Send,
    ) -> Result<T, ConnectorFault> {
        self.connector
            .block(exchange)
            .map_err(|error| fault(&error))
    }

    /// Read one record by identifier.
    pub fn get_record(
        &self,
        record_identifier: &str,
    ) -> Result<BRegComplete<RegistryRecordSingleResponse>, ConnectorFault> {
        self.run(self.connector.client().get_record(
            self.connector.route(),
            record_identifier,
            &options(self.connector.profile()),
        ))
    }

    /// Read the newest retained revisions of one record as inert bytes.
    pub fn record_revisions(
        &self,
        record_identifier: &str,
    ) -> Result<BRegComplete<BRegRawDocument>, ConnectorFault> {
        self.run(self.connector.client().record_revisions(
            self.connector.route(),
            record_identifier,
            Some(self.connector.profile()),
        ))
    }

    /// Read one exact retained revision as inert bytes.
    pub fn get_record_revision(
        &self,
        record_identifier: &str,
        revision: u64,
    ) -> Result<BRegComplete<BRegRawDocument>, ConnectorFault> {
        self.run(self.connector.client().get_record_revision(
            self.connector.route(),
            record_identifier,
            revision,
            &options(self.connector.profile()),
        ))
    }

    /// Read the first record page and advance the destination's own
    /// continuation until at least `maximum_items` items are read, the
    /// collection ends, or the continuation stops. The caller's bound is
    /// the only automatic advance; a page that overshoots the bound keeps
    /// every item it returned.
    pub fn list_page(
        &self,
        request: &BRegListRequest,
        maximum_items: usize,
    ) -> Result<RecordPage, ConnectorFault> {
        let first = self.run(
            self.connector
                .client()
                .list_records(self.connector.route(), request),
        )?;
        let mut items = first.value.value.items;
        let mut continuation = first.value.continuation;
        while items.len() < maximum_items {
            let Some(next) = continuation.take() else {
                break;
            };
            let page = self.run(self.connector.client().continue_list(&next))?;
            items.extend(page.value.value.items);
            continuation = page.value.continuation;
        }
        Ok(RecordPage {
            items,
            continuation: continuation.map(|value| value.projection()),
        })
    }

    /// Evaluate one compiled selector against the request-origin values.
    /// The unresolved answer is [`Lookup::Unresolved`], the destination's
    /// own typed problem: never retried, never not-found.
    pub fn lookup(&self, request: &BRegLookupRequest) -> Result<Lookup, ConnectorFault> {
        match self.run(
            self.connector
                .client()
                .lookup_record(self.connector.route(), request),
        ) {
            Ok(record) => Ok(Lookup::Resolved(Box::new(record))),
            Err(ConnectorFault::Native { code: Some(code) })
                if code == super::problems::LOOKUP_UNRESOLVED =>
            {
                Ok(Lookup::Unresolved)
            }
            Err(error) => Err(error),
        }
    }

    /// Read one Proposal's value-free summary: the identity, state,
    /// turn, and submission version a submit attempt is prepared from.
    pub fn proposal_summary(&self, id: &str) -> Result<ProposalSummary, ConnectorFault> {
        let read = self.run(
            self.connector
                .client()
                .get_proposal(self.connector.proposal_get_binding()?, id),
        )?;
        let proposal = read.value;
        Ok(ProposalSummary {
            id: proposal.id().to_owned(),
            state: proposal.state(),
            turn: proposal.turn(),
            submission_version: proposal.submission_version(),
        })
    }

    /// List Proposals through the server's own filters and cursor. One
    /// bounded page; the runner advances by passing `next_cursor` back in
    /// the query.
    pub fn list_proposals_page(
        &self,
        query: &BRegProposalQuery,
    ) -> Result<ProposalPage, ConnectorFault> {
        let page = self.run(
            self.connector
                .client()
                .list_proposals(self.connector.proposal_collection()?, query),
        )?;
        Ok(ProposalPage {
            summaries: page
                .value
                .items
                .iter()
                .map(|proposal: &BRegProposal| ProposalSummary {
                    id: proposal.id().to_owned(),
                    state: proposal.state(),
                    turn: proposal.turn(),
                    submission_version: proposal.submission_version(),
                })
                .collect(),
            next_cursor: page.value.next_cursor,
        })
    }
}

fn options(profile: &str) -> BRegRecordOptions {
    BRegRecordOptions::default()
        .access_profile(profile)
        .expect("the connector's profile passed the client's validation at construction")
}

