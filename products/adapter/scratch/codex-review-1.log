// SPDX-License-Identifier: Apache-2.0
//! The BReg ingestion run family: `breg.ingestion.create-run` and
//! `breg.ingestion.submit-chunk`, the finite protocol one bulk import
//! follows, with the input digest, counts, and checkpoints surfaced.
//!
//! The family writes through the destination's operator-opened import
//! authority. The connector records the host's decision in
//! `BregConnectorConfig::allow_import_profile` (default off): with the
//! authority closed, both operations stay out of the catalog and
//! `prepare` answers [`ConnectorFault::AuthorityAbsent`].
//!
//! * Create run announces one whole input and opens a durable run. The
//!   destination takes no idempotency key here and allocates a fresh run
//!   id for every accepted request, so the descriptor's rule is
//!   read-then-decide: recovery lists the caller's open runs under the
//!   announced input digest and settles on what the destination proves;
//!   only when no run exists does recovery announce again, under the same
//!   ledger key and never under a destination key.
//! * Submit chunk is unkeyed and replay-safe by the destination's own
//!   protocol: a resubmitted chunk replays its retained receipt, which
//!   the outcome note names. Recovery resends the identical chunk.
//!
//! Closed input shapes: `breg.ingestion.create-run/v1` is
//! `{"profile": "...", "operation": "create" | "patch", "packageRevision":
//! "<sha256:...>", "schemaFingerprint": "<sha256:...>", "inputDigest":
//! "<64 hex>", "inputLength": <n>, "itemCount": <n>, "chunkCount": <n>}`;
//! `breg.ingestion.submit-chunk/v1` is `{"run": "<uuid>", "profile":
//! "...", "chunkIndex": <n>, "prefixDigest": "<64 hex>", "items": [
//! ...closed create-or-patch batch items... ]}`.

use std::sync::{Arc, LazyLock};

use serde::{Deserialize, Serialize};
use serde_json::Value;
use uuid::Uuid;

use registry_breg_client::{
    BRegBatchOperation, BRegIngestionChunk, BRegIngestionRunListQuery, BRegIngestionRunRequest,
    BRegIngestionRunStatus, BREG_INGESTION_CHUNK_ALGORITHM_VERSION,
};

use crate::operation::{
    BodyKind, CommandKey, ConnectorFault, CredentialRequirements, IdempotencyRule, InputSchema,
    MutationBehavior, NativeState, Observable, Operation, OperationDescriptor, PreparedAttempt,
    Product, RecoveryRule, SendOutcome,
};

use super::{accepted, classify, completed, fault};

/// Announcing one whole input opens the durable run.
pub static CREATE_RUN: LazyLock<OperationDescriptor> = LazyLock::new(|| OperationDescriptor {
    name: "breg.ingestion.create-run",
    product: Product::Breg,
    input_schema: InputSchema::ConnectorDefined {
        shape: "breg.ingestion.create-run/v1".to_owned(),
    },
    body_kind: BodyKind::Json,
    mutation: MutationBehavior::Unconditional,
    credentials: CredentialRequirements {
        credential_kinds: vec!["private-key-jwt".to_owned()],
        requires_task_grant: false,
        requires_operator_authority: true,
    },
    // The destination takes no key for the announcement and never replays
    // one; recovery reads the caller's runs under the input digest.
    idempotency: IdempotencyRule::ReadBeforeRetry,
    recovery: RecoveryRule::ReadThenDecide,
    completion: "the destination opened the announced run and answered with its run id",
    observable: true,
});

/// One chunk of an open run commits atomically with the checkpoint
/// advance; a resubmission replays its retained receipt.
pub static SUBMIT_CHUNK: LazyLock<OperationDescriptor> = LazyLock::new(|| OperationDescriptor {
    name: "breg.ingestion.submit-chunk",
    product: Product::Breg,
    input_schema: InputSchema::ConnectorDefined {
        shape: "breg.ingestion.submit-chunk/v1".to_owned(),
    },
    body_kind: BodyKind::Json,
    mutation: MutationBehavior::Unconditional,
    credentials: CredentialRequirements {
        credential_kinds: vec!["private-key-jwt".to_owned()],
        requires_task_grant: false,
        requires_operator_authority: true,
    },
    idempotency: IdempotencyRule::DestinationReplay,
    recovery: RecoveryRule::IdempotentResend,
    completion: "the destination committed the chunk once and answered with its retained receipt",
    observable: true,
});

const CREATE_RUN_OPERATION: &str = "breg.ingestion.create-run";
const SUBMIT_CHUNK_OPERATION: &str = "breg.ingestion.submit-chunk";

fn is_sha256_hex(value: &str) -> bool {
    value.len() == 64 && value.bytes().all(|byte| byte.is_ascii_hexdigit())
}

#[derive(Serialize, Deserialize)]
struct CreateRunEnvelope {
    version: u8,
    operation: String,
    key: String,
    profile: String,
    operation_kind: String,
    package_revision: String,
    schema_fingerprint: String,
    input_digest: String,
    input_length: u64,
    item_count: u64,
    chunk_count: u64,
}

/// The exact, persistable run announcement.
pub struct PreparedCreateRun {
    envelope: Vec<u8>,
    key: CommandKey,
}

impl PreparedCreateRun {
    /// Restore the stored bytes of one announcement. The key is the
    /// runner's ledger key; the destination request carries none.
    pub fn from_bytes(bytes: &[u8]) -> Result<Self, ConnectorFault> {
        let envelope: CreateRunEnvelope =
            serde_json::from_slice(bytes).map_err(|_| ConnectorFault::NotPrepared)?;
        if envelope.version != 1 || envelope.operation != CREATE_RUN_OPERATION {
            return Err(ConnectorFault::NotPrepared);
        }
        Ok(Self {
            envelope: bytes.to_vec(),
            key: CommandKey::new(envelope.key).map_err(|_| ConnectorFault::NotPrepared)?,
        })
    }
}

impl std::fmt::Debug for PreparedCreateRun {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        formatter.write_str("PreparedCreateRun(<redacted>)")
    }
}

impl std::fmt::Debug for PreparedSubmitChunk {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        formatter.write_str("PreparedSubmitChunk(<redacted>)")
    }
}

impl PreparedAttempt for PreparedCreateRun {
    fn as_bytes(&self) -> &[u8] {
        &self.envelope
    }

    fn operation(&self) -> &'static str {
        CREATE_RUN_OPERATION
    }

    fn key(&self) -> &CommandKey {
        &self.key
    }
}

#[derive(Serialize, Deserialize)]
struct SubmitChunkEnvelope {
    version: u8,
    operation: String,
    key: String,
    run: String,
    profile: String,
    chunk_index: u64,
    prefix_digest: String,
    items: Vec<Value>,
}

/// The exact, persistable chunk attempt.
pub struct PreparedSubmitChunk {
    envelope: Vec<u8>,
    key: CommandKey,
}

impl PreparedSubmitChunk {
    /// Restore the stored bytes of one chunk attempt.
    pub fn from_bytes(bytes: &[u8]) -> Result<Self, ConnectorFault> {
        let envelope: SubmitChunkEnvelope =
            serde_json::from_slice(bytes).map_err(|_| ConnectorFault::NotPrepared)?;
        if envelope.version != 1 || envelope.operation != SUBMIT_CHUNK_OPERATION {
            return Err(ConnectorFault::NotPrepared);
        }
        Ok(Self {
            envelope: bytes.to_vec(),
            key: CommandKey::new(envelope.key).map_err(|_| ConnectorFault::NotPrepared)?,
        })
    }
}

impl PreparedAttempt for PreparedSubmitChunk {
    fn as_bytes(&self) -> &[u8] {
        &self.envelope
    }

    fn operation(&self) -> &'static str {
        SUBMIT_CHUNK_OPERATION
    }

    fn key(&self) -> &CommandKey {
        &self.key
    }
}

fn build_run_request(
    envelope: &CreateRunEnvelope,
) -> Result<BRegIngestionRunRequest, ConnectorFault> {
    let operation_kind = match envelope.operation_kind.as_str() {
        "create" => BRegBatchOperation::Create,
        "patch" => BRegBatchOperation::Patch,
        _ => return Err(ConnectorFault::InvalidInput),
    };
    BRegIngestionRunRequest::builder()
        .operation(operation_kind)
        .profile(envelope.profile.clone())
        .map_err(|_| ConnectorFault::InvalidInput)?
        .package_revision(envelope.package_revision.clone())
        .map_err(|_| ConnectorFault::InvalidInput)?
        .schema_fingerprint(envelope.schema_fingerprint.clone())
        .map_err(|_| ConnectorFault::InvalidInput)?
        .input_digest(envelope.input_digest.clone())
        .map_err(|_| ConnectorFault::InvalidInput)?
        .input_length(envelope.input_length)
        .item_count(envelope.item_count)
        .map_err(|_| ConnectorFault::InvalidInput)?
        .chunk_count(envelope.chunk_count)
        .map_err(|_| ConnectorFault::InvalidInput)?
        .chunk_algorithm_version(BREG_INGESTION_CHUNK_ALGORITHM_VERSION)
        .map_err(|_| ConnectorFault::InvalidInput)?
        .build()
        .map_err(|_| ConnectorFault::InvalidInput)
}

fn require_opened(connector: &super::BregConnector) -> Result<(), ConnectorFault> {
    if connector.import_opened {
        Ok(())
    } else {
        Err(ConnectorFault::AuthorityAbsent)
    }
}

fn parse_digest(input: &Value, member: &str) -> Result<String, ConnectorFault> {
    let value = input
        .get(member)
        .and_then(Value::as_str)
        .ok_or(ConnectorFault::InvalidInput)?;
    if is_sha256_hex(value) {
        Ok(value.to_owned())
    } else {
        Err(ConnectorFault::InvalidInput)
    }
}

fn parse_count(input: &Value, member: &str) -> Result<u64, ConnectorFault> {
    let value = input.get(member).and_then(Value::as_u64);
    match value {
        Some(0) | None => Err(ConnectorFault::InvalidInput),
        Some(count) => Ok(count),
    }
}

/// The run announcement over one connected connector.
pub struct IngestionCreateRun {
    pub(crate) connector: Arc<super::BregConnector>,
}

impl IngestionCreateRun {
    fn unseal(&self, prepared: &PreparedCreateRun) -> Result<CreateRunEnvelope, ConnectorFault> {
        let envelope: CreateRunEnvelope =
            serde_json::from_slice(&prepared.envelope).map_err(|_| ConnectorFault::NotPrepared)?;
        if envelope.version != 1 || envelope.operation != CREATE_RUN_OPERATION {
            return Err(ConnectorFault::NotPrepared);
        }
        Ok(envelope)
    }

    fn announce(&self, envelope: &CreateRunEnvelope) -> Result<SendOutcome, ConnectorFault> {
        let request = build_run_request(envelope)?;
        let answer = self.connector.block(
            self.connector
                .client()
                .create_ingestion_run(self.connector.route(), &request),
        );
        match answer {
            Ok(run) => Ok(accepted(correlation(
                &run.value.run_id().to_string(),
                &envelope.profile,
            ))),
            Err(error) => classify(&error),
        }
    }
}

/// The family's correlation: `<run-id>/<profile>`, the identity a run
/// observation reads through.
fn correlation(run: &str, profile: &str) -> String {
    format!("{run}/{profile}")
}

fn split_correlation(correlation: &str) -> Result<(Uuid, &str), ConnectorFault> {
    let (run, profile) = correlation
        .split_once('/')
        .ok_or(ConnectorFault::InvalidInput)?;
    let run = Uuid::parse_str(run).map_err(|_| ConnectorFault::InvalidInput)?;
    Ok((run, profile))
}

impl Observable for IngestionCreateRun {
    fn observe(&self, correlation: &str) -> Result<NativeState, ConnectorFault> {
        observe_run(&self.connector, correlation)
    }
}

impl Operation for IngestionCreateRun {
    type Prepared = PreparedCreateRun;

    fn describe(&self) -> &OperationDescriptor {
        &CREATE_RUN
    }

    fn prepare(&self, input: &Value, key: CommandKey) -> Result<PreparedCreateRun, ConnectorFault> {
        require_opened(&self.connector)?;
        let member = |name: &str| -> Result<&str, ConnectorFault> {
            input
                .get(name)
                .and_then(Value::as_str)
                .ok_or(ConnectorFault::InvalidInput)
        };
        let envelope = CreateRunEnvelope {
            version: 1,
            operation: CREATE_RUN_OPERATION.to_owned(),
            key: key.as_str().to_owned(),
            profile: member("profile")?.to_owned(),
            operation_kind: member("operation")?.to_owned(),
            package_revision: member("packageRevision")?.to_owned(),
            schema_fingerprint: member("schemaFingerprint")?.to_owned(),
            input_digest: parse_digest(input, "inputDigest")?,
            input_length: parse_count(input, "inputLength")?,
            item_count: parse_count(input, "itemCount")?,
            chunk_count: parse_count(input, "chunkCount")?,
        };
        // Build once here so shape faults answer at prepare, with no I/O.
        build_run_request(&envelope)?;
        Ok(PreparedCreateRun {
            envelope: serde_json::to_vec(&envelope).map_err(|_| ConnectorFault::InvalidInput)?,
            key,
        })
    }

    fn send(&self, prepared: &PreparedCreateRun) -> Result<SendOutcome, ConnectorFault> {
        let envelope = self.unseal(prepared)?;
        self.announce(&envelope)
    }

    fn recover(&self, prepared: &PreparedCreateRun) -> Result<SendOutcome, ConnectorFault> {
        let envelope = self.unseal(prepared)?;
        // Read what the destination proves: the caller's open runs under
        // the announced input digest. An existing run is the outcome; only
        // silence announces again, under the same ledger key and no
        // destination key.
        let query = BRegIngestionRunListQuery::default()
            .access_profile(envelope.profile.clone())
            .map_err(|_| ConnectorFault::NotPrepared)?
            .status(BRegIngestionRunStatus::Open)
            .input_digest(envelope.input_digest.clone())
            .map_err(|_| ConnectorFault::NotPrepared)?;
        let listed = self.connector.block(
            self.connector
                .client()
                .list_ingestion_runs(self.connector.route(), &query),
        );
        match listed {
            Ok(page) if !page.value.runs().is_empty() => Ok(accepted(correlation(
                &page.value.runs()[0].run_id().to_string(),
                &envelope.profile,
            ))),
            Ok(_) => self.announce(&envelope),
            Err(error) => classify(&error),
        }
    }
}

/// The chunk submission over one connected connector.
pub struct IngestionSubmitChunk {
    pub(crate) connector: Arc<super::BregConnector>,
}

impl IngestionSubmitChunk {
    fn unseal(
        &self,
        prepared: &PreparedSubmitChunk,
    ) -> Result<SubmitChunkEnvelope, ConnectorFault> {
        let envelope: SubmitChunkEnvelope =
            serde_json::from_slice(&prepared.envelope).map_err(|_| ConnectorFault::NotPrepared)?;
        if envelope.version != 1 || envelope.operation != SUBMIT_CHUNK_OPERATION {
            return Err(ConnectorFault::NotPrepared);
        }
        Ok(envelope)
    }

    fn submit(&self, envelope: &SubmitChunkEnvelope) -> Result<SendOutcome, ConnectorFault> {
        let run = Uuid::parse_str(&envelope.run).map_err(|_| ConnectorFault::NotPrepared)?;
        let chunk = BRegIngestionChunk::new(
            envelope.chunk_index,
            envelope.items.clone(),
            &envelope.prefix_digest,
        )
        .map_err(|_| ConnectorFault::NotPrepared)?;
        let answer = self
            .connector
            .block(self.connector.client().submit_ingestion_chunk(
                self.connector.route(),
                run,
                &chunk,
                &envelope.profile,
            ));
        match answer {
            Ok(submission) => {
                let receipt = submission.value.receipt();
                let mut outcome = completed(correlation(&envelope.run, &envelope.profile));
                if receipt.replayed() {
                    outcome.note =
                        Some("the destination replayed its retained receipt for this chunk");
                }
                Ok(outcome)
            }
            Err(error) => classify(&error),
        }
    }
}

impl Observable for IngestionSubmitChunk {
    fn observe(&self, correlation: &str) -> Result<NativeState, ConnectorFault> {
        observe_run(&self.connector, correlation)
    }
}

impl Operation for IngestionSubmitChunk {
    type Prepared = PreparedSubmitChunk;

    fn describe(&self) -> &OperationDescriptor {
        &SUBMIT_CHUNK
    }

    fn prepare(
        &self,
        input: &Value,
        key: CommandKey,
    ) -> Result<PreparedSubmitChunk, ConnectorFault> {
        require_opened(&self.connector)?;
        let run = input
            .get("run")
            .and_then(Value::as_str)
            .ok_or(ConnectorFault::InvalidInput)?;
        Uuid::parse_str(run).map_err(|_| ConnectorFault::InvalidInput)?;
        let profile = input
            .get("profile")
            .and_then(Value::as_str)
            .ok_or(ConnectorFault::InvalidInput)?;
        let chunk_index = input
            .get("chunkIndex")
            .and_then(Value::as_u64)
            .ok_or(ConnectorFault::InvalidInput)?;
        let prefix_digest = parse_digest(input, "prefixDigest")?;
        let items: Vec<Value> = serde_json::from_value(
            input
                .get("items")
                .cloned()
                .ok_or(ConnectorFault::InvalidInput)?,
        )
        .map_err(|_| ConnectorFault::InvalidInput)?;
        if items.is_empty() {
            return Err(ConnectorFault::InvalidInput);
        }
        // Encode once here so the closed item shape and the digest and
        // body bounds answer at prepare, with no I/O.
        BRegIngestionChunk::new(chunk_index, items.clone(), &prefix_digest)
            .map_err(|_| ConnectorFault::InvalidInput)?;
        let envelope = SubmitChunkEnvelope {
            version: 1,
            operation: SUBMIT_CHUNK_OPERATION.to_owned(),
            key: key.as_str().to_owned(),
            run: run.to_owned(),
            profile: profile.to_owned(),
            chunk_index,
            prefix_digest,
            items,
        };
        Ok(PreparedSubmitChunk {
            envelope: serde_json::to_vec(&envelope).map_err(|_| ConnectorFault::InvalidInput)?,
            key,
        })
    }

    fn send(&self, prepared: &PreparedSubmitChunk) -> Result<SendOutcome, ConnectorFault> {
        let envelope = self.unseal(prepared)?;
        self.submit(&envelope)
    }

    fn recover(&self, prepared: &PreparedSubmitChunk) -> Result<SendOutcome, ConnectorFault> {
        // The destination's own protocol replays a committed chunk, so the
        // identical resend is this operation's recovery.
        let envelope = self.unseal(prepared)?;
        self.submit(&envelope)
    }
}

/// Read one run's durable state as the family's native lifecycle: the
/// status word with the input digest, counts, and checkpoints the run
/// publishes.
fn observe_run(
    connector: &super::BregConnector,
    correlation: &str,
) -> Result<NativeState, ConnectorFault> {
    let (run, profile) = split_correlation(correlation)?;
    let answer = connector.block(connector.client().read_ingestion_run(
        connector.route(),
        run,
        Some(profile),
    ));
    match answer {
        Ok(read) => {
            let value = read.value;
            let mut details = vec![
                ("inputDigest".to_owned(), value.input_digest().to_owned()),
                ("itemCount".to_owned(), value.item_count().to_string()),
                ("chunkCount".to_owned(), value.chunk_count().to_string()),
                (
                    "nextChunkIndex".to_owned(),
                    value.next_chunk_index().to_string(),
                ),
                (
                    "committedItems".to_owned(),
                    value.committed_items().to_string(),
                ),
            ];
            if let Some(reason) = value.blocked_reason() {
                details.push(("blockedReason".to_owned(), reason.as_str().to_owned()));
            }
            Ok(NativeState {
                state: value.status().as_str().to_owned(),
                details,
            })
        }
        Err(error) => Err(fault(&error)),
    }
}
// SPDX-License-Identifier: Apache-2.0
//! The BReg immediate Action family (`breg.action.invoke`).
//!
//! The prepared form carries the client's own inert `BRegPreparedAction`
//! evidence (the exact invocation bytes and key) plus the original inputs
//! `recover_action` requires. The closed input shape
//! (`breg.action.invoke/v1`): `{"input": { ...action inputs... }}`.
//!
//! # Target conditions
//!
//! The destination derives target-condition keys from an action's
//! reference inputs, and conditions are an explicit read before
//! invocation. `prepare` performs no I/O. For an action without
//! condition keys the prepared form carries the client's inert evidence
//! and every send re-arms the exact request from it. For a guarded
//! action the client publishes no way to prepare condition-less
//! evidence (`BRegActionInvocationRequest::new` refuses `None`
//! conditions outright, so `prepare_action` cannot run before the
//! conditions exist), so the prepared form carries the inputs and every
//! `send` and `recover` gathers the conditions for the same inputs as
//! the operation's one declared preflight (an unkeyed read the client
//! never resends) before the one keyed exchange under the same key:
//! unchanged targets reproduce the identical body, which the destination
//! replays or executes once, and a moved target produces a different
//! body under a spent key, which the destination answers with
//! `idempotency.key-reused` and the connector surfaces as a refusal.
//! Silence is never read as success.
//!
//! # Correlation and observation
//!
//! The send's correlation is the receipt's application identity alone
//! (`<application-id>`) when the receipt named no result record, or
//! `<application-id>/<record-type>/<record-id>` naming the first result
//! record; observation reads that record back. Either form observes: a
//! bare application identity observes as the family's terminal state,
//! because an immediate Action is complete on its receipt.

use std::sync::{Arc, LazyLock};

use serde::{Deserialize, Serialize};
use serde_json::{Map, Value};

use registry_breg_client::{
    BRegActionInvocationRequest, BRegActionTargetConditions, BRegActionTargetConditionsRequest,
    BRegIdempotencyKey, BRegPreparedAction,
};

use crate::operation::{
    BodyKind, CommandKey, ConnectorFault, CredentialRequirements, IdempotencyRule, InputSchema,
    MutationBehavior, NativeState, Observable, Operation, OperationDescriptor, PreparedAttempt,
    Product, RecoveryRule, SendOutcome,
};

use super::{classify, completed, fault};

/// An immediate Action holds the target conditions' declared
/// preconditions; an unguarded action carries none.
pub static INVOKE: LazyLock<OperationDescriptor> = LazyLock::new(|| OperationDescriptor {
    name: "breg.action.invoke",
    product: Product::Breg,
    input_schema: InputSchema::ConnectorDefined {
        shape: "breg.action.invoke/v1".to_owned(),
    },
    body_kind: BodyKind::Json,
    mutation: MutationBehavior::Preconditioned,
    credentials: CredentialRequirements {
        credential_kinds: vec!["private-key-jwt".to_owned()],
        requires_task_grant: false,
        requires_operator_authority: false,
    },
    idempotency: IdempotencyRule::CallerKeyed {
        receipt_retention_days: Some(7),
    },
    recovery: RecoveryRule::ExactSameKey,
    completion: "the destination executed the action once and answered with its receipt",
    observable: true,
});

const OPERATION: &str = "breg.action.invoke";

#[derive(Serialize, Deserialize)]
pub(crate) struct InvokeEnvelope {
    pub version: u8,
    pub operation: String,
    pub key: String,
    pub action: String,
    pub action_revision: String,
    pub inputs: Map<String, Value>,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub evidence: Option<Value>,
}

/// The exact, persistable immediate Action attempt.
pub struct PreparedInvoke {
    envelope: Vec<u8>,
    key: CommandKey,
}

impl PreparedInvoke {
    /// Restore the stored bytes of one invocation attempt.
    pub fn from_bytes(bytes: &[u8]) -> Result<Self, ConnectorFault> {
        let envelope = unseal_invocation(bytes, OPERATION)?;
        Ok(Self {
            envelope: bytes.to_vec(),
            key: CommandKey::new(envelope.key).map_err(|_| ConnectorFault::NotPrepared)?,
        })
    }
}

impl std::fmt::Debug for PreparedInvoke {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        formatter.write_str("PreparedInvoke(<redacted>)")
    }
}

impl PreparedAttempt for PreparedInvoke {
    fn as_bytes(&self) -> &[u8] {
        &self.envelope
    }

    fn operation(&self) -> &'static str {
        OPERATION
    }

    fn key(&self) -> &CommandKey {
        &self.key
    }
}

/// The immediate Action invocation over one connected connector.
pub struct ActionInvoke {
    pub(crate) connector: Arc<super::BregConnector>,
}

/// The prepared invocation material shared by the immediate Action and
/// the Proposal start: the original inputs and, when the action carries
/// no condition keys, the client's inert evidence of the exact request.
pub(crate) struct Invocation {
    pub evidence: Option<BRegPreparedAction>,
    pub inputs: Map<String, Value>,
}

/// Prepare the invocation with no I/O. A guarded action's request cannot
/// exist before its conditions, so only the inputs are validated here and
/// the send gathers the conditions.
pub(crate) fn prepare_invocation(
    connector: &super::BregConnector,
    input: &Value,
    key: &CommandKey,
) -> Result<Invocation, ConnectorFault> {
    let inputs: Map<String, Value> = input
        .get("input")
        .and_then(Value::as_object)
        .ok_or(ConnectorFault::InvalidInput)?
        .clone();
    let guarded = !connector
        .action_binding()
        .required_condition_keys()
        .is_empty();
    let evidence = if guarded {
        None
    } else {
        let request = BRegActionInvocationRequest::new(
            connector.action_binding(),
            inputs.clone(),
            None,
        )
        .map_err(|_| ConnectorFault::InvalidInput)?;
        Some(
            connector
                .client()
                .prepare_action(
                    connector.action_binding(),
                    &request,
                    &BRegIdempotencyKey::parse(key.as_str())
                        .map_err(|_| ConnectorFault::InvalidInput)?,
                )
                .map_err(|error| match error {
                    registry_breg_client::BaseRegistryClientError::InvalidRequest { .. } => {
                        ConnectorFault::InvalidInput
                    }
                    _ => fault(&error),
                })?,
        )
    };
    Ok(Invocation { evidence, inputs })
}

/// The condition inputs one action's contract requires, drawn from the
/// invocation inputs.
fn condition_inputs(
    connector: &super::BregConnector,
    inputs: &Map<String, Value>,
) -> Result<Map<String, Value>, ConnectorFault> {
    connector
        .action_binding()
        .required_condition_keys()
        .iter()
        .map(|name| {
            inputs
                .get(name)
                .cloned()
                .map(|value| (name.clone(), value))
        })
        .collect::<Option<Map<String, Value>>>()
        .ok_or(ConnectorFault::InvalidInput)
}

/// Read the current target conditions for one invocation's inputs. One
/// unkeyed exchange the client never resends.
fn acquire_conditions(
    connector: &super::BregConnector,
    inputs: &Map<String, Value>,
) -> Result<BRegActionTargetConditions, ConnectorFault> {
    let request = BRegActionTargetConditionsRequest::new(
        connector.action_binding(),
        condition_inputs(connector, inputs)?,
    )
    .map_err(|_| ConnectorFault::InvalidInput)?;
    connector
        .block(connector.client().action_target_conditions(
            connector.action_binding(),
            &request,
        ))
        .map(|read| read.value)
        .map_err(|error| fault(&error))
}

/// The invocation request one send executes: the saved evidence re-armed
/// when the action carries no conditions, and otherwise the conditions
/// read fresh for the same inputs. A prepared attempt whose action or its
/// revision left the deployment answers
/// [`ConnectorFault::BindingChanged`] and is never sent.
pub(crate) fn invocation_request(
    connector: &super::BregConnector,
    envelope: &InvokeEnvelope,
) -> Result<BRegActionInvocationRequest, ConnectorFault> {
    if envelope.action != connector.action_binding().action_identifier()
        || envelope.action_revision != connector.action_binding().definition_revision()
    {
        return Err(ConnectorFault::BindingChanged);
    }
    let key =
        BRegIdempotencyKey::parse(&envelope.key).map_err(|_| ConnectorFault::NotPrepared)?;
    let Some(evidence) = &envelope.evidence else {
        let conditions = acquire_conditions(connector, &envelope.inputs)?;
        return BRegActionInvocationRequest::new(
            connector.action_binding(),
            envelope.inputs.clone(),
            Some(&conditions),
        )
        .map_err(|_| ConnectorFault::InvalidInput);
    };
    let prepared = BRegPreparedAction::from_slice(
        &serde_json::to_vec(evidence).map_err(|_| ConnectorFault::NotPrepared)?,
    )
    .map_err(|_| ConnectorFault::NotPrepared)?;
    connector
        .client()
        .recover_action(
            connector.action_binding(),
            &prepared,
            &envelope.inputs,
            &key,
        )
        .map_err(|error| fault(&error))
}

/// Seal the invocation material under this module's envelope shape.
pub(crate) fn seal_invocation(
    operation: &'static str,
    key: &CommandKey,
    action: &str,
    action_revision: &str,
    invocation: &Invocation,
) -> Result<Vec<u8>, ConnectorFault> {
    let envelope = InvokeEnvelope {
        version: 1,
        operation: operation.to_owned(),
        key: key.as_str().to_owned(),
        action: action.to_owned(),
        action_revision: action_revision.to_owned(),
        inputs: invocation.inputs.clone(),
        evidence: invocation
            .evidence
            .as_ref()
            .map(|evidence| {
                serde_json::from_slice(evidence.as_bytes())
                    .map_err(|_| ConnectorFault::InvalidInput)
            })
            .transpose()?,
    };
    serde_json::to_vec(&envelope).map_err(|_| ConnectorFault::InvalidInput)
}

/// The invocation request one send executes: the saved evidence re-armed
/// when it carries the action's conditions, and otherwise the conditions
/// read fresh for the same inputs. A prepared attempt whose action left
/// the deployment answers [`ConnectorFault::BindingChanged`] and is never
/// sent.
/// Open this module's envelope shape, refusing foreign or earlier forms.
pub(crate) fn unseal_invocation(
    bytes: &[u8],
    operation: &'static str,
) -> Result<InvokeEnvelope, ConnectorFault> {
    let envelope: InvokeEnvelope =
        serde_json::from_slice(bytes).map_err(|_| ConnectorFault::NotPrepared)?;
    if envelope.version != 1 || envelope.operation != operation {
        return Err(ConnectorFault::NotPrepared);
    }
    Ok(envelope)
}

impl ActionInvoke {
    fn execute(&self, prepared: &PreparedInvoke) -> Result<SendOutcome, ConnectorFault> {
        let envelope = unseal_invocation(&prepared.envelope, OPERATION)?;
        let key =
            BRegIdempotencyKey::parse(&envelope.key).map_err(|_| ConnectorFault::NotPrepared)?;
        // The exact saved attempt first: its conditions ride its own
        // bytes, so recovery never re-reads them.
        let request = invocation_request(&self.connector, &envelope)?;
        let answer = self.connector.block(self.connector.client().invoke_action(
            self.connector.action_binding(),
            &request,
            &key,
        ));
        match answer {
            Ok(receipt) => {
                let application = receipt.value.application_identifier();
                let correlation = match receipt.value.results().values().next() {
                    Some(result) => format!(
                        "{application}/{}/{}",
                        result.record_type_identifier(),
                        result.record_identifier()
                    ),
                    None => application.to_string(),
                };
                Ok(completed(correlation))
            }
            Err(error) => classify(&error),
        }
    }
}

impl Observable for ActionInvoke {
    fn observe(&self, correlation: &str) -> Result<NativeState, ConnectorFault> {
        let mut parts = correlation.splitn(3, '/');
        let application = parts.next().ok_or(ConnectorFault::InvalidInput)?;
        match (parts.next(), parts.next()) {
            (Some(record_type), Some(record_identifier)) => {
                let reads = self.connector.reads();
                let record = reads.get_record(record_identifier)?;
                Ok(NativeState {
                    state: "present".to_owned(),
                    details: vec![
                        ("application".to_owned(), application.to_owned()),
                        ("recordType".to_owned(), record_type.to_owned()),
                        (
                            "revision".to_owned(),
                            record.value.data.revision_identifier.clone(),
                        ),
                    ],
                })
            }
            (None, _) | (Some(_), None) => Ok(NativeState {
                // An immediate Action is complete on its receipt; a bare
                // application identity observes as that terminal state.
                state: "completed".to_owned(),
                details: vec![("application".to_owned(), application.to_owned())],
            }),
        }
    }
}

impl Operation for ActionInvoke {
    type Prepared = PreparedInvoke;

    fn describe(&self) -> &OperationDescriptor {
        &INVOKE
    }

    fn prepare(&self, input: &Value, key: CommandKey) -> Result<PreparedInvoke, ConnectorFault> {
        if self.connector.action_mode() != registry_breg_client::BRegActionMode::Immediate {
            return Err(ConnectorFault::NotEnabled);
        }
        let invocation = prepare_invocation(&self.connector, input, &key)?;
        let envelope = seal_invocation(
            OPERATION,
            &key,
            self.connector.action_binding().action_identifier(),
            self.connector.action_binding().definition_revision(),
            &invocation,
        )?;
        Ok(PreparedInvoke { envelope, key })
    }

    fn send(&self, prepared: &PreparedInvoke) -> Result<SendOutcome, ConnectorFault> {
        self.execute(prepared)
    }

    fn recover(&self, prepared: &PreparedInvoke) -> Result<SendOutcome, ConnectorFault> {
        self.execute(prepared)
    }
}

