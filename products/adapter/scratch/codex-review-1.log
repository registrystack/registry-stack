#!/usr/bin/env bash
set -euo pipefail

: "${CARGO_TARGET_DIR:?Set CARGO_TARGET_DIR to an external worktree Cargo target.}"

repo_root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
cd "$repo_root"

# The verification floor from products/adapter/DELIVERY-PLAN.md: format
# over the workspace, then clippy and tests over the adapter crates. Cargo
# runs in the caller's explicit worktree target, so an omitted target cannot
# fill the source volume before the example generator rejects it. PATH keeps
# cargo reachable when it is not on the caller's PATH.
PATH="$HOME/.cargo/bin:$PATH" cargo fmt --check
PATH="$HOME/.cargo/bin:$PATH" cargo clippy -p registry-adapter -p registry-adapter-core -p registry-adapterctl --all-targets -- -D warnings
PATH="$HOME/.cargo/bin:$PATH" cargo test -p registry-adapter -p registry-adapter-core -p registry-adapterctl --locked

# The generated schemas are held to their generator (CFG-SCHEMA-2), and the
# five adapter formats are held to the configuration-format convention
# (CFG-SCHEMA-1) with the platform lint that CI also runs.
PATH="$HOME/.cargo/bin:$PATH" cargo run --locked -p registry-adapterctl -- schemas --check --output-dir products/adapter/schemas
products/adapter/scripts/generate-effective-contract-example.sh --check
uv run --no-project --with PyYAML==6.0.2 python products/platform/scripts/check-config-conventions.py

# The Camel port table (CONCEPT.md 8.10) is held to the code: every
# delivered row maps to named core tests and every accepted key has a row;
# later-increment rows report pending and never fail.
python3 products/adapter/scripts/check-port-table.py

# The example and corpus checks run the real adapterctl binary. It comes
# from, most explicit first:
#   1. the --bin-dir option,
#   2. the ADAPTERCTL_BIN environment variable, run exactly as named,
#   3. a build under the exported CARGO_TARGET_DIR,
# and the script refuses otherwise. A repo-local target/ directory is
# never used: a stale binary there once checked green against the wrong
# reader, which passed the corpus silently.
bin_dir=''
adapterctl_bin=''
previous=''
for argument in "$@"; do
  case "$argument" in
  --bin-dir=*) bin_dir="${argument#--bin-dir=}" ;;
  *)
    if [[ "$previous" == '--bin-dir' ]]; then
      bin_dir="$argument"
    fi
    ;;
  esac
  previous="$argument"
done

if [[ -n "$bin_dir" ]]; then
  adapterctl_bin="${bin_dir}/adapterctl"
elif [[ -n "${ADAPTERCTL_BIN:-}" ]]; then
  if [[ ! -x "${ADAPTERCTL_BIN}" ]]; then
    printf 'check-contracts: ADAPTERCTL_BIN names no executable: %s\n' "${ADAPTERCTL_BIN}" >&2
    printf 'Set ADAPTERCTL_BIN to the adapterctl binary, pass --bin-dir, or export CARGO_TARGET_DIR.\n' >&2
    exit 2
  fi
  # Run exactly the named binary: reducing it to its directory would
  # silently run a different adapterctl from the same directory. The
  # directory is kept only for the aws-lc-fips artifact lookup below.
  adapterctl_bin="${ADAPTERCTL_BIN}"
  bin_dir="$(cd "$(dirname "${ADAPTERCTL_BIN}")" && pwd -P)"
elif [[ -n "${CARGO_TARGET_DIR:-}" ]]; then
  command -v cargo >/dev/null 2>&1 || {
    printf 'check-contracts: CARGO_TARGET_DIR is set but cargo is not on PATH.\n' >&2
    exit 2
  }
  cargo build --locked -p registry-adapterctl --manifest-path "${repo_root}/Cargo.toml" --target-dir "${CARGO_TARGET_DIR}"
  bin_dir="${CARGO_TARGET_DIR}/debug"
  adapterctl_bin="${bin_dir}/adapterctl"
else
  printf 'check-contracts: no adapterctl binary found.\n' >&2
  printf 'Set ADAPTERCTL_BIN to the adapterctl binary, pass --bin-dir, or export CARGO_TARGET_DIR; the repository target/ directory is never used.\n' >&2
  exit 2
fi

if [[ ! -x "${adapterctl_bin}" ]]; then
  printf 'check-contracts: no adapterctl binary at %s.\n' "${adapterctl_bin}" >&2
  printf 'Set ADAPTERCTL_BIN to the adapterctl binary, pass --bin-dir, or export CARGO_TARGET_DIR.\n' >&2
  exit 2
fi

# A debug build that links aws-lc-fips-sys dynamically on macOS needs its
# library at each adapterctl launch. Keep the directory in the same
# non-DYLD carrier the conformance wrapper uses, and put it on the DYLD
# search for the direct child executions below.
if [[ -z "${REGISTRY_CARGO_RUNTIME_LIBRARY_PATH:-}" ]]; then
  for artifacts in "${bin_dir}"/build/aws-lc-fips-sys-*/out/build/artifacts; do
    if [[ -d "$artifacts" ]]; then
      REGISTRY_CARGO_RUNTIME_LIBRARY_PATH="$(cd "$artifacts" && pwd -P)"
      export REGISTRY_CARGO_RUNTIME_LIBRARY_PATH
      break
    fi
  done
fi
if [[ -n "${REGISTRY_CARGO_RUNTIME_LIBRARY_PATH:-}" ]]; then
  DYLD_FALLBACK_LIBRARY_PATH="${REGISTRY_CARGO_RUNTIME_LIBRARY_PATH}${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
  export DYLD_FALLBACK_LIBRARY_PATH
fi

# The example is held to the exact command the configuration-format
# conformance registers for the adapter formats (products/platform/
# config-formats.yaml, `check:`): the project, its pinned profile and
# pack, and the shared fixture set.
fixture_flags=()
for fixture in products/adapter/fixtures/dhis2-tracker/*.yaml; do
  fixture_flags+=(--fixtures "$fixture")
done
"$adapterctl_bin" check products/adapter/examples/dhis2-tracker/project.yaml \
  --profile products/adapter/profiles/breg-records/profile.yaml \
  --pack products/adapter/packs/dhis2-tracker/pack.yaml \
  "${fixture_flags[@]}" >/dev/null
printf 'Example check passed\n'

# The same contract executes offline through the real route engine and
# exact intercepted transcript. Simulated writes do not claim PostgreSQL
# durability; the database suite establishes that independently.
"$adapterctl_bin" fixtures replay products/adapter/examples/dhis2-tracker/project.yaml \
  --profile products/adapter/profiles/breg-records/profile.yaml \
  --pack products/adapter/packs/dhis2-tracker/pack.yaml \
  "${fixture_flags[@]}" >/dev/null
printf 'Example fixture replay passed\n'

# The govstack example binds the same pack under the GovStack Consultation
# profile. Its fixtures are derived from the dhis2-tracker captures (each
# file says so), and the contract it compiles to is committed beside the
# project, so `compile --check` refuses on drift.
govstack_flags=()
for fixture in products/adapter/fixtures/dhis2-govstack/*.yaml; do
  govstack_flags+=(--fixtures "$fixture")
done
"$adapterctl_bin" check products/adapter/examples/dhis2-govstack/project.yaml \
  --profile products/adapter/profiles/govstack-consultation/profile.yaml \
  --pack products/adapter/packs/dhis2-tracker/pack.yaml \
  "${govstack_flags[@]}" >/dev/null
"$adapterctl_bin" fixtures replay products/adapter/examples/dhis2-govstack/project.yaml \
  --profile products/adapter/profiles/govstack-consultation/profile.yaml \
  --pack products/adapter/packs/dhis2-tracker/pack.yaml \
  "${govstack_flags[@]}" >/dev/null
"$adapterctl_bin" compile --check products/adapter/examples/dhis2-govstack/project.yaml \
  --profile products/adapter/profiles/govstack-consultation/profile.yaml \
  --pack products/adapter/packs/dhis2-tracker/pack.yaml >/dev/null
printf 'GovStack example check, fixture replay and compile passed\n'

# The OpenCRVS birth example is held to the same two commands. Its fixtures
# are hand-derived from the reviewed Evidence reference and marked synthetic
# (each file says so): nothing has run against a real OpenCRVS, so this
# proves the contract shape, not the live upstream.
ocrvs_flags=()
for fixture in products/adapter/fixtures/opencrvs-events/*.yaml; do
  ocrvs_flags+=(--fixtures "$fixture")
done
"$adapterctl_bin" check products/adapter/examples/opencrvs-events/project.yaml \
  --profile products/adapter/profiles/breg-records/profile.yaml \
  --pack products/adapter/packs/opencrvs-events/pack.yaml \
  "${ocrvs_flags[@]}" >/dev/null
printf 'OpenCRVS example check passed\n'
"$adapterctl_bin" fixtures replay products/adapter/examples/opencrvs-events/project.yaml \
  --profile products/adapter/profiles/breg-records/profile.yaml \
  --pack products/adapter/packs/opencrvs-events/pack.yaml \
  "${ocrvs_flags[@]}" >/dev/null
printf 'OpenCRVS example fixture replay passed\n'

# Each committed experiment holds the concrete contract its project compiles
# to (`generated/openapi.json` beside the project) and at least one fixture
# that the actual runtime interpreter replays offline. `compile --check` and
# `fixtures replay` refuse on drift or an unserved transcript, so experiments
# cannot rot behind reader, core, document, or route-engine changes. An
# experiment that carries no `profile.yaml` beside its project binds the
# maintained profile its project pins by id, under
# `products/adapter/profiles/<id>/`, the same profile its documented check
# command names; a project that pins no id, one with no maintained profile,
# or one with no discovered fixture refuses loudly rather than being skipped.
experiments=0
experiment_fixtures=0
for project in products/adapter/experiments/*/project.yaml; do
  directory="${project%/*}"
  if [[ -f "${directory}/profile.yaml" ]]; then
    profile="${directory}/profile.yaml"
  else
    profile_id="$(awk '/^profile:$/ { pinned = 1; next } pinned && /^  id:/ { sub(/^  id:[[:space:]]*/, ""); print; exit } pinned && /^[^ ]/ { exit }' "${project}")"
    if [[ -z "${profile_id}" ]]; then
      printf 'check-contracts: %s pins no profile id.\n' "${project}" >&2
      exit 2
    fi
    profile="products/adapter/profiles/${profile_id}/profile.yaml"
  fi
  fixture_paths=("${directory}"/fixtures/*.yaml)
  if [[ ! -f "${fixture_paths[0]}" ]]; then
    printf 'check-contracts: %s has no fixture under %s/fixtures/.\n' "${project}" "${directory}" >&2
    exit 2
  fi
  experiment_fixture_flags=()
  for fixture in "${fixture_paths[@]}"; do
    experiment_fixture_flags+=(--fixtures "${fixture}")
    experiment_fixtures=$((experiment_fixtures + 1))
  done
  "$adapterctl_bin" compile --check "$project" --profile "$profile" >/dev/null
  "$adapterctl_bin" fixtures replay "$project" \
    --profile "$profile" \
    "${experiment_fixture_flags[@]}" >/dev/null
  experiments=$((experiments + 1))
done
printf 'Experiment contracts and fixture replays hold (%d experiments, %d fixtures)\n' \
  "$experiments" "$experiment_fixtures"

# The bad-authoring corpus: every discovered bad/ member refuses with its
# own code (plus, transitionally, a co-fired partner code that is another
# member's expectation; see the runner and the corpus README), and the
# base/ control passes with zero findings. The runner self-tests its
# decision logic before it spends an adapterctl run.
python3 products/adapter/scripts/check-corpus.py "$adapterctl_bin"

printf 'Adapter product contracts passed\n'
// SPDX-License-Identifier: Apache-2.0

//! The job compiler and page entry
//! (`products/adapter/CONCEPT.md` sections 17.1 and 17.2): one http
//! send shaped by a pack script into the item contract, the cursor
//! round trip through the read-only `AdapterJobCursor` property, the
//! page faults, and the profile's page deadline.

use std::time::{Duration, Instant};

use registry_adapter::job::{compile_job, run_job_page, ADAPTER_JOB_CURSOR_PROPERTY};
use registry_platform_config::sha256_uri;
use serde_json::{json, Value};

#[path = "support/upstream/mod.rs"]
#[allow(dead_code)]
mod upstream;

const PAGE_SCRIPT: &str = r#"// The fetched submissions page, shaped as the item
// contract (CONCEPT 17.2): one item per reply entry, the route's own
// next cursor carried through under the engine's property rules.
fn page(exchange) {
    let entries = exchange.body.data;
    if entries == () {
        throw "the reply carries no data array";
    }
    let items = [];
    for entry in entries {
        if entry.id == () {
            throw "a reply entry carries no id";
        }
        items.push(#{key: "submissions/" + entry.id, value: entry});
    }
    #{items: items, next: exchange.properties.jobNext}
}
"#;

/// The malformed variant: every item it emits carries an empty key, so
/// the entry refuses the page under `adapter.job.page-key`.
const EMPTY_KEY_SCRIPT: &str = r#"// The fetched submissions page, every item
// keyed by the empty string.
fn page(exchange) {
    let items = [];
    for entry in exchange.body.data {
        items.push(#{key: "", value: entry});
    }
    #{items: items, next: exchange.properties.jobNext}
}
"#;

/// The profile of the fixture job: a page deadline of one minute unless
/// the lane tightens it.
fn profile_json(page_deadline_milliseconds: u64) -> String {
    format!(
        r#""profile": {{
            "pageDeadlineMilliseconds": {page_deadline_milliseconds},
            "maximumResponseBytes": 16777216,
            "maximumPageItems": 100,
            "maximumPageBytes": 1048576,
            "read": {{
                "maximumFileBytes": 1073741824,
                "maximumRowBytes": 1048576,
                "maximumFieldBytes": 65536,
                "maximumRowsPerPage": 100
            }}
        }}"#
    )
}

/// The pack of the fixture job: one http endpoint over the double and
/// one source route that sends, then shapes the reply through the
/// script the pack pins.
fn pack_yaml(script: &str, script_path: &str) -> String {
    let digest = sha256_uri(script.as_bytes());
    format!(
        r#"apiVersion: id.registrystack.org/formats/adapter/pack/v1alpha1
kind: AdapterPack
id: case-api-pack
version: "1"
testedVersions: []
endpoints:
  - id: submissions
    component: http
    authentication:
      type: none
    attemptTimeoutMilliseconds: 10000
    maximumResponseBytes: 65536
sourceRoutes:
  - id: submissions-page
    scan: finite
    nextRecovery: exact-replay
    steps:
      - to:
          uri: http:submissions
          parameters:
            httpMethod: GET
            path: /v1/submissions
            query:
              cursor:
                exchangeProperty: AdapterJobCursor
      - setProperty:
          name: jobNext
          value:
            jsonpath: $.nextCursor
      - setBody:
          rhai:
            file: {script_path}
            entrypoint: page
scripts:
  - path: {script_path}
    digest: {digest}
capabilities: {{}}
"#
    )
}

/// The profile beside the pack: the same facade surface the workspace
/// checks run over, with no operation the job would serve.
const PROFILE_YAML: &str = r#"apiVersion: id.registrystack.org/formats/adapter/profile/v1alpha1
kind: AdapterProfile
id: case-api
version: "1"
operations:
  - id: cases-get
    method: GET
    path: /v2/cases/{type}/{case_id}
    pathParameters:
      - type
      - case_id
    recordTypeParameter: type
    recordIdParameter: case_id
    responseEnvelope: '{"case": {{record}}, "fetchedAt": "{{requestId}}"}'
problems:
  - code: cases.upstream
    status: 502
    title: the source could not be reached
    classes: [upstream, breaker.open, throttle.rejected, loop.maximum-iterations-reached]
  - code: cases.mapping
    status: 422
    title: the request or its mapping was refused
    classes: [validation, conversion.unmapped, aggregation.duplicate]
  - code: cases.exhausted
    status: 502
    title: the run exhausted a budget
    classes: [script, budget.exhausted]
  - code: cases.boundary
    status: 500
    title: the facade refused the call
    classes: [disclosure.violation, egress.refused, credential.rejected, outcome, facade]
problemEnvelope: '{"family": "{{problemCode}}"}'
"#;

fn project_yaml(profile_digest: &str, pack_digest: &str, bind_source_route: bool) -> String {
    let binding = if bind_source_route {
        r#"bindings:
  - id: case-get
    operation: cases-get
    recordType: case
    route: submissions-page
    maximumUpstreamCalls: 4
"#
    } else {
        "bindings: []\n"
    };
    format!(
        r#"apiVersion: id.registrystack.org/formats/adapter/project/v1alpha1
kind: AdapterProject
project:
  id: case-api-example
  version: "1"
profile:
  id: case-api
  version: "1"
  digest: {profile_digest}
pack:
  id: case-api-pack
  version: "1"
  digest: {pack_digest}
recordTypes:
  - name: case
    fields:
      - name: case_type
        type: string
        required: true
{binding}"#
    )
}

fn job_yaml(pack_digest: &str, page_deadline_milliseconds: u64) -> String {
    format!(
        r#"apiVersion: id.registrystack.org/formats/adapter/job/v1alpha1
kind: AdapterJob
job:
  id: case-daily
  version: "1"
source:
  pack:
    id: case-api-pack
    version: "1"
    digest: {pack_digest}
  route: submissions-page
{}"#,
        profile_json(page_deadline_milliseconds)
    )
}

fn runtime_yaml(base_url: &str) -> String {
    let config = json!({
        "apiVersion": "id.registrystack.org/formats/adapter/runtime/v1alpha1",
        "kind": "AdapterRuntimeConfig",
        "id": "job-deployment",
        "endpoints": [
            {
                "endpoint": "submissions",
                "baseUrl": base_url,
                "credential": {"type": "none"}
            }
        ],
        "allowedPrivateCidrs": ["192.168.0.0/16"],
        "listener": {"bind": "127.0.0.1:8080"},
        "database": {
            "runtimeUrlRef": "secret:env/JOB_TEST_DB",
            "migrationUrlRef": "secret:env/JOB_TEST_DB"
        },
        "oidc": {
            "issuer": "https://issuer.example.invalid",
            "audience": "job-test"
        },
        "allowedClients": ["job-client"],
        "audit": {"retentionDays": 90}
    });
    serde_json::to_string_pretty(&config).expect("the runtime config renders")
}

/// One fixture workspace: the profile and project beside the pack, the
/// job, and the operator runtime config, over the loopback double.
struct Fixture {
    _directory: tempfile::TempDir,
    pack: std::path::PathBuf,
    job: std::path::PathBuf,
# Registry Stack configuration conventions

These rules apply to every configuration format Registry Stack defines: the
files adopters author, the runtime files operators deploy, and the files our
tools generate for a person or another tool to read. A person who has learned
one product's files should be able to predict how every other product's files
look, how they are read, and how a mistake is reported.

The rules are normative. **MUST** rules are enforced by the gate the
[Enforcement summary](#enforcement-summary) gives them. A mechanical gate fails
CI when a change breaks its rule; where the gate is review, the reviewer cites
the rule ID. **SHOULD** rules are reviewed by people; a deviation needs a
reason in the pull request. A rule whose reason is not evident states it, so
a reviewer can tell a real exception from a habit.

Product guides decide what a format means. These conventions decide how it is
written and read. When a product guide and this page disagree on spelling,
parsing, or diagnostics, this page wins; fix the guide.

## Scope

In scope:

- **Authored files** describe what a registry, service, or package is:
  `registry.yaml`, `module.yaml`, `casework.yaml`, `scheduling.yaml`,
  `messaging.yaml`, Render bundles, Discovery origins and mappings, Evidence
  bundles and authoring files, fixtures, journeys, and the files beside them.
  They are reviewed in version control, are deterministic, and never hold an
  environment value or a secret. A value that differs per environment (an
  issuer, an endpoint) is named in the authored file by a local identifier and
  bound in an operator file.
- **Operator files** describe where and how a deployment runs: every
  `runtime.yaml`, development client files, and operator request files.
- **Generated files** are of two kinds. A **read-back format** is one a
  Registry Stack tool reads again (module locks, package manifests, receipts,
  checkpoints, development state); it follows every rule except CFG-SCHEMA-2
  and CFG-SCHEMA-6, which cover the files people edit. An **output format**
  is written for people or for tools we do not own and is never read back
  (explain output, `--format json` reports); it is registered with
  `reader: none`, follows CFG-ENV, CFG-NAME, CFG-ID, CFG-QTY, and CFG-EMPTY,
  and is exempt from CFG-YAML-1, CFG-CHECK-1, CFG-SCHEMA-2, and CFG-SCHEMA-6.
  A **build artifact** is a read-back format that its own product's build
  writes and reads again and that no one edits (the compiled package model in
  BReg's `package.json`). It is registered with `audience: generated` and
  `buildArtifact: true`; the registry entry is held to the code like any
  other, and no rule of this convention applies to the format.
- Authored and operator **JSON** documents (scenarios, migration descriptors,
  backup bindings) follow every rule that is not YAML-specific, including the
  envelope. A JSON document that is a request or response body of a product
  API (`examples/inputs/*.json`, operator request files) is a payload: the API
  contract governs it, not these conventions. Authored JSON is parsed strictly
  (CFG-YAML-2) and never required to be canonical bytes; a tool that digests it
  canonicalizes it first.

Out of scope, recorded as exception classes in
[Exceptions](#exceptions):

- formats another project owns (OpenAPI, JSON Schema, LinkML, ThunderID
  resources, `SHA256SUMS`, GitHub workflows, release tooling);
- exchange data models whose member names a published specification fixes
  (Registry Manifest metadata documents) and record data (JSONL imports);
- HTTP problem codes, which belong to each product's API contract.

Also out of scope:

- repository tooling metadata read only by repository scripts
  (`config-formats.yaml`, the exceptions register, release manifests), which
  those scripts' tests govern.

## Concepts

| Term | Meaning |
|---|---|
| Format | One document shape with one `apiVersion` and `kind`, owned by one product. |
| Envelope | The `apiVersion` and `kind` pair every document carries. |
| Local identifier | A name an author chooses in our files for something our files define (an entity, a profile, a template, a destination). |
| External identifier | A name defined elsewhere that our files quote (an OIDC client id, a claim name, a scope, a URN). |
| Reference | A member whose value names an item defined elsewhere in the same file or another file. |
| Sentinel | A reserved string written in place of a list or value to state an open choice explicitly, such as `unrestricted`. |
| Diagnostic | One reported problem: severity, code, location, message, and the fix. |
| Stability | `promised`: covered by API stability; `experimental`: shipped, may change in a minor release with a `BREAKING:` note; `unpromised`: no promise (fixtures, journeys, development clients, ctl data files, authoring files). |
| Format registry | `products/platform/config-formats.yaml`, the machine-readable list of every format, its schema, its reader, and its check command. |
| Exceptions register | `products/platform/config-conventions-exceptions.yaml`, every recorded deviation with its class and resolution. |

## 1. Files and envelopes

**CFG-ENV-1 (MUST). Every document carries `apiVersion` and `kind`.** Both
are plain strings at the top level, in any position, and the reader checks
them before it decodes any other member. Neither may come from `${...}`
substitution. A document missing either is refused at its root node, with
the empty path (`config.missing-envelope`); a document of another format, or
at a version the reader does not read, is refused with a message that names
the expected `apiVersion` and `kind`. When both are wrong, `kind` is reported
(`config.wrong-kind`). The `apiVersion` is reported beside it only when it is
a version the reader lists as retired (`config.retired-api-version`), so the
author learns of both in one run; any other wrong `apiVersion` is not
reported until `kind` is right.
*Why:* a reader can refuse the wrong file with a precise message ("this is a
`CaseworkFixture`, `casework check` reads a `CaseworkProject`"), editors can
pick a schema, and a format can be versioned on its own.
*Enforced by:* the shared reader's envelope check; the format registry lint
(each schema file describes one `apiVersion` and declares both members as
`const`; a format read at several versions has one schema per version,
CFG-SCHEMA-3).

**CFG-ENV-2 (MUST). `apiVersion` is
`id.registrystack.org/formats/<product>/<format>/<version>`.** `<product>` is
the product token (CFG-ENV-3). `kind` matches
`^(BReg|Casework|Coordinator|Documents|Scheduling|Messaging|Discovery|Render|Evidence|Manifest|Adapter|Platform)([A-Z][a-z0-9]+)+$`,
with acronyms written as words (`Mcp`, `Oid4vci`). `<format>` derives from
`kind`: remove the product prefix; remove a trailing `Config`; split the rest
before each uppercase letter; lowercase each word and join with `-`. The
result is non-empty and unique within the product. `<version>` matches
`^v[1-9][0-9]*((alpha|beta)[1-9][0-9]*)?$`.

| `kind` | `apiVersion` (before its version) |
|---|---|
| `CaseworkProject` | `id.registrystack.org/formats/casework/project/` |
| `BRegProject` | `id.registrystack.org/formats/breg/project/` |
| `BRegRuntimeConfig` | `id.registrystack.org/formats/breg/runtime/` |
| `BRegDataImportCheckpoint` | `id.registrystack.org/formats/breg/data-import-checkpoint/` |
| `CaseworkFixture` | `id.registrystack.org/formats/casework/fixture/` |
| `AdapterProfile` | `id.registrystack.org/formats/adapter/profile/` |
| `AdapterRuntimeConfig` | `id.registrystack.org/formats/adapter/runtime/` |

The `apiVersion` is a name, not a URL: readers compare it literally and never
fetch it. The identifier catalog may document it at the same path under
`https://`.
*Why:* `id.registrystack.org` is the one namespace for every identifier the
stack mints, and its catalog already promises that an identifier is never
# Adapter Delivery Plan

Status: active. Revised 2026-10-30 for the Camel port (`CONCEPT.md` D7 to
D15) and again that day for the exchange contract (`CONCEPT.md` 8.11, D20
to D28), which the first API transformation experiments showed the
Increment 1 runtime could not be designed without. Revised 2026-10-31 for
current engine semantics and lead-owned orchestration. Companion to
`CONCEPT.md`: the concept is the product contract; this
file decomposes its section 14 into parallel workstreams with definitions of
done and runnable acceptance commands. On any conflict, `CONCEPT.md` wins.

The scope is the full port table in `CONCEPT.md` section 8.10, every row,
whether or not a maintained pack uses it today (Jeremi's ruling: the engine
is a reusable integration piece). No stream shrinks a row to what a pack
needs; a row that cannot land says so in its report.

## Rules every agent works under

Every brief carries these rules by reference; they are not optional.

1. The current lead owns integration and may delegate bounded work to its
   own agents only. Each brief assigns disjoint paths; delegated agents do
   not spawn agents, and parallel agents never edit the same file.
2. Worktree: `/Users/jeremi/orca/workspaces/registry-stack/live-adapter`.
    Absolute paths only; never `cd`. First command: verify
    `git -C /Users/jeremi/orca/workspaces/registry-stack/live-adapter
    --no-optional-locks rev-parse HEAD` equals the SHA in your brief; if it
    differs, stop and report.
3. Never push, merge, rebase, tag, reset, stash, `checkout --`, or clean.
    Commit with plain `git commit -m ...`: this machine's commit-msg hook
    appends the DCO `Signed-off-by` trailer automatically. Never type that
    trailer yourself, never add agent attribution trailers, and never set
    author or committer to an agent. After your first commit, run
    `git --no-optional-locks log -1 --format=%B | rg 'Signed-off-by'` and
    confirm exactly one such line; if there is none, amend with
    `git commit --amend --no-edit -s`. Conventional subjects, imperative
    mood: `feat(adapter):`, `test(adapter):`, `chore(adapter):`, or the
    owning area's prefix (`feat(platform):` for `products/platform`).
4. Delete nothing outside `products/adapter/scratch/<your-stream>/`. Treat
    modified and untracked files you did not create as another session's
    work; never revert or reformat them.
5. Cargo always runs as:
   `CARGO_TARGET_DIR=<target-dir> PATH="$HOME/.cargo/bin:$PATH" cargo ...`
   Never clean a target directory another agent builds in. Concurrent
   cargo runs serialize on the target lock; wait, never kill.
6. Shared files (root `Cargo.toml`, `Cargo.lock` dependency additions,
   `deny.toml`, `rust-toolchain.toml`, root `AGENTS.md`, `.github/**`, and
   each crate's `lib.rs` module list) change only in a wave's scaffold step
   or by the integration stream at a wave boundary. If your stream needs a
   change there mid-wave, stop and report it instead of editing.
7. TDD: write the failing test first; write only enough code to pass;
   refactor while green. Test output must be clean; expected errors are
   captured and asserted on, never printed past.
8. Verification floor, reported verbatim with failures included:
   `cargo fmt --check`; `cargo clippy -p <owned crates> --all-targets --
   -D warnings`; `cargo test -p <owned crates> --locked`.
9. Report what landed and what did not. No stubs of promised behavior; if
   scope must shrink, the report says so, not the silence.
10. Never log secrets or environment dumps. All adapter diagnostics are
    value-free (`adapter.*` codes, CFG-SEC-3).
11. Port, do not invent. Before writing a port-table row, open its Camel
    page (and the resilience4j page for the breaker), and write the
    conformance cases from what the page says: option names, defaults,
    exchange properties, matching and ordering rules. Each case's doc
    comment cites the page URL. If the page contradicts `CONCEPT.md`, the
    report says so and the stream follows the page for semantics and
    `CONCEPT.md` for spelling and divergences; the integration stream
    corrects the concept. Never write a default from memory.
    The pinned reference (`CONCEPT.md` 5.4) is a read-only shallow clone of
    tag `camel-4.23.0` at
    `/Volumes/CodexWorktrees/agent-scratch/camel-src/camel-4.23.0`; never
    edit, build, or commit from it, and never copy it into the repository.
    Where the page is silent, ambiguous, or gone, read the implementing
    Java there and cite it (`camel-4.23.0:<path>`). Rows where this is
    mandatory, because the semantics live in code: error handler and
    redelivery (`RedeliveryErrorHandler`, `RedeliveryPolicy`), exception
    clauses (`DefaultExceptionPolicyStrategy`), try/catch/finally, circuit
    breaker, throttle, split, loop, enrich, aggregation strategies,
    `direct` (`DirectProducer`), `http` failure handling
    (`HttpOperationFailedException`), the header filter
    (`HttpHeaderFilterStrategy`), mock and intercept (`MockEndpoint`,
    `InterceptSendToEndpointDefinition`), and the idempotent consumer.
    For each such row, the stream lists the Camel unit tests under the
    clone that exercise it and ports each one as a conformance case, or
    records why it does not apply (outside the port's boundaries, or a
    recorded divergence). Read the Java for behavior and write idiomatic
    Rust; never translate it line by line.

## Wave model and review protocol

Waves run sequentially. The current lead may run a bounded set of streams in
parallel only on disjoint paths, and reviews every hand-back before
integration. Each increment opens with a serial scaffold step (module roots
and dependency additions), so parallel streams never touch a shared file.
The lead captures the HEAD SHA at wave launch, carries it in every brief,
closes the integration stream, runs the acceptance commands, records open
findings, and makes the go or stop decision for the next wave.

At every increment the lead assigns an independent staff-engineer review of
the integrated diff against `CONCEPT.md` to a fresh agent that owns no
concurrent edit path: is it still a faithful Camel port, is the architecture
holding up for the next increment, and what should change in the plan. The
lead resolves that feedback before the next increment and records the report
as `products/adapter/reviews/increment-<n>-staff.md`. Blockers and any
`CONCEPT.md` contradiction go directly to the lead as they happen; Jeremi's
fresh decisions remain authoritative.

## API transformation experiments (before Increment 1, after it, after 3)

The first run happened on the Increment 0 model, before any runtime: five
experiments (FHIR R4 search and conditional create, GraphQL cursor paging,
REST offset paging over mTLS with `private_key_jwt`, and a FHIR-shaped
second target profile) all passed `check` and still could not have run.
Their eight P0 gaps became `CONCEPT.md` 8.11; their check defects became
Increment 0's closing round; their P1 gaps are assigned to Increment 1
streams below. `products/adapter/experiments/FINDINGS.md` holds the record.
The experiments are rerun after Increment 1, migrated to 8.11, and after
Increment 3.

Owned by the lead, under `products/adapter/experiments/**`, no
`.rs` file. Each experiment is a pack, a profile, a project, and
`documented` fixtures served over the upstream double, chosen to stress the
engine on API shapes the two maintained packs do not cover:

- Sources: cursor pagination, offset and page-number pagination, a nested
  resource needing `enrich` per item, code lists needing conversion,
  partial failures inside a `split`, a source that returns 200 with an error
  body, a FHIR R4 source (Bundle paging over `link[relation=next]`,
  conditional create as `idempotentUpstream`), a GraphQL source (after
  Increment 3).
- Targets: `breg-records` v1, the 13.6 test profile, a POST-search profile
  with a query body, a FHIR R4 profile (searchset Bundle with links and
  totals, `OperationOutcome` problems).
- Upstream authentication: across the set, every kind of `CONCEPT.md` 10.2
  at least once (`static-api-key`, both OAuth2 kinds, mTLS with `none`),
  so the maintained packs and the experiments together cover all six.

Each experiment records what it needed: when one cannot be expressed
without Rust, or only awkwardly, the finding is a port-table gap or a
divergence to revisit, fed back into the plan. Results summarize in
`products/adapter/experiments/FINDINGS.md`. Candidate components beyond the
port table, ranked, are in `products/adapter/COMPONENT-CANDIDATES.md`; an
experiment that forces one of them records it there.

## Takeover

When Increment 3 closes (or the program stops earlier), the lead runs every
acceptance command and the final multi-expert review, fixes the remaining
findings directly, and writes the report to Jeremi.

