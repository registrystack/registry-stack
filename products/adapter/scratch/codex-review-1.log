# yaml-language-server: $schema=https://id.registrystack.org/schemas/adapter/job/job.v1alpha1.schema.json
#
# The odk-central example job: the odk-central pack's odk-submissions
# source route, bounded by this profile. One page per run, 100
# submissions at most, the endpoint's 1 MiB response bound as the
# profile's response and page bound. The read bounds carry the job
# profile's documented members at their widest values; no pollEnrich
# read is in this route.
#
# The pack pin is exact (CFG-ID-4): id, version, and the sha256 of the
# pack document (products/adapter/packs/odk-central/pack.yaml). If the
# pack changes, repin the digest.
#
# The repeat-table sketch has its own source route, `odk-repeats`: a
# deployment that reads a repeat set copies this job, names that route,
# and binds the endpoint base URL to the repeat entity set. Its key
# composition is the pack README's probe question 4; treat that route
# as unproved.
#
# What can check this today: nothing. `adapterctl job check` lands in
# the parallel engine stream; until then this artifact is a reviewed
# document. The files that check should read: this job.yaml, the
# pack (pack.yaml with its scripts/), and the runtime config beside
# this file.
apiVersion: id.registrystack.org/formats/adapter/job/v1alpha1
kind: AdapterJob
job:
  id: odk-central-submissions-example
  version: "1"
source:
  pack:
    id: odk-central
    version: "1"
    digest: sha256:2a0c9d0d0d154aeeb7a6f1d8052185ae6e495b23bc07b324105f35a3eb0e870d
  route: odk-submissions
profile:
  # One route run: one send, one redelivery at most, well inside the
  # page deadline.
  pageDeadlineMilliseconds: 300000
  # The endpoint declares 1048576; the profile is never tighter than a
  # bound of an endpoint the source route reaches.
  maximumResponseBytes: 1048576
  # The pack's fixed page size.
  maximumPageItems: 100
  maximumPageBytes: 1048576
  read:
    maximumFileBytes: 1073741824
    maximumRowBytes: 1048576
    maximumFieldBytes: 65536
    maximumRowsPerPage: 100
# yaml-language-server: $schema=https://id.registrystack.org/schemas/adapter/runtime/runtime.v1alpha1.schema.json
#
# The odk-central example deployment's runtime configuration, in the
# example form: every secret is a reference into the operator's
# provider, never a value.
#
# The deployment-owned scoping lives in the base URL: the endpoint
# binding pins the origin plus the base path, and the pack's sends stay
# under it (CONCEPT 8.11.5). Bind `odk-odata` to the entity-set URL of
# the deployment's own form - origin, /v1/projects/<project
# id>/forms/<form id>.svc/Submissions (or the repeat entity set for the
# odk-repeats sketch), no trailing slash; the pack's `path: /` lands on
# the entity set. The project id and form id below are obviously
# synthetic stand-ins.
#
# The remaining blocks (listener, database, OIDC, audit) are the
# facade runtime's required members, which today's AdapterRuntimeConfig
# reader carries; a job deployment reads the endpoint bindings and the
# credential of this file. Copy the file, fill in the environment's
# references, and keep the facade blocks at their loopback and
# placeholder values until the job runner's own runtime profile lands.
apiVersion: id.registrystack.org/formats/adapter/runtime/v1alpha1
kind: AdapterRuntimeConfig
id: odk-central-job-example
endpoints:
  - endpoint: odk-odata
    baseUrl: https://central.example.invalid/v1/projects/1/forms/fixture-form.svc/Submissions
    tlsTrustProfile: odk-private-ca
    credential:
      type: basic
      usernameRef: secret:env/ODK_EMAIL
      passwordRef: secret:env/ODK_PASSWORD
outboundTls:
  trustProfiles:
    odk-private-ca:
      # The absolute path of the bundle file on the deployment's own
      # host; a CA bundle is not a secret, so the profile names a file.
      caBundleFile: /etc/registry-adapter/trust/odk-private-ca.pem
listener:
  bind: 127.0.0.1:8080
database:
  runtimeUrlRef: secret:env/ADAPTER_DB_RUNTIME
  migrationUrlRef: secret:env/ADAPTER_DB_MIGRATION
oidc:
  issuer: https://issuer.example.invalid
  audience: registry-adapter-example
allowedClients:
  - registry-adapter-example-client
allowedPrivateCidrs:
  # The private ranges this deployment may call upstream. The example
  # range stands in for the deployment's own; private endpoints stay
  # refused unless their range is listed here.
  - 10.0.0.0/8
audit:
  retentionDays: 90
