+    let mut facade_endpoints: HashSet<&str> = HashSet::new();
+    for (_, steps, prefix) in &ordered {
+        let reachable = facade.contains(steps);
+        walk_steps(steps, &mut |step, path| {
+            let pointer = format!("{prefix}/steps{path}");
+            match step {
+                Step::To(to) => {
