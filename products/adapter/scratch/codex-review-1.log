pub(crate) fn read<T: DeserializeOwned>(
    path: &Path,
    format: &FormatSpec<'static>,
) -> Result<(T, Vec<u8>), LoadError> {
    let shown = path.display().to_string();
    let bytes = std::fs::read(path).map_err(|_| LoadError::Unreadable {
        path: shown.clone(),
    })?;
    let mut hook = AuthoredExpressions;
    let decoded = Reader::new(shown.clone())
        .with_hook(&mut hook)
        .decode::<T>(&bytes, &Expect::one(format))
        .map_err(|refused| LoadError::Refused {
            path: shown,
            reasons: refused
                .into_diagnostics()
                .iter()
                .map(|diagnostic| format!("{} {}", diagnostic.code, diagnostic.message))
                .collect::<Vec<_>>()
                .join("; "),
        })?;
    Ok((decoded.value, bytes))
}

/// Resolve every secret reference of an endpoint's static credential, so
/// a reference that names no secret refuses startup and not the first send.
/// The resolved values are dropped unread; the sender resolves them again
/// per send.
fn resolve_static_credential(
    endpoint: &str,
    plan: &AuthPlan,
    resolver: &SecretResolver,
) -> Result<(), LoadError> {
    let references: Vec<&str> = match plan.static_credential() {
        Some(StaticCredential::Basic {
            username_ref,
            password_ref,
        }) => vec![username_ref.as_str(), password_ref.as_str()],
        Some(StaticCredential::Authorization { token_ref, .. }) => vec![token_ref.as_str()],
        Some(StaticCredential::ApiKey { value_ref, .. }) => vec![value_ref.as_str()],
        None => Vec::new(),

impl UnservedReason {
    const fn code(self) -> &'static str {
        match self {
            Self::ProfileOperationMissing => "adapter.operation.profile-operation-missing",
            Self::ReservedFacadePath => "adapter.operation.reserved-facade-path",
            Self::MethodUnsupported => "adapter.operation.method-unsupported",
            Self::WriteAsyncUnsupported => "adapter.operation.write-async-unsupported",
            Self::RequestBodyUnsupported => "adapter.operation.request-body-unsupported",
            Self::RequestEnvelopeMissing => "adapter.operation.request-envelope-missing",
            Self::PaginationDeclarationMissing => {
                "adapter.operation.pagination-declaration-missing"
            }
            Self::RecordTypeMissing => "adapter.operation.record-type-missing",
            Self::FilterFieldMissing => "adapter.operation.filter-field-missing",
            Self::RouteInstantiationRefused => "adapter.operation.route-instantiation-refused",
            Self::RouteMissing => "adapter.operation.route-missing",
            Self::CursorKeyMissing => "adapter.operation.cursor-key-missing",
            Self::RouteUnsupported => "adapter.operation.route-unsupported",
            Self::WriteIdempotencyMissing => "adapter.operation.write-idempotency-missing",
            Self::DirectRouteMissing => "adapter.operation.direct-route-missing",
            Self::SourceAuthenticationUnsupported => {
                "adapter.operation.source-authentication-unsupported"
            }
            Self::SourceComponentMismatch => "adapter.operation.source-component-mismatch",
            Self::SourceUnbound => "adapter.operation.source-unbound",
            Self::RecordSchemaUnavailable => "adapter.operation.record-schema-unavailable",
            Self::JobComponentSend => registry_adapter_core::JobCode::SendComponentRefused.code(),
        }
    }
}

fn not_served(reason: UnservedReason, detail: impl Into<String>) -> BindingRefusal {
    BindingRefusal::NotServed {
        reason,
        detail: detail.into(),
    }
}

#[derive(Debug, Error)]
pub enum LoadError {
    #[error("{path} could not be read")]
    Unreadable { path: String },
    #[error("no {file} beside the project in {directory}; pass {flag} FILE")]
    Absent {
        file: &'static str,
        directory: String,
        flag: &'static str,
    },
    #[error("{path} was refused: {reasons}")]
    Refused { path: String, reasons: String },
    #[error("the workspace check refused the deployment: {0}")]
    Workspace(String),
    #[error("{0}")]
    Runtime(String),
}

/// One facade operation this runtime answers.
pub struct ServedOperation {
    pub operation: String,
    pub method: registry_adapter_core::HttpMethod,
    pub method_path: String,
    /// The compiled request envelope of a read over POST.
    pub request_template: Option<ReadRequestTemplate>,
    /// The largest request body, in bytes, this operation reads.
    pub request_maximum_bytes: usize,
    /// The filters the binding declares, each with its record field's type.
    pub filters: Vec<ServedFilter>,
    pub record_type_parameter: String,
    pub record_id_parameter: Option<String>,
    pub binding: String,
#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Explicit native BReg connector journey acceptance.

Run: python3 products/adapter/scripts/test-connector-native.py --env FILE
The env file supplies ADAPTER_TEST_DATABASE_URL, an owned disposable local
PostgreSQL database. This runner builds the BReg product binaries, sets the
connector test's environment, and runs crates/registry-adapter-connectors'
ignored native tests. It creates and removes only unique fixture databases,
roles and schemas.
"""
import argparse
import importlib.util
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile
from urllib.parse import urlsplit

REPO = Path(__file__).resolve().parents[3]


def native_fixture():
    # Reuse the coordinator runner's shared build helpers (a private build
    # directory, rendered diagnostics, and the exact FIPS library path on
    # macOS) without provisioning its unrelated composition. Its module
    # imports its own sibling fixtures, so their directory joins sys.path.
    sys.path.insert(0, str(REPO / "products/coordinator/scripts"))
    spec = importlib.util.spec_from_file_location(
        "coordinator_native_services", REPO / "products/coordinator/scripts/test-real-services.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def run(env_file):
    environment = dict(os.environ)
    if env_file:
        # Read only named prerequisites, never execute the file or dump it.
        for line in env_file.read_text().splitlines():
            fields = shlex.split(line, comments=True)
            if fields and fields[0] == "export":
                fields = fields[1:]
            for field in fields:
                key, separator, value = field.partition("=")
                if separator and key in {"ADAPTER_TEST_DATABASE_URL", "AWS_LC_FIPS_SYS_CMAKE_BUILDER"}:
                    environment[key] = value
    if not environment.get("ADAPTER_TEST_DATABASE_URL"):
        raise SystemExit("ADAPTER_TEST_DATABASE_URL must name an owned disposable local PostgreSQL database")
    database = urlsplit(environment["ADAPTER_TEST_DATABASE_URL"])
    if database.scheme not in {"postgres", "postgresql"} or database.hostname not in {"127.0.0.1", "localhost", "::1"}:
        raise SystemExit("native acceptance requires a loopback PostgreSQL URL")
    environment.update(CARGO_INCREMENTAL="0", CARGO_PROFILE_DEV_DEBUG="0", CARGO_PROFILE_TEST_DEBUG="0")
    target = json.loads(subprocess.check_output(
        ["cargo", "metadata", "--locked", "--no-deps", "--format-version", "1"], cwd=REPO, env=environment))["target_directory"]
    with tempfile.TemporaryDirectory(prefix="adapter-breg-connector-build-") as root:
        log_path = Path(root) / "build.jsonl"
        module = native_fixture()
        command = ["cargo", "build", "--locked", "-p", "registry-breg", "-p", "registry-bregctl",
            "--features", "registry-breg/runtime,registry-breg/postgres-test",
            "--bin", "breg", "--bin", "bregctl",
            "--message-format", "json-render-diagnostics"]
        messages = module.cargo_build(command, log_path, environment)
        if sys.platform == "darwin":
            environment["DYLD_FALLBACK_LIBRARY_PATH"] = str(module.exact_fips_library(messages).parent)
        environment["ADAPTER_BREG_BIN"] = str(Path(target) / "debug/breg")
        environment["ADAPTER_BREGCTL_BIN"] = str(Path(target) / "debug/bregctl")
        result = subprocess.run(["cargo", "test", "--locked", "-p", "registry-adapter-connectors",
            "--features", "breg", "--test", "breg_native",
            "--", "--ignored", "--nocapture"], cwd=REPO, env=environment)
        raise SystemExit(result.returncode)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env", type=Path)
    arguments = parser.parse_args()
    run(arguments.env)
