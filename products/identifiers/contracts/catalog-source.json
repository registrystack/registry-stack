  "referenceExclusions": [
    {
      "glob": "crates/registry-manifest-core/tests/**",
      "classification": "fixture",
      "reason": "Manifest test shapes are local conformance fixtures, not Registry Stack identifier contracts."
    },
    {
      "glob": "crates/registry-platform-httpsec/**",
      "classification": "legacy-source",
      "reason": "The legacy body-limit problem helper is not wired into a current product route."
    },
    {
      "glob": "crates/registry-platform-testing/**",
      "classification": "fixture",
      "reason": "Cross-crate HTTP problem values are test fixtures for legacy helpers."
    },
    {
      "glob": "docs/site/src/content/docs/reference/api-stability.mdx",
      "classification": "historical-documentation",
      "reason": "The stability reference describes the broader historical identifier surface."
    },
    {
      "glob": "products/manifest/fixtures/**",
      "classification": "fixture",
      "reason": "Manifest profile identifiers in fixtures are not Registry Stack resolver contracts."
    },
    {
      "glob": "products/platform/config-conventions-exceptions.yaml",
      "classification": "planned-resolution",
      "reason": "Exception resolutions name the identifier a deviation moves to; the change that applies a resolution publishes its identifier and deletes the entry."
    },
    {
      "glob": "products/platform/scripts/test_check_config_conventions.py",
      "classification": "fixture",
      "reason": "Convention lint tests build throwaway schemas whose identifiers are test inputs, not Registry Stack resolver contracts."
    },
    {
      "glob": "products/platform/scripts/test_run_config_conformance.py",
      "classification": "fixture",
      "reason": "Conformance runner tests build throwaway schemas whose identifiers are test inputs, not Registry Stack resolver contracts."
    },
    {
      "glob": "release/*.schema.json",
      "classification": "retired-product",
      "reason": "RegistryReleaseLockV1 identifiers belong to retired registryctl release tooling."
    },
    {
      "glob": "schemas/*.schema.json",
      "classification": "retired-product",
      "reason": "Root Relay V1 and Notary configuration schemas are retired."
    }
  ],
  "schemaSources": [
    {
      "glob": "products/identifiers/contracts/*.schema.json",
      "owner": "identifiers",
      "status": "active",
      "compatibilityLine": "v1",
      "description": "JSON Schema for the Registry Stack identifier catalog."
    },
    {
      "glob": "products/registry-record/schema/*.json",
      "owner": "registry-record",
      "status": "active",
      "compatibilityLine": "v1",
      "description": "Registry Record base response profile JSON Schema."
    },
    {
      "glob": "products/breg/generated/authoring/*.schema.json",
      "sourcePath": "crates/registry-breg/src/schema.rs",
      "owner": "breg",
      "status": "active",
      "compatibilityLine": "v1alpha1",
      "description": "Base Registry Engine project authoring JSON Schema."
    },
    {
      "glob": "products/breg/generated/runtime/*.schema.json",
      "sourcePath": "crates/registry-breg/src/schema.rs",
      "owner": "breg",
      "status": "active",
      "compatibilityLine": "v1alpha1",
      "description": "Base Registry Engine runtime configuration JSON Schema."
    },
    {
      "glob": "products/breg/generated/mcp-runtime/*.schema.json",
      "sourcePath": "crates/registry-breg-mcp/src/schema.rs",
      "owner": "breg",
      "status": "active",
      "compatibilityLine": "v1alpha1",
      "description": "Base Registry Engine citizen MCP gateway runtime configuration JSON Schema."
    },
    {
      "glob": "products/breg/generated/review-runtime/*.schema.json",
      "sourcePath": "crates/registry-breg-review/src/schema.rs",
      "owner": "breg",
      "status": "active",
      "compatibilityLine": "v1alpha1",
      "description": "Base Registry Engine citizen review page runtime configuration JSON Schema."
    },
    {
      "glob": "products/breg/generated/tools/*.v1.schema.json",
