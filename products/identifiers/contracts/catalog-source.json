      "owner": "breg",
      "status": "active",
      "compatibilityLine": "v1",
      "description": "Base Registry Engine tool-file JSON Schemas at version v1."
    },
    {
      "glob": "products/breg/generated/tools/*.v1alpha1.schema.json",
