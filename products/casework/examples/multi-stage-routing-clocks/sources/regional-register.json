{
  "apiVersion": "registry.registrystack.org/casework-source-description/v1alpha1",
  "kind": "BRegCaseworkSourceDescription",
  "origin": "bregctl explain change-requests",
  "authority": "none",
  "sourceId": "regional-register",
  "sourceRevision": "sha256:regional-source-revision",
  "request": {
    "requestEntity": "regional-correction",
    "requestRoute": "regional-corrections",
    "review": {
      "authority": "casework-main",
      "policyId": "regional-review"
    },
    "fields": [
      {
        "field": "region",
        "apiName": "region",
        "schema": {
          "type": "string",
          "enum": ["north", "south", "islands"]
        }
      }
    ],
    "onApproved": {"mode": "manual"},
    "application": {},
    "contractFingerprint": "sha256:regional-correction-contract"
  }
}
