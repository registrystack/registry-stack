{
  "$defs": {
    "AccessTokenType": {
      "description": "The access-token type an issuer entry admits.",
      "oneOf": [
        {
          "const": "at+jwt",
          "description": "RFC 9068 access tokens, typed `at+jwt` or `application/at+jwt`.",
          "type": "string"
        },
        {
          "const": "JWT",
          "description": "Access tokens typed `JWT`, from a provider that does not type them\n`at+jwt`. An ID token stays refused.",
          "type": "string"
        }
      ]
    },
    "AuditConfig": {
      "additionalProperties": false,
      "description": "The audit journal: where it is written and the key its hashes use.",
      "else": {
        "required": [
          "path"
        ]
      },
      "if": {
        "properties": {
          "destination": {
            "const": "stdout"
          }
        },
        "required": [
          "destination"
        ]
      },
      "properties": {
        "destination": {
          "$ref": "#/$defs/AuditDestinationKind",
          "default": "file",
          "description": "Where audit entries go: a rotated `file` (the default) or `stdout`."
        },
        "hashKeyCustody": {
          "$ref": "#/$defs/AuditKeyCustody",
          "description": "Who provisioned the key. Absent means `operator-provisioned`.\n`development-generated` marks a key a development tool made.",
          "x-registry-development-only": [
            "platform.posture.generated-audit-key"
          ]
        },
        "hashKeyRef": {
          "$ref": "#/$defs/SecretReference",
          "description": "Secret reference to the audit hash key."
        },
        "path": {
          "description": "The active audit file. Required for, and only allowed with, `file`.",
          "pattern": "^/+(?:(?:[^/.][^/]*|\\.(?:[^/.][^/]*|\\.[^/]+)?)/+)*(?:[^/.][^/]*|\\.(?:[^/.][^/]*|\\.[^/]+))$",
          "type": "string"
        },
        "retentionDays": {
          "description": "Delete rotated files older than this many days. Only allowed with\n`file`; omitted, rotated files are kept 90 days.",
          "format": "uint32",
          "maximum": 36500,
          "minimum": 1,
          "type": "integer"
        },
        "rotateBytes": {
          "description": "Rotate the active file once it reaches this many bytes. Only allowed\nwith `file`; omitted, the file rotates at 100 MiB.",
          "format": "uint64",
          "maximum": 4294967295,
          "minimum": 1048576,
          "type": "integer"
        }
      },
      "required": [
        "hashKeyRef"
      ],
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "rotateBytes"
              ]
            },
            {
              "required": [
                "retentionDays"
              ]
            }
          ]
        }
      },
      "type": "object"
    },
    "AuditDestinationKind": {
      "description": "The configured audit destination kind, as written in product configuration.",
      "oneOf": [
        {
          "const": "file",
          "description": "Durable, rotated JSON Lines file.",
          "type": "string"
        },
        {
          "const": "stdout",
          "description": "One JSON line per entry on standard output, flushed per entry.",
          "type": "string"
        }
      ]
    },
    "AuditKeyCustody": {
      "description": "Who provisioned the audit hash key.",
      "oneOf": [
        {
          "const": "operator-provisioned",
          "description": "The operator provisioned the key.",
          "type": "string"
        },
        {
          "const": "development-generated",
          "description": "A development tool generated the key.",
          "type": "string"
        }
      ]
    },
    "AuthenticationConfig": {
      "additionalProperties": false,
      "properties": {
        "oidc": {
          "$ref": "#/$defs/OidcConfig"
        }
      },
      "required": [
        "oidc"
      ],
      "type": "object"
    },
    "BregBinding": {
      "additionalProperties": false,
      "description": "Environment-specific transport and reader identity. Human display always replaces it.",
      "properties": {
        "baseUrl": {
          "$ref": "#/$defs/Url"
        },
        "clientAssertionAudience": {
          "description": "The authorization server's issuer identifier: the client assertion's\nsole audience. It has no default.",
          "type": "string"
        },
        "clientAssertionKeyRef": {
          "$ref": "#/$defs/SecretReference"
        },
        "clientIdRef": {
          "$ref": "#/$defs/SecretReference"
        },
        "delegatedDisplayExchange": {
          "$ref": "#/$defs/DelegatedDisplayExchangeBinding"
        },
        "humanSourceAuthentication": {
          "$ref": "#/$defs/HumanSourceAuthentication",
          "description": "Opt in to independently verified, same-human source credentials."
        },
        "resource": {
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "statusProfile": {
          "type": "string"
        },
        "taskGrantProfile": {
          "type": "string"
        },
        "tokenEndpoint": {
          "$ref": "#/$defs/Url"
        }
      },
      "required": [
        "baseUrl",
        "statusProfile",
        "tokenEndpoint",
        "clientIdRef",
        "clientAssertionKeyRef",
        "clientAssertionAudience"
      ],
      "type": "object"
    },
    "CaseworkIssuer": {
      "additionalProperties": false,
      "description": "One entry of `authentication.oidc.issuers`.",
      "properties": {
        "accessTokenType": {
          "$ref": "#/$defs/AccessTokenType",
          "default": "at+jwt",
          "description": "The access-token type the entry admits. Absent reads `at+jwt`.",
          "x-registry-explicit-production": [
            "platform.posture.jwt-access-token"
          ]
        },
        "actorKind": {
          "$ref": "#/$defs/IssuerActorKind",
          "description": "The kind every token from this issuer is treated as. Absent declares\nnone.",
          "x-registry-explicit-production": [
            "platform.posture.issuer-actor-kind"
          ]
        },
        "allowInsecureHttp": {
          "default": false,
          "description": "Permit plain HTTP beyond loopback to the configured issuer and to a\nJWKS URI declared in configuration. Loopback needs no setting. The\nvalue `true` is a development-only setting: the loader records it, and\nproduction refuses it.",
          "type": "boolean",
          "x-registry-development-only": [
            "platform.posture.insecure-issuer-http"
          ]
        },
        "allowedClients": {
          "anyOf": [
            {
              "const": "unrestricted",
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          ],
          "description": "The clients whose tokens the entry admits.",
          "x-registry-development-only": [
            "casework.posture.unrestricted-clients"
          ]
        },
        "assertionIssuers": {
          "additionalProperties": {
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "description": "The assertion authorities each client may exchange a subject token\nfrom, keyed by client identifier. Omitted, no assertion-issuer rule\napplies. Written, it lists at least one client, each with at least one\nauthority, and a client that is not listed may exchange from no\nauthority.",
          "maxProperties": 64,
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/ExternalId",
            "maxLength": 128
          },
          "type": "object"
        },
        "audience": {
          "description": "The audience every accepted access token must carry in `aud`.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "clientActorKinds": {
          "additionalProperties": {
            "$ref": "#/$defs/DeclaredActorKind"
          },
          "description": "The kind tokens from each named client are treated as. Absent declares\nnone. Not combined with `actorKind`.",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/ExternalId"
          },
          "type": "object",
          "x-registry-explicit-production": [
            "platform.posture.client-actor-kinds"
          ]
        },
        "issuer": {
          "$ref": "#/$defs/Url",
          "description": "Exact issuer accepted in access-token `iss` claims, an absolute\n`https` URL, or a plain `http` URL when `allowInsecureHttp` is set."
        },
        "jwksSource": {
          "$ref": "#/$defs/JwksSource",
          "default": {
            "type": "discovery"
          },
          "description": "Where the issuer's signing keys come from. Absent reads the issuer's\nOpenID Connect discovery document.",
          "x-registry-development-only": [
            "platform.posture.test-issuer"
          ]
        },
        "maximumTokenLifetimeSeconds": {
          "description": "The longest lifetime, in seconds, an access token from this issuer may\ndeclare, independently of the issuer's own policy.",
          "format": "uint64",
          "maximum": 7200,
          "minimum": 1,
          "type": "integer"
        },
        "revokedKeyIds": {
          "description": "Signing-key identifiers Casework refuses for this issuer, even while\nthe issuer still publishes them. Listing a key does not revoke it at\nthe issuer. Omitted, no key is refused. Written, the list is non-empty.",
          "items": {
            "$ref": "#/$defs/ExternalId"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "scopeClaim": {
          "$ref": "#/$defs/ScopeClaimName",
          "default": "scope",
          "description": "The claim that carries scopes. Absent reads `scope`.",
          "x-registry-explicit-production": [
            "platform.posture.scope-claim"
          ]
        }
      },
      "required": [
        "issuer",
        "audience",
        "allowedClients"
      ],
      "type": "object"
    },
    "DatabaseConfig": {
      "additionalProperties": false,
      "description": "The PostgreSQL connection a stateful runtime uses. Both URLs are secret\nreferences and may name the same secret.",
      "properties": {
        "caBundleRef": {
          "$ref": "#/$defs/SecretReference",
          "description": "Secret reference to a PEM root certificate the connection trusts.\nAbsent, the connection trusts the platform's root certificates."
        },
        "migrationUrlRef": {
          "$ref": "#/$defs/SecretReference",
          "description": "Secret reference to the migration connection URL."
        },
        "runtimeUrlRef": {
          "$ref": "#/$defs/SecretReference",
          "description": "Secret reference to the least-privileged runtime connection URL."
        },
        "testOnlyPlaintext": {
          "default": false,
          "description": "Allow a plaintext connection. Refused outside test builds.",
          "type": "boolean"
        },
        "transport": {
          "$ref": "#/$defs/DatabaseTransport",
          "description": "How the connection is protected. Absent means `verified-tls`. A\nplaintext transport must match the database hosts, and cannot be\nwritten beside `testOnlyPlaintext`.",
          "x-registry-development-only": [
            "platform.posture.database-private-plaintext"
          ]
        }
      },
      "required": [
        "runtimeUrlRef",
        "migrationUrlRef"
      ],
      "type": "object"
    },
    "DatabaseTransport": {
      "description": "How a PostgreSQL connection is protected.",
      "oneOf": [
        {
          "const": "verified-tls",
          "description": "TLS with verification. `caBundleRef` is optional.",
          "type": "string"
        },
        {
          "const": "loopback-plaintext",
          "description": "No TLS. Every host must be a Unix socket, a numeric loopback address\nor `localhost`.",
          "type": "string"
        },
        {
          "const": "private-network-plaintext",
          "description": "No TLS, in development only. Every host must also be loopback, a\nsocket, a private IPv4 address (RFC 1918), an IPv6 unique local\naddress (`fc00::/7`), or a name that resolves only to such addresses.",
          "type": "string"
        }
      ]
    },
    "DeclaredActorKind": {
      "description": "An actor kind an operator declares for a caller.",
      "enum": [
        "human",
        "agent",
        "service"
      ],
      "type": "string"
    },
    "DelegatedDisplayExchangeBinding": {
      "additionalProperties": false,
      "description": "Dedicated per-call delegation for staff-subject source disclosure. This is\nseparate from the provider's status and task-context service credential.",
      "properties": {
        "clientAssertionAudience": {
          "description": "The authorization server's issuer identifier: the client assertion's\nsole audience. It has no default.",
          "type": "string"
        },
        "clientAssertionKeyRef": {
          "$ref": "#/$defs/SecretReference"
        },
        "clientIdRef": {
          "$ref": "#/$defs/SecretReference"
        },
        "generation": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tokenEndpoint": {
          "$ref": "#/$defs/Url"
        }
      },
      "required": [
        "tokenEndpoint",
        "clientIdRef",
        "clientAssertionKeyRef",
        "clientAssertionAudience",
        "resource",
        "scopes",
        "generation"
      ],
      "type": "object"
    },
    "DelegatedStaffReaderConfig": {
      "additionalProperties": false,
      "description": "One deployment-owned delegation ceiling. The policy id is the containing\nmap key, never a human profile supplied by the HTTP caller.",
      "properties": {
        "actorSubject": {
          "type": "string"
        },
        "assertionIssuer": {
          "$ref": "#/$defs/Url"
        },
        "client": {
          "type": "string"
        },
        "maximumTokenLifetimeSeconds": {
          "format": "uint64",
          "maximum": 300,
          "minimum": 1,
          "type": "integer"
        },
        "profile": {
          "$ref": "#/$defs/LocalId"
        },
        "representedHuman": {
          "$ref": "#/$defs/RepresentedHumanConfig",
          "description": "The claim, and the value it holds, that says the person this\ndelegated token represents is human. The token's own actor kind is\nthe gateway's and does not stand for the represented person."
        },
        "requiredScope": {
          "type": "string"
        },
        "sourceProfiles": {
          "items": {
            "$ref": "#/$defs/LocalId"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "profile",
        "client",
        "actorSubject",
        "representedHuman",
        "assertionIssuer",
        "requiredScope",
        "maximumTokenLifetimeSeconds"
      ],
      "type": "object"
    },
    "Digest": {
      "description": "A SHA-256 digest: `sha256:` followed by 64 lowercase hex digits.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EnvironmentSecretProviderConfig": {
      "additionalProperties": false,
      "description": "The environment secret provider. It takes no settings.",
      "type": "object"
    },
    "ExternalId": {
      "description": "An identifier another system issues, written exactly as its issuer gives it.",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "type": "string"
    },
    "FileSecretProviderConfig": {
      "additionalProperties": false,
      "description": "The file secret provider.",
      "properties": {
        "root": {
          "description": "Absolute directory holding one file per secret. A name may be a\nrelative link that stays below this directory, through at most 8 links.\nThe file it reaches must be a regular file with one hard link, owned by\nthe runtime user with mode 0400 or 0600, or owned by root with no\naccess beyond group read (0440 or 0640) when the runtime is not root.\nA process that declared development loads a file with looser read or\nmode bits and logs a warning.",
          "pattern": "^/",
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "type": "object"
    },
    "HumanSourceAuthentication": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        }
      },
      "required": [
        "audience"
      ],
      "type": "object"
    },
    "IdentityConfig": {
      "additionalProperties": false,
      "description": "The logical identity of the database this deployment activates packages\nin. It is chosen by the operator (for example `casework-production`) and\nnever derived from a URL or a PostgreSQL database name. The first\n`caseworkctl apply` records it, and every later apply and every startup\nrefuses a database whose recorded identity differs.",
      "properties": {
        "databaseId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\u0000-\\u001f\\u007f-\\u009f \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?$",
          "type": "string"
        }
      },
      "required": [
        "databaseId"
      ],
      "type": "object"
    },
    "IssuerActorKind": {
      "$ref": "#/$defs/DeclaredActorKind",
      "description": "The kind every token from one issuer is treated as."
    },
    "JwksSource": {
      "description": "Where a runtime obtains the OIDC issuer's signing keys.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Read `jwks_uri` from the issuer's OpenID Connect discovery document.",
          "properties": {
            "type": {
              "const": "discovery",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Fetch the key set from this absolute `https` URI, skipping discovery.\nA plain `http` URI is accepted on loopback for supervised local\ndevelopment, and beyond loopback only when the issuer block sets\n`allowInsecureHttp`.",
          "properties": {
            "type": {
              "const": "uri",
              "type": "string"
            },
            "uri": {
              "$ref": "#/$defs/Url"
            }
          },
          "required": [
            "type",
            "uri"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Read the key set from a secret, for deployments without network access\nto the issuer.",
          "properties": {
            "documentRef": {
              "$ref": "#/$defs/SecretReference"
            },
            "type": {
              "const": "static",
              "type": "string"
            }
          },
          "required": [
            "type",
            "documentRef"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Read the key set from a secret, as `static` does, for a test issuer a\ndevelopment run supervises. Development only: production refuses it.",
          "properties": {
            "documentRef": {
              "$ref": "#/$defs/SecretReference"
            },
            "type": {
              "const": "test-issuer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "documentRef"
          ],
          "type": "object"
        }
      ]
    },
    "ListenerBind": {
      "description": "Socket address the runtime listens on, written host:port with an IP address host ([addr]:port for IPv6).",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "ListenerNetworkExposure": {
      "description": "The operator-declared private network placement of an HTTP listener.",
      "enum": [
        "private-address",
        "container-private"
      ],
      "type": "string"
    },
    "LocalId": {
      "description": "A local identifier: a lowercase letter, then up to 63 lowercase letters, digits, `_`, or `-`.",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "MetricsListenerConfig": {
      "additionalProperties": false,
      "description": "The operator-private metrics listener of a runtime. `networkExposure`\nhas the meaning it has on the serving listener: `private-address` (the\ndefault) requires a loopback or private address, and `container-private`\nalso permits the unspecified address inside a private container network.",
      "properties": {
        "bind": {
          "$ref": "#/$defs/ListenerBind"
        },
        "networkExposure": {
          "$ref": "#/$defs/ListenerNetworkExposure",
          "default": "private-address"
        }
      },
      "required": [
        "bind"
      ],
      "type": "object"
    },
    "OidcConfig": {
      "additionalProperties": false,
      "description": "The access tokens this runtime accepts: the issuers it trusts, each with\nits own keys, rules and clients, and the delegated staff readers.",
      "properties": {
        "delegatedStaffReaders": {
          "additionalProperties": {
            "$ref": "#/$defs/DelegatedStaffReaderConfig"
          },
          "description": "Explicitly opted-in delegated staff readers, keyed by the policy id a\ndedicated read client sends. Absence disables delegated staff reads.",
          "propertyNames": {
            "$ref": "#/$defs/LocalId"
          },
          "type": "object"
        },
        "issuers": {
          "additionalProperties": {
            "$ref": "#/$defs/CaseworkIssuer"
          },
          "description": "The issuers a token may come from, by issuer id.",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/LocalId"
          },
          "type": "object"
        }
      },
      "required": [
        "issuers"
      ],
      "type": "object"
    },
    "PrivateListenerConfig": {
      "additionalProperties": false,
      "description": "The listener of a runtime that declares its TLS termination and network\nexposure.",
      "properties": {
        "bind": {
          "$ref": "#/$defs/ListenerBind"
        },
        "networkExposure": {
          "$ref": "#/$defs/ListenerNetworkExposure",
          "default": "private-address"
        },
        "tlsTermination": {
          "$ref": "#/$defs/TlsTermination"
        }
      },
      "required": [
        "bind",
        "tlsTermination"
      ],
      "type": "object"
    },
    "RepresentedHumanConfig": {
      "additionalProperties": false,
      "description": "A claim of a delegated token, and the exact value it holds, that says the\nrepresented person is human.",
      "properties": {
        "claim": {
          "description": "The claim name.",
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "description": "The exact string value the claim holds for a human.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "claim",
        "value"
      ],
      "type": "object"
    },
    "ReviewCompletionRuntimeConfig": {
      "additionalProperties": false,
      "properties": {
        "attemptTimeoutMilliseconds": {
          "default": 5000,
          "format": "uint64",
          "maximum": 30000,
          "minimum": 100,
          "type": "integer"
        },
        "hmacSha256KeyRef": {
          "$ref": "#/$defs/SecretReference",
          "description": "Exact bytes of the current Standard Webhooks signing key."
        },
        "maximumAttempts": {
          "default": 12,
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "previousHmacSha256KeyRef": {
          "$ref": "#/$defs/SecretReference",
          "description": "Exact bytes of the previous signing key during rotation."
        },
        "retryDelaySeconds": {
          "default": 30,
          "format": "uint64",
          "maximum": 86400,
          "minimum": 1,
          "type": "integer"
        },
        "url": {
          "$ref": "#/$defs/Url"
        }
      },
      "required": [
        "url",
        "hmacSha256KeyRef"
      ],
      "type": "object"
    },
    "RuntimePackageConfig": {
      "additionalProperties": false,
      "properties": {
        "expectedDigest": {
          "$ref": "#/$defs/Digest",
          "description": "`sha256:` label of the package digest, the digest of the package's\n`SHA256SUMS` file. When set, the runtime refuses to start on any other\npackage, and on an authored project that has no `SHA256SUMS`.\nOmitted, the runtime starts on whichever package `root` holds."
        },
        "root": {
          "description": "Absolute path of the package directory.",
          "pattern": "^/",
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "type": "object"
    },
    "ScopeClaimName": {
      "$ref": "#/$defs/ExternalId",
      "description": "The name of the claim that carries scopes."
    },
    "SecretProvidersConfig": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "file": {
              "$ref": "#/$defs/FileSecretProviderConfig"
            }
          },
          "required": [
            "file"
          ]
        },
        {
          "properties": {
            "environment": {
              "$ref": "#/$defs/EnvironmentSecretProviderConfig"
            }
          },
          "required": [
            "environment"
          ]
        }
      ],
      "description": "The secret providers a runtime enables. A reference is resolved only by a\nprovider declared here: `secret:file/name` under `file.root`, and\n`secret:env/NAME` only when `environment: {}` is present.",
      "properties": {
        "environment": {
          "$ref": "#/$defs/EnvironmentSecretProviderConfig",
          "description": "Enables `secret:env/NAME` references, read from the process\nenvironment. Declared as an empty mapping: `environment: {}`."
        },
        "file": {
          "$ref": "#/$defs/FileSecretProviderConfig",
          "description": "Enables `secret:file/name` references, read from files under `root`."
        }
      },
      "type": "object"
    },
    "SecretReference": {
      "description": "An exact secret reference: secret:file/name, resolved under secretProviders.file.root, or secret:env/NAME, resolved only when secretProviders.environment is declared.",
      "pattern": "^(?:secret:env/[A-Z][A-Z0-9_]{0,127}|secret:file/[a-z][a-z0-9._-]{0,127})$",
      "type": "string"
    },
    "TaskAuthorityConfig": {
      "additionalProperties": false,
      "properties": {
        "exchangeAudience": {
          "type": "string"
        },
        "issuer": {
          "$ref": "#/$defs/Url"
        },
        "signingKeyRef": {
          "$ref": "#/$defs/SecretReference"
        },
        "statusClients": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Service client IDs mapped to their one protected resource audience.",
          "propertyNames": {
            "$ref": "#/$defs/ExternalId"
          },
          "type": "object"
        }
      },
      "required": [
        "issuer",
        "exchangeAudience",
        "signingKeyRef",
        "statusClients"
      ],
      "type": "object"
    },
    "TlsTermination": {
      "description": "Declares the trusted transport boundary for a runtime's plaintext HTTP\nlistener. Production listeners require operator-controlled upstream TLS\ntermination; direct plaintext is limited to the explicit loopback-only\ndevelopment mode.",
      "oneOf": [
        {
          "enum": [
            "operator-controlled-upstream",
            "development-loopback"
          ],
          "type": "string"
        },
        {
          "const": "loopback-plaintext",
          "description": "Plaintext on a loopback bind, behind a proxy on the same host. Valid\nin every posture. It is placement only: it relaxes nothing a product\nrelaxes under `development-loopback`.",
          "type": "string"
        }
      ]
    },
    "Url": {
      "description": "An absolute http or https URL with a host preserved as written, no user information, and no backslash, whitespace or control character. DNS case and equivalent IPv6 literals are permitted.",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\u005C\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+([/?#][^\\u005C\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]*)?$",
      "type": "string"
    }
  },
