{
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "initiator": {
          "$ref": "#/$defs/Initiator"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        }
      },
      "required": [
        "producer"
      ],
      "type": "object"
    },
    "Initiator": {
      "additionalProperties": false,
      "properties": {
        "expectedIssuer": {
          "$ref": "#/$defs/Url"
        },
        "trust": {
          "$ref": "#/$defs/InitiatorTrust"
        }
      },
      "required": [
        "expectedIssuer",
        "trust"
      ],
      "type": "object"
    },
    "InitiatorTrust": {
      "enum": [
        "run-test-people"
      ],
      "type": "string"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "expectedIssuer": {
          "$ref": "#/$defs/Url"
        },
        "expectedProfile": {
          "type": "string"
        },
        "expectedSubject": {
          "type": "string"
        }
      },
      "required": [
        "expectedIssuer",
        "expectedProfile",
        "expectedSubject"
      ],
      "type": "object"
    },
    "Url": {
      "description": "An absolute http or https URL with a host preserved as written, no user information, and no backslash, whitespace or control character. DNS case and equivalent IPv6 literals are permitted.",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\u005C\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+([/?#][^\\u005C\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]*)?$",
      "type": "string"
    }
  },
  "$id": "https://id.registrystack.org/schemas/casework/run-source/run-source.v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/casework/run-source/v1alpha1",
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/Binding"
    },
    "identityProfile": {
      "type": "string"
    },
    "identityScopes": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "identitySubject": {
      "type": "string"
    },
    "kind": {
      "const": "CaseworkRunSource",
      "type": "string"
    },
    "producer": {
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "producer",
    "identityProfile",
    "identitySubject",
    "identityScopes",
    "binding"
  ],
  "title": "Casework synthetic run source binding",
  "type": "object"
}
