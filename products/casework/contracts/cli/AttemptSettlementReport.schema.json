{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha3/AttemptSettlementReport.schema.json",
  "title": "AttemptSettlementReport",
  "description": "Versioned JSON report emitted by caseworkctl for attempt settle.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "project",
        "runtimeConfig",
        "report"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "attempt settle"
        },
        "status": {
          "const": "complete"
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "AttemptSettlementReport"
        },
        "project": {
          "type": "string"
        },
        "runtimeConfig": {
          "type": "string"
        },
        "report": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "attempt settle"
        },
        "status": {
          "enum": [
            "domain-refusal",
            "operational-failure"
          ]
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "AttemptSettlementReport"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "artifact",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  }
}
