{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha3/LifecycleReport.schema.json",
  "title": "LifecycleReport",
  "description": "Versioned JSON report emitted by caseworkctl for lifecycle.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "lifecycles"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "lifecycle"
        },
        "status": {
          "const": "complete"
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "LifecycleReport"
        },
        "lifecycles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/lifecycle"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "lifecycle"
        },
        "status": {
          "enum": [
            "domain-refusal",
            "operational-failure"
          ]
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "LifecycleReport"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "path",
              "message"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/diagnostic"
          },
          {
            "properties": {
              "severity": {
                "const": "warning"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "states",
        "transitions",
        "enforcement"
      ],
      "properties": {
        "id": {
          "enum": [
            "occurrence",
            "review_request"
          ]
        },
        "label": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lifecycleState"
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lifecycleTransition"
          }
        },
        "enforcement": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/enforcementLayer"
          }
        }
      }
    },
    "lifecycleState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "initial",
        "terminal",
        "unreachable",
        "incomingTransitions",
        "outgoingTransitions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "initial": {
          "type": "boolean"
        },
        "terminal": {
          "type": "boolean"
        },
        "unreachable": {
          "type": "boolean"
        },
        "incomingTransitions": {
          "type": "integer",
          "minimum": 0
        },
        "outgoingTransitions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lifecycleTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "event",
        "to",
        "guard"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "guard": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "enforcementLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "events"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
