{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/casework/retention-erase-report/retention-erase-report.v1alpha3.schema.json",
  "title": "RetentionEraseReport",
  "description": "Versioned JSON report emitted by caseworkctl for retention erase.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind"
  ],
  "properties": {
    "apiVersion": {
      "const": "registry.registrystack.org/caseworkctl/v1alpha3"
    },
    "kind": {
      "const": "RetentionEraseReport"
    }
  },
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "project",
        "runtimeConfig",
        "report"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "retention erase"
        },
        "status": {
          "const": "complete"
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "RetentionEraseReport"
        },
        "project": {
          "type": "string"
        },
        "runtimeConfig": {
          "type": "string"
        },
        "report": {
          "$ref": "#/$defs/retention"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "retention erase"
        },
        "status": {
          "enum": [
            "domain-refusal",
            "operational-failure"
          ]
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "RetentionEraseReport"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "path",
              "message"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/diagnostic"
          },
          {
            "properties": {
              "severity": {
                "const": "warning"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "applied",
        "blockedLiveAttempts",
        "items",
        "drafts",
        "correctionContexts",
        "attemptPayloads",
        "receiptPayloads",
        "historyDetails",
        "eventDetails",
        "idempotencyResponses",
        "clockOccurrences",
        "clockPreviews"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceId",
            "requestKind",
            "requestId"
          ],
          "properties": {
            "sourceId": {
              "type": "string"
            },
            "requestKind": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            }
          }
        },
        "applied": {
          "type": "boolean"
        },
        "blockedLiveAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "drafts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "correctionContexts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attemptPayloads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "receiptPayloads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "historyDetails": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eventDetails": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "idempotencyResponses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clockOccurrences": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clockPreviews": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
