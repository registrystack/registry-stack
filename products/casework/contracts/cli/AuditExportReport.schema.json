{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha2/AuditExportReport.schema.json",
  "title": "AuditExportReport",
  "description": "Versioned JSON report emitted by caseworkctl for audit export.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "command",
        "runtimeConfig",
        "output",
        "auditChain"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha2"
        },
        "kind": {
          "const": "AuditExportReport"
        },
        "ok": {
          "const": true
        },
        "command": {
          "const": "audit export"
        },
        "runtimeConfig": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "auditChain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "records",
            "segments",
            "activeSegmentVerified",
            "startPrevHash",
            "headHash"
          ],
          "properties": {
            "records": {
              "type": "integer",
              "minimum": 0
            },
            "segments": {
              "type": "integer",
              "minimum": 0
            },
            "activeSegmentVerified": {
              "type": "boolean"
            },
            "startPrevHash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "headHash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "diagnostics"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha2"
        },
        "kind": {
          "const": "AuditExportReport"
        },
        "ok": {
          "const": false
        },
        "command": {
          "const": "audit export"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "artifact",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  }
}
