{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha2/AuditRestoreAcknowledgementReport.schema.json",
  "title": "AuditRestoreAcknowledgementReport",
  "description": "Versioned JSON report emitted by caseworkctl for audit acknowledge-restore.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "command",
        "runtimeConfig",
        "acknowledgement"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha2"
        },
        "kind": {
          "const": "AuditRestoreAcknowledgementReport"
        },
        "ok": {
          "const": true
        },
        "command": {
          "const": "audit acknowledge-restore"
        },
        "runtimeConfig": {
          "type": "string"
        },
        "acknowledgement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "acknowledged",
            "recordsAhead",
            "markedPublished",
            "databaseHead",
            "journalHead",
            "acknowledgementHash"
          ],
          "properties": {
            "relation": {
              "enum": [
                "consistent",
                "database-behind",
                "journal-behind"
              ]
            },
            "acknowledged": {
              "type": "boolean"
            },
            "recordsAhead": {
              "type": "integer",
              "minimum": 0
            },
            "markedPublished": {
              "type": "integer",
              "minimum": 0
            },
            "databaseHead": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "journalHead": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "acknowledgementHash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "diagnostics"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha2"
        },
        "kind": {
          "const": "AuditRestoreAcknowledgementReport"
        },
        "ok": {
          "const": false
        },
        "command": {
          "const": "audit acknowledge-restore"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "artifact",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  }
}
