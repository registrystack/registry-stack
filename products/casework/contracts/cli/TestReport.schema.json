{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha3/TestReport.schema.json",
  "title": "TestReport",
  "description": "Versioned JSON report emitted by caseworkctl for test.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "project",
        "authoringStatus",
        "filesChecked",
        "diagnostics",
        "fixtures",
        "proofBoundary",
        "productionClosure",
        "networkAccess",
        "databaseAccess"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "test"
        },
        "status": {
          "const": "passed"
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "TestReport"
        },
        "project": {
          "type": "string"
        },
        "authoringStatus": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "filesChecked": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3138
        },
        "diagnostics": {
          "$ref": "#/$defs/warnings"
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fixture"
          }
        },
        "proofBoundary": {
          "const": "offline_synthetic"
        },
        "productionClosure": {
          "const": false
        },
        "networkAccess": {
          "const": false
        },
        "databaseAccess": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "test"
        },
        "status": {
          "enum": [
            "domain-refusal",
            "operational-failure"
          ]
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "TestReport"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "path",
              "message"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/diagnostic"
          },
          {
            "properties": {
              "severity": {
                "const": "warning"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "file"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "const": "passed"
        },
        "file": {
          "type": "string"
        }
      }
    }
  }
}
