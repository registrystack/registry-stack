{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha3/DoctorReport.schema.json",
  "title": "DoctorReport",
  "description": "Versioned JSON report emitted by caseworkctl for doctor.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "runtimeConfig",
        "packageRoot",
        "checks",
        "packageDigest",
        "secretFileChecks",
        "sourceChecks",
        "pinnedWork",
        "eventWiringGuidance",
        "roleMode",
        "singleRoleStatement"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "doctor"
        },
        "status": {
          "const": "complete"
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "DoctorReport"
        },
        "runtimeConfig": {
          "type": "string"
        },
        "packageRoot": {
          "type": "string"
        },
        "packageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "checks": {
          "$ref": "#/$defs/doctorChecks"
        },
        "secretFileChecks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sourceChecks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "pinnedWork": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "conflicts"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "clear",
                "acknowledged"
              ]
            },
            "conflicts": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "eventWiringGuidance": {
          "type": "string"
        },
        "roleMode": {
          "enum": [
            "single",
            "split"
          ]
        },
        "singleRoleStatement": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "doctor"
        },
        "status": {
          "enum": [
            "domain-refusal",
            "operational-failure"
          ]
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "DoctorReport"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "path",
              "message"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/diagnostic"
          },
          {
            "properties": {
              "severity": {
                "const": "warning"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "doctorChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration",
        "secretFiles",
        "sourceDescriptions",
        "sourceConnections",
        "audit",
        "database",
        "activation",
        "pinnedWork",
        "oidcIssuer",
        "directory",
        "reconciliation"
      ],
      "properties": {
        "configuration": {
          "const": "ready"
        },
        "secretFiles": {
          "const": "ready"
        },
        "sourceDescriptions": {
          "const": "ready"
        },
        "sourceConnections": {
          "const": "ready"
        },
        "audit": {
          "const": "ready"
        },
        "database": {
          "const": "ready"
        },
        "activation": {
          "const": "ready"
        },
        "pinnedWork": {
          "const": "ready"
        },
        "oidcIssuer": {
          "const": "ready"
        },
        "directory": {
          "const": "ready"
        },
        "reconciliation": {
          "const": "ready"
        }
      }
    }
  }
}
