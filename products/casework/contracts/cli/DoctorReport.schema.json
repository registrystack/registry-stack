{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/casework/doctor-report/doctor-report.v1alpha3.schema.json",
  "title": "CaseworkDoctorReport",
  "description": "Versioned JSON report emitted by caseworkctl for doctor.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind"
  ],
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/casework/doctor-report/v1alpha3"
    },
    "kind": {
      "const": "CaseworkDoctorReport"
    }
  },
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "runtimeConfig",
        "packageRoot",
        "checks",
        "packageDigest",
        "secretFileChecks",
        "sourceChecks",
        "pinnedWork",
        "eventWiringGuidance",
        "roleMode",
        "singleRoleStatement"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "doctor"
        },
        "status": {
          "const": "complete"
        },
        "apiVersion": {
          "const": "id.registrystack.org/formats/casework/doctor-report/v1alpha3"
        },
        "kind": {
          "const": "CaseworkDoctorReport"
        },
        "runtimeConfig": {
          "type": "string"
        },
        "packageRoot": {
          "type": "string"
        },
        "packageDigest": {
          "$ref": "#/$defs/Digest"
        },
        "checks": {
          "$ref": "#/$defs/doctorChecks"
        },
        "secretFileChecks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/secretFileCheck"
          }
        },
        "sourceChecks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceCheck"
          }
        },
        "pinnedWork": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "conflicts"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "clear",
                "acknowledged"
              ]
            },
            "conflicts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/strandedWork"
              }
            }
          }
        },
        "eventWiringGuidance": {
          "type": "string"
        },
        "roleMode": {
          "enum": [
            "single",
            "split"
          ]
        },
        "singleRoleStatement": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "doctor"
        },
        "status": {
          "enum": [
            "domain-refusal",
            "operational-failure"
          ]
        },
        "apiVersion": {
          "const": "id.registrystack.org/formats/casework/doctor-report/v1alpha3"
        },
        "kind": {
          "const": "CaseworkDoctorReport"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "path",
              "message"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/diagnostic"
          },
          {
            "properties": {
              "severity": {
                "const": "warning"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "doctorChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration",
        "secretFiles",
        "sourceDescriptions",
        "sourceConnections",
        "audit",
        "database",
        "activation",
        "pinnedWork",
        "oidcIssuer",
        "directory",
        "reconciliation"
      ],
      "properties": {
        "configuration": {
          "const": "ready"
        },
        "secretFiles": {
          "const": "ready"
        },
        "sourceDescriptions": {
          "const": "ready"
        },
        "sourceConnections": {
          "const": "ready"
        },
        "audit": {
          "const": "ready"
        },
        "database": {
          "const": "ready"
        },
        "activation": {
          "const": "ready"
        },
        "pinnedWork": {
          "const": "ready"
        },
        "oidcIssuer": {
          "const": "ready"
        },
        "directory": {
          "const": "ready"
        },
        "reconciliation": {
          "const": "ready"
        }
      }
    },
    "secretFileCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setting",
        "provider",
        "status"
      ],
      "properties": {
        "setting": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "file",
            "environment"
          ]
        },
        "status": {
          "enum": [
            "ready",
            "not-checked"
          ]
        },
        "refusal": {
          "type": "string"
        }
      }
    },
    "sourceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "runtime",
        "readerProfile",
        "requiredGrants",
        "eventWiring",
        "reconciliation"
      ],
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "runtime": {
          "const": "ready"
        },
        "readerProfile": {
          "const": "ready"
        },
        "requiredGrants": {
          "const": "ready"
        },
        "eventWiring": {
          "const": "unknown"
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consecutiveFailures",
            "lastSucceededAt",
            "lastFailedAt",
            "lastFailure"
          ],
          "properties": {
            "consecutiveFailures": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "lastSucceededAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "lastFailedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "lastFailure": {
              "oneOf": [
                {
                  "enum": [
                    "source-unavailable",
                    "source-refused",
                    "store",
                    "configuration"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "strandedWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "reviews"
      ],
      "properties": {
        "reason": {
          "enum": [
            "queue-removed",
            "profile-removed",
            "producer-removed",
            "review-kind-changed",
            "source-removed",
            "context-field-not-displayed",
            "displayed-field-not-projected"
          ]
        },
        "queue": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "reviewKind": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "reviews": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Digest": {
      "description": "A SHA-256 digest: `sha256:` followed by 64 lowercase hex digits.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
