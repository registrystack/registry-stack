{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha2/DoctorReport.schema.json",
  "title": "DoctorReport",
  "description": "Versioned JSON report emitted by caseworkctl for doctor.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "command",
        "runtimeConfig",
        "packageRoot",
        "checks",
        "packageDigest",
        "secretFileChecks",
        "sourceChecks",
        "pinnedWork",
        "auditChain",
        "eventWiringGuidance"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha2"
        },
        "kind": {
          "const": "DoctorReport"
        },
        "ok": {
          "const": true
        },
        "command": {
          "const": "doctor"
        },
        "runtimeConfig": {
          "type": "string"
        },
        "packageRoot": {
          "type": "string"
        },
        "packageDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "checks": {
          "$ref": "#/$defs/doctorChecks"
        },
        "secretFileChecks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sourceChecks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "pinnedWork": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "conflicts"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "clear",
                "acknowledged",
                "development"
              ]
            },
            "conflicts": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "auditChain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "records",
            "segments",
            "activeSegmentVerified"
          ],
          "properties": {
            "records": {
              "type": "integer",
              "minimum": 0
            },
            "segments": {
              "type": "integer",
              "minimum": 0
            },
            "activeSegmentVerified": {
              "type": "boolean"
            }
          }
        },
        "eventWiringGuidance": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "diagnostics"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha2"
        },
        "kind": {
          "const": "DoctorReport"
        },
        "ok": {
          "const": false
        },
        "command": {
          "const": "doctor"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "artifact",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "doctorChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration",
        "secretFiles",
        "sourceDescriptions",
        "sourceConnections",
        "database",
        "pinnedWork",
        "oidcIssuer",
        "directory",
        "reconciliation",
        "auditChain"
      ],
      "properties": {
        "configuration": {
          "const": "ready"
        },
        "secretFiles": {
          "const": "ready"
        },
        "sourceDescriptions": {
          "const": "ready"
        },
        "sourceConnections": {
          "const": "ready"
        },
        "database": {
          "const": "ready"
        },
        "pinnedWork": {
          "const": "ready"
        },
        "oidcIssuer": {
          "const": "ready"
        },
        "directory": {
          "const": "ready"
        },
        "reconciliation": {
          "const": "ready"
        },
        "auditChain": {
          "const": "ready"
        }
      }
    }
  }
}
