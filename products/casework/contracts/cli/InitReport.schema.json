{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha1/InitReport.schema.json",
  "title": "InitReport",
  "description": "Versioned JSON report emitted by caseworkctl for init.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "command",
        "template",
        "project",
        "created",
        "next"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "InitReport"
        },
        "ok": {
          "const": true
        },
        "command": {
          "const": "init"
        },
        "template": {
          "enum": [
            "professional-review",
            "standalone-decision"
          ]
        },
        "project": {
          "type": "string"
        },
        "created": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "diagnostics"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "InitReport"
        },
        "ok": {
          "const": false
        },
        "command": {
          "const": "init"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "artifact",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  }
}
