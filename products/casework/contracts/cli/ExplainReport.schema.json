{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha1/ExplainReport.schema.json",
  "title": "ExplainReport",
  "description": "Versioned JSON report emitted by caseworkctl for explain.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "command",
        "projectId",
        "policyVersion",
        "requests",
        "accessProfiles",
        "queues",
        "reviewKinds",
        "calendars",
        "clocks",
        "networkAccess",
        "databaseAccess"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "ExplainReport"
        },
        "ok": {
          "const": true
        },
        "command": {
          "const": "explain"
        },
        "projectId": {
          "type": "string"
        },
        "policyVersion": {
          "type": "string"
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "accessProfiles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "queues": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reviewKinds": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "calendars": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "clocks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "networkAccess": {
          "const": false
        },
        "databaseAccess": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "diagnostics"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "ExplainReport"
        },
        "ok": {
          "const": false
        },
        "command": {
          "const": "explain"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "artifact",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  }
}
