{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/casework/status-report/status-report.v1alpha3.schema.json",
  "title": "CaseworkStatusReport",
  "description": "Versioned JSON report emitted by caseworkctl for status.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind"
  ],
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/casework/status-report/v1alpha3"
    },
    "kind": {
      "const": "CaseworkStatusReport"
    }
  },
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "runtimeConfig",
        "active",
        "history",
        "schemaVersion",
        "supportedSchemaVersion",
        "roleMode",
        "singleRoleStatement"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "status"
        },
        "status": {
          "const": "complete"
        },
        "apiVersion": {
          "const": "id.registrystack.org/formats/casework/status-report/v1alpha3"
        },
        "kind": {
          "const": "CaseworkStatusReport"
        },
        "runtimeConfig": {
          "type": "string"
        },
        "active": {
          "oneOf": [
            {
              "$ref": "#/$defs/activation"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activation"
          }
        },
        "schemaVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "supportedSchemaVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "roleMode": {
          "oneOf": [
            {
              "enum": [
                "single",
                "split"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "singleRoleStatement": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "status"
        },
        "status": {
          "enum": [
            "domain-refusal",
            "operational-failure"
          ]
        },
        "apiVersion": {
          "const": "id.registrystack.org/formats/casework/status-report/v1alpha3"
        },
        "kind": {
          "const": "CaseworkStatusReport"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "path",
              "message"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/diagnostic"
          },
          {
            "properties": {
              "severity": {
                "const": "warning"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationId",
        "applyOrder",
        "packageDigest",
        "predecessorPackageDigest",
        "databaseId",
        "planKind",
        "appliedAt",
        "operatorReferenceHash",
        "backupReferences",
        "roleMode"
      ],
      "properties": {
        "activationId": {
          "type": "string"
        },
        "applyOrder": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "packageDigest": {
          "$ref": "#/$defs/Digest"
        },
        "predecessorPackageDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "databaseId": {
          "type": "string"
        },
        "planKind": {
          "enum": [
            "initial",
            "successor"
          ]
        },
        "appliedAt": {
          "type": "string"
        },
        "operatorReferenceHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "backupReferences": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "roleMode": {
          "enum": [
            "single",
            "split"
          ]
        }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "Digest": {
      "description": "A SHA-256 digest: `sha256:` followed by 64 lowercase hex digits.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
