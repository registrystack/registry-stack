{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha1/SourceAddReport.schema.json",
  "title": "SourceAddReport",
  "description": "Versioned JSON report emitted by caseworkctl for source add.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "command",
        "status",
        "sourceId",
        "registry",
        "project",
        "sourceDescription",
        "bregRuntimeBinding",
        "connection",
        "bregAuthoringChanges",
        "bregAuthoringPatch",
        "activation",
        "next"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "SourceAddReport"
        },
        "ok": {
          "const": true
        },
        "command": {
          "const": "source add"
        },
        "status": {
          "enum": [
            "preview",
            "applied"
          ]
        },
        "sourceId": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "sourceDescription": {
          "type": "string"
        },
        "bregRuntimeBinding": {
          "type": "string"
        },
        "connection": {
          "type": "object"
        },
        "bregAuthoringChanges": {
          "type": "array"
        },
        "bregAuthoringPatch": {
          "type": "object"
        },
        "candidateRuntimeBinding": {
          "type": "object"
        },
        "activation": {
          "const": "not_performed"
        },
        "next": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "diagnostics"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "SourceAddReport"
        },
        "ok": {
          "const": false
        },
        "command": {
          "const": "source add"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "artifact",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  }
}
