{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha2/ApplyReport.schema.json",
  "title": "ApplyReport",
  "description": "Versioned JSON report emitted by caseworkctl for apply.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "command",
        "runtimeConfig",
        "activationId",
        "applyOrder",
        "packageDigest",
        "predecessorPackageDigest",
        "databaseId",
        "planKind",
        "appliedAt",
        "operatorReferenceHash",
        "backupReferences",
        "roleMode",
        "schemaVersionsApplied",
        "effects",
        "singleRoleStatement"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha2"
        },
        "kind": {
          "const": "ApplyReport"
        },
        "ok": {
          "const": true
        },
        "command": {
          "const": "apply"
        },
        "runtimeConfig": {
          "type": "string"
        },
        "activationId": {
          "type": "string"
        },
        "applyOrder": {
          "type": "integer",
          "minimum": 1
        },
        "packageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "predecessorPackageDigest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "databaseId": {
          "type": "string"
        },
        "planKind": {
          "enum": [
            "initial",
            "successor"
          ]
        },
        "appliedAt": {
          "type": "string"
        },
        "operatorReferenceHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "backupReferences": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "roleMode": {
          "enum": [
            "single",
            "split"
          ]
        },
        "schemaVersionsApplied": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "effects": {
          "type": "object"
        },
        "singleRoleStatement": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "diagnostics"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha2"
        },
        "kind": {
          "const": "ApplyReport"
        },
        "ok": {
          "const": false
        },
        "command": {
          "const": "apply"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "artifact",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationId",
        "applyOrder",
        "packageDigest",
        "predecessorPackageDigest",
        "databaseId",
        "planKind",
        "appliedAt",
        "operatorReferenceHash",
        "backupReferences",
        "roleMode"
      ],
      "properties": {
        "activationId": {
          "type": "string"
        },
        "applyOrder": {
          "type": "integer",
          "minimum": 1
        },
        "packageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "predecessorPackageDigest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "databaseId": {
          "type": "string"
        },
        "planKind": {
          "enum": [
            "initial",
            "successor"
          ]
        },
        "appliedAt": {
          "type": "string"
        },
        "operatorReferenceHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "backupReferences": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "roleMode": {
          "enum": [
            "single",
            "split"
          ]
        }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
