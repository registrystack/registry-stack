{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/casework/plan-report/plan-report.v1alpha3.schema.json",
  "title": "PlanReport",
  "description": "Versioned JSON report emitted by caseworkctl for plan.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind"
  ],
  "properties": {
    "apiVersion": {
      "const": "registry.registrystack.org/caseworkctl/v1alpha3"
    },
    "kind": {
      "const": "PlanReport"
    }
  },
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "runtimeConfig",
        "active",
        "candidatePackageDigest",
        "databaseIdCheck",
        "planKind",
        "schemaVersion",
        "supportedSchemaVersion",
        "pendingSchemaVersions",
        "effects",
        "refusals",
        "runtimeRoleMode",
        "changesPending"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "plan"
        },
        "status": {
          "const": "complete"
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "PlanReport"
        },
        "runtimeConfig": {
          "type": "string"
        },
        "active": {
          "oneOf": [
            {
              "$ref": "#/$defs/activation"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidatePackageDigest": {
          "$ref": "#/$defs/Digest"
        },
        "databaseIdCheck": {
          "enum": [
            "notRecorded",
            "matches",
            "differs"
          ]
        },
        "planKind": {
          "enum": [
            "initial",
            "successor"
          ]
        },
        "schemaVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "supportedSchemaVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pendingSchemaVersions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "effects": {
          "oneOf": [
            {
              "$ref": "#/$defs/effects"
            },
            {
              "type": "null"
            }
          ]
        },
        "refusals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/refusal"
          }
        },
        "runtimeRoleMode": {
          "oneOf": [
            {
              "enum": [
                "single",
                "split"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "changesPending": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "runtimeConfig",
        "active",
        "candidatePackageDigest",
        "databaseIdCheck",
        "planKind",
        "schemaVersion",
        "supportedSchemaVersion",
        "pendingSchemaVersions",
        "effects",
        "refusals",
        "runtimeRoleMode",
        "changesPending",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "plan"
        },
        "status": {
          "const": "refused"
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "PlanReport"
        },
        "runtimeConfig": {
          "type": "string"
        },
        "active": {
          "oneOf": [
            {
              "$ref": "#/$defs/activation"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidatePackageDigest": {
          "$ref": "#/$defs/Digest"
        },
        "databaseIdCheck": {
          "enum": [
            "notRecorded",
            "matches",
            "differs"
          ]
        },
        "planKind": {
          "enum": [
            "initial",
            "successor"
          ]
        },
        "schemaVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "supportedSchemaVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pendingSchemaVersions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "effects": {
          "oneOf": [
            {
              "$ref": "#/$defs/effects"
            },
            {
              "type": "null"
            }
          ]
        },
        "refusals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/refusal"
          }
        },
        "runtimeRoleMode": {
          "oneOf": [
            {
              "enum": [
                "single",
                "split"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "changesPending": {
          "type": "boolean"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "plan"
        },
        "status": {
          "enum": [
            "domain-refusal",
            "operational-failure"
          ]
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "PlanReport"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "path",
              "message"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/diagnostic"
          },
          {
            "properties": {
              "severity": {
                "const": "warning"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationId",
        "applyOrder",
        "packageDigest",
        "predecessorPackageDigest",
        "databaseId",
        "planKind",
        "appliedAt",
        "operatorReferenceHash",
        "backupReferences",
        "roleMode"
      ],
      "properties": {
        "activationId": {
          "type": "string"
        },
        "applyOrder": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "packageDigest": {
          "$ref": "#/$defs/Digest"
        },
        "predecessorPackageDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "databaseId": {
          "type": "string"
        },
        "planKind": {
          "enum": [
            "initial",
            "successor"
          ]
        },
        "appliedAt": {
          "type": "string"
        },
        "operatorReferenceHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "backupReferences": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "roleMode": {
          "enum": [
            "single",
            "split"
          ]
        }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pinnedWork",
        "sourceGenerations",
        "taskTemplates"
      ],
      "properties": {
        "pinnedWork": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "stranded"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "clear",
                "acknowledged",
                "refused"
              ]
            },
            "stranded": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/strandedWork"
              }
            }
          }
        },
        "sourceGenerations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "change"
            ],
            "properties": {
              "sourceId": {
                "type": "string"
              },
              "change": {
                "enum": [
                  "registered",
                  "unchanged",
                  "changed"
                ]
              }
            }
          }
        },
        "taskTemplates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "templateId",
              "templateVersion",
              "change"
            ],
            "properties": {
              "templateId": {
                "type": "string"
              },
              "templateVersion": {
                "type": "string"
              },
              "change": {
                "enum": [
                  "added",
                  "activated",
                  "retained",
                  "deactivated"
                ]
              }
            }
          }
        }
      }
    },
    "strandedWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "reviews"
      ],
      "properties": {
        "reason": {
          "enum": [
            "queue-removed",
            "profile-removed",
            "review-kind-changed",
            "source-removed",
            "context-field-not-displayed",
            "displayed-field-not-projected"
          ]
        },
        "queue": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "reviewKind": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "reviews": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Digest": {
      "description": "A SHA-256 digest: `sha256:` followed by 64 lowercase hex digits.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
