{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha1/UsageReport.schema.json",
  "title": "UsageReport",
  "description": "Versioned JSON report emitted by caseworkctl for usage.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "diagnostics"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "UsageReport"
        },
        "ok": {
          "const": false
        },
        "command": {
          "const": "usage"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "artifact",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  }
}
