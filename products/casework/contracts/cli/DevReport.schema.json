{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha1/DevReport.schema.json",
  "title": "DevReport",
  "description": "Versioned JSON report emitted by caseworkctl for dev.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "command",
        "status",
        "project",
        "stateFile",
        "operatorConfig",
        "caseworkUrl",
        "tokenEndpoint",
        "issuer",
        "clientAssertionAudience",
        "resource",
        "audience",
        "journal",
        "sources",
        "clients",
        "directory"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "DevReport"
        },
        "ok": {
          "const": true
        },
        "command": {
          "const": "dev"
        },
        "status": {
          "enum": [
            "starting",
            "ready",
            "stopping",
            "stopped",
            "failed"
          ]
        },
        "project": {
          "type": "string"
        },
        "stateFile": {
          "type": "string"
        },
        "operatorConfig": {
          "type": "string"
        },
        "caseworkUrl": {
          "type": "string"
        },
        "tokenEndpoint": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "clientAssertionAudience": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "journal": {
          "type": "string"
        },
        "sources": {
          "type": "object"
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "directory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "teams"
          ],
          "properties": {
            "revision": {
              "type": "integer"
            },
            "teams": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "diagnostics"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "DevReport"
        },
        "ok": {
          "const": false
        },
        "command": {
          "const": "dev"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "artifact",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  }
}
