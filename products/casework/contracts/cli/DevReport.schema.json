{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/casework/dev-report/dev-report.v1alpha3.schema.json",
  "title": "CaseworkDevReport",
  "description": "Versioned JSON report emitted by caseworkctl for dev.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind"
  ],
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/casework/dev-report/v1alpha3"
    },
    "kind": {
      "const": "CaseworkDevReport"
    }
  },
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "project",
        "stateFile",
        "operatorConfig",
        "caseworkUrl",
        "tokenEndpoint",
        "issuer",
        "clientAssertionAudience",
        "resource",
        "audience",
        "journal",
        "sources",
        "clients",
        "directory"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "dev"
        },
        "status": {
          "enum": [
            "starting",
            "ready",
            "stopping",
            "stopped",
            "failed"
          ]
        },
        "apiVersion": {
          "const": "id.registrystack.org/formats/casework/dev-report/v1alpha3"
        },
        "kind": {
          "const": "CaseworkDevReport"
        },
        "project": {
          "type": "string"
        },
        "stateFile": {
          "type": "string"
        },
        "operatorConfig": {
          "type": "string"
        },
        "caseworkUrl": {
          "$ref": "#/$defs/Url"
        },
        "tokenEndpoint": {
          "type": "string"
        },
        "issuer": {
          "$ref": "#/$defs/Url"
        },
        "clientAssertionAudience": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "journal": {
          "type": "string"
        },
        "sources": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/LocalId"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project",
              "bregUrl"
            ],
            "properties": {
              "project": {
                "type": "string"
              },
              "bregUrl": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/Url"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "profile",
              "role",
              "clientIdFile",
              "assertionKeyFile"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/LocalId"
              },
              "profile": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "staff",
                  "supervisor",
                  "administrator",
                  "requester"
                ]
              },
              "clientIdFile": {
                "type": "string"
              },
              "assertionKeyFile": {
                "type": "string"
              }
            }
          }
        },
        "directory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "teams"
          ],
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "teams": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "dev"
        },
        "status": {
          "enum": [
            "domain-refusal",
            "operational-failure"
          ]
        },
        "apiVersion": {
          "const": "id.registrystack.org/formats/casework/dev-report/v1alpha3"
        },
        "kind": {
          "const": "CaseworkDevReport"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "path",
              "message"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/diagnostic"
          },
          {
            "properties": {
              "severity": {
                "const": "warning"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "LocalId": {
      "description": "A local identifier: a lowercase letter, then up to 63 lowercase letters, digits, `_`, or `-`.",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "Url": {
      "description": "An absolute http or https URL with a host, no user information, and no whitespace or control character.",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+([/?#][^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]*)?$",
      "type": "string"
    }
  }
}
