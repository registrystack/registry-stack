{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/casework/attempt-uncertain-marking-report/attempt-uncertain-marking-report.v1alpha3.schema.json",
  "title": "CaseworkAttemptUncertainMarkingReport",
  "description": "Versioned JSON report emitted by caseworkctl for attempt mark-uncertain.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind"
  ],
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/casework/attempt-uncertain-marking-report/v1alpha3"
    },
    "kind": {
      "const": "CaseworkAttemptUncertainMarkingReport"
    }
  },
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "project",
        "runtimeConfig",
        "report"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "attempt mark-uncertain"
        },
        "status": {
          "const": "complete"
        },
        "apiVersion": {
          "const": "id.registrystack.org/formats/casework/attempt-uncertain-marking-report/v1alpha3"
        },
        "kind": {
          "const": "CaseworkAttemptUncertainMarkingReport"
        },
        "project": {
          "type": "string"
        },
        "runtimeConfig": {
          "type": "string"
        },
        "report": {
          "$ref": "#/$defs/uncertainMarking"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "attempt mark-uncertain"
        },
        "status": {
          "enum": [
            "domain-refusal",
            "operational-failure"
          ]
        },
        "apiVersion": {
          "const": "id.registrystack.org/formats/casework/attempt-uncertain-marking-report/v1alpha3"
        },
        "kind": {
          "const": "CaseworkAttemptUncertainMarkingReport"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "path",
              "message"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/diagnostic"
          },
          {
            "properties": {
              "severity": {
                "const": "warning"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "uncertainMarking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptId",
        "itemId",
        "operation",
        "bindingReference",
        "reason",
        "decidedBy",
        "attemptState",
        "itemState",
        "applied",
        "originalActor",
        "originalProfileId"
      ],
      "properties": {
        "attemptId": {
          "type": "string",
          "format": "uuid"
        },
        "itemId": {
          "type": "string",
          "format": "uuid"
        },
        "operation": {
          "type": "string"
        },
        "bindingReference": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "decidedBy": {
          "type": "string"
        },
        "attemptState": {
          "enum": [
            "pending",
            "uncertain",
            "completed",
            "refused"
          ]
        },
        "itemState": {
          "type": "string"
        },
        "applied": {
          "type": "boolean"
        },
        "originalActor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "subject"
          ],
          "properties": {
            "issuer": {
              "$ref": "#/$defs/Url"
            },
            "subject": {
              "type": "string"
            }
          }
        },
        "originalProfileId": {
          "type": "string"
        }
      }
    },
    "Url": {
      "description": "An absolute http or https URL with a host, no user information, and no whitespace or control character.",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+([/?#][^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]*)?$",
      "type": "string"
    }
  }
}
