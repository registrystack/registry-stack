{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha1/CheckReport.schema.json",
  "title": "CheckReport",
  "description": "Versioned JSON report emitted by caseworkctl for check.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "command",
        "status",
        "project",
        "effective",
        "profile",
        "findings",
        "networkAccess",
        "databaseAccess"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "CheckReport"
        },
        "ok": {
          "const": true
        },
        "command": {
          "const": "check"
        },
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "project": {
          "type": "string"
        },
        "effective": {
          "type": "object"
        },
        "profile": {
          "enum": [
            "authoring",
            "production"
          ]
        },
        "findings": {
          "$ref": "#/$defs/findings"
        },
        "networkAccess": {
          "const": false
        },
        "databaseAccess": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "diagnostics"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "CheckReport"
        },
        "ok": {
          "const": false
        },
        "command": {
          "const": "check"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "artifact",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  }
}
