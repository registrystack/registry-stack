{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha3/CheckReport.schema.json",
  "title": "CheckReport",
  "description": "Versioned JSON report emitted by caseworkctl for check.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "project",
        "effective",
        "profile",
        "filesChecked",
        "diagnostics",
        "networkAccess",
        "databaseAccess"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "check"
        },
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "CheckReport"
        },
        "project": {
          "type": "string"
        },
        "effective": {
          "type": "object"
        },
        "profile": {
          "enum": [
            "authoring",
            "production"
          ]
        },
        "filesChecked": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3139
        },
        "diagnostics": {
          "$ref": "#/$defs/warnings"
        },
        "networkAccess": {
          "const": false
        },
        "databaseAccess": {
          "const": false
        },
        "runtimeConfig": {
          "type": "string"
        },
        "bregPackage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "packageDigest",
            "registryRevision",
            "sourceId",
            "sourceRevision",
            "pin"
          ],
          "properties": {
            "package": {
              "type": "string"
            },
            "packageDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "registryRevision": {
              "type": "string"
            },
            "sourceId": {
              "type": "string"
            },
            "sourceRevision": {
              "type": "string"
            },
            "pin": {
              "const": "current"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "check"
        },
        "status": {
          "enum": [
            "domain-refusal",
            "operational-failure"
          ]
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "CheckReport"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "path",
              "message"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/diagnostic"
          },
          {
            "properties": {
              "severity": {
                "const": "warning"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    }
  }
}
