{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/casework/check-report/check-report.v1alpha3.schema.json",
  "title": "CheckReport",
  "description": "Versioned JSON report emitted by caseworkctl for check.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind"
  ],
  "properties": {
    "apiVersion": {
      "const": "registry.registrystack.org/caseworkctl/v1alpha3"
    },
    "kind": {
      "const": "CheckReport"
    }
  },
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "project",
        "effective",
        "profile",
        "filesChecked",
        "diagnostics",
        "networkAccess",
        "databaseAccess"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "check"
        },
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "CheckReport"
        },
        "project": {
          "type": "string"
        },
        "effective": {
          "$ref": "#/$defs/effective"
        },
        "profile": {
          "enum": [
            "authoring",
            "production"
          ]
        },
        "filesChecked": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3140
        },
        "diagnostics": {
          "$ref": "#/$defs/warnings"
        },
        "networkAccess": {
          "const": false
        },
        "databaseAccess": {
          "const": false
        },
        "runtimeConfig": {
          "type": "string"
        },
        "bregPackage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "packageDigest",
            "registryRevision",
            "sourceId",
            "sourceRevision",
            "pin"
          ],
          "properties": {
            "package": {
              "type": "string"
            },
            "packageDigest": {
              "$ref": "#/$defs/Digest"
            },
            "registryRevision": {
              "type": "string"
            },
            "sourceId": {
              "type": "string"
            },
            "sourceRevision": {
              "type": "string"
            },
            "pin": {
              "const": "current"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "command",
        "status",
        "apiVersion",
        "kind",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "command": {
          "const": "check"
        },
        "status": {
          "enum": [
            "domain-refusal",
            "operational-failure"
          ]
        },
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha3"
        },
        "kind": {
          "const": "CheckReport"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048577
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "path",
              "message"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048577
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/diagnostic"
          },
          {
            "properties": {
              "severity": {
                "const": "warning"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "effective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "inbox",
        "reviewKinds",
        "reviewProducers"
      ],
      "properties": {
        "projectId": {
          "type": "string"
        },
        "mode": {
          "const": "standalone"
        },
        "queues": {
          "type": "array",
          "items": {
            "$ref": "../project/project.v1alpha1.schema.json#/$defs/QueuePolicy"
          }
        },
        "reviewKinds": {
          "type": "array",
          "items": {
            "$ref": "../project/project.v1alpha1.schema.json#/$defs/ReviewKindPolicy"
          }
        },
        "reviewProducers": {
          "type": "array",
          "items": {
            "$ref": "../project/project.v1alpha1.schema.json#/$defs/ReviewProducerPolicy"
          }
        },
        "inbox": {
          "$ref": "../project/project.v1alpha1.schema.json#/$defs/InboxPolicy"
        },
        "sourceConnections": {
          "const": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkedSource"
          }
        },
        "sourceDescription": {
          "type": "string"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources",
            "queues"
          ],
          "properties": {
            "sources": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "queues": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "checkedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceAdapter",
        "requests"
      ],
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "sourceAdapter": {
          "type": "string"
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkedRequest"
          }
        }
      }
    },
    "checkedRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "queue",
        "queueMode",
        "routingRules",
        "applicationMode",
        "clock",
        "target"
      ],
      "properties": {
        "entity": {
          "type": "string"
        },
        "queue": {
          "type": "string"
        },
        "queueMode": {
          "type": "string"
        },
        "routingRules": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "applicationMode": {
          "type": [
            "string",
            "null"
          ]
        },
        "clock": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "Digest": {
      "description": "A SHA-256 digest: `sha256:` followed by 64 lowercase hex digits.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
