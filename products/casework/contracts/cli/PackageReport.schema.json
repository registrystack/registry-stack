{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/caseworkctl/v1alpha1/PackageReport.schema.json",
  "title": "PackageReport",
  "description": "Versioned JSON report emitted by caseworkctl for package.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "command",
        "project",
        "dryRun",
        "policyDigest",
        "files",
        "runtimeConfigurationIncluded",
        "secretsIncluded",
        "networkAccess",
        "databaseAccess"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "PackageReport"
        },
        "ok": {
          "const": true
        },
        "command": {
          "const": "package"
        },
        "project": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "runtimeConfigurationIncluded": {
          "const": false
        },
        "secretsIncluded": {
          "const": false
        },
        "networkAccess": {
          "const": false
        },
        "databaseAccess": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "ok",
        "diagnostics"
      ],
      "properties": {
        "apiVersion": {
          "const": "registry.registrystack.org/caseworkctl/v1alpha1"
        },
        "kind": {
          "const": "PackageReport"
        },
        "ok": {
          "const": false
        },
        "command": {
          "const": "package"
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    }
  ],
  "$defs": {
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "artifact",
        "path",
        "message",
        "suggestedAction"
      ],
      "properties": {
        "severity": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  }
}
