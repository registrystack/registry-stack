{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/discovery/schema/v1alpha1/registry-discovery-v1alpha1.schema.json",
  "title": "Registry Discovery v1alpha1 provider description",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "@type", "profile", "services"],
  "properties": {
    "@context": {"const": "https://registrystack.org/discovery/context/v1alpha1"},
    "@type": {"const": "dcat:Catalog"},
    "profile": {"const": "registry-discovery-v1alpha1"},
    "services": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/service"}}
  },
  "$defs": {
    "identifier": {"type": "string", "format": "uri", "minLength": 1, "maxLength": 4096, "pattern": "^\\S(?:[^\\u0000-\\u001F\\u007F-\\u009F]*\\S)?$"},
    "identifierSet": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "optionalIdentifierSet": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^\\S(?:[^\\u0000-\\u001F\\u007F-\\u009F]*\\S)?$"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@type", "bindingId", "serviceId", "serviceKind", "title", "description", "endpointURL", "jurisdictions", "conformsTo"],
      "properties": {
        "@type": {"const": "dcat:DataService"},
        "bindingId": {"$ref": "#/$defs/identifier"},
        "serviceId": {"$ref": "#/$defs/identifier"},
        "serviceKind": {"enum": ["evidence", "relay"]},
        "title": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "endpointURL": {"type": "string", "format": "uri", "maxLength": 4096, "pattern": "^(?:https://[^/?#@]+|http://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]+)?)(?:/[^?#]*)?$"},
        "publisherId": {"$ref": "#/$defs/identifier"},
        "operatorId": {"$ref": "#/$defs/identifier"},
        "registryAuthorityId": {"$ref": "#/$defs/identifier"},
        "legalIssuerId": {"$ref": "#/$defs/identifier"},
        "technicalProviderId": {"$ref": "#/$defs/identifier"},
        "jurisdictions": {"$ref": "#/$defs/identifierSet"},
        "conformsTo": {"$ref": "#/$defs/identifierSet"},
        "evidenceTypeIds": {"$ref": "#/$defs/optionalIdentifierSet"},
        "semanticClassIds": {"$ref": "#/$defs/optionalIdentifierSet"},
        "operationFamilyIds": {"$ref": "#/$defs/optionalIdentifierSet"}
      },
      "allOf": [
        {"if": {"properties": {"serviceKind": {"const": "evidence"}}, "required": ["serviceKind"]}, "then": {"required": ["evidenceTypeIds"], "properties": {"evidenceTypeIds": {"$ref": "#/$defs/identifierSet"}}, "not": {"anyOf": [{"required": ["semanticClassIds"]}, {"required": ["operationFamilyIds"]}]}}},
        {"if": {"properties": {"serviceKind": {"const": "relay"}}, "required": ["serviceKind"]}, "then": {"not": {"required": ["evidenceTypeIds"]}}}
      ]
    }
  }
}
