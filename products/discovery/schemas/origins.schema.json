{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/discovery/schema/origins-v1alpha1.json",
  "title": "Registry Discovery approved origins",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "origins"],
  "properties": {
    "schemaVersion": {"const": "registry-discovery/origins/v1alpha1"},
    "origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/origin"}
    }
  },
  "$defs": {
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originId", "catalogUrl", "profile", "enabled"],
      "properties": {
        "originId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "catalogUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^https://[^\\s\\u0000-\\u001F\\u007F-\\u009F/?#@]+(?!.*//)(?:/[^\\s\\u0000-\\u001F\\u007F-\\u009F?#]*)?$",
          "description": "Exact production HTTPS URL without credentials, query, or fragment. Loopback HTTP is a CLI development-mode exception, not part of this production authoring schema."
        },
        "profile": {"const": "registry-discovery-v1alpha1"},
        "enabled": {"type": "boolean"}
      }
    }
  }
}
