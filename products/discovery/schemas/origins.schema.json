{
  "$defs": {
    "ApprovedOrigin": {
      "additionalProperties": false,
      "description": "One approved origin: a provider whose public description the index\ncollects.",
      "properties": {
        "catalogUrl": {
          "$ref": "#/$defs/Url",
          "description": "Exact production HTTPS URL without credentials, query, or fragment.\nLoopback HTTP is a development exception `discoveryctl` accepts only\nwith `--allow-loopback`, not part of this production authoring schema.",
          "pattern": "^https://[^\\s\\u0000-\\u001F\\u007F-\\u009F/?#@]+(?!.*//)(?:/[^\\s\\u0000-\\u001F\\u007F-\\u009F?#]*)?$"
        },
        "enabled": {
          "description": "Whether `discoveryctl package` collects this origin.",
          "type": "boolean"
        },
        "originId": {
          "description": "The origin's name in this project: 1 to 128 characters from `A-Z`,\n`a-z`, `0-9`, `.`, `_`, and `-`.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/OriginProfile"
        }
      },
      "required": [
        "originId",
        "catalogUrl",
        "profile",
        "enabled"
      ],
      "type": "object"
    },
    "OriginProfile": {
      "description": "The publication profile an approved origin implements.",
      "enum": [
        "registry-discovery-v1alpha1"
      ],
      "type": "string"
    },
    "Url": {
      "description": "An absolute http or https URL with a host, no user information, and no whitespace or control character.",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+([/?#][^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]*)?$",
      "type": "string"
    }
  },
  "$id": "https://id.registrystack.org/schemas/discovery/origins/origins.v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The origins the operator approves for one index.",
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/discovery/origins/v1alpha1",
      "description": "The format and version of this file.",
      "type": "string"
    },
    "kind": {
      "const": "DiscoveryOrigins",
      "description": "The kind of this file.",
      "type": "string"
    },
    "origins": {
      "description": "One to 128 approved origins.",
      "items": {
        "$ref": "#/$defs/ApprovedOrigin"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "origins"
  ],
  "title": "Registry Discovery approved origins",
  "type": "object"
}
