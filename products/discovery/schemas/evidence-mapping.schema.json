{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/discovery/schema/evidence-mapping-v1alpha1.json",
  "title": "Registry Discovery requirement-to-evidence-type mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mappingId", "mappingAuthorityId", "requirementId", "alternatives"],
  "properties": {
    "schemaVersion": {"const": "registry-discovery/evidence-mapping/v1alpha1"},
    "mappingId": {"$ref": "#/$defs/identifier"},
    "mappingAuthorityId": {"$ref": "#/$defs/identifier"},
    "requirementId": {"$ref": "#/$defs/identifier"},
    "jurisdiction": {"$ref": "#/$defs/identifier"},
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/alternative"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "format": "uri", "minLength": 1, "maxLength": 4096},
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceTypeListId", "evidenceTypeIds"],
      "properties": {
        "evidenceTypeListId": {"$ref": "#/$defs/identifier"},
        "evidenceTypeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  }
}
