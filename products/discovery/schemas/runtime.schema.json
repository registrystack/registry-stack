{
  "$defs": {
    "Digest": {
      "description": "A SHA-256 digest: `sha256:` followed by 64 lowercase hex digits.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ListenerBind": {
      "description": "Socket address the runtime listens on, written host:port with an IP address host ([addr]:port for IPv6).",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "LogLevel": {
      "enum": [
        "error",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "PackageConfig": {
      "additionalProperties": false,
      "description": "The package a runtime serves: `root` is the absolute package directory,\nand `expectedDigest`, when set, pins the package digest the runtime must\nfind there. The package digest is the digest of the package's\n`SHA256SUMS` file; see [`crate::package`].",
      "properties": {
        "expectedDigest": {
          "$ref": "#/$defs/Digest",
          "description": "`sha256:` label of the package digest, the digest of the package's\n`SHA256SUMS` file. When set, the runtime refuses to start on any other\npackage."
        },
        "root": {
          "description": "Absolute path of the package directory.",
          "pattern": "^/",
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "type": "object"
    },
    "RuntimeListener": {
      "additionalProperties": false,
      "description": "The address the service listens on and the time it gives one request.",
      "properties": {
        "bind": {
          "$ref": "#/$defs/ListenerBind"
        },
        "requestTimeoutMilliseconds": {
          "description": "Time allowed to handle one inbound request, in milliseconds.",
          "format": "uint64",
          "maximum": 300000,
          "minimum": 1000,
          "type": "integer"
        }
      },
      "required": [
        "bind",
        "requestTimeoutMilliseconds"
      ],
      "type": "object"
    },
    "ipv4SocketHost": {
      "description": "Four canonical decimal IPv4 octets followed by a decimal port.",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0)\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0):[0-9]+$"
    },
    "ipv6HexSocketHost": {
      "description": "A bracketed hexadecimal IPv6 literal, including every RFC 3986 compression position, followed by a decimal port.",
      "pattern": "^\\[(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:))\\]:[0-9]+$"
    },
    "ipv6MixedSocketHost": {
      "description": "A bracketed IPv6 literal whose final 32 bits use canonical dotted-decimal IPv4 notation, followed by a decimal port.",
      "pattern": "^\\[(?:(?:[0-9A-Fa-f]{1,4}:){6}|::(?:[0-9A-Fa-f]{1,4}:){5}|(?:[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){4}|(?:(?:[0-9A-Fa-f]{1,4}:){0,1}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){3}|(?:(?:[0-9A-Fa-f]{1,4}:){0,2}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){2}|(?:(?:[0-9A-Fa-f]{1,4}:){0,3}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}:|(?:(?:[0-9A-Fa-f]{1,4}:){0,4}[0-9A-Fa-f]{1,4})?::)(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0)\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0)\\]:[0-9]+$"
    },
    "socketPort": {
      "description": "A decimal u16 port, including zero and Rust-compatible leading zeroes.",
      "pattern": ":0*(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    }
  },
  "$id": "https://id.registrystack.org/schemas/discovery/runtime/runtime.v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The operator runtime configuration document.",
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/discovery/runtime/v1alpha1",
      "type": "string"
    },
    "kind": {
      "const": "DiscoveryRuntimeConfig",
      "type": "string"
    },
    "limits": {
      "additionalProperties": false,
      "description": "The bounds the service applies to every request and response.",
      "properties": {
        "maximumRequestBytes": {
          "description": "Largest request body, in bytes, the service reads.",
          "format": "uint64",
          "maximum": 16777216,
          "minimum": 1,
          "type": "integer"
        },
        "maximumResponseBytes": {
          "description": "Largest response body, in bytes, the service writes.",
          "format": "uint64",
          "maximum": 16777216,
          "minimum": 65536,
          "type": "integer"
        },
        "maximumResultAlternatives": {
          "description": "Most evidence-type alternatives one response returns.",
          "format": "uint64",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "maximumResultRecords": {
          "description": "Most service records one response returns.",
          "format": "uint64",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "shutdownGraceMilliseconds": {
          "description": "Time allowed to drain in-flight requests on shutdown, in milliseconds.",
          "format": "uint64",
          "maximum": 300000,
          "minimum": 1000,
          "type": "integer"
        }
      },
      "required": [
        "maximumRequestBytes",
        "maximumResponseBytes",
        "maximumResultRecords",
        "maximumResultAlternatives",
        "shutdownGraceMilliseconds"
      ],
      "type": "object"
    },
    "listener": {
      "$ref": "#/$defs/RuntimeListener",
      "allOf": [
        {
          "properties": {
            "bind": {
              "allOf": [
                {
                  "$ref": "#/$defs/socketPort"
                },
                {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ipv4SocketHost"
                    },
                    {
                      "$ref": "#/$defs/ipv6HexSocketHost"
                    },
                    {
                      "$ref": "#/$defs/ipv6MixedSocketHost"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "logLevel": {
      "$ref": "#/$defs/LogLevel",
      "description": "The least severe event the service logs."
    },
    "package": {
      "$ref": "#/$defs/PackageConfig",
      "allOf": [
        {
          "properties": {
            "root": {
              "not": {
                "pattern": "(^|/)\\.{1,2}(/|$)"
              }
            }
          }
        }
      ],
      "description": "The package directory `discoveryctl package` built."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "listener",
    "package",
    "limits",
    "logLevel"
  ],
  "title": "Registry Discovery runtime configuration",
  "type": "object"
}
