      "value": "ftp://provider.example/catalog.jsonld"
    },
    {
      "name": "origins-refuses-query-bearing-url",
      "contract": "origins",
      "pointer": "/origins/0/catalogUrl",
      "value": "https://provider.example/catalog.jsonld?private=true"
    },
    {
      "name": "origins-refuses-whitespace-before-url-parsing",
      "contract": "origins",
      "pointer": "/origins/0/catalogUrl",
      "value": " https://provider.example/catalog.jsonld"
    },
    {
      "name": "origins-refuses-empty-catalog-path-segments",
      "contract": "origins",
      "pointer": "/origins/0/catalogUrl",
      "value": "https://provider.example/a//catalog.jsonld"
    },
    {
      "name": "mapping-refuses-unknown-root-member",
