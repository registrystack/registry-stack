{
  "schemaVersion": "registry-discovery/schema-negative-corpus/v1alpha1",
  "cases": [
    {
      "name": "origins-refuses-unknown-root-member",
      "contract": "origins",
      "pointer": "/unexpected",
      "value": true
    },
    {
      "name": "origins-refuses-invalid-origin-id",
      "contract": "origins",
      "pointer": "/origins/0/originId",
      "value": "contains spaces"
    },
    {
      "name": "origins-refuses-non-https-production-url",
