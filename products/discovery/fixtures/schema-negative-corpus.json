      "pointer": "/limits/maximumRequestBytes",
      "value": 0
    },
    {
      "name": "runtime-refuses-response-bound-below-service-minimum",
      "contract": "runtime",
      "pointer": "/limits/maximumResponseBytes",
      "value": 65535
    },
    {
      "name": "runtime-refuses-non-socket-listener",
      "contract": "runtime",
