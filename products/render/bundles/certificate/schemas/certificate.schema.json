{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reference", "recipient-name", "registry-identifier", "recorded-date", "valid-until", "verify-url"],
  "properties": {
    "reference": { "type": "string", "minLength": 1 },
    "recipient-name": { "type": "string", "minLength": 1 },
    "registry-identifier": { "type": "string", "minLength": 1 },
    "recorded-date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "valid-until": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "verify-url": { "type": "string", "pattern": "^https://[^ ]+$" }
  }
}
