{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reference", "payer-name-ar", "payer-name-fr", "payer-id", "region", "amount", "currency", "date", "method-ar", "purpose-ar", "verify-url", "bidi-note"],
  "properties": {
    "reference": { "type": "string", "minLength": 1 },
    "payer-name-ar": { "type": "string", "minLength": 1 },
    "payer-name-fr": { "type": "string", "minLength": 1 },
    "payer-id": { "type": "string", "pattern": "^[0-9]{10}$" },
    "region": { "type": "string" },
    "amount": { "type": "string", "pattern": "^[0-9][0-9 ]*(,[0-9]{2})?$" },
    "currency": { "type": "string", "enum": ["XTS"] },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "method-ar": { "type": "string" },
    "purpose-ar": { "type": "string" },
    "verify-url": { "type": "string", "pattern": "^https://[^ ]+$" },
    "bidi-note": { "type": "string" }
  }
}
