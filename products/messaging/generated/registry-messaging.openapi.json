{
  "components": {
    "schemas": {
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "authentication.refused",
              "content.invalid",
              "content.too-large",
              "content.too-many-segments",
              "idempotency.expired",
              "idempotency.key-reused",
              "message.not-visible",
              "operation.not-authorized",
              "profile.not-authorized",
              "request.body-too-large",
              "request.invalid",
              "request.method-not-allowed",
              "request.not-found",
              "request.unprocessable",
              "request.unsupported-media-type",
              "service.unavailable",
              "template.data-invalid",
              "template.locale-unavailable",
              "template.not-found",
              "template.render-refused"
            ],
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "type": {
            "enum": [
              "https://id.registrystack.org/problems/registry-messaging/authentication/refused",
              "https://id.registrystack.org/problems/registry-messaging/content/invalid",
              "https://id.registrystack.org/problems/registry-messaging/content/too-large",
              "https://id.registrystack.org/problems/registry-messaging/content/too-many-segments",
              "https://id.registrystack.org/problems/registry-messaging/idempotency/expired",
              "https://id.registrystack.org/problems/registry-messaging/idempotency/key-reused",
              "https://id.registrystack.org/problems/registry-messaging/message/not-visible",
              "https://id.registrystack.org/problems/registry-messaging/operation/not-authorized",
              "https://id.registrystack.org/problems/registry-messaging/profile/not-authorized",
              "https://id.registrystack.org/problems/registry-messaging/request/body-too-large",
              "https://id.registrystack.org/problems/registry-messaging/request/invalid",
              "https://id.registrystack.org/problems/registry-messaging/request/method-not-allowed",
              "https://id.registrystack.org/problems/registry-messaging/request/not-found",
              "https://id.registrystack.org/problems/registry-messaging/request/unprocessable",
              "https://id.registrystack.org/problems/registry-messaging/request/unsupported-media-type",
              "https://id.registrystack.org/problems/registry-messaging/service/unavailable",
              "https://id.registrystack.org/problems/registry-messaging/template/data-invalid",
              "https://id.registrystack.org/problems/registry-messaging/template/locale-unavailable",
              "https://id.registrystack.org/problems/registry-messaging/template/not-found",
              "https://id.registrystack.org/problems/registry-messaging/template/render-refused"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "traceId"
        ],
        "type": "object"
      },
      "TemplatePreview": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "enum": [
              "email",
              "sms"
            ],
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "packageDigest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "parts": {
            "additionalProperties": false,
            "properties": {
              "html": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ],
            "type": "object"
          },
          "sms": {
            "additionalProperties": false,
            "description": "The segment count, for an SMS template only.",
            "properties": {
              "encoding": {
                "enum": [
                  "gsm7",
                  "ucs2"
                ],
                "type": "string"
              },
              "segments": {
                "minimum": 1,
                "type": "integer"
              },
              "units": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "encoding",
              "units",
              "segments"
            ],
            "type": "object"
          },
          "template": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "type": "object"
          }
        },
        "required": [
          "template",
          "locale",
          "channel",
          "packageDigest",
          "parts"
        ],
        "type": "object"
      },
      "TemplatePreviewRequest": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "description": "The template data, validated against the template version's schema before rendering."
          },
          "locale": {
            "description": "A locale the template version declares.",
            "type": "string"
          }
        },
        "required": [
          "locale",
          "data"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Registry Messaging HTTP contract. Every refusal is one application/problem+json document from the closed vocabulary.",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "Registry Messaging API",
    "version": "v1alpha1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The operation succeeded. The body is empty."
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "request.method-not-allowed"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: request.method-not-allowed."
          }
        },
        "security": [],
        "summary": "Report that the process is serving."
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReady",
        "responses": {
          "200": {
            "description": "The operation succeeded. The body is empty."
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "request.method-not-allowed"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: request.method-not-allowed."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "service.unavailable"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: service.unavailable."
          }
        },
        "security": [],
        "summary": "Report that the store answers with the expected schema."
      }
    },
    "/v1/messages/{message_id}": {
      "get": {
        "operationId": "getMessage",
        "parameters": [
          {
            "in": "path",
            "name": "message_id",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The operation succeeded. The body is empty."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "authentication.refused"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: authentication.refused."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "profile.not-authorized"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: profile.not-authorized."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "message.not-visible"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: message.not-visible."
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "request.method-not-allowed"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: request.method-not-allowed."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "service.unavailable"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: service.unavailable."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Read the status of a message the caller submitted, or any message for an operator. A message the caller may not see answers exactly like one that does not exist."
      }
    },
    "/v1/templates/{template_id}/versions/{version}/preview": {
      "post": {
        "operationId": "previewTemplate",
        "parameters": [
          {
            "in": "path",
            "name": "template_id",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TemplatePreviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplatePreview"
                }
              }
            },
            "description": "The operation succeeded."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "request.invalid"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: request.invalid."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "authentication.refused"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: authentication.refused."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "operation.not-authorized",
                            "profile.not-authorized"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: operation.not-authorized, profile.not-authorized."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "template.not-found"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: template.not-found."
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "request.method-not-allowed"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: request.method-not-allowed."
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "request.body-too-large"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: request.body-too-large."
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "request.unsupported-media-type"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: request.unsupported-media-type."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "request.unprocessable",
                            "template.data-invalid",
                            "template.locale-unavailable",
                            "template.render-refused"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: request.unprocessable, template.data-invalid, template.locale-unavailable, template.render-refused."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "service.unavailable"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "A problem: service.unavailable."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Render a template version of the active package with the given locale and data, for a sender whose profile lists the template. Nothing is persisted; the body is byte-identical to `messagingctl preview --format json`."
      }
    }
  }
}
