{
  "$defs": {
    "AuditConfig": {
      "additionalProperties": false,
      "properties": {
        "hashKeyRef": {
          "pattern": "^secret:(?:env|file)/",
          "type": "string"
        },
        "path": {
          "pattern": "^/",
          "type": "string"
        }
      },
      "required": [
        "path",
        "hashKeyRef"
      ],
      "type": "object"
    },
    "AuthenticationConfig": {
      "additionalProperties": false,
      "properties": {
        "oidc": {
          "$ref": "#/$defs/OidcConfig"
        }
      },
      "required": [
        "oidc"
      ],
      "type": "object"
    },
    "CallbackVerifierConfig": {
      "description": "How the provider's delivery callbacks are authenticated, from a closed set of algorithms. Required exactly when the package declares `receipts: callback`; there is no unauthenticated kind.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "HMAC-SHA1 over `url` and the request's query, followed by the form parameters sorted by name, base64 in `header`.",
          "properties": {
            "header": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
              "type": "string"
            },
            "kind": {
              "const": "hmac-sha1-url-form",
              "type": "string"
            },
            "secretRef": {
              "pattern": "^(?:secret:env/[A-Z][A-Z0-9_]{0,127}|secret:file/[a-z][a-z0-9._-]{0,127})$",
              "type": "string"
            },
            "url": {
              "description": "The external callback URL the provider was given and signs, exactly as given, without a query or fragment.",
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "^https?://[^?#]+$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url",
            "header",
            "secretRef"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "HMAC-SHA256 over the raw request body, in `header` as `encoding`.",
          "properties": {
            "encoding": {
              "enum": [
                "hex",
                "base64"
              ],
              "type": "string"
            },
            "header": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
              "type": "string"
            },
            "kind": {
              "const": "hmac-sha256-body",
              "type": "string"
            },
            "secretRef": {
              "pattern": "^(?:secret:env/[A-Z][A-Z0-9_]{0,127}|secret:file/[a-z][a-z0-9._-]{0,127})$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "header",
            "encoding",
            "secretRef"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A secret random token as the last segment of the callback path.",
          "properties": {
            "kind": {
              "const": "path-token",
              "type": "string"
            },
            "tokenRef": {
              "pattern": "^(?:secret:env/[A-Z][A-Z0-9_]{0,127}|secret:file/[a-z][a-z0-9._-]{0,127})$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tokenRef"
          ],
          "type": "object"
        }
      ]
    },
    "CredentialPlacement": {
      "description": "Where an OAuth client secret travels in the token request.",
      "enum": [
        "basic-header",
        "form-body"
      ],
      "type": "string"
    },
    "DatabaseConfig": {
      "additionalProperties": false,
      "properties": {
        "migrationUrlRef": {
          "pattern": "^secret:(?:env|file)/",
          "type": "string"
        },
        "runtimeUrlRef": {
          "pattern": "^secret:(?:env|file)/",
          "type": "string"
        },
        "testOnlyPlaintext": {
          "default": false,
          "type": "boolean"
        },
        "trustedRootCertificateRef": {
          "default": null,
          "pattern": "^secret:(?:env|file)/",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "runtimeUrlRef",
        "migrationUrlRef"
      ],
      "type": "object"
    },
    "EnvironmentSecretProviderConfig": {
      "additionalProperties": false,
      "type": "object"
    },
    "FileSecretProviderConfig": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "pattern": "^/",
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "type": "object"
    },
    "HttpProviderAuthentication": {
      "description": "How a send authenticates to the provider. The credential is added by\nRust after the prepare script returns; no script ever sees it.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "No credential. Only for a loopback development provider.",
          "properties": {
            "kind": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`Authorization: Basic` over the two resolved values.",
          "properties": {
            "kind": {
              "const": "basic",
              "type": "string"
            },
            "passwordRef": {
              "type": "string"
            },
            "usernameRef": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "usernameRef",
            "passwordRef"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`Authorization: <scheme> <token>`. Absent, the scheme is `Bearer`,\nthe only one the destination substrate presents today.",
          "properties": {
            "kind": {
              "const": "static-authorization",
              "type": "string"
            },
            "scheme": {
              "type": [
                "string",
                "null"
              ]
            },
            "tokenRef": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tokenRef"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The resolved value in the named request header.",
          "properties": {
            "headerName": {
              "type": "string"
            },
            "kind": {
              "const": "static-api-key",
              "type": "string"
            },
            "valueRef": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "headerName",
            "valueRef"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The resolved value in the named query parameter, appended after the\nscript's own target.",
          "properties": {
            "kind": {
              "const": "static-api-key-query",
              "type": "string"
            },
            "parameterName": {
              "type": "string"
            },
            "valueRef": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "parameterName",
            "valueRef"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An OAuth 2.0 client-credentials bearer token, fetched from\n`tokenEndpoint` and cached.",
          "properties": {
            "assumedLifetimeSeconds": {
              "description": "The lifetime assumed when the token response carries no\n`expires_in`. Absent, `expires_in` is required.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "audience": {
              "type": [
                "string",
                "null"
              ]
            },
            "clientIdRef": {
              "type": "string"
            },
            "clientSecretRef": {
              "type": "string"
            },
            "credentialPlacement": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CredentialPlacement"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Where the client secret travels. The token request carries it in\nthe form body; `basic-header` is refused until the substrate can\nplace it there."
            },
            "kind": {
              "const": "oauth2-client-credentials",
              "type": "string"
            },
            "maximumCacheSeconds": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "resource": {
              "type": [
                "string",
                "null"
              ]
            },
            "scope": {
              "type": [
                "string",
                "null"
              ]
            },
            "tokenEndpoint": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tokenEndpoint",
            "clientIdRef",
            "clientSecretRef",
            "maximumCacheSeconds"
          ],
          "type": "object"
        }
      ]
    },
    "ListenerConfig": {
      "additionalProperties": false,
      "properties": {
        "bind": {
          "default": "127.0.0.1:8107",
          "type": "string"
        },
        "networkExposure": {
          "$ref": "#/$defs/ListenerNetworkExposure"
        },
        "tlsTermination": {
          "$ref": "#/$defs/TlsTermination"
        }
      },
      "required": [
        "tlsTermination"
      ],
      "type": "object"
    },
    "ListenerNetworkExposure": {
      "description": "The operator-declared private network placement of the HTTP listener.",
      "enum": [
        "private-address",
        "container-private"
      ],
      "type": "string"
    },
    "MetricsListenerConfig": {
      "additionalProperties": false,
      "description": "The operator-private listener that serves `/metrics`. It is a separate\nsocket rather than a route on the public listener, so reaching the\ncounters requires reaching a different, private address.",
      "properties": {
        "bind": {
          "type": "string"
        }
      },
      "required": [
        "bind"
      ],
      "type": "object"
    },
    "OidcConfig": {
      "additionalProperties": false,
      "properties": {
        "allowedClients": {
          "description": "The OAuth clients this runtime admits. Every access profile resolves\nits caller from the matched client, so the list is never empty, and\nevery client a profile names must appear here.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "assertionIssuers": {
          "additionalProperties": {
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "default": {},
          "description": "The assertion authorities each client may exchange a subject token\nfrom, keyed by client identifier. A deployment that performs no token\nexchange leaves this empty, and an exchanged token is then refused.",
          "maxProperties": 64,
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "type": "object"
        },
        "audience": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "jwksSource": {
          "$ref": "#/$defs/OidcJwksSource"
        },
        "jwksUri": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "scopeClaim": {
          "default": "registry_scopes",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "audience",
        "allowedClients"
      ],
      "type": "object"
    },
    "OidcJwksSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "discovery",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "documentRef": {
              "pattern": "^(?:secret:env/[A-Z][A-Z0-9_]{0,127}|secret:file/[a-z][a-z0-9._-]{0,127})$",
              "type": "string"
            },
            "kind": {
              "const": "static",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "documentRef"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderConnection": {
      "description": "One provider's runtime half. The package declares the provider's kind,\nand for an `http` provider its scripts; the two halves must name the same\nkind.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "One SMTP provider's runtime settings, as the operator writes them.",
          "properties": {
            "allowedPrivateCidrs": {
              "description": "Exact RFC 1918, CGNAT, or unique-local networks the relay may resolve\ninto. Every other non-public address is refused.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "attemptTimeoutSeconds": {
              "default": 30,
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "authentication": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SmtpAuthentication"
                },
                {
                  "type": "null"
                }
              ]
            },
            "host": {
              "description": "The relay's DNS name or IP literal. It is resolved once per attempt and\nis the name TLS verifies the relay's certificate against.",
              "type": "string"
            },
            "kind": {
              "const": "smtp",
              "type": "string"
            },
            "port": {
              "description": "Defaults to 587 for `starttls` and 465 for `implicit`; required for\n`development-loopback`.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "tls": {
              "$ref": "#/$defs/SmtpTlsMode"
            },
            "trustedRootCertificateRef": {
              "description": "A PEM root certificate trusted in addition to the public web roots,\nfor a relay behind a private certificate authority.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "host",
            "tls"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Boxed: an `http` connection is several times the size of an `smtp`\none.",
          "properties": {
            "acknowledgeQueryStringContent": {
              "description": "Required, and only allowed, when the package sends with `get`: the\nmessage content travels in the query string, where provider access\nlogs keep it.",
              "type": "boolean"
            },
            "allowedPrivateCidrs": {
              "description": "Exact RFC 1918, CGNAT, or unique-local networks an `https` provider may\nresolve into, for an in-country gateway on a private network. Every\nother non-public address is refused.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "authentication": {
              "$ref": "#/$defs/HttpProviderAuthentication"
            },
            "baseUrl": {
              "description": "The provider's origin and path prefix, ending in `/`. Every request\ntarget a script returns is relative to it and stays under it.\n`https` in production; `http` only to a loopback host.",
              "type": "string"
            },
            "callbackVerifier": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CallbackVerifierConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "concurrencyLimit": {
              "description": "The most sends this deployment has in flight to the provider, at most\nthe package's declared `capabilities.concurrencyLimit`.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "http",
              "type": "string"
            },
            "maximumResponseBytes": {
              "description": "The largest response body read, at most 1 MiB.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "redirects": {
              "$ref": "#/$defs/RedirectPolicy"
            },
            "timeoutMilliseconds": {
              "description": "One send's whole budget: resolution, connection, request, and\nresponse, at most 10000.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "tlsTrustProfile": {
              "description": "The operator-declared trust bundle the provider's certificate chains\nto, instead of the public web roots. The runtime resolves the name to\nPEM and passes it to [`HttpProviderSettings::activate`].",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "baseUrl",
            "timeoutMilliseconds",
            "maximumResponseBytes",
            "concurrencyLimit",
            "redirects",
            "authentication"
          ],
          "type": "object"
        }
      ]
    },
    "RedirectPolicy": {
      "description": "Redirect handling. A provider redirect is never followed.",
      "enum": [
        "deny"
      ],
      "type": "string"
    },
    "RetentionConfig": {
      "additionalProperties": false,
      "description": "Retention periods the retention sweep enforces. Every value is deployment\nconfiguration: a jurisdiction's retention schedule approves the deployed\nnumbers, and the audit journal records them at startup.",
      "properties": {
        "payloadDays": {
          "default": 7,
          "description": "How long a message's rendered payload and recipient contact are kept,\nfrom 1 to 30 days.",
          "format": "uint16",
          "maximum": 30,
          "minimum": 1,
          "type": "integer"
        },
        "recordDays": {
          "default": 90,
          "description": "How long the content-free message record is kept, at least as long as\nthe payload and at most ten years.",
          "format": "uint16",
          "maximum": 3650,
          "minimum": 1,
          "type": "integer"
        },
        "submissionReceiptDays": {
          "default": 7,
          "description": "How long a submission receipt stays replayable under its idempotency\nkey, from one day to the record period.",
          "format": "uint16",
          "maximum": 3650,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "RuntimePackageConfig": {
      "additionalProperties": false,
      "description": "The root of an authored Messaging package, holding `messaging.yaml` and\nits `templates/` tree.",
      "properties": {
        "expectedDigest": {
          "default": null,
          "description": "The `sha256:` digest the operator pins the package to. The runtime\ncomputes the digest of the package it reads and refuses to start when\nthe two differ.",
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "pattern": "^/",
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "type": "object"
    },
    "SecretProvidersConfig": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "file": {
              "$ref": "#/$defs/FileSecretProviderConfig"
            }
          },
          "required": [
            "file"
          ]
        },
        {
          "properties": {
            "environment": {
              "$ref": "#/$defs/EnvironmentSecretProviderConfig"
            }
          },
          "required": [
            "environment"
          ]
        }
      ],
      "properties": {
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentSecretProviderConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "file": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileSecretProviderConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "SmtpAuthentication": {
      "additionalProperties": false,
      "description": "The credential pair the relay authenticates, as `secret:` references.",
      "properties": {
        "passwordRef": {
          "type": "string"
        },
        "usernameRef": {
          "type": "string"
        }
      },
      "required": [
        "usernameRef",
        "passwordRef"
      ],
      "type": "object"
    },
    "SmtpTlsMode": {
      "description": "How the connection to the relay is protected.",
      "oneOf": [
        {
          "const": "starttls",
          "description": "Connect in plaintext and upgrade with `STARTTLS` before anything else\nis sent. The relay must offer it. Defaults to port 587.",
          "type": "string"
        },
        {
          "const": "implicit",
          "description": "TLS from the first byte. Defaults to port 465.",
          "type": "string"
        },
        {
          "const": "development-loopback",
          "description": "Plaintext to a loopback relay, for a local development server only.\nThe host must be a loopback literal or `localhost`, every resolved\naddress must be loopback, and the port must be explicit. Accepted\nonly by a test build or behind a `development-loopback` listener.",
          "type": "string"
        }
      ]
    },
    "TlsTermination": {
      "description": "Declares the trusted transport boundary for the plaintext HTTP listener.\nProduction listeners require operator-controlled upstream TLS termination;\ndirect plaintext is limited to the explicit loopback-only development mode.",
      "enum": [
        "operator-controlled-upstream",
        "development-loopback"
      ],
      "type": "string"
    },
    "TlsTrustProfileConfig": {
      "additionalProperties": false,
      "description": "A PEM bundle of one or more certificate authorities, held in the secret\nprovider so it is read under the same file checks as every credential.",
      "properties": {
        "bundleRef": {
          "type": "string"
        }
      },
      "required": [
        "bundleRef"
      ],
      "type": "object"
    }
  },
  "$id": "https://id.registrystack.org/schemas/messaging/runtime/runtime.v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The operator runtime configuration document.",
  "properties": {
    "apiVersion": {
      "const": "registry.registrystack.org/messaging-runtime/v1alpha1",
      "type": "string"
    },
    "audit": {
      "$ref": "#/$defs/AuditConfig"
    },
    "authentication": {
      "$ref": "#/$defs/AuthenticationConfig"
    },
    "database": {
      "$ref": "#/$defs/DatabaseConfig"
    },
    "kind": {
      "const": "MessagingRuntimeConfig",
      "type": "string"
    },
    "listener": {
      "$ref": "#/$defs/ListenerConfig"
    },
    "metricsListener": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricsListenerConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "package": {
      "$ref": "#/$defs/RuntimePackageConfig"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/ProviderConnection"
      },
      "description": "The runtime half of each package provider, by provider id: where the\nprovider is and how the runtime authenticates to it. A package\nprovider with no entry has no transport, and its messages fail with\n`provider-unconfigured`.",
      "type": "object"
    },
    "retention": {
      "$ref": "#/$defs/RetentionConfig",
      "default": {
        "payloadDays": 7,
        "recordDays": 90,
        "submissionReceiptDays": 7
      }
    },
    "secretProviders": {
      "$ref": "#/$defs/SecretProvidersConfig"
    },
    "tlsTrustProfiles": {
      "additionalProperties": {
        "$ref": "#/$defs/TlsTrustProfileConfig"
      },
      "description": "Named PEM bundles an `http` provider's `tlsTrustProfile` trusts\ninstead of the public web roots.",
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "package",
    "listener",
    "secretProviders",
    "database",
    "authentication",
    "audit"
  ],
  "title": "Registry Messaging runtime configuration",
  "type": "object"
}
