{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/breg/queries-explanation/queries-explanation.v1alpha4.schema.json",
  "title": "QueriesExplanation",
  "description": "Wire shape of `explanation` for `bregctl explain queries`. Every node is reconstructed field by field by bregctl and is pinned in full, except `fieldType`, which is a passthrough of the compiled field-type source and is declared opaque wherever it appears.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "operations"],
  "$defs": {
    "DerivedId": {
      "description": "An identifier the compiler derives from local identifiers: two or more local identifiers joined by `.`. It is never authored.",
      "pattern": "^[a-z][a-z0-9_-]{0,63}(\\.[a-z][a-z0-9_-]{0,63})+$",
      "type": "string"
    },
    "fieldType": {
      "type": "object",
      "description": "Passthrough of the compiled field type. Shape follows FieldTypeSource and is outside this contract version.",
      "x-registry-passthrough": "bregctl writes the compiled field type as the engine holds it; its shape follows FieldTypeSource and is outside this contract version."
    },
    "fieldSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "apiName", "sourceKind", "fieldType"],
      "properties": {
        "field": { "type": "string" },
        "apiName": { "type": "string" },
        "sourceKind": { "enum": ["stored", "derived"] },
        "fieldType": { "$ref": "#/$defs/fieldType" }
      }
    }
  },
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/breg/queries-explanation/v1alpha4"
    },
    "kind": {
      "const": "BRegQueriesExplanation"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "routeId", "profile", "entity", "kind", "apiFields", "filterable",
          "sortable", "allowCount", "selectors", "readPath", "wire", "bounds"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/DerivedId" },
          "routeId": { "type": "string" },
          "profile": { "type": "string" },
          "entity": { "type": "string" },
          "kind": { "enum": ["list", "current", "as-of", "snapshot"] },
          "apiFields": { "type": "array", "items": { "$ref": "#/$defs/fieldSummary" } },
          "selectors": { "type": "array", "items": { "$ref": "#/$defs/fieldSummary" } },
          "filterable": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["apiName", "field", "fieldType", "operators", "wireOperators", "examples"],
              "properties": {
                "apiName": { "type": "string" },
                "field": { "type": "string" },
                "fieldType": { "$ref": "#/$defs/fieldType" },
                "operators": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": ["equals", "in", "range", "is-null", "is-not-null", "prefix", "contains"]
                  }
                },
                "wireOperators": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": ["eq", "ne", "in", "ge", "gt", "le", "lt", "eq null", "ne null", "startswith", "contains"]
                  }
                },
                "examples": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "sortable": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["apiName", "field", "fieldType", "directions", "examples"],
              "properties": {
                "apiName": { "type": "string" },
                "field": { "type": "string" },
                "fieldType": { "$ref": "#/$defs/fieldType" },
                "directions": { "type": "array", "uniqueItems": true, "items": { "enum": ["asc"] } },
                "examples": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "allowCount": { "type": "boolean" },
          "readPath": { "type": ["string", "null"] },
          "wire": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "select", "filter", "orderBy", "pageSize", "count", "cursor", "accessProfile", "asOf"
            ],
            "properties": {
              "select": { "const": "$select" },
              "filter": { "const": "$filter" },
              "orderBy": { "const": "$orderby" },
              "pageSize": { "const": "$top" },
              "count": { "const": "$count" },
              "cursor": { "const": "$skiptoken" },
              "accessProfile": { "const": "accessProfile", "x-registry-member-names": true },
              "asOf": { "const": "asOf", "x-registry-member-names": true },
              "bbox": { "const": "bbox" }
            }
          },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "maximumPageSize", "maximumTop", "maximumSelectedFields", "maximumFilterPayloadBytes",
              "maximumFilterDepth", "maximumFilterNodes", "maximumFilterPredicates", "maximumInValues"
            ],
            "properties": {
              "maximumPageSize": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "maximumTop": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "maximumSelectedFields": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "maximumFilterPayloadBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "maximumFilterDepth": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "maximumFilterNodes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "maximumFilterPredicates": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "maximumInValues": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            }
          },
          "spatialQueries": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bbox"],
            "properties": {
              "bbox": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field", "apiName", "maximumLongitudeSpanDegrees", "maximumLatitudeSpanDegrees",
                  "coordinateReferenceSystem", "requiresPostgis"
                ],
                "properties": {
                  "field": { "type": "string" },
                  "apiName": { "type": "string" },
                  "maximumLongitudeSpanDegrees": { "type": "number" },
                  "maximumLatitudeSpanDegrees": { "type": "number" },
                  "coordinateReferenceSystem": { "const": "CRS84" },
                  "requiresPostgis": { "const": true }
                }
              }
            }
          },
          "gis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["collectionId", "collectionPath", "itemsPath", "accessProfile", "representation"],
            "properties": {
              "collectionId": { "type": "string" },
              "collectionPath": { "type": "string" },
              "itemsPath": { "type": "string" },
              "accessProfile": { "type": "string" },
              "representation": { "const": "application/geo+json" }
            }
          }
        }
      }
    }
  }
}
