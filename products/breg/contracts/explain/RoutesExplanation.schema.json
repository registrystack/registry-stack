{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/breg/routes-explanation/routes-explanation.v1alpha6.schema.json",
  "title": "RoutesExplanation",
  "description": "Wire shape of bregctl explain routes. Record and Action entries use their compiled inventories; Proposal instance and statistics entries project the same generated OpenAPI used by clients.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "routes"
  ],
  "$defs": {
    "DerivedId": {
      "description": "An identifier the compiler derives from local identifiers: two or more local identifiers joined by `.`. It is never authored.",
      "pattern": "^[a-z][a-z0-9_-]{0,63}(\\.[a-z][a-z0-9_-]{0,63})+$",
      "type": "string"
    },
    "HttpMethod": {
      "enum": [
        "DELETE",
        "GET",
        "PATCH",
        "POST"
      ]
    }
  },
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/breg/routes-explanation/v1alpha6"
    },
    "kind": {
      "const": "BRegRoutesExplanation"
    },
    "routes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "description": "Record route. Fields beyond the pinned `type` and `id` follow CompiledRoute and are outside this contract version.",
            "x-registry-passthrough": "bregctl writes each Record route as the engine holds it plus the injected type; only type and id are pinned, and other members follow CompiledRoute outside this contract version.",
            "additionalProperties": true,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "record"
              },
              "id": {
                "$ref": "#/$defs/DerivedId"
              }
            }
          },
          {
            "type": "object",
            "description": "Action route. Reconstructed field by field by bregctl.",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "actionId",
              "actionRouteKind",
              "method",
              "path",
              "operation",
              "accessProfiles",
              "defaultAccessProfile",
              "requiresIdempotencyKey"
            ],
            "properties": {
              "type": {
                "const": "action"
              },
              "id": {
                "$ref": "#/$defs/DerivedId"
              },
              "actionId": {
                "type": "string"
              },
              "actionRouteKind": {
                "enum": [
                  "availability",
                  "invoke",
                  "target-conditions",
                  "start"
                ]
              },
              "method": {
                "$ref": "#/$defs/HttpMethod"
              },
              "path": {
                "type": "string"
              },
              "operation": {
                "enum": [
                  "create",
                  "get",
                  "lookup",
                  "list",
                  "patch",
                  "tombstone",
                  "batch",
                  "revisions",
                  "snapshot",
                  "invoke",
                  "start"
                ]
              },
              "accessProfiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "defaultAccessProfile": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "requiresIdempotencyKey": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "method",
              "path",
              "accessProfiles",
              "defaultAccessProfile",
              "requiresIdempotencyKey",
              "requiresIfMatch"
            ],
            "properties": {
              "type": {
                "const": "proposal"
              },
              "id": {
                "$ref": "#/$defs/DerivedId"
              },
              "method": {
                "$ref": "#/$defs/HttpMethod"
              },
              "path": {
                "type": "string"
              },
              "accessProfiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "defaultAccessProfile": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "requiresIdempotencyKey": {
                "type": "boolean"
              },
              "requiresIfMatch": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "method",
              "path",
              "accessProfiles",
              "defaultAccessProfile",
              "requiresIdempotencyKey",
              "requiresIfMatch"
            ],
            "properties": {
              "type": {
                "const": "statistics"
              },
              "id": {
                "$ref": "#/$defs/DerivedId"
              },
              "method": {
                "$ref": "#/$defs/HttpMethod"
              },
              "path": {
                "type": "string"
              },
              "accessProfiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "defaultAccessProfile": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "requiresIdempotencyKey": {
                "type": "boolean"
              },
              "requiresIfMatch": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    }
  }
}
