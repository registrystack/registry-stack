{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/breg-explain/v1alpha2/RoutesExplanation.schema.json",
  "title": "RoutesExplanation",
  "description": "Wire shape of `explanation` for `bregctl explain routes`. `routes` mixes two record shapes with no shared field beyond the injected `kind` discriminator: an entity-route half, which is a passthrough of the compiled route table (CompiledRoute) with `kind` injected after serialization, and an action-route half, which bregctl reconstructs field by field. Only the injected `kind` and the action half are pinned in full; the entity half's other fields are outside this contract version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "routes"],
  "properties": {
    "apiVersion": {
      "const": "registry.registrystack.org/breg-explain/v1alpha2"
    },
    "kind": {
      "const": "RoutesExplanation"
    },
    "routes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "description": "Entity route. Passthrough of the compiled route table plus the injected `kind`; fields beyond `kind` follow CompiledRoute and are outside this contract version.",
            "additionalProperties": true,
            "required": ["kind"],
            "properties": {
              "kind": { "const": "entity" }
            }
          },
          {
            "type": "object",
            "description": "Action route. Reconstructed field by field by bregctl.",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "actionId",
              "actionRouteKind",
              "method",
              "path",
              "operation",
              "accessProfiles",
              "defaultAccessProfile",
              "requiresIdempotencyKey"
            ],
            "properties": {
              "kind": { "const": "action" },
              "id": { "type": "string" },
              "actionId": { "type": "string" },
              "actionRouteKind": { "enum": ["invoke", "target_conditions"] },
              "method": { "enum": ["DELETE", "GET", "PATCH", "POST"] },
              "path": { "type": "string" },
              "operation": {
                "enum": [
                  "create", "get", "lookup", "list", "patch", "tombstone", "batch",
                  "revisions", "snapshot", "submit_request", "revise_request",
                  "cancel_request", "apply_request", "invoke"
                ]
              },
              "accessProfiles": { "type": "array", "items": { "type": "string" } },
              "defaultAccessProfile": { "type": ["string", "null"] },
              "requiresIdempotencyKey": { "type": "boolean" }
            }
          }
        ]
      }
    }
  }
}
