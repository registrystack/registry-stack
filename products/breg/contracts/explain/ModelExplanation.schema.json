{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/breg/model-explanation/model-explanation.v1alpha6.schema.json",
  "title": "ModelExplanation",
  "description": "Wire shape of the native compiled model inspector and module closure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "registryId",
    "version",
    "moduleOrder",
    "moduleClosure",
    "revision",
    "recordTypes",
    "actions",
    "statisticalDatasets",
    "display",
    "reviewAuthorities",
    "datasets",
    "accessProfiles",
    "authoring"
  ],
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/breg/model-explanation/v1alpha6"
    },
    "kind": {
      "const": "BRegModelExplanation"
    },
    "registryId": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "moduleOrder": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moduleClosure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "digest",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/LocalId"
          },
          "digest": {
            "$ref": "#/$defs/Digest"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "revision": {
      "$ref": "#/$defs/Digest"
    },
    "recordTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "apiName",
          "revision",
          "display",
          "fields",
          "relationships",
          "sourceModule",
          "primaryDataset",
          "route",
          "mutationMode",
          "mutationPolicy",
          "classification",
          "canonicalId",
          "tombstone",
          "batch",
          "temporal",
          "geojson",
          "accessLog",
          "constraints",
          "indexes",
          "selectorProfiles",
          "readPaths",
          "hooks",
          "derivedRelations",
          "moduleOrigins"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/LocalId"
          },
          "revision": {
            "$ref": "#/$defs/Digest"
          },
          "mutationMode": {
            "enum": [
              "mutable",
              "create-only"
            ]
          },
          "mutationPolicy": {
            "type": "object",
            "additionalProperties": {
              "const": "proposal-required"
            },
            "propertyNames": {
              "$ref": "#/$defs/LocalId"
            }
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "restricted"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "apiName",
                "schema",
                "fieldType",
                "required",
                "classification",
                "display"
              ],
              "properties": {
                "encrypted": {
                  "type": "boolean"
                },
                "fieldType": {
                  "type": "object",
                  "x-registry-passthrough": "The compiled FieldTypeSource, as in query field summaries; its internal shape follows the engine's field type contract."
                },
                "display": {
                  "$ref": "#/$defs/Display"
                }
              },
              "x-registry-passthrough": "Normalized logical field schema and effective classification; compiler-owned metadata."
            }
          },
          "readPaths": {
            "type": "object",
            "x-registry-passthrough": "Compiler-resolved read paths, separate from relationship edges."
          },
          "hooks": {
            "type": "object",
            "x-registry-passthrough": "Compiled hook declarations, with empty condition tests omitted.",
            "propertyNames": {
              "$ref": "#/$defs/LocalId"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "display": {
                  "$ref": "#/$defs/Presentation"
                }
              },
              "x-registry-passthrough": "Compiled hook declaration, including optional authored display."
            }
          },
          "moduleOrigins": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fields": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/LocalId"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/LocalId"
                }
              },
              "constraints": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/LocalId"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/LocalId"
                }
              },
              "hooks": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/LocalId"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/LocalId"
                }
              },
              "derivedRelations": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/LocalId"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/LocalId"
                }
              },
              "indexes": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/LocalId"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/LocalId"
                }
              },
              "accessProfiles": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/LocalId"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/LocalId"
                }
              },
              "selectorProfiles": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/LocalId"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/LocalId"
                }
              },
              "readPaths": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/LocalId"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/LocalId"
                }
              }
            },
            "description": "Module ids that contributed members of this Record type. An absent member originated in the project root."
          }
        },
        "x-registry-passthrough": "Source-free normalized definition owned by the compiler; identity and revision are pinned here."
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "revision",
          "execution",
          "inputs",
          "plan",
          "bounds"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/LocalId"
          },
          "revision": {
            "$ref": "#/$defs/Digest"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "apiName",
                "label",
                "schema",
                "required",
                "nullable"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/LocalId"
                },
                "apiName": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "schema": {
                  "type": "object",
                  "x-registry-foreign": "json-schema-2020-12"
                },
                "required": {
                  "type": "boolean"
                },
                "nullable": {
                  "type": "boolean"
                },
                "display": {
                  "$ref": "#/$defs/Display"
                }
              },
              "x-registry-passthrough": "Normalized compiled logical field metadata; its field type and schema are owned by the engine."
            }
          },
          "execution": {
            "type": "object",
            "x-registry-passthrough": "The compiled Action execution policy is owned by the engine.",
            "properties": {
              "proposal": {
                "type": "object",
                "properties": {
                  "hooks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "display": {
                          "$ref": "#/$defs/Presentation"
                        }
                      },
                      "x-registry-passthrough": "Compiled Proposal hook, including optional authored display."
                    }
                  }
                },
                "x-registry-passthrough": "Compiled Proposal policy; display is presentation only."
              }
            }
          }
        },
        "x-registry-passthrough": "Source-free normalized definition owned by the compiler; identity and revision are pinned here."
      }
    },
    "statisticalDatasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "unitEntityId",
          "population",
          "period",
          "dimensions",
          "disclosure"
        ],
        "x-registry-passthrough": "Normalized compiled statistical dataset inventory, including authority requirements; no source bytes.",
        "properties": {
          "display": {
            "$ref": "#/$defs/Presentation"
          }
        }
      }
    },
    "display": {
      "$ref": "#/$defs/Display"
    },
    "reviewAuthorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "protocol",
          "display"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/LocalId"
          },
          "protocol": {
            "const": "id.registrystack.org/protocols/review/v1"
          },
          "display": {
            "$ref": "#/$defs/Display"
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/LocalId"
          },
          "display": {
            "$ref": "#/$defs/Display"
          }
        }
      }
    },
    "accessProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/LocalId"
          },
          "display": {
            "$ref": "#/$defs/Presentation"
          }
        }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents"
      ],
      "properties": {
        "documents": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "file",
                "authoredPaths",
                "bindings"
              ],
              "properties": {
                "kind": {
                  "const": "BRegProject"
                },
                "file": {
                  "const": "registry.yaml"
                },
                "authoredPaths": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "prefixItems": [
                    {
                      "const": ""
                    }
                  ],
                  "items": {
                    "type": "string",
                    "pattern": "^(?:/(?:[^~]|~[01])*)?$"
                  },
                  "description": "Exact RFC 6901 pointers to authored nodes, in source order, including root, containers and sequence items. Presence only; compiled or derived members are not defaults merely because they are absent."
                },
                "bindings": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/AuthoringBinding"
                  },
                  "description": "Exact links from identity-bearing objects in this explanation to their authored source objects. Append only source-corresponding member paths; generated children do not imply defaults."
                }
              }
            }
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "module",
              "file",
              "authoredPaths",
              "bindings"
            ],
            "properties": {
              "kind": {
                "const": "BRegModule"
              },
              "module": {
                "$ref": "#/$defs/LocalId"
              },
              "file": {
                "type": "string",
                "pattern": "^modules/[a-z][a-z0-9_-]{0,63}/module\\.yaml$"
              },
              "authoredPaths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "prefixItems": [
                  {
                    "const": ""
                  }
                ],
                "items": {
                  "type": "string",
                  "pattern": "^(?:/(?:[^~]|~[01])*)?$"
                },
                "description": "Exact RFC 6901 pointers to authored nodes, in source order, including root, containers and sequence items. Presence only; compiled or derived members are not defaults merely because they are absent."
              },
              "bindings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/AuthoringBinding"
                },
                "description": "Exact links from identity-bearing objects in this explanation to their authored source objects. Append only source-corresponding member paths; generated children do not imply defaults."
              }
            }
          }
        }
      },
      "description": "The exact project and module documents used to compile this explanation. Files are relative to the project directory."
    }
  },
  "$defs": {
    "Digest": {
      "description": "A SHA-256 digest: `sha256:` followed by 64 lowercase hex digits.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "LocalId": {
      "description": "A local identifier: a lowercase letter, then up to 63 lowercase letters, digits, `_`, or `-`.",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "Display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "titleField": {
          "type": "string"
        }
      }
    },
    "AuthoringBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explanationPointer",
        "sourcePointer"
      ],
      "properties": {
        "explanationPointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~]|~[01])*)?$",
          "description": "RFC 6901 pointer against this explanation document."
        },
        "sourcePointer": {
          "type": "string",
          "pattern": "^/(?:[^~]|~[01])*$",
          "description": "RFC 6901 pointer against the enclosing authoring document."
        }
      }
    },
    "Presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
