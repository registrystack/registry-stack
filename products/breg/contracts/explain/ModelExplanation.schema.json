{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.registrystack.org/schemas/breg/model-explanation/model-explanation.v1alpha4.schema.json",
  "title": "ModelExplanation",
  "description": "Wire shape of the native compiled model inspector and module closure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "registryId",
    "version",
    "moduleOrder",
    "moduleClosure",
    "revision",
    "recordTypes",
    "actions"
  ],
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/breg/model-explanation/v1alpha4"
    },
    "kind": {
      "const": "BRegModelExplanation"
    },
    "registryId": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "moduleOrder": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moduleClosure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "digest",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/LocalId"
          },
          "digest": {
            "$ref": "#/$defs/Digest"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "revision": {
      "$ref": "#/$defs/Digest"
    },
    "recordTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "apiName",
          "revision",
          "display",
          "fields",
          "relationships"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/LocalId"
          },
          "revision": {
            "$ref": "#/$defs/Digest"
          }
        },
        "x-registry-passthrough": "Source-free normalized definition owned by the compiler; identity and revision are pinned here."
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "revision",
          "execution",
          "inputs",
          "plan",
          "bounds"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/LocalId"
          },
          "revision": {
            "$ref": "#/$defs/Digest"
          }
        },
        "x-registry-passthrough": "Source-free normalized definition owned by the compiler; identity and revision are pinned here."
      }
    }
  },
  "$defs": {
    "Digest": {
      "description": "A SHA-256 digest: `sha256:` followed by 64 lowercase hex digits.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "LocalId": {
      "description": "A local identifier: a lowercase letter, then up to 63 lowercase letters, digits, `_`, or `-`.",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    }
  }
}
