{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registrystack.org/breg-explain/v1alpha3/AccessExplanation.schema.json",
  "title": "AccessExplanation",
  "description": "Wire shape of `explanation` for `bregctl explain access` without `--scenario`. The evaluation-rule strings are hand-authored constants and are pinned; `routes`, `entities`, `actions`, `rowReach`, `claimContract`, and `claimContractError` are passthroughs of compiled-model values and are declared opaque, except `routes.entries[].entityId`, which is pinned because consumers read it today. `consent` is pinned in full: its structure exists only to be this payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "scopeMatching",
    "purposeMatching",
    "rowMatching",
    "profileSelection",
    "relationshipMatching",
    "missingClaims",
    "evaluation",
    "routes",
    "entities",
    "actions",
    "rowReach",
    "claimContract",
    "claimContractError",
    "consent"
  ],
  "properties": {
    "apiVersion": {
      "const": "registry.registrystack.org/breg-explain/v1alpha3"
    },
    "kind": {
      "const": "AccessExplanation"
    },
    "scopeMatching": { "type": "string" },
    "purposeMatching": { "type": "string" },
    "rowMatching": { "type": "string" },
    "profileSelection": { "type": "string" },
    "relationshipMatching": { "type": "string" },
    "missingClaims": { "type": "string" },
    "evaluation": { "type": "string" },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Passthrough of the compiled access-route inventory; only `entityId` is pinned. Other fields follow CompiledAccessEntry and are outside this contract version.",
            "additionalProperties": true,
            "required": ["entityId"],
            "properties": {
              "entityId": { "type": "string" }
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "description": "Passthrough of the compiled model's per-entity access explanation; shape follows EntityAccessExplanation and is outside this contract version.",
      "items": { "type": "object" }
    },
    "actions": {
      "type": "object",
      "description": "Passthrough of the compiled action inventory; shape follows CompiledActionInventory and is outside this contract version."
    },
    "rowReach": {
      "type": "array",
      "description": "Passthrough of the compiled model's row-reach explanation; shape follows RowReachExplanation and is outside this contract version.",
      "items": { "type": "object" }
    },
    "claimContract": {
      "type": ["object", "null"],
      "description": "Passthrough of the compiled authority inventory, or null when the registry declares no authority contract; shape follows AuthorityInventory and is outside this contract version."
    },
    "claimContractError": {
      "type": ["string", "null"],
      "description": "The compiled authority inventory's failure, or null when the inventory was built. AuthorityInventoryError is a value-free enum serialized as one of these snake_case strings; the vocabulary is pinned and grows only with an apiVersion bump.",
      "enum": [
        "anonymous_profile_carries_authority",
        "principal_claim_missing",
        "target_entity_not_compiled",
        "boundary_field_not_compiled",
        "lookup_selector_not_compiled",
        "lookup_claim_mapping_incomplete",
        "lookup_field_not_compiled",
        "conflicting_claim_expectation",
        null
      ]
    },
    "consent": {
      "description": "Consent-gated permissions, the recipient set of every client, and the consent records they check; null when the project declares no recipients, consent record, or requireConsent permission. Built only for this payload and pinned in full.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "condition",
        "unmappedClients",
        "trustModel",
        "ungating",
        "organizations",
        "groups",
        "clients",
        "records",
        "permissions",
        "issuers"
      ],
      "properties": {
        "condition": {
          "type": "string"
        },
        "unmappedClients": {
          "type": "string"
        },
        "trustModel": {
          "type": "string"
        },
        "ungating": {
          "type": "string"
        },
        "organizations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "clients",
              "groups",
              "retired"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "clients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "retired": {
                "type": "boolean"
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "members",
              "clients"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "clients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "clients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consentClient"
          }
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity",
              "maxDuration",
              "gives",
              "revokes",
              "refusals",
              "scopes",
              "indexes"
            ],
            "properties": {
              "entity": {
                "type": "string"
              },
              "maxDuration": {
                "type": "string"
              },
              "gives": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "revokes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refusals": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "indexes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity",
              "profile",
              "sourcePath",
              "record",
              "on",
              "condition",
              "purposes",
              "scope",
              "maxDuration",
              "probeFunction",
              "indexes",
              "readableFields",
              "clients",
              "issuingActions"
            ],
            "properties": {
              "entity": {
                "type": "string"
              },
              "profile": {
                "type": "string"
              },
              "sourcePath": {
                "type": "string"
              },
              "record": {
                "type": "string"
              },
              "on": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              },
              "purposes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scope": {
                "type": "string"
              },
              "maxDuration": {
                "type": "string"
              },
              "probeFunction": {
                "type": "string"
              },
              "indexes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "readableFields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "classification"
                  ],
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "classification": {
                      "enum": [
                        "public",
                        "internal",
                        "restricted",
                        null
                      ]
                    }
                  }
                }
              },
              "clients": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/consentClient"
                }
              },
              "issuingActions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/consentIssuer"
                }
              }
            }
          }
        },
        "issuers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consentIssuer"
          }
        }
      }
    }
  },
  "$defs": {
    "consentIssuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "issuer"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "issuer": {
          "enum": [
            "self",
            "steward"
          ]
        }
      }
    },
    "consentClient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "organization",
        "recipients"
      ],
      "properties": {
        "client": {
          "type": "string"
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
