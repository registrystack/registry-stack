{
  "version": 1,
  "operations": [
    "Create",
    "Get",
    "Lookup",
    "List",
    "Patch",
    "Tombstone",
    "Batch",
    "Revisions",
    "Snapshot",
    "SubmitRequest",
    "ApproveRequest",
    "RejectRequest",
    "RequestRevision",
    "ReviseRequest",
    "CancelRequest",
    "ApplyRequest",
    "Invoke"
  ],
  "queryKinds": [
    "List",
    "Current",
    "AsOf",
    "Snapshot"
  ],
  "queryOptions": [
    "accessProfile",
    "$select",
    "$filter",
    "$orderby",
    "$top",
    "$count",
    "$skiptoken",
    "bbox",
    "asOf",
    "snapshot",
    "validAt",
    "requestHistoryAfterProposalVersion",
    "proposalVersion"
  ],
  "queryOptionBindings": {
    "accessProfile": {
      "rust": ["BRegRecordOptions.access_profile"],
      "node": ["RecordProjectionOptions.accessProfile"],
      "python": ["BaseRegistryClient.get_record.access_profile"]
    },
    "$select": {
      "rust": ["BRegRecordOptions.select"],
      "node": ["RecordProjectionOptions.select"],
      "python": ["BaseRegistryClient.get_record.select"]
    },
    "$filter": {
      "rust": ["BRegListRequest.filter"],
      "node": ["ListOptions.filter"],
      "python": ["BaseRegistryClient.list_records.filter"]
    },
    "$orderby": {
      "rust": ["BRegListRequest.orderby"],
      "node": ["ListOptions.orderby"],
      "python": ["BaseRegistryClient.list_records.orderby"]
    },
    "$top": {
      "rust": ["BRegListRequest.top"],
      "node": ["ListOptions.top"],
      "python": ["BaseRegistryClient.list_records.top"]
    },
    "$count": {
      "rust": ["BRegListRequest.count"],
      "node": ["ListOptions.count"],
      "python": ["BaseRegistryClient.list_records.count"]
    },
    "$skiptoken": {
      "rust": ["BRegContinuationProjection.skiptoken"],
      "node": ["ListContinuation.skiptoken"],
      "python": ["BaseRegistryClient.continue_list.continuation"]
    },
    "bbox": {
      "rust": ["BRegListRequest.bbox", "BRegGeoJsonListRequest.bbox"],
      "node": ["ListOptions.bbox", "GeoJsonListOptions.bbox"],
      "python": ["BaseRegistryClient.list_records.bbox", "BaseRegistryClient.list_geojson_records.bbox"],
      "forbidden": {
        "rust": ["BRegCurrentListRequest.bbox", "BRegAsOfListRequest.bbox", "BRegSnapshotListRequest.bbox", "BRegRelationshipListRequest.bbox"],
        "node": ["CollectionOptions.bbox", "AsOfListOptions.bbox", "SnapshotListOptions.bbox"],
        "python": ["BaseRegistryClient.list_current_records.bbox", "BaseRegistryClient.list_records_as_of.bbox", "BaseRegistryClient.list_snapshot_records.bbox", "BaseRegistryClient.list_relationship_records.bbox"]
      }
    },
    "asOf": {
      "rust": ["BRegAsOfListRequest.new.as_of"],
      "node": ["AsOfListOptions.asOf"],
      "python": ["BaseRegistryClient.list_records_as_of.as_of"]
    },
    "snapshot": {
      "rust": ["BRegSnapshotListRequest.snapshot.value"],
      "node": ["SnapshotListOptions.snapshot"],
      "python": ["BaseRegistryClient.list_snapshot_records.snapshot"]
    },
    "validAt": {
      "rust": ["BRegSnapshotListRequest.valid_at.value"],
      "node": ["SnapshotListOptions.validAt"],
      "python": ["BaseRegistryClient.list_snapshot_records.valid_at"]
    },
    "requestHistoryAfterProposalVersion": {
      "rust": ["BRegRecordOptions.request_history_after_proposal_version.value"],
      "node": ["RecordOptions.requestHistoryAfterProposalVersion"],
      "python": ["BaseRegistryClient.get_record.request_history_after_proposal_version"]
    },
    "proposalVersion": {
      "rust": ["BaseRegistryClient.download_attachment.proposal_version"],
      "node": ["BaseRegistryClient.downloadAttachment.proposalVersion"],
      "python": ["BaseRegistryClient.download_attachment.proposal_version"]
    }
  },
  "representations": [
    "application/json",
    "application/ld+json",
    "application/geo+json",
    "application/problem+json",
    "application/octet-stream",
    "*/*"
  ],
  "excludedRoutes": [
    {
      "prefix": "/v1/gis",
      "reason": "QGIS adapter is an interoperable access path; native SDK GIS uses /v1/records."
    }
  ],
