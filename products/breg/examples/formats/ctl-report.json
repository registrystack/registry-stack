  "findings": [
    {
      "artifact": "BRegProject",
      "code": "breg.access.profile-related-disclosure",
      "message": "profile `facility-reader` can read `operator` records linked to `facility` through `facility-assignment` on read path `operators`; it sees fields jurisdiction, operator-code, status under its own `facility` row boundaries, and access profiles declared for `operator` do not apply",
      "path": "/accessProfiles/1/permissions/records/1/readPaths/0",
      "rank": "widens-access",
      "severity": "warning",
      "source": {
        "column": 15,
        "file": "products/breg/examples/facility/registry.yaml",
        "line": 237
      },
      "suggestedAction": "Remove fields that these readers should not see from this read path's readableFields, or remove the read path; use a direct permission on the related record type when its own row boundaries should apply."
    }
  ],
