{
  "apiVersion": "id.registrystack.org/formats/breg/example-scenarios/v1alpha1",
  "kind": "BRegExampleScenarios",
  "scenarios": [{
    "id": "register-facility",
    "description": "Create an operator, atomically register a facility and assignment, and read the facility.",
    "input": "examples/inputs/facility.json",
    "steps": [
      {"id":"create-operator","operation":"create","recordType":"operator","client":"operator-editor","accessProfile":"operator-editor","input":"operator","capture":"operator"},
      {"id":"register","operation":"invoke","recordType":"facility","client":"registrar","accessProfile":"facility-registrar","action":"register-facility","result":"facility","input":"facility","capture":"facility"},
      {"id":"read-facility","operation":"get","recordType":"facility","client":"reader","accessProfile":"facility-reader","record":"facility"}
    ]
  }]
}
