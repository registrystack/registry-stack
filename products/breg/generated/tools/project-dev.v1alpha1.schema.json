{
  "$defs": {
    "Bindings": {
      "additionalProperties": false,
      "properties": {
        "bregReviewAuthority": {
          "$ref": "#/$defs/BregReviewAuthority"
        },
        "caseworkContextProvider": {
          "$ref": "#/$defs/CaseworkContextProvider"
        }
      },
      "type": "object"
    },
    "BregReviewAuthority": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/LocalId"
        },
        "identity": {
          "$ref": "#/$defs/LocalId"
        },
        "producer": {
          "$ref": "#/$defs/LocalId"
        }
      },
      "required": [
        "id",
        "producer",
        "identity"
      ],
      "type": "object"
    },
    "Capture": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "pointer": {
              "type": "string"
            },
            "type": {
              "const": "pointer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pointer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "header": {
              "$ref": "#/$defs/CapturedHeader"
            },
            "type": {
              "const": "header",
              "type": "string"
            }
          },
          "required": [
            "type",
            "header"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "find": {
              "type": "string"
            },
            "pointer": {
              "type": "string"
            },
            "type": {
              "const": "find",
              "type": "string"
            },
            "where": {
              "$ref": "#/$defs/FindWhere"
            }
          },
          "required": [
            "type",
            "find",
            "where",
            "pointer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "pointer": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "type": {
              "const": "value",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pointer"
          ],
          "type": "object"
        }
      ]
    },
    "CapturedHeader": {
      "enum": [
        "etag"
      ],
      "type": "string"
    },
    "CaseworkContextProvider": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/LocalId"
        },
        "id": {
          "$ref": "#/$defs/LocalId"
        },
        "identity": {
          "$ref": "#/$defs/LocalId"
        }
      },
      "required": [
        "id",
        "identity",
        "action"
      ],
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
        "contains": true,
        "equals": true,
        "length": {
          "format": "uint",
          "maximum": 1048576,
          "minimum": 0,
          "type": "integer"
        },
        "pointer": {
          "type": "string"
        }
      },
      "required": [
        "pointer"
      ],
      "type": "object"
    },
    "DerivedId": {
      "description": "A dotted development journey step identifier whose segments are local identifiers.",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{0,63}(\\.[a-z][a-z0-9_-]{0,63})+$",
      "type": "string"
    },
    "Expected": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Check"
          },
          "type": "array"
        },
        "code": {
          "type": "string"
        },
        "json": {
          "additionalProperties": true,
          "default": {},
          "propertyNames": {
            "$ref": "#/$defs/ExternalId"
          },
          "type": "object",
          "x-registry-passthrough": "Expected values are compared with the product response at the named JSON pointers."
        },
        "status": {
          "$ref": "#/$defs/ExpectedStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "ExpectedStatus": {
      "anyOf": [
        {
          "format": "uint32",
          "maximum": 599,
          "minimum": 200,
          "type": "integer"
        },
        {
          "items": {
            "format": "uint32",
            "maximum": 599,
            "minimum": 200,
            "type": "integer"
          },
          "type": "array"
        }
      ]
    },
    "ExternalId": {
      "description": "An identifier another system issues, written exactly as its issuer gives it.",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "type": "string"
    },
    "FindWhere": {
      "additionalProperties": false,
      "properties": {
        "equals": true,
        "pointer": {
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "equals"
      ],
      "type": "object"
    },
    "Grant": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "additionalProperties": true,
          "default": {},
          "propertyNames": {
            "$ref": "#/$defs/ExternalId"
          },
          "type": "object",
          "x-registry-passthrough": "Claim values are written into the development token as given."
        },
        "profile": {
          "$ref": "#/$defs/LocalId"
        },
        "scopes": {
          "items": {
            "$ref": "#/$defs/ExternalId"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "profile",
        "scopes"
      ],
      "type": "object"
    },
    "Journey": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/LocalId"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "steps"
      ],
      "type": "object"
    },
    "LocalId": {
      "description": "A local identifier: a lowercase letter, then up to 63 lowercase letters, digits, `_`, or `-`.",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "Method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "type": "string"
    },
    "Poll": {
      "additionalProperties": false,
      "properties": {
        "maximumWaitMilliseconds": {
          "format": "uint64",
          "maximum": 60000,
          "minimum": 1,
          "type": "integer"
        },
        "pollIntervalMilliseconds": {
          "format": "uint64",
          "maximum": 5000,
          "minimum": 50,
          "type": "integer"
        }
      },
      "required": [
        "maximumWaitMilliseconds",
        "pollIntervalMilliseconds"
      ],
      "type": "object"
    },
    "Product": {
      "enum": [
        "breg",
        "casework"
      ],
      "type": "string"
    },
    "ProductPlan": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "$ref": "#/$defs/ExternalId"
        },
        "product": {
          "$ref": "#/$defs/Product"
        },
        "project": {
          "type": "string"
        }
      },
      "required": [
        "product",
        "project",
        "audience"
      ],
      "type": "object"
    },
    "RawBody": {
      "additionalProperties": false,
      "properties": {
        "base64": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        }
      },
      "required": [
        "contentType",
        "base64"
      ],
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "as": {
          "$ref": "#/$defs/LocalId"
        },
        "body": true,
        "capture": {
          "additionalProperties": {
            "$ref": "#/$defs/Capture"
          },
          "default": {},
          "propertyNames": {
            "allOf": [
              {
                "$ref": "#/$defs/ExternalId"
              },
              {
                "maxLength": 64,
                "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$",
                "type": "string"
              }
            ]
          },
          "type": "object"
        },
        "expect": {
          "$ref": "#/$defs/Expected"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "propertyNames": {
            "$ref": "#/$defs/ExternalId"
          },
          "type": "object"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalId"
            },
            {
              "$ref": "#/$defs/DerivedId"
            }
          ]
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "path": {
          "type": "string"
        },
        "poll": {
          "$ref": "#/$defs/Poll"
        },
        "product": {
          "$ref": "#/$defs/Product"
        },
        "raw": {
          "$ref": "#/$defs/RawBody"
        }
      },
      "required": [
        "id",
        "product",
        "as",
        "method",
        "path",
        "expect"
      ],
      "type": "object"
    },
    "TestPerson": {
      "additionalProperties": false,
      "properties": {
        "caseworkContext": {
          "default": false,
          "description": "Forward the same authority to both products. Both grants must declare the same scopes and additional claims.",
          "type": "boolean"
        },
        "client": {
          "$ref": "#/$defs/ExternalId"
        },
        "grants": {
          "additionalProperties": false,
          "properties": {
            "breg": {
              "$ref": "#/$defs/Grant"
            },
            "casework": {
              "$ref": "#/$defs/Grant"
            }
          },
          "type": "object"
        },
        "subject": {
          "$ref": "#/$defs/ExternalId"
        }
      },
      "required": [
        "subject",
        "client",
        "grants"
      ],
      "type": "object"
    },
    "Url": {
      "description": "An absolute http or https URL with a host preserved as written, no user information, and no backslash, whitespace or control character. DNS case and equivalent IPv6 literals are permitted.",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\u005C\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+([/?#][^\\u005C\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]*)?$",
      "type": "string"
    }
  },
  "$id": "https://id.registrystack.org/schemas/breg/project-dev/project-dev.v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/breg/project-dev/v1alpha1",
      "description": "The format and version this file is written in.",
      "type": "string"
    },
    "bindings": {
      "$ref": "#/$defs/Bindings",
      "default": {}
    },
    "issuer": {
      "$ref": "#/$defs/Url"
    },
    "journey": {
      "$ref": "#/$defs/Journey"
    },
    "kind": {
      "const": "BRegProjectDev",
      "description": "The kind of document this file is.",
      "type": "string"
    },
    "people": {
      "additionalProperties": {
        "$ref": "#/$defs/TestPerson"
      },
      "propertyNames": {
        "$ref": "#/$defs/LocalId"
      },
      "type": "object"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/ProductPlan"
      },
      "type": "array"
    },
    "schemaTestPeople": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/LocalId"
        },
        "propertyNames": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalId"
            },
            {
              "$ref": "#/$defs/DerivedId"
            }
          ]
        },
        "type": "object"
      },
      "default": {},
      "propertyNames": {
        "$ref": "#/$defs/LocalId"
      },
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "issuer",
    "products",
    "people",
    "journey"
  ],
  "title": "Registry Stack project development plan",
  "type": "object"
}
