{
  "$defs": {
    "CredentialBindingDocument": {
      "additionalProperties": false,
      "properties": {
        "credential": {
          "$ref": "#/$defs/CredentialDocumentMode"
        },
        "journeyId": {
          "$ref": "#/$defs/LocalId"
        },
        "stepId": {
          "$ref": "#/$defs/LocalId"
        }
      },
      "required": [
        "journeyId",
        "stepId",
        "credential"
      ],
      "type": "object"
    },
    "CredentialDocumentMode": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "anonymous",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "tokenRef": {
              "$ref": "#/$defs/SecretReference"
            },
            "type": {
              "const": "bearer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tokenRef"
          ],
          "type": "object"
        }
      ]
    },
    "LocalId": {
      "description": "A local identifier: a lowercase letter, then up to 63 lowercase letters, digits, `_`, or `-`.",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "SecretReference": {
      "description": "An exact secret reference: secret:file/name, resolved under secretProviders.file.root, or secret:env/NAME, resolved only when secretProviders.environment is declared.",
      "pattern": "^(?:secret:env/[A-Z][A-Z0-9_]{0,127}|secret:file/[a-z][a-z0-9._-]{0,127})$",
      "type": "string"
    }
  },
  "$id": "https://id.registrystack.org/schemas/breg/schema-test-credentials/schema-test-credentials.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The schema-test credentials file: one credential for every step of the\npackaged journeys, a bearer token only by secret reference (CFG-SEC-1).",
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/breg/schema-test-credentials/v1",
      "description": "The format and version this file is written in.",
      "type": "string"
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/CredentialBindingDocument"
      },
      "type": "array"
    },
    "kind": {
      "const": "BRegSchemaTestCredentials",
      "description": "The kind of document this file is.",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "bindings"
  ],
  "title": "Base Registry Engine schema test credentials",
  "type": "object"
}
