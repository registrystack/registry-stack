                  "$ref": "#/components/schemas/ExecutionReviewed"
                }
              }
            },
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid bounded request"
          },
          "401": {
            "description": "Verified access token required",
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer authentication challenge for missing or refused credentials.",
                "schema": {
                  "const": "Bearer",
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Current caller policy refused"
          },
          "404": {
            "description": "Absent or unauthorized run"
          },
          "409": {
            "description": "State or recovery conflict"
          },
          "415": {
            "description": "JSON media type required after caller authorization"
          },
          "503": {
            "description": "Database, audit or verifier unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
