{
  "components": {
    "schemas": {
      "AdmissionHold": {
        "properties": {
          "admissionsHold": {
            "type": "boolean"
          }
        },
        "required": [
          "admissionsHold"
        ],
        "type": "object"
      },
      "AdmissionRelease": {
        "additionalProperties": false,
        "properties": {
          "admissionHistoryComplete": {
            "type": "boolean"
          },
          "priorDeploymentFenced": {
            "type": "boolean"
          },
          "recoveryReference": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "recoveryReference",
          "admissionHistoryComplete",
          "priorDeploymentFenced"
        ],
        "type": "object"
      },
      "Doctor": {
        "properties": {
          "activationReady": {
            "type": "boolean"
          },
          "state": {
            "properties": {
              "admissionsHold": {
                "type": "boolean"
              },
              "auditReady": {
                "type": "boolean"
              },
              "databaseId": {
                "type": "string"
              },
              "oldestDueAt": {
                "format": "date-time",
                "type": [
                  "string",
                  "null"
                ]
              },
              "oldestTerminalPayloadAt": {
                "format": "date-time",
                "type": [
                  "string",
                  "null"
                ]
              },
              "restoreHold": {
                "type": "boolean"
              },
              "restoreReviewRequired": {
                "minimum": 0,
                "type": "integer"
              },
              "schemaVersion": {
                "type": "integer"
              },
              "states": {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              "terminalPayloads": {
                "minimum": 0,
                "type": "integer"
              },
              "uncertain": {
                "type": "integer"
              }
            },
            "required": [
              "databaseId",
              "schemaVersion",
              "restoreHold",
              "auditReady",
              "admissionsHold",
              "restoreReviewRequired",
              "states",
              "uncertain",
              "terminalPayloads",
              "oldestTerminalPayloadAt"
            ],
            "type": "object"
          }
        },
        "required": [
          "activationReady",
          "state"
        ],
        "type": "object"
      },
      "Erased": {
        "properties": {
          "erased": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "erased"
        ],
        "type": "object"
      },
      "ExecutionRecovery": {
        "additionalProperties": false,
        "properties": {
          "executionHistoryComplete": {
            "type": "boolean"
          },
          "priorDeploymentFenced": {
            "type": "boolean"
          },
          "recoveryReference": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "recoveryReference",
          "executionHistoryComplete",
          "priorDeploymentFenced"
        ],
        "type": "object"
      },
      "ExecutionReviewed": {
        "properties": {
          "executionRecoveryReviewed": {
            "type": "boolean"
          }
        },
        "required": [
          "executionRecoveryReviewed"
        ],
        "type": "object"
      },
      "Hold": {
        "properties": {
          "restoreHold": {
            "type": "boolean"
          }
        },
        "required": [
          "restoreHold"
        ],
        "type": "object"
      },
      "OperationIdentity": {
        "additionalProperties": false,
        "description": "Pinned public operation contract; does not establish current authority or receipt availability.",
        "properties": {
          "effect": {
            "enum": [
              "read",
              "mutation",
              "evaluation"
            ],
            "type": "string"
          },
          "id": {
            "enum": [
              "read-record",
              "submit-message",
              "read-scheduling",
              "read-availability",
              "create-appointment",
              "invoke-breg-action",
              "external-get",
              "evaluate-decision"
            ],
            "type": "string"
          },
          "keyRequirement": {
            "enum": [
              "none",
              "required"
            ],
            "type": "string"
          },
          "product": {
            "type": "string"
          },
          "readReceipt": {
            "type": "boolean"
          },
          "recovery": {
            "enum": [
              "read-again",
              "same-command-and-receipt",
              "same-command",
              "hold-after-dispatch"
            ],
            "type": "string"
          },
          "requiresPreparation": {
            "type": "boolean"
          },
          "version": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "product",
          "effect",
          "keyRequirement",
          "requiresPreparation",
          "recovery",
          "readReceipt"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "suggestedAction": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "Reason": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "Retention": {
        "additionalProperties": false,
        "properties": {
          "before": {
            "format": "date-time",
            "type": "string"
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "before",
          "limit"
        ],
        "type": "object"
      },
      "RetryScheduled": {
        "properties": {
          "runId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "const": "retry-scheduled"
          }
        },
        "required": [
          "runId",
          "status"
        ],
        "type": "object"
      },
      "RunInspection": {
        "properties": {
          "recovery": {
            "properties": {
              "operation": {
                "$ref": "#/components/schemas/OperationIdentity"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "retryAllowed": {
                "type": "boolean"
              }
            },
            "required": [
              "retryAllowed"
            ],
            "type": "object"
          },
          "run": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepStatus"
            },
            "type": "array"
          }
        },
        "required": [
          "run",
          "steps",
          "recovery"
        ],
        "type": "object"
      },
      "RunList": {
        "properties": {
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunStatus"
            },
            "maxItems": 100,
            "type": "array"
          }
        },
        "required": [
          "runs"
        ],
        "type": "object"
      },
      "RunStatus": {
        "properties": {
          "admittedAt": {
            "format": "date-time",
            "type": "string"
          },
          "bindingDigest": {
            "type": "string"
          },
          "cancelRequested": {
            "description": "Cancellation is irreversible and prevents later workflow effects; an uncertain evaluation may still have run at its provider.",
            "type": "boolean"
          },
          "deadlineAt": {
            "format": "date-time",
            "type": "string"
          },
          "definitionDigest": {
            "type": "string"
          },
          "failureCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "nextDueAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "output": {},
          "restoreReviewRequired": {
            "type": "boolean"
          },
          "runId": {
            "format": "uuid",
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "uncertain": {
            "type": "boolean"
          },
          "workflowId": {
            "type": "string"
          },
          "workflowVersion": {
            "type": "string"
          }
        },
        "required": [
          "runId",
          "workflowId",
          "workflowVersion",
          "definitionDigest",
          "bindingDigest",
          "step",
          "state",
          "admittedAt",
          "deadlineAt",
          "uncertain",
          "cancelRequested",
          "restoreReviewRequired"
        ],
        "type": "object"
      },
      "Start": {
        "additionalProperties": false,
        "properties": {
          "flow": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "input": {}
        },
        "required": [
          "flow",
          "input"
        ],
        "type": "object"
      },
      "StepStatus": {
        "properties": {
          "attempt": {
            "type": "integer"
          },
          "commandPrepared": {
            "type": "boolean"
          },
          "failureCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "generation": {
            "type": "integer"
          },
          "leaseExpiresAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "nextDueAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "receiptExpired": {
            "type": "boolean"
          },
          "state": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "uncertain": {
            "type": "boolean"
          }
        },
        "required": [
          "step",
          "state",
          "generation",
          "attempt",
          "commandPrepared",
          "uncertain",
          "receiptExpired"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
