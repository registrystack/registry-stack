{
  "$defs": {
    "AccessConfig": {
      "additionalProperties": false,
      "description": "The OIDC issuer a runtime accepts access tokens from: the exact `iss`\nvalue, the `aud` value a token must carry, and where the issuer's signing\nkeys come from, written under `authentication.oidc` beside the product's\nown token rules.",
      "properties": {
        "allowInsecureHttp": {
          "default": false,
          "description": "Permit plain HTTP beyond loopback to the configured issuer and to a\nJWKS URI declared in configuration. TLS remains required unless the\noperator explicitly accepts this transport risk.",
          "type": "boolean"
        },
        "assertionIssuers": {
          "additionalProperties": {
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "description": "Assertion authorities each client may exchange a subject token from,\nkeyed by client identifier. Omitted, no assertion-issuer rule applies;\nwritten, it lists at least one client, each with at least one\nauthority. Once a client is listed, a token it exchanged is accepted\nonly for one of that client's declared authorities, and a client that\nis not listed may exchange from no authority.",
          "maxProperties": 64,
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/ExternalId",
            "maxLength": 128
          },
          "type": "object"
        },
        "audience": {
          "description": "The audience every accepted access token must carry in `aud`.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "issuer": {
          "$ref": "#/$defs/Url",
          "description": "Exact issuer accepted in access-token `iss` claims, an absolute\n`https` URL, or a plain `http` URL when `allowInsecureHttp` is set."
        },
        "jwksSource": {
          "$ref": "#/$defs/JwksSource",
          "default": {
            "type": "discovery"
          },
          "description": "Where the issuer's signing keys come from. Absent reads the issuer's\nOpenID Connect discovery document."
        },
        "policies": {
          "additionalProperties": {
            "$ref": "#/$defs/ClientPolicy"
          },
          "maxProperties": 64,
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/ExternalId",
            "maxLength": 128
          },
          "type": "object"
        },
        "scopeClaim": {
          "$ref": "#/$defs/ExternalId",
          "default": "registry_scopes",
          "maxLength": 128
        }
      },
      "required": [
        "issuer",
        "audience",
        "policies"
      ],
      "type": "object"
    },
    "Action": {
      "enum": [
        "start",
        "status",
        "inspect",
        "retry-same",
        "cancel",
        "reconcile",
        "doctor",
        "restore-hold",
        "release-restore-hold",
        "release-admission-hold",
        "complete-execution-recovery",
        "retain"
      ],
      "type": "string"
    },
    "AuthorizationConfig": {
      "additionalProperties": false,
      "properties": {
        "clientAssertionAudience": {
          "$ref": "#/$defs/ExternalId"
        },
        "clientId": {
          "$ref": "#/$defs/ExternalId",
          "maxLength": 256
        },
        "resource": {
          "$ref": "#/$defs/ExternalId"
        },
        "scopes": {
          "items": {
            "$ref": "#/$defs/ExternalId"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "signingKeyRef": {
          "$ref": "#/$defs/SecretReference"
        },
        "taskAuthority": {
          "$ref": "#/$defs/TaskAuthorityConfig"
        },
        "tokenEndpoint": {
          "$ref": "#/$defs/Url"
        }
      },
      "required": [
        "tokenEndpoint",
        "clientId",
        "signingKeyRef",
        "resource",
        "scopes"
      ],
      "type": "object"
    },
    "ClientPolicy": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "required": [
              "workflows"
            ]
          },
          "if": {
            "properties": {
              "actions": {
                "items": {
                  "enum": [
                    "doctor",
                    "restore-hold",
                    "release-restore-hold",
                    "release-admission-hold",
                    "complete-execution-recovery",
                    "retain"
                  ]
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "workflows"
              ]
            }
          }
        }
      ],
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "maxItems": 15,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "operator": {
          "default": false,
          "type": "boolean"
        },
        "requiredScopes": {
          "items": {
            "$ref": "#/$defs/ExternalId"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "workflows": {
          "description": "The workflows this policy's run actions reach: start, status, inspect,\nretry-same, cancel and reconcile. Required when the policy lists a run\naction and refused when it lists none.",
          "items": {
            "$ref": "#/$defs/ExternalId",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "requiredScopes",
        "actions"
      ],
      "type": "object"
    },
    "ConnectionConfig": {
      "description": "One logical connection namespace. The discriminator selects its complete\ndeployment contract; a connection cannot borrow another variant's authority.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "authorization": {
              "$ref": "#/$defs/AuthorizationConfig"
            },
            "baseUrl": {
              "$ref": "#/$defs/Url"
            },
            "profile": {
              "$ref": "#/$defs/ExternalId"
            },
            "type": {
              "const": "breg",
              "type": "string"
            }
          },
          "required": [
            "type",
            "baseUrl",
            "authorization",
            "profile"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authorization": {
              "$ref": "#/$defs/AuthorizationConfig"
            },
            "baseUrl": {
              "$ref": "#/$defs/Url"
            },
            "completion": {
              "$ref": "#/$defs/ReviewCompletionConfig",
              "description": "Authenticated minimized wake-ups; omission uses polling only."
            },
            "producer": {
              "$ref": "#/$defs/LocalId"
            },
            "profile": {
              "$ref": "#/$defs/ExternalId"
            },
            "resultCheckSeconds": {
              "default": 900,
              "format": "uint32",
              "maximum": 86400,
              "minimum": 60,
              "type": "integer"
            },
            "type": {
              "const": "casework-review-producer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "baseUrl",
            "authorization",
            "profile",
            "producer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authorization": {
              "$ref": "#/$defs/AuthorizationConfig"
            },
            "baseUrl": {
              "$ref": "#/$defs/Url"
            },
            "type": {
              "const": "messaging",
              "type": "string"
            }
          },
          "required": [
            "type",
            "baseUrl",
            "authorization"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "allOf": [
            {
              "else": {
                "not": {
                  "required": [
                    "observationAuthorization"
                  ]
                }
              },
              "if": {
                "properties": {
                  "authorization": {
                    "properties": {
                      "taskAuthority": {
                        "type": "object"
                      }
                    },
                    "required": [
                      "taskAuthority"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "observationAuthorization"
                ]
              }
            }
          ],
          "properties": {
            "authorization": {
              "$ref": "#/$defs/AuthorizationConfig"
            },
            "baseUrl": {
              "$ref": "#/$defs/Url"
            },
            "observationAuthorization": {
              "$ref": "#/$defs/AuthorizationConfig",
              "description": "Ordinary receipt reads under the original owner, without taskAuthority."
            },
            "type": {
              "const": "scheduling",
              "type": "string"
            }
          },
          "required": [
            "type",
            "baseUrl",
            "authorization"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The reviewed directory contract and environment-specific destination.",
          "properties": {
            "attemptTimeoutMilliseconds": {
              "default": 2000,
              "format": "uint64",
              "maximum": 2000,
              "minimum": 1,
              "type": "integer"
            },
            "authorization": {
              "$ref": "#/$defs/AuthorizationConfig",
              "description": "Omission makes the configured read public; it never inherits a caller token.",
              "not": {
                "required": [
                  "taskAuthority"
                ]
              }
            },
            "baseUrl": {
              "$ref": "#/$defs/Url",
              "pattern": "^[^\\s\\\\]+$"
            },
            "maximumResponseBytes": {
              "default": 65536,
              "format": "uint64",
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            "paths": {
              "items": {
                "$ref": "#/$defs/ExternalId"
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "queryParameters": {
              "description": "Omission permits no query parameters.",
              "items": {
                "$ref": "#/$defs/ExternalId"
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "responseSchema": {
              "description": "Local JSON Schema for the complete {status, body} response.",
              "x-registry-foreign": "json-schema-2020-12"
            },
            "type": {
              "const": "external-http",
              "type": "string"
            }
          },
          "required": [
            "type",
            "baseUrl",
            "paths",
            "responseSchema"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attemptTimeoutMilliseconds": {
              "default": 8000,
              "format": "uint64",
              "maximum": 8000,
              "minimum": 1,
              "type": "integer"
            },
            "authorization": {
              "$ref": "#/$defs/DecisionAuthorization"
            },
            "baseUrl": {
              "$ref": "#/$defs/Url",
              "pattern": "^[^\\s\\\\]+$"
            },
            "maximumRequestBytes": {
              "default": 65536,
              "format": "uint64",
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            "maximumResponseBytes": {
              "default": 65536,
              "format": "uint64",
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            "model": {
              "$ref": "#/$defs/ExternalId"
            },
            "protocol": {
              "$ref": "#/$defs/DecisionProtocol"
            },
            "type": {
              "const": "evaluation",
              "type": "string"
            }
          },
          "required": [
            "type",
            "protocol",
            "baseUrl",
            "model",
            "authorization"
          ],
          "type": "object"
        }
      ]
    },
    "DatabaseConfig": {
      "additionalProperties": false,
      "description": "The PostgreSQL connection a stateful runtime uses. Both URLs are secret\nreferences and may name the same secret.",
      "properties": {
        "migrationUrlRef": {
          "$ref": "#/$defs/SecretReference",
          "description": "Secret reference to the migration connection URL."
        },
        "runtimeUrlRef": {
          "$ref": "#/$defs/SecretReference",
          "description": "Secret reference to the least-privileged runtime connection URL."
        },
        "testOnlyPlaintext": {
          "default": false,
          "description": "Allow a plaintext connection. Refused outside test builds.",
          "type": "boolean"
        },
        "trustedRootCertificateRef": {
          "$ref": "#/$defs/SecretReference",
          "description": "Secret reference to a PEM root certificate the connection trusts.\nAbsent, the connection trusts the platform's root certificates."
        }
      },
      "required": [
        "runtimeUrlRef",
        "migrationUrlRef"
      ],
      "type": "object"
    },
    "DecisionAuthorization": {
      "description": "Explicit service identity. Local authorization is limited to numeric loopback.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "bearer": {
              "additionalProperties": false,
              "properties": {
                "principal": {
                  "$ref": "#/$defs/ExternalId"
                },
                "tokenRef": {
                  "$ref": "#/$defs/SecretReference"
                }
              },
              "required": [
                "tokenRef",
                "principal"
              ],
              "type": "object"
            }
          },
          "required": [
            "bearer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "local": {
              "additionalProperties": false,
              "type": "object"
            }
          },
          "required": [
            "local"
          ],
          "type": "object"
        }
      ]
    },
    "DecisionProtocol": {
      "enum": [
        "system-one",
        "openai-decisions"
      ],
      "type": "string"
    },
    "DeploymentConfig": {
      "additionalProperties": false,
      "properties": {
        "activeStateKey": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "admissionKeyRef": {
          "$ref": "#/$defs/SecretReference"
        },
        "auditFile": {
          "pattern": "^/+(?:(?:[^/.][^/]*|\\.(?:[^/.][^/]*|\\.[^/]+)?)/+)*(?:[^/.][^/]*|\\.(?:[^/.][^/]*|\\.[^/]+))$",
          "type": "string"
        },
        "auditKeyRef": {
          "$ref": "#/$defs/SecretReference"
        },
        "authentication": {
          "$ref": "#/$defs/AccessConfig"
        },
        "databaseId": {
          "$ref": "#/$defs/ExternalId",
          "maxLength": 128
        },
        "listener": {
          "$ref": "#/$defs/PrivateListenerConfig"
        },
        "metricsListener": {
          "$ref": "#/$defs/ListenerConfig",
          "description": "The operator-private socket `/metrics` is served on. When it is\nomitted, no metrics are served."
        },
        "packages": {
          "description": "One pinned package per workflow. List each package root and digest once.",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/PackageConfig"
              },
              {
                "properties": {
                  "expectedDigest": {
                    "$ref": "#/$defs/Digest"
                  }
                },
                "required": [
                  "expectedDigest"
                ]
              }
            ],
            "unevaluatedProperties": false
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "runtimeRole": {
          "maxLength": 63,
          "pattern": "^[a-z_][a-z0-9_]{0,62}$",
          "type": "string"
        },
        "stateKeys": {
          "additionalProperties": false,
          "maxProperties": 16,
          "minProperties": 1,
          "patternProperties": {
            "^[^\\u0000-\\u001F\\u007F-\\u009F]+$": {
              "$ref": "#/$defs/StateKeyConfig"
            }
          },
          "propertyNames": {
            "$ref": "#/$defs/ExternalId",
            "maxLength": 10,
            "pattern": "^[1-9][0-9]*$"
          },
          "type": "object"
        }
      },
      "required": [
        "databaseId",
        "runtimeRole",
        "packages",
        "listener",
        "authentication",
        "auditFile",
        "auditKeyRef",
        "activeStateKey",
        "stateKeys",
        "admissionKeyRef"
      ],
      "type": "object"
    },
    "Digest": {
      "description": "A SHA-256 digest: `sha256:` followed by 64 lowercase hex digits.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EnvironmentSecretProviderConfig": {
      "additionalProperties": false,
      "description": "The environment secret provider. It takes no settings.",
      "type": "object"
    },
    "EventSourceConfig": {
      "additionalProperties": false,
      "description": "Trusted producer binding. Event vocabulary and mapping stay in the package.",
      "properties": {
        "signingKeyRef": {
          "$ref": "#/$defs/SecretReference",
          "description": "Protected reference to the raw HMAC-SHA-256 key, at least 32 bytes."
        },
        "source": {
          "$ref": "#/$defs/ExternalId",
          "description": "Exact absolute producer URI that signed event envelopes must declare."
        }
      },
      "required": [
        "source",
        "signingKeyRef"
      ],
      "type": "object"
    },
    "ExternalId": {
      "description": "An identifier another system issues, written exactly as its issuer gives it.",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "type": "string"
    },
    "FileSecretProviderConfig": {
      "additionalProperties": false,
      "description": "The file secret provider.",
      "properties": {
        "root": {
          "description": "Absolute directory holding one file per secret. Each file must be a\nregular file owned by the runtime user, mode 0400 or 0600, with exactly\none hard link.",
          "pattern": "^/",
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "type": "object"
    },
    "JwksSource": {
      "description": "Where a runtime obtains the OIDC issuer's signing keys.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Read `jwks_uri` from the issuer's OpenID Connect discovery document.",
          "properties": {
            "type": {
              "const": "discovery",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Fetch the key set from this absolute `https` URI, skipping discovery.\nA plain `http` URI is accepted on loopback for supervised local\ndevelopment, and beyond loopback only when the issuer block sets\n`allowInsecureHttp`.",
          "properties": {
            "type": {
              "const": "uri",
              "type": "string"
            },
            "uri": {
              "$ref": "#/$defs/Url"
            }
          },
          "required": [
            "type",
            "uri"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Read the key set from a secret, for deployments without network access\nto the issuer.",
          "properties": {
            "documentRef": {
              "$ref": "#/$defs/SecretReference"
            },
            "type": {
              "const": "static",
              "type": "string"
            }
          },
          "required": [
            "type",
            "documentRef"
          ],
          "type": "object"
        }
      ]
    },
    "ListenerBind": {
      "description": "Socket address the runtime listens on, written host:port with an IP address host ([addr]:port for IPv6).",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "ListenerConfig": {
      "additionalProperties": false,
      "description": "The listener of a runtime that declares no TLS or exposure settings.",
      "properties": {
        "bind": {
          "$ref": "#/$defs/ListenerBind"
        }
      },
      "required": [
        "bind"
      ],
      "type": "object"
    },
    "ListenerNetworkExposure": {
      "description": "The operator-declared private network placement of an HTTP listener.",
      "enum": [
        "private-address",
        "container-private"
      ],
      "type": "string"
    },
    "LocalId": {
      "description": "A local identifier: a lowercase letter, then up to 63 lowercase letters, digits, `_`, or `-`.",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "PackageConfig": {
      "additionalProperties": false,
      "description": "The package a runtime serves: `root` is the absolute package directory,\nand `expectedDigest`, when set, pins the package digest the runtime must\nfind there. The package digest is the digest of the package's\n`SHA256SUMS` file; see [`crate::package`].",
      "properties": {
        "expectedDigest": {
          "$ref": "#/$defs/Digest",
          "description": "`sha256:` label of the package digest, the digest of the package's\n`SHA256SUMS` file. When set, the runtime refuses to start on any other\npackage."
        },
        "root": {
          "description": "Absolute path of the package directory.",
          "pattern": "^/",
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "type": "object"
    },
    "PrivateListenerConfig": {
      "additionalProperties": false,
      "description": "The listener of a runtime that declares its TLS termination and network\nexposure.",
      "properties": {
        "bind": {
          "$ref": "#/$defs/ListenerBind"
        },
        "networkExposure": {
          "$ref": "#/$defs/ListenerNetworkExposure",
          "default": "private-address"
        },
        "tlsTermination": {
          "$ref": "#/$defs/TlsTermination"
        }
      },
      "required": [
        "bind",
        "tlsTermination"
      ],
      "type": "object"
    },
    "ReviewCompletionConfig": {
      "additionalProperties": false,
      "description": "How Casework's completion event for this connection's review requests is\nauthenticated. The event only wakes a waiting run: the run reads the result\nitself with its own producer authorization.",
      "properties": {
        "bearerTokenRef": {
          "$ref": "#/$defs/SecretReference",
          "description": "The bearer token Casework's completion destination sends."
        },
        "recipientBinding": {
          "description": "The recipientBinding the Casework project names for this producer's\ncompletion destination: 1 to 256 printable ASCII characters without\nspaces. Casework sends it in the registry-recipient-binding header.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[!-~]{1,256}$",
          "type": "string"
        }
      },
      "required": [
        "recipientBinding",
        "bearerTokenRef"
      ],
      "type": "object"
    },
    "SecretProvidersConfig": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "file": {
              "$ref": "#/$defs/FileSecretProviderConfig"
            }
          },
          "required": [
            "file"
          ]
        },
        {
          "properties": {
            "environment": {
              "$ref": "#/$defs/EnvironmentSecretProviderConfig"
            }
          },
          "required": [
            "environment"
          ]
        }
      ],
      "description": "The secret providers a runtime enables. A reference is resolved only by a\nprovider declared here: `secret:file/name` under `file.root`, and\n`secret:env/NAME` only when `environment: {}` is present.",
      "properties": {
        "environment": {
          "$ref": "#/$defs/EnvironmentSecretProviderConfig",
          "description": "Enables `secret:env/NAME` references, read from the process\nenvironment. Declared as an empty mapping: `environment: {}`."
        },
        "file": {
          "$ref": "#/$defs/FileSecretProviderConfig",
          "description": "Enables `secret:file/name` references, read from files under `root`."
        }
      },
      "type": "object"
    },
    "SecretReference": {
      "description": "An exact secret reference: secret:file/name, resolved under secretProviders.file.root, or secret:env/NAME, resolved only when secretProviders.environment is declared.",
      "pattern": "^(?:secret:env/[A-Z][A-Z0-9_]{0,127}|secret:file/[a-z][a-z0-9._-]{0,127})$",
      "type": "string"
    },
    "StateKeyConfig": {
      "additionalProperties": false,
      "properties": {
        "keyRef": {
          "$ref": "#/$defs/SecretReference"
        }
      },
      "required": [
        "keyRef"
      ],
      "type": "object"
    },
    "TaskAuthorityConfig": {
      "additionalProperties": false,
      "properties": {
        "baseUrl": {
          "$ref": "#/$defs/Url"
        },
        "bootstrapResource": {
          "$ref": "#/$defs/ExternalId"
        },
        "exchangeAudience": {
          "$ref": "#/$defs/ExternalId"
        },
        "issuer": {
          "$ref": "#/$defs/ExternalId"
        },
        "subject": {
          "$ref": "#/$defs/ExternalId"
        }
      },
      "required": [
        "baseUrl",
        "issuer",
        "subject",
        "exchangeAudience",
        "bootstrapResource"
      ],
      "type": "object"
    },
    "TlsTermination": {
      "description": "Declares the trusted transport boundary for a runtime's plaintext HTTP\nlistener. Production listeners require operator-controlled upstream TLS\ntermination; direct plaintext is limited to the explicit loopback-only\ndevelopment mode.",
      "enum": [
        "operator-controlled-upstream",
        "development-loopback"
      ],
      "type": "string"
    },
    "Url": {
      "description": "An absolute http or https URL with a host preserved as written, no user information, and no backslash, whitespace or control character. DNS case and equivalent IPv6 literals are permitted.",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\u005C\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+([/?#][^\\u005C\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]*)?$",
      "type": "string"
    }
  },
  "$id": "https://id.registrystack.org/schemas/coordinator/runtime/runtime.v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/coordinator/runtime/v1alpha1",
      "type": "string"
    },
    "connections": {
      "additionalProperties": {
        "$ref": "#/$defs/ConnectionConfig"
      },
      "description": "Named deployment bindings with one explicit type per connection.",
      "maxProperties": 16,
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/LocalId"
      },
      "type": "object"
    },
    "database": {
      "allOf": [
        {
          "$ref": "#/$defs/DatabaseConfig"
        },
        {
          "properties": {
            "testOnlyPlaintext": {
              "const": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "deployment": {
      "$ref": "#/$defs/DeploymentConfig"
    },
    "eventSources": {
      "additionalProperties": {
        "$ref": "#/$defs/EventSourceConfig"
      },
      "description": "Optional trusted event producers keyed by the logical IDs used in Workflow triggers.",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/LocalId"
      },
      "type": "object"
    },
    "kind": {
      "const": "CoordinatorRuntimeConfig",
      "type": "string"
    },
    "minimumObservationIntervalSeconds": {
      "default": 30,
      "description": "Stricter deployment spacing for every product completion observation.",
      "format": "uint32",
      "maximum": 86400,
      "minimum": 30,
      "type": "integer"
    },
    "namespace": {
      "maxLength": 60,
      "pattern": "^coordinator_[a-z0-9_]*$",
      "type": "string"
    },
    "secretProviders": {
      "$ref": "#/$defs/SecretProvidersConfig"
    }
  },
  "required": [
    "secretProviders",
    "database",
    "namespace",
    "connections",
    "apiVersion",
    "kind"
  ],
  "title": "RuntimeConfig",
  "type": "object"
}
