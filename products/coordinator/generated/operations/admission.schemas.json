        "$ref": "#/$defs/ContentDigest"
      },
      "id": {
        "type": "string"
      },
      "version": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "version",
      "digest"
    ],
    "title": "PolicyBinding",
    "type": "object"
  },
