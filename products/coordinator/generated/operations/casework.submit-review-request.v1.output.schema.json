{
  "$defs": {
    "ContentDigest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "PolicyBinding": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/ContentDigest"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "SubjectBinding": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/ContentDigest"
        },
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "type",
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policy": {
      "$ref": "#/$defs/PolicyBinding"
    },
    "requestId": {
      "format": "uuid",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/SubjectBinding"
    },
    "submissionDigest": {
      "$ref": "#/$defs/ContentDigest"
    }
  },
  "required": [
    "requestId",
    "subject",
    "policy",
    "submissionDigest"
  ],
  "title": "casework.submit-review-request/v1 output",
  "type": "object"
}
