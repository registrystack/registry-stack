{
  "$defs": {
    "Money": {
      "additionalProperties": false,
      "description": "An exact positive decimal amount. Scale belongs to the configured currency\npolicy; wire amounts are strings so no binary floating-point rounding occurs.",
      "properties": {
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "scale": {
          "maximum": 6,
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "maxLength": 24,
          "minLength": 1,
          "not": {
            "pattern": "^0(\\.0{1,6})?$"
          },
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
          "type": "string"
        }
      },
      "required": [
        "value",
        "currency",
        "scale"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The exact provider completion reported to the authoritative instruction.\nThis does not claim beneficiary credit or final settlement.",
  "properties": {
    "bindingRevision": {
      "type": "string"
    },
    "disbursementId": {
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "type": "string"
    },
    "instructionId": {
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "type": "string"
    },
    "instructionRecordId": {
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "type": "string"
    },
    "instructionVersion": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "money": {
      "$ref": "#/$defs/Money"
    },
    "providerReference": {
      "type": "string"
    },
    "providerResultDigest": {
      "type": "string"
    },
    "simulation": {
      "type": "boolean"
    }
  },
  "required": [
    "disbursementId",
    "instructionRecordId",
    "instructionId",
    "instructionVersion",
    "bindingRevision",
    "simulation",
    "money",
    "providerReference",
    "providerResultDigest"
  ],
  "title": "payments.record-provider-confirmation/v1 output",
  "type": "object"
}
