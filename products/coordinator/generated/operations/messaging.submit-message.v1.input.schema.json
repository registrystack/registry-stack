{
  "$defs": {
    "DirectContent": {
      "additionalProperties": false,
      "description": "Content a caller supplies instead of naming a template.",
      "properties": {
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "Recipient": {
      "description": "Where one message goes: exactly one email address or one E.164 phone\nnumber, written `{\"email\": ...}` or `{\"phone\": ...}`.\n\nIts `Debug` never prints the contact, so a recipient that reaches a log\nthrough a derived `Debug` names only its kind.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string"
            }
          },
          "required": [
            "email"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "phone": {
              "type": "string"
            }
          },
          "required": [
            "phone"
          ],
          "type": "object"
        }
      ]
    },
    "TemplateReference": {
      "additionalProperties": false,
      "description": "One template version, under `templates/<id>/<version>/`, as the wire\ncontract names it.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The body of `POST /v1/messages`. Exactly one of `template` or `content`\nis present; `locale` and `data` accompany a template and nothing else.\nInstants are RFC 3339 strings the runtime parses.",
  "oneOf": [
    {
      "properties": {
        "content": {
          "type": "null"
        },
        "data": {
          "not": {
            "type": "null"
          }
        },
        "locale": {
          "type": "string"
        },
        "template": {
          "$ref": "#/$defs/TemplateReference"
        }
      },
      "required": [
        "template",
        "locale",
        "data"
      ]
    },
    {
      "properties": {
        "content": {
          "$ref": "#/$defs/DirectContent"
        },
        "data": {
          "type": "null"
        },
        "locale": {
          "type": "null"
        },
        "template": {
          "type": "null"
        }
      },
      "required": [
        "content"
      ]
    }
  ],
  "properties": {
    "content": {
      "anyOf": [
        {
          "$ref": "#/$defs/DirectContent"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": true,
    "expiresAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "locale": {
      "type": [
        "string",
        "null"
      ]
    },
    "notBefore": {
      "type": [
        "string",
        "null"
      ]
    },
    "senderProfile": {
      "type": "string"
    },
    "template": {
      "anyOf": [
        {
          "$ref": "#/$defs/TemplateReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "to": {
      "$ref": "#/$defs/Recipient"
    }
  },
  "required": [
    "senderProfile",
    "to"
  ],
  "title": "messaging.submit-message/v1 input",
  "type": "object"
}
