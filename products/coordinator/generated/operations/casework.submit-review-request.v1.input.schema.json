{
  "$defs": {
    "ContentDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "HumanIdentity": {
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "subject"
      ],
      "type": "object"
    },
    "PolicyBinding": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/ContentDigest"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "ReviewContext": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "snapshot": true,
            "strategy": {
              "const": "submitted",
              "type": "string"
            }
          },
          "required": [
            "strategy",
            "snapshot"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "binding": {
              "$ref": "#/$defs/SourceContextBinding"
            },
            "strategy": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "strategy",
            "binding"
          ],
          "type": "object"
        }
      ]
    },
    "SourceContextBinding": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "reference"
      ],
      "type": "object"
    },
    "SubjectBinding": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/ContentDigest"
        },
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "type",
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "$ref": "#/$defs/ReviewContext"
    },
    "initiator": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "$ref": "#/$defs/PolicyBinding"
    },
    "requesterReference": {
      "type": "string"
    },
    "resultConstraints": true,
    "subject": {
      "$ref": "#/$defs/SubjectBinding"
    }
  },
  "required": [
    "policy",
    "subject",
    "requesterReference",
    "context"
  ],
  "title": "casework.submit-review-request/v1 input",
  "type": "object"
}
