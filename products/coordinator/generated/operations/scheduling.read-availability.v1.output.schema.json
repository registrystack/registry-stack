{
  "$defs": {
    "AvailabilityEntry": {
      "description": "One availability answer entry. Exact-time offerings answer in grid slots;\narrival-window offerings answer in windows.",
      "oneOf": [
        {
          "description": "A grid slot and how many pool members are still free across it.",
          "properties": {
            "end": {
              "format": "date-time",
              "type": "string"
            },
            "free": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "slot",
              "type": "string"
            },
            "start": {
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "start",
            "end",
            "free"
          ],
          "type": "object"
        },
        {
          "description": "A published window and its remaining recipient units, the caller's\nchannel slice included when the window reserves one for it.",
          "properties": {
            "channelRemaining": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "end": {
              "format": "date-time",
              "type": "string"
            },
            "kind": {
              "const": "window",
              "type": "string"
            },
            "remaining": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "start": {
              "format": "date-time",
              "type": "string"
            },
            "window": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "window",
            "start",
            "end",
            "remaining",
            "channelRemaining"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One page of a bounded listing, with the opaque cursor that continues it.",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/AvailabilityEntry"
      },
      "type": "array"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "items",
    "nextCursor"
  ],
  "title": "scheduling.read-availability/v1 output",
  "type": "object"
}
