{
  "$defs": {
    "GrantReference": {
      "additionalProperties": false,
      "description": "An approval reference, never an assertion or bearer credential. The shared\nCasework source requires the signed authority's original deadline to match.",
      "properties": {
        "expiresAt": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "expiresAt"
      ],
      "type": "object"
    },
    "LocalId": {
      "description": "A local identifier: a lowercase letter, then up to 63 lowercase letters, digits, `_`, or `-`.",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "durationMinutes": {
      "default": null,
      "maximum": 10080,
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "end": {
      "format": "date-time",
      "type": "string"
    },
    "grant": {
      "anyOf": [
        {
          "$ref": "#/$defs/GrantReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "offering": {
      "$ref": "#/$defs/LocalId"
    },
    "resource": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "start": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "offering",
    "start",
    "end",
    "limit"
  ],
  "title": "scheduling.read-availability/v1 input",
  "type": "object"
}
