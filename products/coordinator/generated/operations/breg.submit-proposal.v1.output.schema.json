{
  "$defs": {
    "BRegAvailability": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "observedRevision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/BRegAvailabilityReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/BRegRecoveryHint"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "available",
        "observedRevision"
      ],
      "type": "object"
    },
    "BRegAvailabilityReason": {
      "enum": [
        "pending-review",
        "stale-revision",
        "contract-changed",
        "dependency-outage",
        "invalid-input",
        "already-applied"
      ],
      "type": "string"
    },
    "BRegProposalApplication": {
      "additionalProperties": false,
      "properties": {
        "applicationId": {
          "type": "string"
        },
        "effectDigest": {
          "type": "string"
        },
        "resultLinks": {
          "items": {
            "$ref": "#/$defs/BRegProposalResultReference"
          },
          "type": "array"
        },
        "submissionVersion": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "applicationId",
        "submissionVersion",
        "effectDigest",
        "resultLinks"
      ],
      "type": "object"
    },
    "BRegProposalApplicationMode": {
      "enum": [
        "automatic",
        "manual"
      ],
      "type": "string"
    },
    "BRegProposalApplicationReason": {
      "enum": [
        "contract-changed",
        "review-unavailable",
        "dependency-outage",
        "lease-expired",
        "application-refused",
        "attempts-exhausted"
      ],
      "type": "string"
    },
    "BRegProposalApplicationState": {
      "enum": [
        "pending",
        "applying",
        "blocked",
        "applied",
        "cancelled"
      ],
      "type": "string"
    },
    "BRegProposalApplicationStatus": {
      "additionalProperties": false,
      "description": "Receiver-owned progress for this exact frozen submission, under current\ndisclosure. A blocked submission is not a terminal non-application result.",
      "properties": {
        "automaticRetry": {
          "anyOf": [
            {
              "$ref": "#/$defs/BRegProposalAutomaticRetry"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "$ref": "#/$defs/BRegProposalApplicationMode"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/BRegProposalApplicationReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/BRegRecoveryHint"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/BRegProposalApplicationState"
        }
      },
      "required": [
        "state",
        "mode"
      ],
      "type": "object"
    },
    "BRegProposalAttachment": {
      "additionalProperties": false,
      "description": "Inert slot metadata disclosed on an authorized Proposal representation.",
      "properties": {
        "classification": {
          "type": "string"
        },
        "contentTypes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "links": {
          "additionalProperties": {
            "$ref": "#/$defs/BRegProposalLink"
          },
          "type": "object"
        },
        "maximumBytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "required": {
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/BRegProposalAttachmentValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "required",
        "maximumBytes",
        "contentTypes",
        "classification",
        "links"
      ],
      "type": "object"
    },
    "BRegProposalAttachmentValue": {
      "additionalProperties": false,
      "properties": {
        "byteSize": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "contentType": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "submissionVersion": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "uploadedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "uploadedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "verificationStatus": {
          "type": "string"
        }
      },
      "required": [
        "submissionVersion",
        "sha256",
        "contentType",
        "byteSize",
        "verificationStatus"
      ],
      "type": "object"
    },
    "BRegProposalAutomaticRetry": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "maximumAttempts": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "scheduled": {
          "type": "boolean"
        }
      },
      "required": [
        "scheduled",
        "attempts",
        "maximumAttempts"
      ],
      "type": "object"
    },
    "BRegProposalLink": {
      "additionalProperties": false,
      "description": "Inert server-issued link. Only a client-bound Proposal promotes its use.",
      "properties": {
        "accessProfile": {
          "type": "string"
        },
        "availability": {
          "anyOf": [
            {
              "$ref": "#/$defs/BRegAvailability"
            },
            {
              "type": "null"
            }
          ]
        },
        "ifMatch": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "path",
        "accessProfile",
        "operation"
      ],
      "type": "object"
    },
    "BRegProposalResultReference": {
      "additionalProperties": false,
      "properties": {
        "recordId": {
          "type": "string"
        },
        "recordType": {
          "type": "string"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "recordType",
        "recordId",
        "revision"
      ],
      "type": "object"
    },
    "BRegProposalState": {
      "enum": [
        "draft",
        "submitted",
        "applied",
        "cancelled"
      ],
      "type": "string"
    },
    "BRegRecoveryHint": {
      "enum": [
        "refresh",
        "retry",
        "correct-input",
        "terminal",
        "receipt-only"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A Proposal is independently versioned and never decoded as a Record subtype.",
  "properties": {
    "actionId": {
      "type": "string"
    },
    "actionRevision": {
      "type": "string"
    },
    "application": {
      "anyOf": [
        {
          "$ref": "#/$defs/BRegProposalApplication"
        },
        {
          "type": "null"
        }
      ]
    },
    "applicationStatus": {
      "anyOf": [
        {
          "$ref": "#/$defs/BRegProposalApplicationStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "attachments": {
      "additionalProperties": {
        "$ref": "#/$defs/BRegProposalAttachment"
      },
      "type": "object"
    },
    "blockedReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "effectDigest": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "input": {
      "additionalProperties": true,
      "type": [
        "object",
        "null"
      ]
    },
    "links": {
      "additionalProperties": {
        "$ref": "#/$defs/BRegProposalLink"
      },
      "type": "object"
    },
    "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/BRegProposalState"
    },
    "submissionVersion": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "actionId",
    "actionRevision",
    "submissionVersion",
    "revision",
    "state",
    "links"
  ],
  "title": "breg.submit-proposal/v1 output",
  "type": "object"
}
