{
  "$defs": {
    "ContentDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "PolicyBinding": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/ContentDigest"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "ReviewRequestAccepted": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "#/$defs/PolicyBinding"
        },
        "requestId": {
          "format": "uuid",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/SubjectBinding"
        },
        "submissionDigest": {
          "$ref": "#/$defs/ContentDigest"
        }
      },
      "required": [
        "requestId",
        "subject",
        "policy",
        "submissionDigest"
      ],
      "type": "object"
    },
    "SubjectBinding": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/ContentDigest"
        },
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "type",
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The input of `cancel-review-request`: the accepted request a submit step\nreturned and the reason Casework records with the cancellation.",
  "properties": {
    "reason": {
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ReviewRequestAccepted"
    }
  },
  "required": [
    "request",
    "reason"
  ],
  "title": "casework.cancel-review-request/v1 input",
  "type": "object"
}
