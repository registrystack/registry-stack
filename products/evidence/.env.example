# Key-name reference only. Live tests reject credential files inside the
# repository. Create one profile-specific owner-only file (mode 0600) at an
# absolute external path and pass it with EVIDENCE_DHIS2_LIVE_ENV_FILE or
# EVIDENCE_OPENCRVS_LIVE_ENV_FILE. Do not quote values or combine profiles.

DHIS2_BASE_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_TEST_PROGRAM_ID=
DHIS2_TEST_ORG_UNIT_ID=
DHIS2_TEST_TRACKED_ENTITY_ID=

OPENCRVS_CLIENT_ID=
OPENCRVS_SECRET=
OPENCRVS_URL=
OPENCRVS_TEST_TRACKING_ID=
