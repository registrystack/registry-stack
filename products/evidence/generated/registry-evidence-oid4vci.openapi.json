          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationServerMetadata"
                }
              }
            },
            "description": "Authorization server metadata",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache",
                  "type": "string"
                }
              }
            }
          },
          "408": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The configured request deadline elapsed",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache",
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Discover the anonymous pre-authorized token endpoint"
