              }
            },
            "description": "Evidence or bounded state is unavailable",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "Pragma": {
                "schema": {
                  "const": "no-cache",
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "credentialBearer": []
