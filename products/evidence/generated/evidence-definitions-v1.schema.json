    "subject": {
      "additionalProperties": false,
      "properties": {
        "cardinality": {
          "const": "one"
        },
        "role": {
          "pattern": "^[a-z][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        }
      },
      "required": [
        "role",
        "cardinality",
        "selector"
      ],
      "type": "object"
    }
  },
  "$id": "https://registrystack.org/schemas/evidence/definitions-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assuranceProfile": {
      "enum": [
        "local",
        "production",
        "evidence-grade"
      ]
    },
    "audience": {
      "format": "uri",
      "maxLength": 512,
      "type": "string"
    },
    "definitions": {
      "items": {
        "$ref": "#/$defs/definition"
      },
      "maxItems": 16384,
      "type": "array",
      "uniqueItems": true
    },
    "issuedBy": {
      "format": "uri",
      "maxLength": 512,
      "type": "string"
    },
    "maximumHolderBoundBatchSize": {
      "description": "The effective deployment ceiling for one holder-bound batch. A protocol adapter may advertise no larger batch than this value.",
      "maximum": 16,
      "minimum": 1,
      "type": "integer"
    },
    "providedBy": {
      "format": "uri",
      "maxLength": 512,
      "type": "string"
    },
    "schema": {
      "const": "registry.evidence-definitions/v1"
    }
  },
  "required": [
    "schema",
    "assuranceProfile",
    "audience",
    "issuedBy",
    "providedBy",
    "maximumHolderBoundBatchSize",
    "definitions"
  ],
  "title": "Requester-scoped Evidence definitions Version 1",
  "type": "object"
}
