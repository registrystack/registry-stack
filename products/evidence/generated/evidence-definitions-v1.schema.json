{
  "$comment": "The authenticated response contains only complete request shapes that match exactly one configured authority path. It never exposes source plans, scripts, credentials, requester tags, authority-profile identifiers, selector values, codelist values, codelist paths, internal constraints, or unrelated definitions.",
  "$defs": {
    "alternative": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "source",
            "holder-presented"
          ]
        },
        "responseFormats": {
          "items": {
            "enum": [
              "signed-jws",
              "unsigned-json",
              "sd-jwt-vc",
              "sd-jwt-vc-batch"
            ]
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/subject"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "channel",
        "responseFormats",
        "subjects"
      ],
      "type": "object"
    },
    "concept": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "format": "uri",
          "maxLength": 512,
          "type": "string"
        },
        "form": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "boolean"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "integer"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "date-bucket"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "time-bucket"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "entity-reference"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "structured"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "items": {
                  "enum": [
                    "string",
                    "entity-reference"
                  ]
                },
                "maximumItems": {
                  "maximum": 64,
                  "minimum": 1,
                  "type": "integer"
                },
                "minimumItems": {
                  "maximum": 64,
                  "minimum": 1,
                  "type": "integer"
                },
                "type": {
                  "const": "list"
                },
                "unique": {
                  "const": true
                }
              },
              "required": [
                "type",
                "items",
                "minimumItems",
                "maximumItems",
                "unique"
              ],
              "type": "object"
            }
          ]
        },
        "handle": {
          "pattern": "^[a-z][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "handle",
        "concept",
        "required",
        "form"
      ],
      "type": "object"
    },
    "definition": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "description": "The request shapes of the other channels of this definition that the caller is entitled to. Absent when there are none. A channel the caller is not entitled to is never listed.",
          "items": {
            "$ref": "#/$defs/alternative"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "channel": {
          "description": "The acquisition channel of this entry's own subjects. Present only when the caller is entitled to a holder-presented channel of the definition, as the entry's own channel or as an alternative; absence means the source channel. A caller entitled to the source channel alone receives the entry a source-only definition produces, so the member never reveals that a holder-presented channel exists.",
          "enum": [
            "source",
            "holder-presented"
          ]
        },
        "concepts": {
          "items": {
            "$ref": "#/$defs/concept"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "configurationRevision": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "evidenceType": {
          "format": "uri",
          "maxLength": 512,
          "type": "string"
        },
        "handle": {
          "pattern": "^[a-z][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "criterion",
            "information-requirement",
            "constraint"
          ]
        },
        "purpose": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "referenceFrameworks": {
          "items": {
            "format": "uri",
            "maxLength": 512,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "requirement": {
          "format": "uri",
          "maxLength": 512,
          "type": "string"
        },
        "responseFormats": {
          "items": {
            "enum": [
              "signed-jws",
              "unsigned-json",
              "sd-jwt-vc",
              "sd-jwt-vc-batch"
            ]
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "subjectBindingMode": {
          "description": "What the subject bindings in this requirement's assertions are derived under. The vocabulary is closed and carries no default: absence means audience-scoped, stated here so a relying party reading a definition without the key knows the requirement issues audience-scoped assertions and is not reading an omission it has to resolve elsewhere. A definition that does carry the key states the mode explicitly.",
          "enum": [
            "audience-scoped",
            "holder-bound"
          ]
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/subject"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "handle",
        "requirement",
        "configurationRevision",
        "kind",
        "evidenceType",
        "purpose",
        "responseFormats",
        "referenceFrameworks",
        "subjects",
        "concepts"
      ],
      "type": "object"
    },
    "selector": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/selector-field"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "profile": {
          "pattern": "^[a-z][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "valueOrigin": {
          "enum": [
            "request",
            "authenticated-context",
            "authenticated-grant"
          ]
        }
      },
      "required": [
        "profile",
        "valueOrigin",
        "fields"
      ],
      "type": "object"
    },
    "selector-field": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "maximumBytes": {
              "maximum": 8192,
              "minimum": 1,
              "type": "integer"
            },
            "minimumBytes": {
              "maximum": 8192,
              "minimum": 1,
              "type": "integer"
            },
            "name": {
              "pattern": "^[a-z][a-z0-9._-]{0,63}$",
              "type": "string"
            },
            "type": {
              "const": "string"
            }
          },
          "required": [
            "type",
            "name",
            "minimumBytes",
            "maximumBytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "pattern": "^[a-z][a-z0-9._-]{0,63}$",
              "type": "string"
            },
            "type": {
              "const": "date"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "pattern": "^[a-z][a-z0-9._-]{0,63}$",
              "type": "string"
            },
            "type": {
              "const": "uuid"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "maximum": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "minimum": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "name": {
              "pattern": "^[a-z][a-z0-9._-]{0,63}$",
              "type": "string"
            },
            "type": {
              "const": "integer"
            }
          },
          "required": [
            "type",
            "name",
            "minimum",
            "maximum"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "pattern": "^[a-z][a-z0-9._-]{0,63}$",
              "type": "string"
            },
            "type": {
              "const": "boolean"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "maximumBytes": {
              "maximum": 8192,
              "minimum": 1,
              "type": "integer"
            },
            "name": {
              "pattern": "^[a-z][a-z0-9._-]{0,63}$",
              "type": "string"
            },
            "scheme": {
              "format": "uri",
              "maxLength": 512,
              "type": "string"
            },
            "type": {
              "const": "controlled-code"
            },
            "version": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
