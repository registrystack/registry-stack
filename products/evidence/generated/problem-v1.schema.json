        },
        "status": {
          "const": 429
        },
        "title": {
          "const": "Evidence request rate is exhausted"
        },
        "type": {
          "const": "https://id.registrystack.org/problems/registry-evidence/evidence/rate_limited"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "source.unavailable"
        },
        "detail": {
          "const": "the authoritative source is unavailable"
        },
        "status": {
          "const": 503
