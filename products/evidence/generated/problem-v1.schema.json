        "status": {
          "const": 400
        },
        "title": {
          "const": "Selector is invalid"
        },
        "type": {
          "const": "https://id.registrystack.org/problems/registry-evidence/request/selector_invalid"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "auth.invalid_credential"
        },
        "detail": {
          "const": "bearer access token validation failed"
        },
        "status": {
          "const": 401
        },
        "title": {
          "const": "Bearer access token is invalid"
        },
        "type": {
          "const": "https://id.registrystack.org/problems/registry-evidence/auth/invalid_credential"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "evidence.denied"
        },
        "detail": {
          "const": "the Evidence request is not permitted"
        },
        "status": {
          "const": 403
        },
        "title": {
          "const": "Evidence request is not permitted"
        },
        "type": {
          "const": "https://id.registrystack.org/problems/registry-evidence/evidence/denied"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "format.unsupported"
        },
        "detail": {
          "const": "the requested format is not supported"
        },
        "status": {
          "const": 406
        },
        "title": {
          "const": "Requested format is not supported"
        },
        "type": {
          "const": "https://id.registrystack.org/problems/registry-evidence/format/unsupported"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "evidence.unavailable"
