  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "code": {
          "const": "evidence.invalid_request"
        },
        "detail": {
          "const": "the Evidence request is invalid"
        },
        "status": {
          "const": 400
        },
        "title": {
          "const": "Evidence request is invalid"
        },
        "type": {
          "const": "https://id.registrystack.org/problems/registry-evidence/evidence/invalid_request"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "request.selector_invalid"
        },
        "detail": {
