      "bind": "issuer"
    },
    "aud": {
      "bind": "audience"
    },
    "sub": "00000000-0000-4000-8000-000000000001",
    "iat": {
      "offsetSeconds": 0
    },
    "nbf": {
      "offsetSeconds": 0
    },
    "exp": {
      "offsetSeconds": 300
    }
  },
  "omits": [
    "scope",
    "scp",
    "client_id",
    "azp",
    "registry_actor_kind"
  ]
