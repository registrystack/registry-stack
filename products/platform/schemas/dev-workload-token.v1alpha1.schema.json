{
  "$defs": {
    "ExternalId": {
      "description": "An identifier another system issues, written exactly as its issuer gives it.",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "type": "string"
    },
    "Url": {
      "description": "An absolute http or https URL with a host preserved as written, no user information, and no backslash, whitespace or control character. DNS case and equivalent IPv6 literals are permitted.",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\u005C\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+([/?#][^\\u005C\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]*)?$",
      "type": "string"
    },
    "WorkloadProduct": {
      "enum": [
        "breg",
        "messaging"
      ],
      "type": "string"
    },
    "WorkloadTokenStatus": {
      "enum": [
        "stopped"
      ],
      "type": "string"
    }
  },
  "$id": "https://id.registrystack.org/schemas/platform/dev-workload-token/dev-workload-token.v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "not": {
        "required": [
          "status"
        ]
      },
      "required": [
        "token"
      ]
    },
    {
      "not": {
        "required": [
          "token"
        ]
      },
      "required": [
        "status"
      ]
    }
  ],
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/platform/dev-workload-token/v1alpha1",
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/ExternalId"
    },
    "claims": {
      "additionalProperties": true,
      "propertyNames": {
        "$ref": "#/$defs/ExternalId"
      },
      "type": "object",
      "x-registry-passthrough": "Claim values are written into the workload token as declared."
    },
    "clientId": {
      "$ref": "#/$defs/ExternalId"
    },
    "expiresAt": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "generation": {
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 1,
      "type": "integer"
    },
    "issuedAt": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "issuer": {
      "$ref": "#/$defs/Url"
    },
    "kind": {
      "const": "PlatformDevWorkloadToken",
      "type": "string"
    },
    "product": {
      "$ref": "#/$defs/WorkloadProduct"
    },
    "profile": {
      "$ref": "#/$defs/ExternalId"
    },
    "resource": {
      "$ref": "#/$defs/ExternalId"
    },
    "runExpiresAt": {
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 1,
      "type": "integer"
    },
    "runId": {
      "$ref": "#/$defs/ExternalId"
    },
    "scopes": {
      "items": {
        "$ref": "#/$defs/ExternalId"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "$ref": "#/$defs/WorkloadTokenStatus"
    },
    "subject": {
      "$ref": "#/$defs/ExternalId"
    },
    "token": {
      "maxLength": 8192,
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "runId",
    "binding",
    "product",
    "issuer",
    "subject",
    "clientId",
    "profile",
    "resource",
    "scopes",
    "claims",
    "generation",
    "issuedAt",
    "expiresAt",
    "runExpiresAt"
  ],
  "title": "DevWorkloadToken",
  "type": "object"
}
