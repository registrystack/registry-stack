    {"clientId": "scheduling-booking-agent", "name": "Scheduling caller", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "secret": "${JOURNEY_CLIENT_SECRET_SCHEDULING}", "standardFlowEnabled": false, "implicitFlowEnabled": false,
     "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true},

    {"clientId": "urn:example:documents", "name": "Documents API", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "standardFlowEnabled": false, "implicitFlowEnabled": false, "directAccessGrantsEnabled": false, "serviceAccountsEnabled": false},
    {"clientId": "case-portal", "name": "Documents caller", "enabled": true, "protocol": "openid-connect", "publicClient": false,
