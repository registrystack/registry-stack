     "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true},

    {"clientId": "urn:example:render", "name": "Render API", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "standardFlowEnabled": false, "implicitFlowEnabled": false, "directAccessGrantsEnabled": false, "serviceAccountsEnabled": false},
    {"clientId": "portal", "name": "Render caller", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "secret": "${JOURNEY_CLIENT_SECRET_RENDER}", "standardFlowEnabled": false, "implicitFlowEnabled": false,
     "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true}
  ],
  "users": [
    {"username": "service-account-directory-client", "enabled": true, "serviceAccountClientId": "directory-client",
     "clientRoles": {"urn:breg:local-directory": ["access"]}},
    {"username": "service-account-casework-client", "enabled": true, "serviceAccountClientId": "casework-client",
     "clientRoles": {"urn:example:casework": ["access"]}},
    {"username": "service-account-case-system", "enabled": true, "serviceAccountClientId": "case-system",
     "clientRoles": {"urn:example:messaging": ["access"]}},
    {"username": "service-account-scheduling-booking-agent", "enabled": true, "serviceAccountClientId": "scheduling-booking-agent",
     "clientRoles": {"urn:example:scheduling": ["access"]}},
    {"username": "service-account-case-portal", "enabled": true, "serviceAccountClientId": "case-portal",
     "clientRoles": {"urn:example:documents": ["access"]}},
    {"username": "service-account-coordinator-producer", "enabled": true, "serviceAccountClientId": "coordinator-producer",
     "clientRoles": {"urn:example:coordinator": ["access"]}},
    {"username": "service-account-registry-adapter-example-client", "enabled": true, "serviceAccountClientId": "registry-adapter-example-client",
     "clientRoles": {"registry-adapter-example": ["access"]}},
    {"username": "service-account-evidence-client", "enabled": true, "serviceAccountClientId": "evidence-client",
     "clientRoles": {"urn:example:audience:local-evidence": ["access"]}},
    {"username": "service-account-portal", "enabled": true, "serviceAccountClientId": "portal",
     "clientRoles": {"urn:example:render": ["access"]}}
  ]
