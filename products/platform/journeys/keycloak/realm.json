{
  "realm": "registry-journey",
  "displayName": "Registry Stack own-provider journey",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "client": {
      "urn:breg:local-directory": [{"name": "access"}],
      "urn:example:casework": [{"name": "access"}],
      "urn:example:messaging": [{"name": "access"}],
      "urn:example:scheduling": [{"name": "access"}],
      "urn:example:documents": [{"name": "access"}],
      "urn:example:coordinator": [{"name": "access"}],
      "registry-adapter-example": [{"name": "access"}],
      "urn:example:audience:local-evidence": [{"name": "access"}],
      "urn:example:render": [{"name": "access"}]
    }
  },
  "clients": [
    {"clientId": "urn:breg:local-directory", "name": "BReg API", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "standardFlowEnabled": false, "implicitFlowEnabled": false, "directAccessGrantsEnabled": false, "serviceAccountsEnabled": false},
    {"clientId": "directory-client", "name": "BReg caller", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "secret": "${JOURNEY_CLIENT_SECRET_BREG}", "standardFlowEnabled": false, "implicitFlowEnabled": false,
     "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true},

    {"clientId": "urn:example:casework", "name": "Casework API", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "standardFlowEnabled": false, "implicitFlowEnabled": false, "directAccessGrantsEnabled": false, "serviceAccountsEnabled": false},
    {"clientId": "casework-client", "name": "Casework caller", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "secret": "${JOURNEY_CLIENT_SECRET_CASEWORK}", "standardFlowEnabled": false, "implicitFlowEnabled": false,
     "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true},

    {"clientId": "urn:example:messaging", "name": "Messaging API", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "standardFlowEnabled": false, "implicitFlowEnabled": false, "directAccessGrantsEnabled": false, "serviceAccountsEnabled": false},
    {"clientId": "case-system", "name": "Messaging caller", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "secret": "${JOURNEY_CLIENT_SECRET_MESSAGING}", "standardFlowEnabled": false, "implicitFlowEnabled": false,
     "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true},

    {"clientId": "urn:example:scheduling", "name": "Scheduling API", "enabled": true, "protocol": "openid-connect", "publicClient": false,
