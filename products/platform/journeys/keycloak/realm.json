    {"clientId": "coordinator-producer", "name": "Coordinator caller", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "secret": "${JOURNEY_CLIENT_SECRET_COORDINATOR}", "standardFlowEnabled": false, "implicitFlowEnabled": false,
     "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true},

    {"clientId": "registry-adapter-example", "name": "Adapter API", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "standardFlowEnabled": false, "implicitFlowEnabled": false, "directAccessGrantsEnabled": false, "serviceAccountsEnabled": false},
    {"clientId": "registry-adapter-example-client", "name": "Adapter caller", "enabled": true, "protocol": "openid-connect", "publicClient": false,
     "secret": "${JOURNEY_CLIENT_SECRET_ADAPTER}", "standardFlowEnabled": false, "implicitFlowEnabled": false,
     "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true},

    {"clientId": "urn:example:audience:local-evidence", "name": "Evidence API", "enabled": true, "protocol": "openid-connect", "publicClient": false,
