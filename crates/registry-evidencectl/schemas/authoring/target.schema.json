        "sd-jwt-vc",
        "sd-jwt-vc-batch"
      ],
      "type": "string"
    },
    "TargetSecretProviders": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetEnvironmentSecretProvider"
            },
            {
              "type": "null"
            }
          ]
        },
        "file": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetFileSecretProvider"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "TargetService": {
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "$ref": "#/$defs/TargetIssuerId"
        },
        "providerId": {
          "type": "string"
        },
        "publicOrigin": {
          "$ref": "#/$defs/Url"
