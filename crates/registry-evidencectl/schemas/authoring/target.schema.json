            }
          ]
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "type": "object"
    },
    "TargetPublication": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/$defs/DisplayText"
        },
        "endpointUrl": {
          "$ref": "#/$defs/Url"
        },
        "jurisdictions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "operatorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisherId": {
          "type": [
            "string",
            "null"
          ]
        },
        "serviceId": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/DisplayText"
        }
      },
      "required": [
        "serviceId",
        "title",
        "description",
        "endpointUrl",
        "jurisdictions"
      ],
      "type": "object"
    },
    "TargetRateLimits": {
      "additionalProperties": false,
      "properties": {
        "burstPerPrincipal": {
          "format": "uint32",
          "maximum": 100000,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "failedSelectorAttemptsPerPrincipalAuthorityPerMinute": {
          "format": "uint32",
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        "requestsPerPrincipalPerMinute": {
          "format": "uint32",
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "requestsPerPrincipalPerMinute",
        "failedSelectorAttemptsPerPrincipalAuthorityPerMinute"
      ],
      "type": "object"
    },
    "TargetResponseFormat": {
      "enum": [
