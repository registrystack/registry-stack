          "type": "string"
        }
      },
      "required": [
        "providerId",
        "issuer",
        "publicOrigin",
        "trustDomain"
      ],
      "type": "object"
    },
    "TargetSigner": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "$ref": "#/$defs/TargetSigningAlgorithm"
            },
            "privateKeyRef": {
              "$ref": "#/$defs/SecretReference"
            },
            "publicJwkFile": {
              "type": "string"
            },
            "type": {
              "const": "local-jwk",
              "type": "string"
            }
          },
          "required": [
            "type",
            "algorithm",
            "privateKeyRef",
            "publicJwkFile"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
