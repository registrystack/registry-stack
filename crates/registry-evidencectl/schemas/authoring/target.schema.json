            },
            "mount": {
              "type": "string"
            },
            "publicJwkFile": {
              "type": "string"
            },
            "type": {
              "const": "transit",
              "type": "string"
            },
            "unixSocketPath": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "algorithm",
            "publicJwkFile",
            "unixSocketPath",
            "mount",
            "keyName",
            "keyVersion",
            "attemptTimeoutMilliseconds"
          ],
          "type": "object"
        }
      ]
    },
    "TargetSigning": {
      "additionalProperties": false,
      "description": "What the target may sign, beyond the signer binding. When the target\nomits this block, it signs for at most 300 seconds.",
      "properties": {
        "maximumAssertionValiditySeconds": {
          "description": "The longest validity, in seconds, any definition on this target may\nsign an assertion for.",
          "format": "uint64",
          "maximum": 31536000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "maximumAssertionValiditySeconds"
      ],
      "type": "object"
    },
    "TargetSigningAlgorithm": {
      "enum": [
        "ES256"
      ],
      "type": "string"
    },
    "TargetSubjectBinding": {
      "additionalProperties": false,
      "properties": {
        "keyVersion": {
          "format": "uint32",
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "secretRef": {
          "$ref": "#/$defs/SecretReference"
        }
      },
      "required": [
        "secretRef",
        "keyVersion"
      ],
      "type": "object"
    },
    "TargetTlsTermination": {
      "enum": [
        "operator-controlled-upstream"
      ],
      "type": "string"
    },
    "TargetTrustProfile": {
      "additionalProperties": false,
      "properties": {
        "caBundleFile": {
          "type": "string"
        }
      },
      "required": [
        "caBundleFile"
      ],
      "type": "object"
    },
    "Url": {
      "description": "An absolute http or https URL with a host preserved as written, no user information, and no backslash, whitespace or control character. DNS case and equivalent IPv6 literals are permitted.",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\u005C\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]+([/?#][^\\u005C\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]*)?$",
      "type": "string"
    }
  },
