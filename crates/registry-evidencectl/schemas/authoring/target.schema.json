            },
            "attemptTimeoutMilliseconds": {
              "format": "uint64",
              "maximum": 30000,
              "minimum": 1,
              "type": "integer"
            },
            "keyName": {
              "type": "string"
            },
            "keyVersion": {
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 1,
