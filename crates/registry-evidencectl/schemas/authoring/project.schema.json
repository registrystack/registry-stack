        "maximumConcurrency": {
          "format": "uint64",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "attemptTimeoutMilliseconds",
        "maximumConcurrency"
      ],
      "type": "object"
    },
    "SourceResponse": {
