            "string",
            "null"
          ]
        },
        "schemeVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "sdJwtVc": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputProjection"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "enum": [
            "boolean",
            "controlled-code",
            "controlled-category",
            "bounded-identifier",
            "bounded-integer",
            "bounded-decimal",
            "date-bucket",
            "time-bucket",
            "audience-scoped-entity-reference",
            "controlled-code-list",
            "entity-reference-list",
            "reviewed-structured-value"
          ],
          "type": "string"
        },
        "unique": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "values": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "concept",
        "type"
      ],
      "type": "object"
    },
    "OutputNumericBound": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "maxLength": 30,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
          "type": "string"
        }
      ]
    },
    "OutputProjection": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "type": "string"
        },
        "disclosure": {
          "$ref": "#/$defs/ProjectionDisclosure"
        }
