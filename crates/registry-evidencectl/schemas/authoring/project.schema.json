      "required": [
        "claim",
        "disclosure"
      ],
      "type": "object"
    },
    "ProjectionDisclosure": {
      "enum": [
        "top-level"
      ],
      "type": "string"
    },
    "Representation": {
      "enum": [
        "signed-jws",
        "sd-jwt-vc",
        "unsigned-json",
        "sd-jwt-vc-batch"
      ],
      "type": "string"
