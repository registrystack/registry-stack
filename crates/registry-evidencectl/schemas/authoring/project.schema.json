            },
            "type": {
              "const": "date",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "description": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DisplayText"
                },
                {
                  "type": "null"
                }
              ]
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DisplayText"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "uuid",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "description": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DisplayText"
                },
                {
                  "type": "null"
                }
              ]
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DisplayText"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maximum": {
              "format": "int64",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "minimum": {
              "format": "int64",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "type": {
              "const": "integer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "minimum",
            "maximum"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "description": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DisplayText"
                },
                {
                  "type": "null"
                }
              ]
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DisplayText"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "boolean",
