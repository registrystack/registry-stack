    "SourceInputSelector": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/LocalId"
        },
        "profile": {
          "$ref": "#/$defs/LocalId"
        },
        "role": {
          "$ref": "#/$defs/LocalId"
        }
      },
      "required": [
        "role",
        "profile",
        "field"
      ],
      "type": "object"
    },
    "SourceProjection": {
      "additionalProperties": false,
      "description": "A reviewed source-facts projection and its versioned output JSON Schema.",
      "properties": {
        "entrypoint": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "entrypoint",
        "schema"
      ],
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/$defs/LocalId"
        },
        "selectors": {
          "items": {
            "$ref": "#/$defs/LocalId"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "role",
        "selectors"
      ],
      "type": "object"
    },
    "ValueOrigin": {
      "enum": [
        "request",
        "authenticated-context",
        "authenticated-grant"
      ],
      "type": "string"
    }
  },
  "$id": "https://id.registrystack.org/schemas/evidence/project/project.v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "id.registrystack.org/formats/evidence/project/v1alpha1",
      "type": "string"
    },
    "assertionDefinitions": {
      "additionalProperties": {
        "$ref": "#/$defs/AssertionDefinition"
      },
      "propertyNames": {
        "$ref": "#/$defs/LocalId"
      },
      "type": "object"
    },
    "description": {
      "anyOf": [
        {
          "$ref": "#/$defs/DisplayText"
        },
        {
          "type": "null"
        }
      ],
      "description": "Human explanation for authors and reviewers; excluded from behavior revisions."
    },
    "functions": {
      "items": {
        "$ref": "#/$defs/Function"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/LocalId"
    },
    "kind": {
      "const": "EvidenceProject",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "$ref": "#/$defs/DisplayText"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional presentation label. Stable references use the identifier."
    },
    "maximumHolderBoundBatchSize": {
      "description": "Maximum assertions released together in one holder-bound batch; omission means one.",
      "format": "uint64",
      "maximum": 16,
      "minimum": 1,
      "type": [
