        "type": {
          "enum": [
            "boolean",
            "controlled-code",
            "controlled-category",
            "bounded-identifier",
            "bounded-integer",
            "bounded-decimal",
            "date-bucket",
            "time-bucket",
            "audience-scoped-entity-reference",
            "controlled-code-list",
            "entity-reference-list",
            "reviewed-structured-value"
