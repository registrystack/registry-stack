            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "codelist": {
              "type": "string"
            },
            "codelistVersion": {
              "type": "string"
            },
            "description": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DisplayText"
                },
                {
                  "type": "null"
                }
              ]
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DisplayText"
                },
                {
                  "type": "null"
