              "type": "string"
            },
            "codelistVersion": {
              "type": "string"
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "maximumBytes": {
              "format": "uint64",
              "maximum": 8192,
              "minimum": 1,
