        "source"
      ],
      "type": "object"
    },
    "FunctionCall": {
      "additionalProperties": false,
      "properties": {
        "function": {
          "$ref": "#/$defs/LocalId"
        },
        "parameters": {
          "additionalProperties": true,
          "type": "object",
          "x-registry-passthrough": "Literal reviewed Function parameter bindings, checked at the named Function call site."
        },
        "selectorInputs": {
          "items": {
            "$ref": "#/$defs/DeriveSelectorInput"
