          },
          "required": [
            "type",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fetch": {
              "$ref": "#/$defs/LocalId"
            },
            "search": {
              "$ref": "#/$defs/LocalId"
            },
            "type": {
              "const": "search-then-fetch",
              "type": "string"
            }
          },
          "required": [
            "type",
            "search",
            "fetch"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fetch": {
              "items": {
                "$ref": "#/$defs/FetchMember"
              },
              "type": "array"
            },
            "maximumAcquisitionMilliseconds": {
              "format": "uint64",
              "maximum": 30000,
              "minimum": 1,
              "type": "integer"
            },
            "search": {
              "$ref": "#/$defs/LocalId"
            },
            "type": {
              "const": "search-then-fetch-set",
              "type": "string"
            }
          },
          "required": [
            "type",
            "search",
            "fetch",
            "maximumAcquisitionMilliseconds"
          ],
          "type": "object"
        }
      ]
    },
    "AcquisitionCapability": {
      "enum": [
        "search-then-fetch-set",
        "source-batch"
      ],
      "type": "string"
    },
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "service"
      ],
      "type": "string"
    },
    "AssertionDefinition": {
      "additionalProperties": false,
      "properties": {
        "acquisition": {
          "$ref": "#/$defs/Acquisition"
        },
        "derive": {
          "$ref": "#/$defs/FunctionCall"
        },
        "description": {
          "description": "Human explanation for authors and reviewers; excluded from behavior revisions.",
          "type": [
            "string",
            "null"
          ]
        },
        "disclosureGuard": true,
        "existenceDisclosure": {
          "default": "collapse-unresolved",
          "type": "string"
        },
        "fixtures": {
          "type": [
            "string",
            "null"
          ]
        },
        "grantCeiling": {
          "$ref": "#/$defs/GrantCeiling"
        },
        "label": {
          "description": "Optional presentation label. Stable references use the identifier.",
          "type": [
            "string",
            "null"
          ]
        },
        "observationTimezone": {
          "default": "UTC",
          "type": "string"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Output"
          },
          "maxProperties": 16,
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/LocalId"
          },
          "type": "object"
        },
        "purpose": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "representations": {
          "items": {
            "$ref": "#/$defs/Representation"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "semantics": {
          "$ref": "#/$defs/Semantics"
        },
        "subjectBinding": {
          "$ref": "#/$defs/BindingMode"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/Subject"
          },
          "type": "array"
        },
        "validitySeconds": {
          "format": "uint64",
          "maximum": 31536000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "question",
        "semantics",
        "purpose",
        "grantCeiling",
        "subjects",
        "acquisition",
        "derive",
        "outputs",
        "validitySeconds",
        "subjectBinding",
        "representations"
      ],
      "type": "object"
    },
    "AuthorityKind": {
      "enum": [
        "statutory",
        "organizational",
        "consent",
        "delegated",
        "explicit-request"
      ],
      "type": "string"
    },
    "BatchResponse": {
      "additionalProperties": false,
      "description": "The batch response uses the Source's byte and transport ceilings.",
