{
  "$defs": {
    "Acquisition": {
      "additionalProperties": false,
      "properties": {
        "holderPresented": {
          "anyOf": [
            {
              "$ref": "#/$defs/HolderPresented"
            },
            {
              "type": "null"
            }
          ],
          "description": "A wallet presentation Source for the selector profiles it lists. A\nrequest on one of those profiles acquires only through this Source."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalId"
            },
            {
              "type": "null"
            }
          ],
          "description": "One reviewed route owns the complete bounded provider interaction for\nthe selector profiles that `holderPresented` does not claim. Optional\nonly when `holderPresented` lists every profile the subject roles allow."
        }
      },
      "type": "object"
    },
    "AcquisitionPosture": {
      "enum": [
        "source-derived",
        "field-projected",
        "record-transformed"
      ],
      "type": "string"
    },
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "service"
      ],
      "type": "string"
    },
    "AssertionDefinition": {
      "additionalProperties": false,
      "properties": {
        "acquisition": {
          "$ref": "#/$defs/Acquisition"
        },
        "derive": {
          "$ref": "#/$defs/FunctionCall"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/DisplayText"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human explanation for authors and reviewers; excluded from behavior revisions."
        },
        "disclosureGuard": true,
        "existenceDisclosure": {
          "default": "collapse-unresolved",
          "type": "string"
        },
        "fixtures": {
          "type": [
            "string",
            "null"
          ]
        },
        "grantCeiling": {
          "$ref": "#/$defs/GrantCeiling"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/DisplayText"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional presentation label. Stable references use the identifier."
        },
        "observationTimezone": {
          "default": "UTC",
          "type": "string"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Output"
          },
          "maxProperties": 16,
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/LocalId"
          },
          "type": "object"
        },
        "publicCheck": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicCheck"
            },
            {
              "type": "null"
            }
          ],
          "description": "Experimental (`v1alpha1`). Declares that this definition may answer the\nunauthenticated public certificate check once a target authority\nactivates it. Declaring it grants nothing by itself."
        },
        "purpose": {
          "type": "string"
        },
        "question": {
          "$ref": "#/$defs/DisplayText"
        },
        "representations": {
          "items": {
            "$ref": "#/$defs/Representation"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "semantics": {
          "$ref": "#/$defs/Semantics"
        },
        "subjectBinding": {
          "$ref": "#/$defs/BindingMode"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/Subject"
          },
          "type": "array"
        },
        "validitySeconds": {
          "format": "uint64",
          "maximum": 31536000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "question",
        "semantics",
        "purpose",
        "grantCeiling",
        "subjects",
        "acquisition",
        "derive",
        "outputs",
        "validitySeconds",
        "subjectBinding",
        "representations"
      ],
      "type": "object"
    },
    "AuthorityKind": {
      "enum": [
        "statutory",
        "organizational",
        "consent",
        "delegated",
        "explicit-request"
      ],
      "type": "string"
    },
    "BindingMode": {
      "enum": [
        "audience-scoped",
        "holder-bound"
      ],
      "type": "string"
    },
    "DeriveSelectorInput": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/SelectorAlternative"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/LocalId"
        }
      },
      "required": [
        "role",
        "alternatives"
      ],
      "type": "object"
    },
    "DisplayText": {
      "description": "Human-readable display text. Bidirectional embedding, override, and isolate controls, byte-order marks, line and paragraph separators, and Unicode noncharacters are refused; multilingual joiners and direction marks remain valid.",
      "not": {
        "pattern": "[  ‪-‮⁦-⁩﻿﷐-﷯￾￿]|🿾|🿿|𯿾|𯿿|𿿾|𿿿|񏿾|񏿿|񟿾|񟿿|񯿾|񯿿|񿿾|񿿿|򏿾|򏿿|򟿾|򟿿|򯿾|򯿿|򿿾|򿿿|󏿾|󏿿|󟿾|󟿿|󯿾|󯿿|󿿾|󿿿|􏿾|􏿿"
      },
      "type": "string"
    },
    "ExternalId": {
      "description": "An identifier another system issues, written exactly as its issuer gives it.",
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "type": "string"
    },
    "Field": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "description": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DisplayText"
                },
                {
                  "type": "null"
                }
              ]
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DisplayText"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maximumBytes": {
              "format": "uint64",
              "maximum": 8192,
              "minimum": 1,
              "type": "integer"
            },
            "minimumBytes": {
              "format": "uint64",
              "maximum": 8192,
              "minimum": 1,
              "type": "integer"
            },
            "type": {
              "const": "string",
              "type": "string"
            }
          },
          "required": [
            "type",
            "minimumBytes",
            "maximumBytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "description": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DisplayText"
                },
                {
                  "type": "null"
                }
              ]
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DisplayText"
                },
                {
                  "type": "null"
                }
