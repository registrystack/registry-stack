    "Function": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "Human explanation for authors and reviewers; excluded from behavior revisions.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/LocalId"
        },
        "interface": {
          "$ref": "#/$defs/FunctionInterface"
        },
        "label": {
          "description": "Optional presentation label. Stable references use the identifier.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "id",
