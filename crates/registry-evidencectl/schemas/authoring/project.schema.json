        "null"
      ]
    },
    "selectorProfiles": {
      "additionalProperties": {
        "$ref": "#/$defs/SelectorProfile"
      },
      "propertyNames": {
        "$ref": "#/$defs/LocalId"
      },
      "type": "object"
    },
    "sources": {
      "additionalProperties": {
        "$ref": "#/$defs/Source"
      },
      "propertyNames": {
        "$ref": "#/$defs/LocalId"
      },
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "id",
    "selectorProfiles",
    "functions",
    "sources",
    "assertionDefinitions"
  ],
  "title": "Evidence project",
  "type": "object"
}
