          ]
        },
        "maximumItems": {
          "format": "uint64",
          "maximum": 64,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "maximumScale": {
          "format": "uint64",
          "maximum": 9,
