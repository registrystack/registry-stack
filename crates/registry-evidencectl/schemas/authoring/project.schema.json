    },
    "OutputNumericBound": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "maxLength": 30,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
          "type": "string"
        }
      ]
    },
    "OutputProjection": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "type": "string"
        },
        "disclosure": {
          "$ref": "#/$defs/ProjectionDisclosure"
        }
