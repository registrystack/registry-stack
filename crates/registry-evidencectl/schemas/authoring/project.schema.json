    "GrantCeiling": {
      "additionalProperties": false,
      "properties": {
        "actorKinds": {
          "items": {
            "$ref": "#/$defs/ActorKind"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "audiences": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
