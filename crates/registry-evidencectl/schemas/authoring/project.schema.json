        "extract": {
          "$ref": "#/$defs/SourceFunctionRef"
        },
        "maximumItems": {
          "format": "uint64",
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        },
        "prepare": {
          "$ref": "#/$defs/SourceFunctionRef"
        },
        "response": {
          "$ref": "#/$defs/BatchResponse"
        }
      },
      "required": [
        "maximumItems",
        "prepare",
        "extract",
        "response"
      ],
      "type": "object"
    },
    "SourceFunctionRef": {
      "additionalProperties": false,
      "description": "Source preparation and extraction share the Source's declared adapter\nparameters and minimized selector inputs. Call sites cannot override them.",
      "properties": {
        "function": {
          "$ref": "#/$defs/LocalId"
        }
      },
      "required": [
        "function"
      ],
      "type": "object"
    },
