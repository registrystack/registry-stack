      "required": [
        "authorities",
        "actorKinds",
        "valueOrigins",
        "audiences"
      ],
      "type": "object"
    },
    "LocalId": {
      "description": "A local identifier: a lowercase letter, then up to 63 lowercase letters, digits, `_`, or `-`.",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    },
