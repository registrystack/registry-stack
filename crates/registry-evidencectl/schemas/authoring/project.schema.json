            {
              "$ref": "#/$defs/LocalId"
            },
            {
              "type": "null"
            }
          ]
        },
        "facts": {
          "additionalProperties": true,
          "propertyNames": {
            "$ref": "#/$defs/LocalId"
          },
          "type": "object",
          "x-registry-passthrough": "Reviewed bounded private fact schemas, normalized by the Evidence compiler and checked by the kernel."
        },
        "forwardAccessAttribution": {
          "default": false,
          "type": "boolean"
        },
        "label": {
          "description": "Optional presentation label. Stable references use the identifier.",
          "type": [
            "string",
            "null"
