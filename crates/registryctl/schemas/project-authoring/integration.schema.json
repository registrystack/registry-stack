          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      ]
    },
    "input": {
      "description": "Type, validation, and canonicalization rules for one authored input.",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "type"],
      "properties": {
        "role": {"x-registry-field": "property", "enum": ["selector", "parameter"] },
        "type": {"x-registry-field": "property", "$ref": "#/$defs/scalarType" },
        "format": {"x-registry-field": "property", "const": "date" },
