  "title": "Registry Stack project environment v1",
  "description": "Binds a Registry Stack project to environment-specific services, sources, credentials, and deployment topology.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "deployment"],
  "properties": {
    "version": {"x-registry-field": "public_property", "const": 1, "description": "Environment authoring format version." },
