      "if": {"x-registry-field": "branch", "required": ["relay_state"] },
      "then": {"x-registry-field": "branch", "properties": { "deployment": {"x-registry-field": "property", "required": ["relay"] } } }
    },
    {
      "x-registry-field": "branch",
      "if": {"x-registry-field": "branch", "required": ["notary_state"] },
      "then": {"x-registry-field": "branch", "properties": { "deployment": {"x-registry-field": "property", "required": ["notary"] } } }
    },
    {
      "x-registry-field": "branch",
      "if": {"x-registry-field": "branch", "required": ["notary_cel"] },
      "then": {"x-registry-field": "branch", "properties": { "deployment": {"x-registry-field": "property", "required": ["notary"] } } }
