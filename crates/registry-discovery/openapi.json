            },
            "maxItems": 128,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "evidenceTypeListId": {
            "format": "uri",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
