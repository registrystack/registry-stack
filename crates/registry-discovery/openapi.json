            "type": "string"
          },
          "evidenceTypeIds": {
            "items": {
              "format": "uri",
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
              "type": "string"
            },
            "maxItems": 256,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "jurisdictions": {
            "items": {
              "format": "uri",
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
              "type": "string"
            },
            "maxItems": 256,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "legalIssuerId": {
            "format": "uri",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
            "type": "string"
          },
          "operationFamilyIds": {
            "items": {
              "format": "uri",
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
