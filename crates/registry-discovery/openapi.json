          {
            "description": "Repeated exact-match values sharing the operation-wide aggregate limit of 4466 decoded Unicode scalar values.",
            "explode": true,
            "in": "query",
            "name": "recordId",
            "schema": {
              "items": {
                "maxLength": 4096,
                "minLength": 1,
                "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$",
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array",
              "uniqueItems": false
            },
            "style": "form"
          },
          {
