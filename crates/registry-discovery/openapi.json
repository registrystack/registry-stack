            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
            "type": "string"
          },
          "originContentDigest": {
            "maxLength": 71,
            "minLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "originFetchedAt": {
            "format": "date-time",
            "maxLength": 64,
            "type": "string"
          },
          "originId": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$",
            "type": "string"
          },
          "originUrl": {
            "format": "uri",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^(?:https://[^\\s\\u0000-\\u001f\\u007f-\\u009f/?#@]+|http://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]+)?)(?:/[^\\s\\u0000-\\u001f\\u007f-\\u009f?#]*)?$",
            "type": "string"
          },
          "publisherId": {
            "format": "uri",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
            "type": "string"
          },
          "recordId": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$",
            "type": "string"
          },
          "registryAuthorityId": {
            "format": "uri",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
            "type": "string"
          },
          "semanticClassIds": {
            "items": {
              "format": "uri",
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
              "type": "string"
            },
            "maxItems": 256,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "serviceId": {
            "format": "uri",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
            "type": "string"
          },
          "serviceKind": {
            "enum": [
              "evidence",
              "relay"
            ],
            "type": "string"
          },
          "technicalProviderId": {
            "format": "uri",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
            "type": "string"
          },
          "title": {
            "maxLength": 16384,
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
            "type": "string"
          }
        },
        "required": [
          "recordId",
          "bindingId",
          "serviceId",
          "serviceKind",
          "title",
          "description",
          "endpointUrl",
          "jurisdictions",
          "conformsTo",
          "evidenceTypeIds",
          "semanticClassIds",
          "operationFamilyIds",
          "originId",
          "originUrl",
          "originContentDigest",
          "originFetchedAt"
        ],
        "type": "object"
      },
      "ServiceSearchResponse": {
        "additionalProperties": false,
        "properties": {
          "catalogRevision": {
            "maxLength": 71,
            "minLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ServiceRecord"
            },
            "maxItems": 10000,
            "minItems": 0,
            "type": "array",
            "uniqueItems": false
          }
        },
        "required": [
          "catalogRevision",
          "items"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Registry Discovery",
    "version": "v1alpha1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Process is live"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "Exact OpenAPI document"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Immutable index is loaded"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/evidence-types/resolve": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceTypeResolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceTypeResolveResponse"
                }
              }
            },
            "description": "Complete exact mapping result"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "422": {
            "$ref": "#/components/responses/ResultBoundExceeded"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/services": {
      "get": {
        "description": "Exact unranked search. The encoded query is limited to 65536 bytes and all decoded values share one aggregate limit of 4466 Unicode scalar values. Individual field maxima do not imply that their aggregate is accepted.",
