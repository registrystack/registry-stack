                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array",
              "uniqueItems": false
            },
            "style": "form"
          },
          {
            "description": "Repeated exact-match values sharing the operation-wide aggregate limit of 4466 decoded Unicode scalar values.",
            "explode": true,
            "in": "query",
            "name": "semanticClass",
            "schema": {
              "items": {
                "format": "uri",
                "maxLength": 4096,
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array",
              "uniqueItems": false
            },
            "style": "form"
          },
          {
            "description": "Repeated exact-match values sharing the operation-wide aggregate limit of 4466 decoded Unicode scalar values.",
            "explode": true,
            "in": "query",
            "name": "operationFamily",
            "schema": {
              "items": {
                "format": "uri",
