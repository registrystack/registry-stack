{
  "components": {
    "responses": {
      "InvalidRequest": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Invalid request or request body exceeds the configured bound"
      },
      "ResultBoundExceeded": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Complete result exceeds the configured bound"
      },
      "Unavailable": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Request exceeded the configured time limit or the response could not be produced"
      }
    },
    "schemas": {
      "EvidenceTypeResolveRequest": {
        "additionalProperties": false,
        "properties": {
          "jurisdiction": {
            "format": "uri",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
            "type": "string"
          },
          "requirementId": {
            "format": "uri",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
            "type": "string"
          }
        },
        "required": [
          "requirementId"
        ],
        "type": "object"
      },
      "EvidenceTypeResolveResponse": {
        "additionalProperties": false,
        "properties": {
          "alternatives": {
            "items": {
              "$ref": "#/components/schemas/ResolvedAlternative"
            },
            "maxItems": 1000,
            "minItems": 0,
            "type": "array",
            "uniqueItems": false
          },
          "jurisdiction": {
            "format": "uri",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
            "type": "string"
          },
          "mappingRevision": {
            "maxLength": 71,
            "minLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "requirementId": {
            "format": "uri",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
            "type": "string"
          }
        },
        "required": [
          "requirementId",
          "mappingRevision",
          "alternatives"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "integer"
          },
          "title": {
            "maxLength": 16384,
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
            "type": "string"
          },
          "type": {
            "format": "uri",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "ResolvedAlternative": {
        "additionalProperties": false,
        "properties": {
          "evidenceTypeIds": {
            "items": {
              "format": "uri",
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
