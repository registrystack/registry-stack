{
  "name": "@registrystack/client",
  "version": "0.44.0",
  "description": "Unified Node.js client for Registry Stack products.",
  "license": "Apache-2.0",
  "homepage": "https://docs.registrystack.org/reference/client-api/",
  "bugs": { "url": "https://github.com/registrystack/registry-stack/issues" },
  "keywords": ["registry", "registrystack", "discovery", "evidence", "breg", "casework", "messaging", "scheduling"],
  "publishConfig": { "access": "public", "provenance": true },
  "repository": { "type": "git", "url": "https://github.com/registrystack/registry-stack", "directory": "crates/registry-stack-client-node" },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./compatibility.json": "./compatibility.json"
  },
  "files": ["index.js", "index.d.ts", "native.js", "compatibility.json", "discovery", "evidence", "breg", "casework", "messaging", "scheduling"],
  "engines": { "node": ">=24.11.0" },
  "scripts": {
    "sync": "python3 ../../release/scripts/sync-registry-client-node.py",
    "sync:check": "python3 ../../release/scripts/sync-registry-client-node.py --check",
    "test": "npm run sync:check && node ../../scripts/run-node-tests.mjs __test__/*.test.js",
    "check:types": "tsc --noEmit --strict --skipLibCheck false --types node --moduleResolution node16 --module node16 --target es2022 index.d.ts __test__/facade.test-d.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
