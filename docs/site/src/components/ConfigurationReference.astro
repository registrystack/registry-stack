---
type Field = {
  key_path: string;
  kind: string;
  type: string | null;
  required: 'yes' | 'no' | 'conditional';
  values: string[] | null;
  // Set when a conditional rule fixes the value in some cases, so the set above
  // is what the grammar accepts somewhere rather than everywhere.
  values_conditional: boolean;
  // One group per alternative the grammar offers. Bounds inside a group apply
  // together; separate groups are alternatives.
  constraints: string[][];
  // Bounds a rule elsewhere adds once its condition holds. They tighten
  // whichever alternative above was taken rather than offering another one.
  conditional_constraints: string[][];
  description: string | null;
  runtime_validation: string | null;
  defaults: string[];
};

const kindLabels: Record<string, string> = {
  property: 'Property',
  array_item: 'Array item',
  map_value: 'Map value',
};

const requiredLabels: Record<Field['required'], string> = {
  yes: 'Yes',
  no: 'No',
  conditional: 'Conditional',
};

type Contract = {
  id: string;
  file: string;
  title: string;
  status: string;
  reference: string;
  field_count: number;
  fields: Field[];
};

// The frozen Version 1 grammar and the adopter-tooling authoring schemas are
// published side by side. A reader who takes one for the other has read the
// page wrongly, so every section states which it is instead of leaving the
// difference to the file name.
const statusLabels: Record<string, string> = {
  frozen: 'Frozen Version 1 contract',
  tooling: 'Adopter tooling, not frozen',
  beta: 'Source preview, pre-1.0',
};

interface Props {
  contracts: Contract[];
  prefix: string;
  compact?: boolean;
}

const { contracts, prefix, compact = false } = Astro.props;

if (contracts.length === 0) {
  throw new Error('the configuration reference is empty; run npm run generate');
}

const unlabelled = contracts.find((contract) => !statusLabels[contract.status]);
if (unlabelled) {
  throw new Error(
    `the configuration reference publishes ${unlabelled.id} under an unknown status ${unlabelled.status}`,
  );
}

const slug = (id: string) => `${prefix}-${id}-configuration`;

// Descriptions come from the contracts, which mark identifiers with backticks
// the way a schema description is written for an editor tooltip. Split on the
// pairs so the page renders them as code rather than as literal backticks.
const segments = (text: string) =>
  text.split('`').map((part, index) => ({ code: index % 2 === 1, text: part }));
---

{
  !compact && (
    <nav aria-label="Configuration files" class="contract-index">
      <ul>
        {contracts.map((contract) => (
          <li>
            <a href={`#${slug(contract.id)}`}>
              <code>{contract.title}</code>
            </a>{' '}
            <span>
              {statusLabels[contract.status]}, {contract.field_count} key paths
            </span>
          </li>
        ))}
      </ul>
    </nav>
  )
}

{
  contracts.map((contract) => (
    <section class="contract-reference">
      {!compact && (
        <>
          <h2 id={slug(contract.id)}>
            <code>{contract.title}</code>
          </h2>
          <p class={`contract-status contract-status-${contract.status}`}>
            {statusLabels[contract.status]}
          </p>
          <p class="contract-source">
            Generated from <code>{contract.file}</code>. {contract.field_count} key paths. Explained in{' '}
            <code>{contract.reference}</code>.
          </p>
        </>
      )}
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Key path</th>
              <th scope="col">Type</th>
              <th scope="col">Required</th>
              <th scope="col">Accepted values</th>
              <th scope="col">Constraints</th>
            </tr>
          </thead>
          <tbody>
            {contract.fields.map((field) => (
              <tr>
                <th scope="row">
                  <code>{field.key_path}</code>
                  {field.kind !== 'property' && <span class="kind">{kindLabels[field.kind]}</span>}
                  {field.description && (
                    <span class="note">
                      {segments(field.description).map((part) =>
                        part.code ? <code>{part.text}</code> : part.text,
                      )}
                    </span>
                  )}
                  {field.runtime_validation && (
                    <span class="note">Runtime check: {field.runtime_validation}</span>
                  )}
                </th>
                <td>{field.type ?? 'Not specified'}</td>
                <td>{requiredLabels[field.required]}</td>
                <td>
                  {field.values ? (
                    <>
                      <ul class="value-list">
                        {field.values.map((value) => (
                          <li>
                            <code>{value}</code>
                          </li>
                        ))}
                      </ul>
                      {field.values_conditional && (
                        <span class="note">A rule elsewhere fixes this value in some cases.</span>
                      )}
                    </>
                  ) : (
                    'Not specified'
                  )}
                  {field.defaults.length > 0 && (
                    <span class="note">
                      Schema default, where declared: {field.defaults.map((value, index) => (
                        <>{index > 0 && ' or '}<code>{value}</code></>
                      ))}
                    </span>
                  )}
                </td>
                <td>
                  {field.constraints.length === 0 &&
                    field.conditional_constraints.length === 0 &&
                    'None specified'}
                  {field.constraints.map((group, index) => (
                    <>
                      {index > 0 && <p class="alternative">or</p>}
                      {group.length > 0 ? (
                        <ul class="value-list">
                          {group.map((constraint) => (
                            <li>
                              <code>{constraint}</code>
                            </li>
                          ))}
                        </ul>
                      ) : (
                        // An alternative the grammar leaves unbounded. Naming
                        // it keeps the neighbouring bounds from reading as
                        // though they held under every alternative.
                        <p class="unbounded">No bound</p>
                      )}
                    </>
                  ))}
                  {field.conditional_constraints.length > 0 && (
                    // A second axis: these tighten whichever alternative above
                    // was taken. Listing them beside it instead would offer the
                    // case where the rule stays silent as a choice of its own.
                    <>
                      <p class="alternative">
                        {field.constraints.length > 0
                          ? 'and, where a rule elsewhere applies'
                          : 'where a rule elsewhere applies'}
                      </p>
                      {field.conditional_constraints.map((group, index) => (
                        <>
                          {index > 0 && <p class="alternative">or</p>}
                          <ul class="value-list">
                            {group.map((constraint) => (
                              <li>
                                <code>{constraint}</code>
                              </li>
                            ))}
                          </ul>
                        </>
                      ))}
                    </>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))
}

<style>
  .contract-index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
  }

  .contract-index span,
  .contract-source {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .contract-reference {
    margin-block: 2.5rem;
  }

  .contract-status {
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.25rem;
    display: inline-block;
    font-size: var(--sl-text-xs);
    letter-spacing: 0.04em;
    margin: 0.25rem 0 0.5rem;
    padding: 0.15rem 0.5rem;
    text-transform: uppercase;
  }

  .contract-status-frozen {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  .contract-status-tooling {
    color: var(--sl-color-gray-2);
  }

  .table-scroll {
    overflow-x: auto;
  }

  .table-scroll table {
    width: 100%;
  }

  .table-scroll th[scope='row'] {
    text-align: start;
    vertical-align: top;
  }

  .table-scroll th[scope='row'] code {
    overflow-wrap: anywhere;
  }

  .kind,
  .note {
    color: var(--sl-color-gray-2);
    display: block;
    font-size: var(--sl-text-xs);
    font-weight: 400;
    margin-top: 0.25rem;
  }

  .value-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .alternative {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-style: italic;
    margin: 0.25rem 0;
  }

  .unbounded {
    color: var(--sl-color-gray-2);
    margin: 0;
  }

  .value-list code {
    overflow-wrap: anywhere;
  }
</style>
