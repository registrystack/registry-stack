---
import reference from '../data/generated/evidence-configuration.json';

type Field = {
  key_path: string;
  kind: string;
  type: string | null;
  required: boolean;
  values: string[] | null;
  constraints: string[];
  description: string | null;
  runtime_validation: string | null;
};

const kindLabels: Record<string, string> = {
  property: 'Property',
  array_item: 'Array item',
  map_value: 'Map value',
};

const contracts = reference.contracts as Array<{
  id: string;
  file: string;
  title: string;
  field_count: number;
  fields: Field[];
}>;

if (contracts.length === 0) {
  throw new Error('the Evidence configuration reference is empty; run npm run generate');
}

const slug = (id: string) => `evidence-${id}-configuration`;
---

<nav aria-label="Configuration files" class="contract-index">
  <ul>
    {
      contracts.map((contract) => (
        <li>
          <a href={`#${slug(contract.id)}`}>
            <code>{contract.title}</code>
          </a>{' '}
          <span>{contract.field_count} key paths</span>
        </li>
      ))
    }
  </ul>
</nav>

{
  contracts.map((contract) => (
    <section class="contract-reference">
      <h2 id={slug(contract.id)}>
        <code>{contract.title}</code>
      </h2>
      <p class="contract-source">
        Generated from <code>{contract.file}</code>. {contract.field_count} key paths.
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Key path</th>
              <th scope="col">Type</th>
              <th scope="col">Required</th>
              <th scope="col">Accepted values</th>
              <th scope="col">Constraints</th>
            </tr>
          </thead>
          <tbody>
            {contract.fields.map((field) => (
              <tr>
                <th scope="row">
                  <code>{field.key_path}</code>
                  {field.kind !== 'property' && <span class="kind">{kindLabels[field.kind]}</span>}
                  {field.description && <span class="note">{field.description}</span>}
                  {field.runtime_validation && (
                    <span class="note">Runtime check: {field.runtime_validation}</span>
                  )}
                </th>
                <td>{field.type ?? '—'}</td>
                <td>{field.required ? 'Yes' : 'No'}</td>
                <td>
                  {field.values ? (
                    <ul class="value-list">
                      {field.values.map((value) => (
                        <li>
                          <code>{value}</code>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    '—'
                  )}
                </td>
                <td>
                  {field.constraints.length > 0 ? (
                    <ul class="value-list">
                      {field.constraints.map((constraint) => (
                        <li>
                          <code>{constraint}</code>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    '—'
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))
}

<style>
  .contract-index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
  }

  .contract-index span,
  .contract-source {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .contract-reference {
    margin-block: 2.5rem;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .table-scroll table {
    width: 100%;
  }

  .table-scroll th[scope='row'] {
    text-align: start;
    vertical-align: top;
  }

  .table-scroll th[scope='row'] code {
    overflow-wrap: anywhere;
  }

  .kind,
  .note {
    color: var(--sl-color-gray-2);
    display: block;
    font-size: var(--sl-text-xs);
    font-weight: 400;
    margin-top: 0.25rem;
  }

  .value-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .value-list code {
    overflow-wrap: anywhere;
  }
</style>
