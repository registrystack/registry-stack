---
import docsetsManifest from '../data/generated/docsets.json';
import { CURRENT_PRODUCTION_DOCSET_PATH } from '../lib/docset-path.mjs';

const repoUrl = 'https://github.com/registrystack/registry-stack/tree/main/docs/site';
const activeDocsetId = process.env.DOCS_DOCSET || docsetsManifest.current;
const activeDocset =
  docsetsManifest.docsets.find((docset) => docset.id === activeDocsetId) ??
  docsetsManifest.docsets.find((docset) => docset.id === docsetsManifest.current);
const isArchived = activeDocset?.status === 'archived';
const isReleasedArchiveBuild =
  isArchived && process.env.DOCS_RELEASED_ARCHIVE === 'true';
const releasedDocset = docsetsManifest.docsets.find(
  (docset) => docset.id === docsetsManifest.released,
);
---

<aside class="registry-preview-banner" role="note" aria-label="Site status">
  {isReleasedArchiveBuild ? (
    <p>
      <strong>Released docs.</strong>{' '}
      You are viewing the documentation published with {activeDocset.label}. Development
      docs are available at <a href={CURRENT_PRODUCTION_DOCSET_PATH}>Latest</a>.
    </p>
  ) : isArchived ? (
    <p>
      <strong>Versioned archive.</strong>{' '}
      You are viewing {activeDocset.label}. For the latest released guidance, use{' '}
      <a href="/">Latest release</a>. Report archive issues on{' '}
      <a href={repoUrl}>GitHub</a>.
    </p>
  ) : (
    <p>
      <strong>Unreleased documentation.</strong>{' '}
      These pages follow the main branch and can change before the next release.
      For supported guidance, use{' '}
      <a href="/">{releasedDocset?.label ?? 'the latest release'}</a>.
    </p>
  )}
</aside>
