// Registry Casework review-only responsibilities and public trust boundaries.
// Components are logical responsibilities in one runtime. Links follow maintained source.
model {
  casework_app = external 'Staff application' {
    technology 'Server-side Casework client'
    description 'Presents visible ReviewTasks through a separately deployed application. Human credentials remain ephemeral server-side inputs; Casework ships no staff UI.'
    link https://github.com/registrystack/registry-stack/blob/main/products/casework/README.md 'Deployment and client boundary'
  }
  casework_staff = actor 'Human reviewer' {
    description 'Claims or receives a visible ReviewTask, keeps a private Decision draft, and decides under the pinned ReviewPolicy and current Directory and source authority.'
  }
  casework_supervisor = actor 'Supervisor' {
    description 'Administers authorized ReviewTask assignments and atomic caseload movement. Protected accountability requires current supervisory authority and remains separately retained.'
  }
  casework_administrator = actor 'Casework administrator' {
    description 'Maintains Directory teams, queue service and immutable calendar revisions. Directory authority grants no producer, source-disclosure or source-apply authority.'
  }
  casework_requester = external 'Trusted review producer' {
    description 'Creates and recovers ReviewRequests for its configured namespaces and policies. Retains the exact subject, policy and submission binding; fetches authenticated ReviewResults. A standalone producer needs no BReg.'
    link https://github.com/registrystack/registry-stack/blob/main/crates/registry-review-protocol/src/lib.rs 'Product-neutral producer and result contract'
  }
  casework_apply_principal = actor 'Source apply principal' {
    description 'Independently authorized by the source to apply an approved frozen Proposal after fresh source authorization and precondition checks. A ReviewResult supplies no mutation authority.'
  }
  casework_client = library 'Casework client SDKs' {
    technology 'Rust / Node.js / Python'
    description 'Bounded source-neutral clients expose policy discovery, request recovery, ReviewTasks, Decision receipts and authenticated results. Thin digest helpers reuse the Rust canonical submission digest. Calls select authorization explicitly; clients do not retry mutations automatically.'
    link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework-client/README.md 'Rust client'
    link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework-client-node/README.md 'Node.js binding'
    link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework-client-py/README.md 'Python binding'
  }
  casework_operator = actor 'Casework operator' {
    description 'Installs a reviewed package and runtime bindings, reviews activation plans, checks readiness and operates backups and the append-only audit archive. Retired WorkItem databases are preserved and refused before mutation; this replacement uses a fresh database.'
  }
  casework_project = artifact 'Casework project' {
    technology 'YAML / local schemas / exact provider exports'
    description 'Declares ReviewPolicies, trusted producers, optional read-only context providers, queues, profiles, teams, calendars, clocks and ReviewTask grant templates. Stable IDs are separate from labels. Current-source policies pin the producer contract and exact local schema bytes; submitted-context policies need no provider.'
    link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework-core/src/model.rs 'Authored project and compiled inspection model'
  }
  casework_cli = tool 'caseworkctl' {
    description 'Initializes, checks, explains and tests policies, generates types, inspects the single review lifecycle and packages the exact closure. Provider pairing verifies the native producer export and reader authority. Plan, status, apply and doctor operate explicit runtime configuration; dev starts a retained standalone session.'
    link https://github.com/registrystack/registry-stack/blob/main/crates/registry-caseworkctl/src/lib.rs 'Current CLI commands'
  }
  casework_package = artifact 'Casework policy package' {
    description 'Contains the checked policy and exact local schema and provider dependency closure with a digest manifest. Deployment endpoints and secret values remain outside the package.'
    link https://github.com/registrystack/registry-stack/blob/main/crates/registry-caseworkctl/src/project.rs 'Package assembly'
  }
  casework_runtime_config = artifact 'Casework runtime configuration' {
    description 'Binds separate runtime and migration database credentials, OIDC, listener policy, audit destination and hash-key reference, optional provider deployments and optional task authority. Service credentials are purpose-bound; human source reads use the exact human credential.'
    link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework/src/config.rs 'Runtime configuration'
  }
  casework_postgres = database 'Casework PostgreSQL' {
    description 'Owns pinned ReviewRequests, ReviewTasks, immutable Decisions, one terminal ReviewResult and feed event, exact replay receipts, Directory, clocks, grants and bounded retention. Current-source display values are not retained. Runtime and activation credentials have separate database authority.'
    link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework/migrations/0001_reviews.sql 'Fresh review-only schema'
  }
  casework_audit_journal = database 'Casework audit journal' {
    technology 'Minimized JSONL / durable file or stdout'
    description 'Records minimized admission and response entries without context, result fields or human reasons. Operators archive streams for tamper evidence. Audit failure gates protected work or disclosure; a response failure may follow a committed transaction and requires exact recovery.'
    link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework/src/audit.rs 'Audit release boundary'
  }
  casework = service 'Registry Casework' {
    technology 'Rust / Axum'
    description 'Runs one review lifecycle for submitted and current-source context. ReviewPolicy, ReviewRequest, ReviewTask, Decision and ReviewResult are its workflow concepts. Sources retain disclosure, reviewability and every eventual mutation.'
    link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework/src/runtime.rs 'Runtime assembly'
    api = component 'Review HTTP API' {
      description 'Serves policies, producer requests and results, human ReviewTasks and receipts, Directory and optional task-grant routes. Authentication, bounded bodies, no-store responses and audit gates apply at the public router.'
      link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework/src/http.rs 'Router'
    }
    access = component 'Authentication and current authority' {
      description 'Verifies OIDC and explicit profiles. Producer, human reviewer and grant-machine authority are separate. Current team service and eligibility are checked for each operation; source disclosure remains an independent live check.'
      link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework/src/auth.rs 'Authentication'
    }
    coordination = component 'Pinned review and staffing' {
      description 'Admits exact producer, subject, policy and submission bindings. Coordinates stages, thresholds, exclusions, claims, assignment, delegation, private drafts, due-ordered next, holdings and atomic caseload moves. Decisions and receipts commit under revision fences; a terminal settlement also commits one result and feed event.'
      link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework/src/review.rs 'Review lifecycle'
      link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework/src/review/staffing.rs 'Visibility-safe staffing'
    }
    task_grants = component 'Institutional task grants' {
      #optional #taskAuthority
      description 'A current eligible ReviewTask holder approves immutable agent, client, resource, scope, purpose, subject and deadline bounds. Submitted context uses its admitted snapshot; current-source fields require human disclosure at approval and separate purpose-bound rechecks. Immediate and explicit deferred modes retain their own lifetime limits. Casework signs short assertions, while the issuer and resource authorize execution independently.'
      link https://github.com/registrystack/registry-stack/blob/main/products/casework/TASK_GRANTS.md 'Approval, recheck, revocation and deadlines'
    }
    source_contract = component 'Read-only context provider boundary' {
      technology 'Source-neutral contract'
      description 'Separates human-display, field-free service-status, field-limited task-grant-context and routing-context capabilities. Each observation matches the exact SubjectBinding and producer contract. Submitted context requires none; unsupported required capabilities fail compilation.'
      link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework-core/src/adapter.rs 'Read-only provider operations'
      link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework-core/src/context.rs 'Pinned context and required capabilities'
    }
    breg_adapter = component 'BReg review context provider' {
      #optional
      technology 'registry-casework-breg / public BReg client'
      description 'Reads only the exact advertised Proposal context operation. Human display forwards the exact human source credential and profile. Service status and other compiled purposes use their separate configured authority and cannot widen display. No BReg database or runtime crate is imported.'
      link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework-breg/src/lib.rs 'Read-only BReg provider'
    }
    workers = component 'Clocks, completion and retention' {
      description 'Evaluates pinned clocks and bounded assignment and retention maintenance. Current-source checks use exact service status. Payload-free completion notifications only wake producers, which fetch authoritative results; delivery failure does not remove the durable result or feed event.'
      link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework/src/runtime.rs 'Background workers'
      link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework/src/review/maintenance.rs 'Retention and completion processing'
    }
    audit = component 'Audit release gate' {
      description 'Admits protected work before execution and confirms minimized response entries before release. Database commits are never described as rolled back merely because their audit response failed.'
      link https://github.com/registrystack/registry-stack/blob/main/crates/registry-casework/src/audit.rs 'Audit gate'
    }
  }
  casework_staff .call casework_app 'Reviews currently visible tasks'
  casework_supervisor .call casework_app 'Administers authorized ReviewTasks'
  casework_administrator .call casework_app 'Maintains Directory and calendar inputs'
  casework_app .call issuer 'Obtains a human token'
  casework_app .call casework_client 'Uses the bounded client'
  casework_client .call casework.api 'Selects explicit Casework and human source authority'
  casework_requester .call issuer 'Obtains its producer credential'
  casework_requester .call casework.api 'Creates, recovers and follows exact ReviewRequests'
  casework.workers .event casework_requester 'Sends a payload-free completion wakeup'
  casework_apply_principal .call breg.api 'Applies only with independent source authority and current preconditions'
  casework_operator .call casework_cli 'Authors and operates reviewed policy'
  casework_project .artifactFlow casework_cli 'Supplies policy and local contract closure'
  casework_cli .artifactFlow casework_package 'Packages exact reviewed bytes'
  casework_cli .call tooling 'Verifies the same-version native producer export and reader authority'
  casework_cli .call casework_postgres 'Plans or applies activation with separate operator authority'
  casework_package .artifactFlow casework 'Supplies exact activated policy'
  casework_runtime_config .artifactFlow casework 'Binds deployment endpoints and secret references'
  casework.api .call casework.access 'Authenticates and selects caller authority'
  casework.access .call issuer 'Resolves configured OIDC keys'
  casework.api .call casework.coordination 'Dispatches the single review lifecycle'
  casework.api .call casework.task_grants 'Dispatches bounded grant operations'
  casework.coordination .call casework.source_contract 'Checks required read-only capabilities'
  casework.coordination .call casework.breg_adapter 'Reads current human display and exact reviewability'
  casework.task_grants .call casework.source_contract 'Selects only compiled grant-context fields'
  casework.task_grants .call casework.breg_adapter 'Rechecks exact subject and granted facts'
  casework.workers .call casework.breg_adapter 'Checks field-free source status for pinned clocks'
  casework.coordination .call casework_postgres 'Commits review state, staffing, receipts and one terminal result'
  casework.task_grants .call casework_postgres 'Commits immutable grants and invalidation'
  casework.workers .call casework_postgres 'Processes pinned clocks, completion and due retention'
  casework.audit .call casework_audit_journal 'Durably accepts minimized entries'
}
