// Stable view URLs now describe the single review lifecycle.
views {
  view casework_architecture {
    title 'Casework / 01. Application architecture'
    description '''
      One runtime coordinates policy-bound human review. A trusted producer supplies either
      bounded submitted context or an exact source reference. A separately deployed staff
      application handles human interaction. Optional current-source providers preserve fresh
      human disclosure; the source independently authorizes every later mutation. PostgreSQL
      owns review state and durable results. The audit archive remains a separate operator duty.
    '''
    include casework_staff, casework_app, casework_client, casework_requester, casework_apply_principal, taskAgent, issuer, casework, casework_postgres, casework_audit_journal, breg
    global predicate casework_storage
  }
  view casework_runtime of casework {
    title 'Casework / 02. Runtime roles and responsibilities'
    description '''
      These components are logical responsibilities inside one process. Producer admission,
      current human eligibility and resource application remain separate authorities. Submitted
      and current-source requests share the same ReviewTask and Decision engine. Providers are
      read-only and purpose-bound. Directory changes do not replace pinned policy or source
      disclosure, and service status never supplies a human display projection.
    '''
    include casework.*, casework_postgres, casework_audit_journal, breg, taskAgent
    global predicate casework_storage
  }
  dynamic view casework_task_approval {
    title 'Casework / 03. A ReviewTask holder approves bounded agent work'
    description '''
      A current eligible holder previews the immutable template and exact disclosed bounds,
      then approves with the task revision and an idempotency key. This sequence shows the
      optional BReg current-source branch; submitted context uses its admitted snapshot.
      Required source fields must be visible to this human. Later machine rechecks use the
      separate task-grant-context purpose. Retries return the original grant and deadline.
      Execution still requires the issuer and destination resource to authorize the agent.
    '''
    casework_staff -> casework_app 'Reviews the exact template and bounds'
    casework_app -> casework.api 'Previews templates under explicit human profiles'
    casework.api -> casework.task_grants 'Checks current holder, team, policy and revision'
    casework.task_grants -> casework.breg_adapter 'Checks human disclosure for required fields'
    casework.breg_adapter -> breg.api 'Reads the exact human-display operation'
    breg.api -> casework.breg_adapter 'Returns exact binding and only human-visible context'
    casework.task_grants -> casework.api 'Returns immutable template, subject bounds and deadline mode'
    casework.api -> casework_app 'Presents the bounded approval'
    casework_app -> casework.api 'Approves template ID/version with If-Match and Idempotency-Key'
    casework.api -> casework.task_grants 'Rechecks current holder and exact context'
    casework.task_grants -> casework_postgres 'Commits one grant or recovers its exact original receipt'
    casework.api -> casework_app 'Returns the original grant ID and deadline'
  }
  dynamic view casework_source_event {
    title 'Casework / 04. Completion notification and authoritative recovery'
    description '''
      The terminal transaction writes one ReviewResult, receipt and feed event together.
      Notification carries no approval payload and only prompts an authenticated result read.
      A lost notification is recovered by polling or resuming the feed. The producer correlates
      the exact request, subject, policy and submission digest before using the result.
    '''
    casework.coordination -> casework_postgres 'Commits terminal result, Decision receipt and feed event'
    casework.workers -> casework_requester 'Sends a payload-free completion wakeup'
    casework_requester -> casework.api 'Fetches the result under its producer authority'
    casework.api -> casework.coordination 'Checks producer ownership and exact request'
    casework.coordination -> casework_postgres 'Reads the retained immutable result'
    casework.api -> casework_requester 'Returns the exact correlated ReviewResult'
    casework_requester -> casework_requester 'Verifies subject, policy and submission binding'
  }
  dynamic view casework_source_action {
    title 'Casework / 05. Review and independently authorized source application'
    description '''
      Casework records a human Decision, not a source action. Current-source decision preflight
      rechecks human disclosure and field-free reviewability for the exact pinned binding.
      BReg, as its own Proposal producer, fetches the authenticated result and correlates its
      frozen submission. An independently authorized source principal applies only after BReg
      rechecks current permissions and preconditions. Rejection, cancellation or a moved binding
      cannot authorize that application.
    '''
    casework_staff -> casework_app 'Decides a held and currently visible ReviewTask'
    casework_app -> casework.api 'Sends a revision-fenced Decision and exact idempotency key'
    casework.api -> casework.coordination 'Checks current human and task authority'
    casework.coordination -> casework.breg_adapter 'Rechecks exact human display and service status separately'
    casework.breg_adapter -> breg.api 'Reads purpose-bound context for the pinned Proposal'
    casework.coordination -> casework_postgres 'Commits Decision and the policy-derived terminal result'
    breg.api -> casework.api 'Fetches its own authenticated ReviewResult'
    casework.api -> breg.api 'Returns exact request, subject, policy and submission binding'
    casework_apply_principal -> breg.api 'Requests application with independent source authority'
    breg.api -> breg.api 'Rechecks frozen Proposal, approval, authorization and current preconditions'
  }
  dynamic view casework_attempt_recovery {
    title 'Casework / 06. Exact review response-loss recovery'
    description '''
      A lost response can follow a committed Decision, including an audit response failure.
      The reviewer retains the exact body and idempotency key, retries that same operation or
      reads the retained Decision receipt. The producer separately recovers the authenticated
      result. Neither path invents another Decision or repeats a source mutation.
    '''
    casework_app -> casework.api 'Retries the exact Decision body and original key'
    casework.api -> casework.coordination 'Checks current caller and the retained operation identity'
    casework.coordination -> casework_postgres 'Loads the original Decision receipt'
    casework.api -> casework_app 'Returns the retained receipt without another Decision'
    casework_requester -> casework.api 'Recovers the exact accepted request or result'
    casework.api -> casework_requester 'Returns the original binding and terminal result when retained'
  }
  dynamic view casework_hosted_decision {
    title 'Casework / 07. Standalone submitted-context review'
    description '''
      A synthetic or institutional producer submits a bounded schema-valid snapshot and exact
      expected policy. This uses the same ReviewRequest, ReviewTask, Decision and ReviewResult
      lifecycle without a provider or BReg. Current reviewer membership still applies. A mismatched
      policy or reused key with different input is refused before admission.
    '''
    casework_requester -> casework.api 'Submits the exact snapshot, subject and expected policy with a stable key'
    casework.api -> casework.coordination 'Checks producer namespace, policy and closed display schema'
    casework.coordination -> casework_postgres 'Commits the pinned request, context and initial ReviewTasks'
    casework_staff -> casework_app 'Claims and decides under the pinned policy'
    casework_app -> casework.api 'Sends revision-fenced claim and Decision requests'
    casework.api -> casework.coordination 'Checks current team service, eligibility and threshold rules'
    casework.coordination -> casework_postgres 'Commits immutable Decision, receipt and one terminal result'
    casework_requester -> casework.api 'Fetches its result or resumes its authenticated feed'
    casework.api -> casework_requester 'Returns only the declared result and exact original bindings'
  }
  view casework_interoperability {
    title 'Casework / 08. Runtime interoperability'
    description '''
      The protocol and generic clients contain no BReg semantics. A substitute source can
      implement the same read-only provider contract. BReg is one optional provider and is the
      producer of its own Proposal reviews; Casework reads its public HTTP contract and no BReg
      database. Human display, service status, task-grant context and routing have separate
      capabilities and authority. Casework never applies a Proposal. Task assertions also leave
      resource authorization with the destination. Every runtime keeps separate state and audit.
    '''
    include casework_app, casework_client, casework_requester, casework_apply_principal, taskAgent, issuer, casework.api, casework.access, casework.coordination, casework.task_grants, casework.source_contract, casework.breg_adapter, casework_postgres, breg.api, breg.task_grants
  }
  view casework_authoring_operations {
    title 'Casework / 09. Authoring and operator artifacts'
    description '''
      caseworkctl init produces a complete submitted-context project. Check, explain, test and
      types inspect the same compiled model. Provider pair verifies a current native producer
      export and its reader authority, and retains the verified export only on explicit apply;
      it installs no source lifecycle hook. Package covers exact local dependencies. Operators
      supply runtime bindings, review plan, apply activation with the migration credential and
      inspect status before serving. Open work keeps its pinned policy closure or activation
      refuses with affected-work recovery. The review-only baseline refuses retired tables;
      operators reconcile old work and preserve its database before fresh installation.
      Retention is bounded runtime maintenance, and lost decisions require database restore
      and reconciliation rather than reconstruction from a source.
    '''
    include casework_operator, casework_project, casework_cli, tooling, casework_package, casework_runtime_config, casework, casework_postgres
    global predicate casework_storage
  }
}
